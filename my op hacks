				if pingItem then
					pingText = " · " .. math.floor(pingItem:GetValue()) .. "ms"
				end
			end
		end)
		DEC.statsLabel.Text = fps .. " fps" .. pingText
		CAM.fpsAccum, CAM.fpsFrames, CAM.fpsTimer = 0, 0, 0
	end
end)

