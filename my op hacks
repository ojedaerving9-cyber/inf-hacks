					airWalkPart.CanCollide = true
					airWalkPart.Anchored = true
					airWalkPart.Parent = Workspace
				end
				airWalkPart.CFrame = hrp.CFrame - Vector3.new(0, 3.2, 0)
			else
				if airWalkPart then
					airWalkPart:Destroy()
					airWalkPart = nil
				end
			end
		end
	else
