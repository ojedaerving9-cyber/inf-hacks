bindAction(UI.hitboxTargetBtn, function()
	-- Same three-way the aim assist uses, and for the same reason: a game with
	-- no Teams object makes "enemies" unanswerable, and ALL is the way out
	if MISC.hitboxTarget == "ENEMIES" then
		MISC.hitboxTarget = "TEAM"
	elseif MISC.hitboxTarget == "TEAM" then
		MISC.hitboxTarget = "ALL"
	else
		MISC.hitboxTarget = "ENEMIES"
	end
	-- Anyone who no longer qualifies has to be put back, or they keep the big
	-- hitbox forever: clear everything and let the next pass rebuild it
	for part, was in pairs(ST.hitboxOrig) do
		pcall(function()
			if part and part.Parent then
				part.Size = was.size
				part.CanCollide = was.collide
				part.Massless = was.massless
				part.Transparency = was.clear
			end
		end)
	end
	table.clear(ST.hitboxOrig)
	ST.hitboxAt = 0
	FN.updateUI()
end)

