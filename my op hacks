-- Slot editor actions. Reading always works: the value replicated to this
-- client already. Writing is the open question -- a client write to a
-- StringValue does not replicate, so it only sticks if the game's own
-- LocalScript reads the value back and tells the server. Worth trying on a game
-- you own; the toast says what happened rather than implying success.
local function lwSlotValue()
	local ch = player.Character
	local inv = ST.invOf(ch)
	if not inv then return nil, "no Inventory on your character" end
	local slot = inv:FindFirstChild("Slot" .. LW.slot)
	if not slot then return nil, "no Slot" .. LW.slot end
	if not slot:IsA("ValueBase") then return nil, "Slot" .. LW.slot .. " is not a value" end
	return slot
end

