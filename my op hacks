--[[
	Breaking out by rejoining.

	Ice, jail and freeze are all server-side state that lives only for as long
	as your session does -- rejoining clears every one of them. So the reliable
	escape is not to out-fight the admin's script, it is to leave and come back,
	and the only real cost of doing that is landing at spawn instead of where
	you were standing.

	So the position is written to its own small file before leaving and read
	back on the way in. Its own file, not the main config: the config is
	rewritten whole every time it is saved, and this needs to be written often
	and cheaply while you walk around.

	POSITION ONLY. The rotation you come back with is whatever the game gives
	you at spawn. Restoring a saved rotation on a fresh character fights the
	spawn camera and leaves you facing a direction you did not choose.
--]]

function FN.savePosFile()
	local ch = player.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	if not root then return false end
	if type(writefile) ~= "function" then return false end

	local p = root.Position
	local ok = pcall(function()
		-- os.time so a stale bookmark from yesterday can be ignored, and the
		-- JobId so we know whether we came back to the same server
		writefile(MISC.posFile, string.format("%.2f,%.2f,%.2f,%d,%s",
			p.X, p.Y, p.Z, os.time(), tostring(game.JobId)))
	end)
	return ok
end

function FN.readPosFile()
	if type(readfile) ~= "function" or type(isfile) ~= "function" then return nil end
	local ok, raw = pcall(function()
		if not isfile(MISC.posFile) then return nil end
		return readfile(MISC.posFile)
	end)
	if not ok or not raw then return nil end

	local x, y, z, when = tostring(raw):match("^(-?[%d%.]+),(-?[%d%.]+),(-?[%d%.]+),(%d+)")
	if not x then return nil end
	x, y, z, when = tonumber(x), tonumber(y), tonumber(z), tonumber(when)
	if not (x and y and z and when) then return nil end

	-- A bookmark older than ten minutes is from some earlier session, and
	-- silently teleporting you somewhere you were half an hour ago is worse
	-- than doing nothing
	if os.time() - when > 600 then return nil end
	return Vector3.new(x, y, z)
end

function FN.clearPosFile()
	pcall(function()
		if type(delfile) == "function" and type(isfile) == "function"
			and isfile(MISC.posFile) then
			delfile(MISC.posFile)
		end
	end)
end

--[[
	Leave and come back. Same server by default, because the jail is per
	session and a rejoin is enough to be rid of it; NEW is there for when it is
	the admin you want to be rid of rather than the cage.
--]]
function FN.breakOut(why)
	if type(writefile) ~= "function" then
		FN.toast("Break out: no file API, cannot save your spot")
		return
	end

	if not FN.savePosFile() then
		FN.toast("Break out: could not save your position")
		return
	end

	FN.toast("Breaking out -- rejoining, then back to your spot")
	warn("[ModMenu] break out: " .. tostring(why))

	-- The menu has to survive the trip or you come back with no way to undo
	-- anything that is done to you next
	FN.armRejoin(true)

	task.delay(0.4, function()
		pcall(function()
			if MISC.breakMode == "NEW" then
				SERV.TeleportService:Teleport(game.PlaceId, player)
			else
				SERV.TeleportService:TeleportToPlaceInstance(
					game.PlaceId, game.JobId, player)
			end
		end)
	end)
end

--[[
	The other half, run at startup. Waits for a character rather than assuming
	one: on a fresh join the script is usually running before the rig exists.
--]]
function FN.returnToSpot()
	if not MISC.tpBack then return end
	local target = FN.readPosFile()
	if not target then return end

	task.spawn(function()
		local ch = player.Character or player.CharacterAdded:Wait()
		local root = ch:WaitForChild("HumanoidRootPart", 10)
		if not root then return end
		-- The spawn animation and any game-side placement finish first, or we
		-- teleport and then get put back
		task.wait(MISC.backDelay or 2)

		local now = player.Character
		local nowRoot = now and now:FindFirstChild("HumanoidRootPart")
		if not nowRoot then return end

		pcall(function()
			-- Position only. The rotation is whatever the spawn gave us.
			nowRoot.CFrame = CFrame.new(target) * nowRoot.CFrame.Rotation
			nowRoot.AssemblyLinearVelocity = Vector3.zero
		end)
		FN.clearPosFile()
		FN.toast(string.format("Back at your spot (%d, %d, %d)",
			target.X, target.Y, target.Z))
	end)
end

--[[
	Song Singer -- a chat script player.

	Paste lines in, press Sing, and they go out one at a time on a timer. Lines
	starting with ";" are commands rather than things to say, which is what
	turns a flat list into something with pauses and structure:

	    ;speed 1.4        gap between every line after this
	    ;wait 3           hold here for three seconds
	    ;prefix >>        put ">> " in front of the lines that follow
	    ;repeat 2         send the line above twice more
	    ;loop             start again from the top when it ends
	    ;stop             end here, ignoring anything below
	    ;say ;hello       send a line that really does start with ;
	    ;# note           a comment, never sent

	The gap has a floor of one second and it is not negotiable: Roblox drops
	messages sent faster than about one a second and will mute you for trying,
	so a "fast" setting that got you muted would be a worse feature than no
	feature. The box below the button says what the gap actually is.
--]]

function FN.singParse(text)
	local lines = {}
	for raw in tostring(text):gmatch("[^\r\n]+") do
		local line = raw:gsub("^%s+", ""):gsub("%s+$", "")
		if line ~= "" then lines[#lines + 1] = line end
	end
	return lines
end

function FN.singSaveFile()
	pcall(function()
		if type(writefile) == "function" then
			writefile(MISC.songFile, BOX.songBox.Text)
		end
	end)
end

function FN.singLoadFile()
	pcall(function()
		if type(readfile) == "function" and type(isfile) == "function"
			and isfile(MISC.songFile) then
			BOX.songBox.Text = readfile(MISC.songFile)
		end
	end)
end

--[[
	Chat budget.

	The one-second floor stops individual messages being dropped. It does
	nothing about the thing that actually gets you muted, which is the SUSTAINED
	rate: Roblox counts messages over a rolling window and mutes you for a while
	once you cross it. A song that averages a comfortable 2.2s gap can still
	trip it, because the chorus fires six lines in eight seconds and the average
	is not what is being measured.

	So: a token bucket. Up to chatBurst messages in any chatWindow seconds,
	which allows a short burst and enforces the average underneath it. Two ways
	to handle running out, and they are a real choice rather than a setting for
	the sake of one:

	  HOLD  the line waits its turn. Nothing is lost, but the song slips behind
	        the music and never catches up.
	  SKIP  the line is dropped. The song stays in time with the track, and you
	        lose whichever lines landed in the burst.

	For a chorus that repeats itself, SKIP is usually the better trade. For
	anything where every line matters, HOLD is.
--]]
function FN.chatReady()
	local now = tick()
	local window = MISC.chatWindow or 15

	-- Drop anything that has aged out of the window
	local kept = {}
	for _, t in ipairs(ST.chatTimes) do
		if now - t < window then kept[#kept + 1] = t end
	end
	ST.chatTimes = kept

	if #kept < (MISC.chatBurst or 7) then return true, 0 end
	-- Not ready: the oldest entry leaving the window is when we next can be
	return false, (kept[1] + window) - now
end

function FN.chatSpend()
	ST.chatTimes[#ST.chatTimes + 1] = tick()
end

--[[
	Pre-flight. Runs the same budget over the whole script before a note is
	sung, so the answer to "will this get me muted" arrives before the song
	rather than during it.

	Simulated, not guessed: the same window and burst the real thing uses,
	stepped through the script's own timings.
--]]
function FN.singCheck(lines)
	local window = MISC.chatWindow or 15
	local burst = MISC.chatBurst or 7
	local sent, clock, over, said = {}, 0, 0, 0
	local gap = math.max(MISC.singGap or 1.4, 1)

	for _, line in ipairs(lines) do
		local cmd, rest = line:match("^;(%a+)%s*(.*)$")
		if cmd == "wait" then
			clock = clock + math.clamp(tonumber(rest) or 1, 0.1, 300)
		elseif cmd == "speed" then
			gap = math.max(tonumber(rest) or 1.4, 1)
		elseif cmd == nil and line:sub(1, 2) ~= ";#" then
			said = said + 1
			clock = clock + gap

			local kept = {}
			for _, t in ipairs(sent) do
				if clock - t < window then kept[#kept + 1] = t end
			end
			sent = kept
			if #sent >= burst then over = over + 1 end
			sent[#sent + 1] = clock
		end
	end

	return said, over, clock
end

--[[
	Merge repeats.

	A call-and-response chorus says the same line twice a second apart, and
	those doubles are usually the densest thing in a song -- the stretch that
	trips the chat limit is almost always a repeat, not new words.

	Sending the pair as one message costs nothing to read and halves the
	message count exactly where it is tightest. The second line's time is
	folded into the wait that follows, so everything after it still lands where
	it should: this changes how many messages go out, not when the rest arrive.
--]]
function FN.singMerge()
	local lines = FN.singParse(BOX.songBox.Text)
	local out, merged = {}, 0
	local i = 1

	while i <= #lines do
		local line = lines[i]
		local isCmd = line:sub(1, 1) == ";"

		if isCmd then
			out[#out + 1] = line
			i = i + 1
		else
			-- Look past the waits between them: the next thing SAID is what
			-- matters, and a ";wait" sitting in between is exactly the shape a
			-- timed chorus has
			local j, held = i + 1, 0
			while j <= #lines and lines[j]:match("^;wait") do
				held = held + (tonumber(lines[j]:match("[%d%.]+")) or 0)
				j = j + 1
			end

			if j <= #lines and lines[j] == line then
				-- Same words again: keep one, and roll the gap it would have
				-- taken into the wait that follows so nothing after it moves
				out[#out + 1] = line
				merged = merged + 1
				local after = 0
				local k = j + 1
				while k <= #lines and lines[k]:match("^;wait") do
					after = after + (tonumber(lines[k]:match("[%d%.]+")) or 0)
					k = k + 1
				end
				local total = held + after
				if total > 0.05 then
					out[#out + 1] = string.format(";wait %.2f", math.max(total, 1))
				end
				i = k
			else
				out[#out + 1] = line
				i = i + 1
			end
		end
	end

	if merged == 0 then
		FN.toast("No repeated lines found next to each other")
		return
	end

	BOX.songBox.Text = table.concat(out, "\n")
	FN.singSaveFile()
	FN.toast(merged .. " repeats merged -- " .. merged .. " fewer messages")
	FN.updateUI()
end

--[[
	Turning the fling on and off.

	The position round trip is the whole reason this is a function rather than
	a flag: spinning at nine thousand radians a second in a crowd ends with you
	somewhere else, usually dead, and "where was I standing" is not a question
	you can answer afterwards.
--]]
--[[
	Desync. The server keeps where you WERE.

	Built on the fly rig rather than a second copy of it: Motor fly already
	welds the character to an anchored part and moves the part, which is
	exactly the shape this needs. The difference is intent -- fly wants to get
	somewhere, this wants the server to stop being told about it -- so this
	records the frozen spot and hands it back when you stand down.

	Honest about the trade, because it is easy to get killed by the half
	nobody mentions: while this is on you are not really anywhere else. The
	server resolves EVERYTHING at the frozen position -- damage you take, damage
	you deal, parts you touch, prompts you stand in front of. It is for not
	being where the danger is, not for going and doing something somewhere else.
--]]
function FN.setDesync(on)
	local ch = player.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")

	if on then
		if not root then
			FN.toast("Desync: no character")
			return
		end
		ST.desyncHome = root.CFrame
		MISC.desync = true

		-- Motor is the mode that welds to an anchored part, which is the whole
		-- mechanism. Any other mode keeps replicating and this would do nothing.
		if ST.flyMode ~= "Motor" then
			ST.desyncPrevMode = ST.flyMode
			ST.flyMode = "Motor"
			if ST.flying then
				pcall(disableFly)
				task.wait(0.05)
			end
		end
		if not ST.flying then pcall(toggleFly) end

		FN.toast("DESYNC on -- the server still has you where you were")
	else
		MISC.desync = false
		if ST.flying then pcall(disableFly) end

		-- Put you back on the spot the server thinks you are, so the two agree
		-- again. Without this the server corrects you itself, which is a
		-- rubber-band from wherever you wandered to and looks exactly like a
		-- teleport to everyone watching.
		pcall(function()
			local r = player.Character
				and player.Character:FindFirstChild("HumanoidRootPart")
			if r and ST.desyncHome then
				markIntentionalTeleport()
				r.CFrame = ST.desyncHome
				r.AssemblyLinearVelocity = Vector3.zero
			end
		end)
		ST.desyncHome = nil

		if ST.desyncPrevMode then
			ST.flyMode = ST.desyncPrevMode
			ST.desyncPrevMode = nil
		end
		FN.toast("Desync off -- back on your real spot")
	end
	FN.updateUI()
end

function FN.setTpKill(on)
	local ch = player.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	if on then
		if not root then
			FN.toast("TP Kill: no character")
			return
		end
		ST.tpKillHome = root.Position
		ST.tpKillTarget = nil
		ST.tpKillHits = 0
		ST.tpKillAt = 0
		ST.tpKillFleeing = false
		table.clear(ST.tpKillSkip)
		MISC.tpKill = true
		FN.toast("TP Kill ON -- orbiting the nearest target")
	else
		MISC.tpKill = false
		ST.tpKillTarget = nil
		ST.tpKillFleeing = false
		table.clear(ST.tpKillSkip)
		pcall(function()
			if root and ST.tpKillHome then
				markIntentionalTeleport()
				root.CFrame = CFrame.new(ST.tpKillHome) * root.CFrame.Rotation
				root.AssemblyLinearVelocity = Vector3.zero
			end
		end)
		ST.tpKillHome = nil
		FN.toast("TP Kill OFF -- back where you started")
	end
	FN.updateUI()
end

function FN.setTouchFling(on)
	local ch = player.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")

	if on then
		if not root then
			FN.toast("Fling: no character")
			return
		end
		ST.flingHome = root.Position
		ST.flingHits = 0
		ST.flingAt = 0
		MISC.touchFling = true

		-- Noclip means passing through the person instead of hitting them
		if ST.noclipping then
			setNoclip(false)
			FN.toast("Noclip off -- fling needs to actually touch them")
		end
		FN.toast("Touch Fling ON -- walk into people")
	else
		MISC.touchFling = false
		pcall(function()
			if root then
				root.AssemblyAngularVelocity = Vector3.zero
				root.AssemblyLinearVelocity = Vector3.zero
				if ST.flingHome then
					root.CFrame = CFrame.new(ST.flingHome) * root.CFrame.Rotation
				end
			end
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			if hum then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
		end)
		ST.flingHome = nil
		FN.toast("Touch Fling OFF -- back where you started")
	end
	FN.updateUI()
end

--[[
	F3X loader.

	Real F3X does its work through a server-side SyncAPI that the game's
	developer has to have installed. In a game that never installed it there is
	nothing on the other end, so the stock build loads, looks right, and changes
	nothing. The builds that work from an executor are patched to apply their
	edits locally instead -- that patch is what makes them "client only", and it
	is not something this script can invent.

	So this loads whichever build you point it at, and says clearly what it did.
	The URL is yours: whatever is at it runs with the same permissions as this
	menu, which is all of them.
--]]
--[[
	Loading F3X from a Roblox asset.

		loadstring(game:GetObjects('rbxassetid://6695644299')[1].Source)()

	That one line does four things that can each fail on their own, and the
	bare version reports none of them -- it either works or you stare at a
	backpack wondering which part broke:

	  GetObjects   executor-only. Absent on some, present but blocked on others.
	  the fetch    a wrong or deleted id returns an empty table, and [1] on it
	               is nil, and indexing .Source on nil is the error you see.
	  .Source      readable only where the executor allows it. A ModuleScript
	               from the site has it; a Model does not.
	  the run      the build itself can throw, which is not the loader's fault
	               and should not be reported as if it were.

	So each step is checked and named. Same code, told apart.
--]]
function FN.loadF3XAsset()
	local id = (BOX.f3xIdBox.Text or ""):gsub("%D", "")
	if id == "" then
		FN.toast("Put an asset id in the box first")
		return
	end

	if type(game.GetObjects) ~= "function" then
		FN.toast("This executor has no GetObjects")
		return
	end
	if type(loadstring) ~= "function" then
		FN.toast("This executor has no loadstring")
		return
	end

	FN.toast("Fetching asset " .. id .. "...")
	task.spawn(function()
		local ok, objects = pcall(function()
			return game:GetObjects("rbxassetid://" .. id)
		end)
		if not ok then
			FN.toast("GetObjects refused: " .. tostring(objects):sub(1, 50))
			warn("[ModMenu] GetObjects failed: " .. tostring(objects))
			return
		end
		if type(objects) ~= "table" or objects[1] == nil then
			FN.toast("Asset " .. id .. " returned nothing -- wrong or deleted id?")
			return
		end

		local first = objects[1]
		local src
		local gotSource = pcall(function() src = first.Source end)
		if not gotSource or type(src) ~= "string" or src == "" then
			FN.toast("That asset is a " .. first.ClassName .. " with no readable Source")
			return
		end

		local fn, err = loadstring(src)
		if not fn then
			FN.toast("Asset would not compile: " .. tostring(err):sub(1, 40))
			return
		end

		local ranOk, runErr = pcall(fn)
		if ranOk then
			MISC.f3xLoaded = true
			FN.toast("F3X loaded from asset -- check your backpack")
		else
			-- The build's own error, not the loader's: said differently so the
			-- next thing you try is the right one
			FN.toast("F3X itself errored: " .. tostring(runErr):sub(1, 55))
			warn("[ModMenu] F3X asset run failed: " .. tostring(runErr))
		end
		FN.updateUI()
	end)
end

function FN.loadF3X()
	local url = BOX.f3xUrlBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
	if url == "" then
		FN.toast("Paste the loader URL for your F3X build first")
		return
	end
	if type(game.HttpGet) ~= "function" then
		FN.toast("This executor has no HttpGet")
		return
	end
	if type(loadstring) ~= "function" then
		FN.toast("This executor has no loadstring")
		return
	end

	FN.toast("Fetching F3X...")
	task.spawn(function()
		local ok, body = pcall(function() return game:HttpGet(url) end)
		if not ok or not body or #body < 50 then
			FN.toast("Could not fetch that URL")
			warn("[ModMenu] F3X fetch failed: " .. tostring(body))
			return
		end

		local fn, err = loadstring(body)
		if not fn then
			-- Almost always an HTML error page rather than Lua: worth saying,
			-- because "it did nothing" and "the URL 404'd" look identical
			FN.toast("That URL did not return Lua (" .. tostring(err):sub(1, 40) .. ")")
			return
		end

		local ranOk, runErr = pcall(fn)
		if ranOk then
			MISC.f3xLoaded = true
			FN.toast("F3X loaded -- check your backpack")
		else
			FN.toast("F3X errored: " .. tostring(runErr):sub(1, 60))
			warn("[ModMenu] F3X run failed: " .. tostring(runErr))
		end
		FN.updateUI()
	end)
end

--[[
	Local build tools.

	The part of F3X that does not need F3X: click a part to select it, then
	move, size, spin, recolour, clone or delete it. Everything is written
	straight onto the instance on this client, so it works in any game and is
	visible to nobody but you.

	That last sentence is the whole shape of the feature. It is a sandbox for
	looking at how a place is built and trying changes out, not a way to edit
	somebody's game -- the server owns those parts and never hears about any of
	this.
--]]
function FN.buildSelect(part)
	if ST.buildBox then
		pcall(function() ST.buildBox:Destroy() end)
		ST.buildBox = nil
	end
	ST.buildSel = part
	if not part then
		FN.updateUI()
		return
	end

	local box = Instance.new("SelectionBox")
	box.Name = "BuildSel" .. uiName
	box.Adornee = part
	box.LineThickness = 0.04
	box.Color3 = Color3.fromRGB(90, 200, 255)
	box.SurfaceTransparency = 0.85
	box.Parent = part
	ST.buildBox = box
	FN.updateUI()
end

function FN.buildGive()
	if ST.buildTool then
		pcall(function() ST.buildTool:Destroy() end)
		ST.buildTool = nil
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		FN.toast("Build tool: no backpack")
		return
	end

	local tool = Instance.new("Tool")
	tool.Name = "BuildTool" .. uiName
	tool.ToolTip = "Click a part to select it. Local only."
	tool.RequiresHandle = false
	tool.CanBeDropped = false

	tool.Activated:Connect(function()
		local hit = mouse.Target
		if not hit then
			FN.buildSelect(nil)
			FN.toast("Nothing under the cursor -- selection cleared")
			return
		end
		-- Selecting your own character is never what you meant
		if hit:IsDescendantOf(player.Character or workspace) and
			hit:FindFirstAncestorOfClass("Model") == player.Character then
			FN.toast("That is you")
			return
		end
		FN.buildSelect(hit)
		FN.toast("Selected " .. hit.Name)
	end)

	tool.Parent = backpack
	ST.buildTool = tool
	FN.toast("Build tool in your backpack -- equip and click a part")
	FN.updateUI()
end

--[[
	Every edit goes through here.

	One dispatcher rather than a function per button: they all share the same
	three guards -- something selected, it still exists, and the write is
	pcall'd because a part the game locks will throw -- and a dozen copies of
	those is a dozen places to forget one.
--]]
function FN.buildAct(what, a, b, c)
	local p = ST.buildSel
	if not p or not p.Parent then
		FN.toast("Nothing selected")
		FN.buildSelect(nil)
		return
	end

	local step = MISC.buildStep or 1
	local ok = pcall(function()
		if what == "move" then
			p.CFrame = p.CFrame + Vector3.new(a * step, b * step, c * step)
		elseif what == "size" then
			local s = p.Size + Vector3.new(a * step, b * step, c * step)
			-- Roblox refuses anything under 0.05 on an axis and throws
			p.Size = Vector3.new(math.max(s.X, 0.05), math.max(s.Y, 0.05),
				math.max(s.Z, 0.05))
		elseif what == "spin" then
			p.CFrame = p.CFrame * CFrame.Angles(
				math.rad(a * 15), math.rad(b * 15), math.rad(c * 15))
		elseif what == "tome" then
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if root then p.CFrame = root.CFrame * CFrame.new(0, 0, -6) end
		elseif what == "anchor" then
			p.Anchored = not p.Anchored
		elseif what == "collide" then
			p.CanCollide = not p.CanCollide
		elseif what == "colour" then
			p.Color = Color3.fromHSV(math.random(), 0.6, 0.9)
		elseif what == "clear" then
			p.Transparency = (p.Transparency > 0.4) and 0 or 0.6
		elseif what == "neon" then
			p.Material = (p.Material == Enum.Material.Neon)
				and Enum.Material.Plastic or Enum.Material.Neon
		elseif what == "clone" then
			local copy = p:Clone()
			copy.Parent = p.Parent or Workspace
			copy.CFrame = p.CFrame + Vector3.new(0, p.Size.Y + 1, 0)
			FN.buildSelect(copy)
		elseif what == "delete" then
			-- Local only: the server still has it, so a rejoin brings it back.
			-- Said once rather than left as a surprise.
			p:Destroy()
			FN.buildSelect(nil)
			FN.toast("Deleted locally -- a rejoin brings it back")
			return
		elseif what == "spawn" then
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			local new = Instance.new("Part")
			new.Name = "BuildPart" .. uiName
			new.Size = Vector3.new(4, 1, 4)
			new.Anchored = true
			new.Material = Enum.Material.SmoothPlastic
			new.Color = Color3.fromRGB(180, 190, 200)
			new.CFrame = root and (root.CFrame * CFrame.new(0, 0, -8))
				or CFrame.new(0, 20, 0)
			new.Parent = Workspace
            FN.buildSelect(new)
		end
	end)

	if not ok then
		FN.toast("That part will not take the change (locked by the game)")
	end
	FN.updateUI()
end

--[[
	Executor check.

	A UNC score tells you how much of a standard an executor implements. It
	does not tell you what stops working in THIS script, which is the only
	question worth asking before you go and rely on something.

	So every entry names the functions a feature needs and the feature that
	needs them, and the report is written in terms of features. Missing
	hookmetamethod reads as "nothing -- Silent Aim uses hookfunction here",
	because that is true and it is what you actually want to know.

	Grouped by what breaks, not by API name: three functions that all only
	matter to one feature are one line, and one function that eight features
	depend on is worth its own.
--]]
--[[
	Executor check, with a verdict.

	Written for the afternoon an executor gets shut down and the next one has
	to be judged in five seconds instead of by finding out which feature is
	broken three days later.

	The listing was already here. What it did not do was ANSWER -- it printed
	sixteen OK/GONE lines and left you to work out whether that added up to a
	working menu. So each probe now carries what losing it actually costs, and
	the whole thing ends in one sentence you can screenshot and compare
	against the next candidate.

	The most important fact in the report is the one that needs no probe. If
	you are reading this at all, the executor compiled twenty-four thousand
	lines of Lua -- and that is the bar most of them fail, long before they run
	out of API surface. Nothing below matters on an executor that cannot load
	the file.
--]]
function FN.execCheck()
	-- { label, {names...}, "what needs it", allOf, cost }
	-- allOf true means every name must exist; false means any one will do.
	-- cost: CORE breaks a system, FEATURE kills one thing, MINOR is a nicety.
	local probes = {
		{ "loadstring", { "loadstring" },
			"F3X loaders, menu rebuild after deletion, Old Days", true, "CORE" },
		{ "globals table", { "getgenv" },
			"surviving a rejoin, cross-copy handshake", true, "CORE" },
		{ "files", { "writefile", "readfile", "isfile" },
			"settings, profiles, song text, return-to-spot", true, "FEATURE" },
		{ "queue on teleport", { "queue_on_teleport", "queueonteleport" },
			"Come Back After Teleport, script survives rejoin", false, "FEATURE" },
		{ "hidden gui", { "gethui" }, "Menu Lives In: HIDDEN", true, "FEATURE" },
		{ "clipboard", { "setclipboard" },
			"every Copy button, both asset finders, all reports", true, "FEATURE" },
		{ "http", { "request", "http_request" },
			"audio search, server hop, What Is This Id", false, "FEATURE" },
		{ "touch", { "firetouchinterest" },
			"Auto Collect, Touch Fling, block breaking", true, "FEATURE" },
		{ "connections", { "getconnections" },
			"Remote Spy replay, some anti-cheat work", true, "FEATURE" },
		{ "function hooks", { "hookfunction", "newcclosure" },
			"Silent Aim", true, "FEATURE" },
		{ "mouse move", { "mousemoverel" },
			"Aim Assist MOUSE method, TP Kill cursor", true, "FEATURE" },
		{ "delete files", { "delfile" },
			"deleting profiles, Reset Settings", true, "MINOR" },
		{ "list files", { "listfiles" },
			"List Saved Profiles -- save and load still work", true, "MINOR" },
		{ "prompts", { "fireproximityprompt" }, "Instant Prompts", true, "MINOR" },
		{ "clicks", { "fireclickdetector" },
			"click-detector interaction", true, "MINOR" },
		{ "fps cap", { "setfpscap" }, "FPS Cap", true, "MINOR" },
		{ "asset objects", { "getobjects" }, "F3X from asset id", true, "MINOR" },
	}

	-- HttpGet and GetObjects hang off game, not the global table
	local function have(name)
		if name == "request" or name == "http_request" then
			local ok = false
			pcall(function()
				ok = type(getgenv and getgenv()[name] or _G[name]) == "function"
					or type(game.HttpGet) == "function"
			end)
			return ok
		end
		if name == "getobjects" then
			local ok = false
			pcall(function() ok = type(game.GetObjects) == "function" end)
			return ok
		end
		return type(getgenv and getgenv()[name] or nil) == "function"
			or type(_G[name]) == "function"
			or (function()
				local ok, v = pcall(function() return getfenv(0)[name] end)
				return ok and type(v) == "function"
			end)()
	end

	-- Worth naming in the report: comparing two of these later is much easier
	-- when each one says which executor it came from
	local who = "unknown executor"
	pcall(function()
		if type(identifyexecutor) == "function" then
			local name, version = identifyexecutor()
			who = tostring(name) .. (version and (" " .. tostring(version)) or "")
		elseif type(getexecutorname) == "function" then
			who = tostring(getexecutorname())
		end
	end)

	local lines = { "[ModMenu] executor check -- " .. who }
	local gone = { CORE = {}, FEATURE = {}, MINOR = {} }

	for _, probe in ipairs(probes) do
		local label, names, needs, allOf, cost =
			probe[1], probe[2], probe[3], probe[4], probe[5]
		local got = 0
		for _, n in ipairs(names) do
			if have(n) then got = got + 1 end
		end
		local ok = allOf and (got == #names) or (got > 0)
		if ok then
			lines[#lines + 1] = "  OK    " .. label
		else
			table.insert(gone[cost], label)
			lines[#lines + 1] = "  GONE  [" .. cost .. "] " .. label
				.. "  ->  " .. needs
		end
	end

	-- Said explicitly, because seeing it fail in a UNC test and not knowing
	-- whether this script cares is exactly the gap this report is for
	lines[#lines + 1] = "  n/a   hookmetamethod, getrawmetatable -- not used"
		.. " here; Silent Aim uses hookfunction"

	local nCore, nFeat, nMinor = #gone.CORE, #gone.FEATURE, #gone.MINOR
	local total = nCore + nFeat + nMinor

	local verdict
	if nCore > 0 then
		verdict = "PARTLY BROKEN -- " .. table.concat(gone.CORE, ", ")
			.. " missing. The menu runs, but those systems will not."
	elseif total == 0 then
		verdict = "PERFECT -- everything this script can use is here."
	elseif nFeat == 0 then
		verdict = "GOOD -- only " .. nMinor .. " convenience function(s) missing."
	elseif nFeat <= 2 then
		verdict = "GOOD -- " .. nFeat .. " feature(s) off: "
			.. table.concat(gone.FEATURE, ", ")
	else
		verdict = "USABLE -- " .. nFeat .. " features off: "
			.. table.concat(gone.FEATURE, ", ")
	end

	lines[#lines + 1] = ""
	-- The headline needs no probe. Reading this at all means the executor
	-- compiled the whole file, and that is the bar most of them fail.
	lines[#lines + 1] = "  It loaded a 24,000-line script -- most cannot."
	lines[#lines + 1] = "  VERDICT: " .. verdict

	for _, l in ipairs(lines) do print(l) end
	if type(setclipboard) == "function" then
		pcall(setclipboard, table.concat(lines, "\n"))
	end

	FN.toast(verdict)
end

--[[
	What is actually on.

	Three hundred toggles and a panic button, and no way to answer "what have I
	got running" except scrolling the whole menu. That question comes up every
	time something behaves oddly, and it is the question WHY AM I FLOATING
	answers for one symptom and nothing answers in general.

	Rather than a hand-written list of features -- which would be wrong within
	two versions, the way every hand-written list in this file has been -- it
	compares the live settings against a snapshot taken before the config
	loaded. Anything that differs from stock is listed, whatever it is called,
	including settings added long after this was written.

	The snapshot is the whole trick. "Is it true" would list every sub-option
	that merely defaults to true; "is it different from how it starts" lists
	only what you or your config actually changed.
--]]
function FN.snapshotDefaults()
	ST.defMisc, ST.defOn = {}, {}
	for k, v in pairs(MISC) do
		if type(v) ~= "table" then ST.defMisc[k] = v end
	end
	for k, v in pairs(ON) do
		if type(v) ~= "table" then ST.defOn[k] = v end
	end
end

function FN.activeReport()
	-- fieldName -> "field name", so the report reads in English without a
	-- lookup table anyone has to maintain
	local function readable(name)
		local spaced = name:gsub("(%l)(%u)", "%1 %2")
		return (spaced:gsub("^%l", string.upper))
	end

	local changed = {}
	local function diff(live, base, prefix)
		if not base then return end
		for k, v in pairs(live) do
			if type(v) ~= "table" and type(v) ~= "function" then
				local was = base[k]
				if was ~= nil and v ~= was then
					-- Booleans read better as a plain name; numbers and modes
					-- are only meaningful with the value attached
					if type(v) == "boolean" then
						if v then changed[#changed + 1] = readable(k) end
					else
						changed[#changed + 1] = readable(k) .. " = " .. tostring(v)
					end
				end
			end
		end
	end

	diff(MISC, ST.defMisc)
	diff(ON, ST.defOn)

	-- The handful of live states that are not settings, so no snapshot covers
	-- them. Short enough to be worth naming by hand.
	if ST.flying then changed[#changed + 1] = "FLYING" end
	if ST.noclipping then changed[#changed + 1] = "NOCLIP" end
	if ST.spectating then changed[#changed + 1] = "SPECTATING" end
	if ST.singOn then changed[#changed + 1] = "SINGING" end
	if MACRO.playing then changed[#changed + 1] = "REPLAYING A ROUTE" end
	if MACRO.recording then changed[#changed + 1] = "RECORDING A ROUTE" end
	if ST.buildSel then changed[#changed + 1] = "A PART IS SELECTED" end

	table.sort(changed)

	-- Keybinds sharing a key: the first handler wins and the second silently
	-- never fires, which reads as "that keybind is broken"
	local seen, clashes = {}, {}
	for slot, code in pairs(KEYS) do
		if code then
			local n = code.Name
			if seen[n] then
				clashes[#clashes + 1] = seen[n] .. " and " .. slot .. " share " .. n
			else
				seen[n] = slot
			end
		end
	end

	print("[ModMenu] active --")
	if #changed == 0 then
		print("  nothing changed from defaults")
	end
	for i, c in ipairs(changed) do print("  " .. i .. ". " .. c) end
	for _, c in ipairs(clashes) do print("  CLASH: " .. c) end

	if type(setclipboard) == "function" then
		pcall(setclipboard, table.concat(changed, "\n"))
	end

	local msg = #changed .. " changed from default"
	if #clashes > 0 then msg = msg .. ", " .. #clashes .. " KEY CLASH" end
	FN.toast(msg .. " -- see console")
end

function FN.singStop(why)
	ST.singOn = false
	ST.singIndex = 1
	ST.singPrefix = ""
	if ST.singTag then
		pcall(function() ST.singTag:Destroy() end)
		ST.singTag = nil
	end
	if why then FN.toast("Singer: " .. why) end
	FN.updateUI()
end

function FN.singStart()
	local lines = FN.singParse(BOX.songBox.Text)
	if #lines == 0 then
		FN.toast("Nothing to sing -- paste some lines first")
		return
	end

	-- Timed text that has not been converted yet: a caption cue, or an [mm:ss]
	-- mark, and no ";wait" anywhere to show the import has already run. Import
	-- then Sing was two presses that could only ever happen in that order.
	local timed, waits = false, false
	for _, line in ipairs(lines) do
		if line:match("^;wait") then waits = true end
		if line:match("%-%->") or FN.singStamp(line) then timed = true end
	end
	if timed and not waits then
		FN.singImport()
		lines = FN.singParse(BOX.songBox.Text)
	end

	ST.singLines = lines
	ST.singIndex = 1
	ST.singPrefix = ""
	ST.singGap = math.max(MISC.singGap or 1.4, 1)
	-- Fires on the very next tick rather than after a gap: pressing Sing and
	-- watching nothing happen for a second and a half reads as broken
	-- Announce line goes in front of the script rather than being sent here:
	-- sending it directly would land in the same second as the first line and
	-- one of the two would be dropped
	if MISC.singAnnounce and (MISC.songTitle or "") ~= "" then
		local intro = "now playing: " .. MISC.songTitle
		if (MISC.songBy or "") ~= "" then intro = intro .. " - " .. MISC.songBy end
		table.insert(ST.singLines, 1, intro)
	end

	ST.singAt = 0
	ST.singOn = true
	ST.singHeld = 0
	ST.singSkipped = 0
	ST.singSaid = 0
	ST.chatTimes = {}

	-- Sung lines, not script entries: a timed song is half ";wait" by volume,
	-- and "4/104" for a 52 line song is a wrong number, not a technical one
	ST.singTotal = 0
	for _, l in ipairs(ST.singLines) do
		if l:sub(1, 1) ~= ";" then ST.singTotal = ST.singTotal + 1 end
	end
	FN.singSaveFile()

	-- Says whether this will hit the limit BEFORE the first line rather than
	-- halfway through, which is when you would otherwise find out
	local said, over, runs = FN.singCheck(ST.singLines)
	if over > 0 then
		FN.toast(string.format("%d lines, %d over the chat limit -- %s",
			said, over,
			(MISC.singOverflow == "SKIP") and "they will be skipped"
				or "they will be held (song drifts late)"))
	else
		FN.toast(string.format("Singing %d lines, %d:%02d, within the chat limit",
			said, math.floor(runs / 60), math.floor(runs % 60)))
	end
	FN.updateUI()
end

-- The line above your own head. Local only -- nobody else sees this one, the
-- chat is the part they see -- so it is off by default and labelled as such.
function FN.singShow(text)
	if not MISC.singOverhead then return end
	local ch = player.Character
	local head = ch and ch:FindFirstChild("Head")
	if not head then return end

	if not ST.singTag or not ST.singTag.Parent then
		local bb = Instance.new("BillboardGui")
		bb.Name = "Singer" .. uiName
		bb.Adornee = head
		bb.AlwaysOnTop = true
		bb.LightInfluence = 0
		bb.Size = UDim2.new(0, 400, 0, 40)
		bb.StudsOffset = Vector3.new(0, 3.2, 0)
		bb.Parent = head

		local label = Instance.new("TextLabel")
		label.Name = "Line"
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBold
		label.TextSize = 15
		label.TextColor3 = Color3.fromRGB(255, 240, 160)
		label.TextStrokeTransparency = 0.35
		label.TextScaled = false
		label.TextWrapped = true
		label.Parent = bb

		ST.singTag = bb
	end

	local lbl = ST.singTag:FindFirstChild("Line")
	if lbl then lbl.Text = text end
	ST.singTag.Adornee = head
end

--[[
	One step of the script, called from the stepper. Commands are handled in a
	loop rather than one per tick: five ";prefix" lines in a row should not
	cost five seconds of silence, because none of them say anything.
--]]
function FN.singStep()
	if not ST.singOn then return end
	if tick() < (ST.singAt or 0) then return end

	local guard = 0
	while ST.singOn do
		guard = guard + 1
		-- A ";loop" with nothing but commands above it would spin forever
		if guard > 200 then
			FN.singStop("script has no lines to say")
			return
		end

		local line = ST.singLines[ST.singIndex]

		if not line then
			if MISC.singLoop then
				ST.singIndex = 1
				ST.singAt = tick() + ST.singGap
				return
			end
			FN.singStop("finished")
			return
		end

		ST.singIndex = ST.singIndex + 1

		local cmd, rest = line:match("^;(%a+)%s*(.*)$")
		if line:sub(1, 2) == ";#" then
			-- comment: fall through and take the next line immediately

		elseif cmd == "wait" then
			local n = tonumber(rest) or 1
			ST.singAt = tick() + math.clamp(n, 0.1, 300)
			return

		elseif cmd == "speed" then
			ST.singGap = math.max(tonumber(rest) or 1.4, 1)

		elseif cmd == "prefix" then
			ST.singPrefix = (rest ~= "") and (rest .. " ") or ""

		elseif cmd == "loop" then
			MISC.singLoop = true

		elseif cmd == "stop" then
			FN.singStop("stopped by ;stop")
			return

		elseif cmd == "repeat" then
			local n = math.clamp(math.floor(tonumber(rest) or 1), 1, 50)
			local prev = ST.singLines[ST.singIndex - 2]
			if prev and prev:sub(1, 1) ~= ";" then
				-- Queued as real lines so every other rule -- the gap, the
				-- prefix, stopping early -- applies to them unchanged
				for _ = 1, n do
					table.insert(ST.singLines, ST.singIndex - 1, prev)
				end
			end

		else
			-- Either ";say something" or an ordinary line
			local text = (cmd == "say") and rest or line
			if text ~= "" then
				local out = (ST.singPrefix or "") .. text
				-- Roblox drops anything past 200 characters
				if #out > 200 then out = out:sub(1, 200) end

				local ready, wait = FN.chatReady()
				if not ready then
					if MISC.singOverflow == "SKIP" then
						-- Dropped, and the clock is not touched: the point of
						-- SKIP is that the song stays with the music
						ST.singSkipped = (ST.singSkipped or 0) + 1
						ST.singAt = tick() + ST.singGap
						FN.updateUI()
						return
					end
					-- HOLD: put the line back and try again when there is room
					ST.singIndex = ST.singIndex - 1
					ST.singAt = tick() + math.max(wait, 0.1)
					ST.singHeld = (ST.singHeld or 0) + 1
					return
				end

				FN.chatSpend()
				ST.singSaid = (ST.singSaid or 0) + 1
				pcall(function() ST.sendChat(out) end)
				FN.singShow(out)
				ST.singAt = tick() + ST.singGap
				FN.updateUI()
				return
			end
		end
	end
end

--[[
	Timing tools for the singer.

	Pasting lines is the easy half. Getting them to land ON the beat is the
	half that actually matters, and it is the half a person cannot do by hand
	-- nobody wants to work out that line 14 needs a 3.2 second gap.

	Two ways in:

	  TIMESTAMPS  If your lines are already marked "[00:14] words", the marks
	              are turned into the gaps between them. This is the .lrc
	              format every karaoke file uses, so anything you already have
	              in that shape works with no editing.

	  SPREAD      No timestamps, just a song length: the lines are spaced
	              evenly across it.

	Neither one goes and gets the words for you. Paste those yourself.
--]]

-- "[01:23.45]" / "[1:23]" / "1:23" at the start of a line -> seconds
function FN.singStamp(line)
	local m, sec, hun = line:match("^%[?(%d+):(%d+)%.(%d+)%]?%s*")
	if not m then
		m, sec = line:match("^%[?(%d+):(%d+)%]?%s*")
		hun = "0"
	end
	if not m then return nil end
	local at = tonumber(m) * 60 + tonumber(sec) + (tonumber("0." .. hun) or 0)
	-- The rest of the line is the words; the stamp itself is never sung
	local text = line:gsub("^%[?%d+:%d+[%.%d]*%]?%s*", "")
	return at, text
end

--[[
	Caption files, converted to the marks the importer already understands.

	SRT and VTT are what a subtitle file looks like when you have one:

	    2
	    00:00:14,500 --> 00:00:17,000
	    the text

	The index line and the end time are both noise here -- only the START time
	and the text matter -- so a pass over the box turns each cue into a plain
	"[mm:ss.xx] text" line and the existing timestamp path does the rest. No
	second copy of the timing logic, and .lrc files keep working untouched.

	Returns the converted text and how many cues it found, so the caller can
	tell "this was a caption file" from "this was already fine".
--]]
function FN.singFromCaptions(text)
	local out, cues = {}, 0
	local pending = nil

	for raw in tostring(text):gmatch("[^\r\n]+") do
		local line = raw:gsub("^%s+", ""):gsub("%s+$", "")

		-- "00:00:14,500 --> 00:00:17,000", comma or dot, hours optional
		local h, m, sec, frac = line:match(
			"^(%d+):(%d+):(%d+)[,%.](%d+)%s*%-%->")
		if not h then
			local m2, s2, f2 = line:match("^(%d+):(%d+)[,%.](%d+)%s*%-%->")
			if m2 then h, m, sec, frac = "0", m2, s2, f2 end
		end

		if h then
			local at = tonumber(h) * 3600 + tonumber(m) * 60 + tonumber(sec)
			pending = string.format("[%02d:%02d.%02d]",
				math.floor(at / 60), at % 60,
				math.floor((tonumber("0." .. frac) or 0) * 100))
			cues = cues + 1
		elseif line == "" or line:upper() == "WEBVTT" then
			-- header and blank separators carry nothing
		elseif line:match("^%d+$") and pending == nil then
			-- a lone number is the cue index, not a lyric
		elseif pending then
			out[#out + 1] = pending .. " " .. line
			pending = nil
		else
			-- text with no cue in front of it: kept as-is so a half-caption,
			-- half-plain paste does not silently lose lines
			out[#out + 1] = line
		end
	end

	return table.concat(out, "\n"), cues
end

function FN.singImport()
	-- Captions first: this is a no-op on anything that is not one
	local converted, cues = FN.singFromCaptions(BOX.songBox.Text)
	if cues > 1 then
		BOX.songBox.Text = converted
		FN.toast("Read " .. cues .. " caption cues")
	end

	local lines = FN.singParse(BOX.songBox.Text)
	local stamped, plain = {}, 0

	for _, line in ipairs(lines) do
		if line:sub(1, 1) == ";" then
			-- existing commands pass through untouched
			stamped[#stamped + 1] = { cmd = line }
		else
			local at, text = FN.singStamp(line)
			if at then
				stamped[#stamped + 1] = { at = at, text = text }
			else
				plain = plain + 1
				stamped[#stamped + 1] = { text = line }
			end
		end
	end

	local marks = 0
	for _, e in ipairs(stamped) do
		if e.at then marks = marks + 1 end
	end
	if marks < 2 then
		FN.toast("Import: need at least two [mm:ss] marks")
		return
	end

	-- Rebuilt as waits between marks. The gap floor still applies underneath:
	-- a song with two lines a third of a second apart cannot be sung at that
	-- speed no matter what the file says, and pretending otherwise would just
	-- get you muted.
	local out, last = {}, nil
	local tight = 0

	-- The lead-in. Everything below only writes the gaps BETWEEN marks, so
	-- without this the first line fires instantly and the entire song runs
	-- early by however long the intro was.
	for _, e in ipairs(stamped) do
		if e.at then
			if e.at > 0.05 then
				out[#out + 1] = ";# lead-in before the first line -- delete to start at once"
				out[#out + 1] = string.format(";wait %.2f", e.at)
			end
			break
		end
	end
	for _, e in ipairs(stamped) do
		if e.cmd then
			out[#out + 1] = e.cmd
		else
			if e.at and last then
				local gap = e.at - last
				if gap < 1 then tight = tight + 1 end
				if gap > 0.05 then
					out[#out + 1] = string.format(";wait %.2f", math.max(gap, 1))
				end
			end
			if e.at then last = e.at end
			if e.text and e.text ~= "" then out[#out + 1] = e.text end
		end
	end

	-- The gap setting would add itself on top of every ;wait we just wrote
	table.insert(out, 1, ";speed 1")
	table.insert(out, 1, ";# timed from timestamps -- ;speed 1 so the waits are exact")

	BOX.songBox.Text = table.concat(out, "\n")
	FN.singSaveFile()

	if tight > 0 then
		FN.toast(marks .. " marks timed, " .. tight .. " too fast for chat (held at 1s)")
	else
		FN.toast(marks .. " marks turned into waits")
	end
	FN.updateUI()
end

-- Even spacing across a length you give it, for lines with no marks at all
function FN.singSpread()
	local text = BOX.songSpreadBox.Text
	local mm, ss = text:match("(%d+):(%d+)")
	local total = mm and (tonumber(mm) * 60 + tonumber(ss)) or tonumber(text:match("%d+"))
	if not total or total < 5 then
		FN.toast("Spread: give a length like 3:20")
		return
	end

	local said = 0
	for _, line in ipairs(FN.singParse(BOX.songBox.Text)) do
		if line:sub(1, 1) ~= ";" then said = said + 1 end
	end
	if said < 2 then
		FN.toast("Spread: needs at least two lines")
		return
	end

	local gap = math.max(total / said, 1)
	MISC.singGap = math.clamp(gap, 1, 30)
	FN.toast(string.format("%d lines over %d:%02d -- %.1fs each",
		said, math.floor(total / 60), total % 60, MISC.singGap))
	FN.updateUI()
end

--[[
	The video's TITLE, from YouTube's oEmbed endpoint.

	Metadata, not content: this asks the public endpoint what a video is called
	and gets back a name, a channel and a thumbnail URL. It is the announce
	line -- "now playing: <title>" -- and it is deliberately the only thing
	here that touches YouTube.
--]]
function FN.singTitle()
	local url = BOX.songUrlBox.Text:gsub("%s+", "")
	if url == "" then
		FN.toast("Paste a YouTube link first")
		return
	end
	if type(game.HttpGet) ~= "function" and type(request) ~= "function" then
		FN.toast("This executor cannot make web requests")
		return
	end

	-- Both link shapes people actually paste
	local id = url:match("[?&]v=([%w_%-]+)") or url:match("youtu%.be/([%w_%-]+)")
	if not id then
		FN.toast("Could not find a video id in that link")
		return
	end

	task.spawn(function()
		local ok, body = pcall(function()
			return game:HttpGet(
				"https://www.youtube.com/oembed?url=https%3A//www.youtube.com/watch%3Fv%3D"
				.. id .. "&format=json")
		end)
		if not ok or not body then
			FN.toast("Could not reach YouTube")
			return
		end

		local decoded
		local okJson = pcall(function()
			decoded = SERV.HttpService:JSONDecode(body)
		end)
		if not okJson or not decoded or not decoded.title then
			FN.toast("YouTube replied with something unexpected")
			return
		end

		MISC.songTitle = tostring(decoded.title)
		MISC.songBy = tostring(decoded.author_name or "")
		FN.toast("Got: " .. MISC.songTitle)
		FN.updateUI()
	end)
end

function FN.whyFloating()
	local reasons = {}
	local function say(text) reasons[#reasons + 1] = text end

	local ch = player.Character
	if not ch then
		say("No character at all -- you are dead or still loading")
		return reasons
	end

	local hum = ch:FindFirstChildOfClass("Humanoid")
	local root = ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Torso")

	-- 1. The character itself, whoever set it that way
	if root then
		if root.Anchored then
			say("Your root part is ANCHORED -- nothing can move you, menu or game")
		end
		if root.Massless then
			say("Your root part is Massless")
		end
		local sz = root.Size
		if math.max(sz.X, sz.Y, sz.Z) > 4 then
			say(string.format("Your root part is %d x %d x %d -- oversized, so you "
				.. "rest on a box bigger than you", sz.X, sz.Y, sz.Z))
		end
	end

	if hum then
		if hum.PlatformStand then
			say("PlatformStand is on -- ragdoll mode, your humanoid is not driving")
		end
		if hum.Sit then
			say("You are SEATED -- get out of the seat first")
		end
		if hum.HipHeight > 4 then
			say(string.format("HipHeight is %.1f -- your legs are stretched, which "
				.. "reads as hovering", hum.HipHeight))
		end
		local st
		pcall(function() st = hum:GetState() end)
		if st == Enum.HumanoidStateType.Physics then
			say("Humanoid state is Physics -- something took manual control of you")
		end
	end

	-- Body movers. Anything here overrides walking completely, and the game
	-- adding one of its own is a case the menu's toggles cannot explain.
	local movers = {}
	for _, d in ipairs(ch:GetDescendants()) do
		if d:IsA("BodyVelocity") or d:IsA("BodyPosition") or d:IsA("BodyGyro")
			or d:IsA("BodyForce") or d:IsA("BodyThrust")
			or d:IsA("LinearVelocity") or d:IsA("AlignPosition")
			or d:IsA("VectorForce") or d:IsA("AngularVelocity") then
			movers[#movers + 1] = d.ClassName .. " (" .. d.Name .. ")"
		end
	end
	if #movers > 0 then
		say("Body movers on you: " .. table.concat(movers, ", "))
	end

	-- 2. Gravity. One number, and it explains everything at once when it is wrong
	local g = Workspace.Gravity
	if g < (ORIGINAL.gravity or 196.2) * 0.5 then
		say(string.format("Workspace gravity is %.1f (normal is %.1f) -- everyone "
			.. "is floating, not just you", g, ORIGINAL.gravity or 196.2))
	end

	-- 3. This menu's own holds
	if ST.flying then say("FLY is on") end
	if MISC.frozen then say("Freeze Character is on") end
	if ST.spiderHover then say("Idle Float has you (Wall Climb) -- tap WASD") end
	if ST.spiderStuck then say("Wall Climb is clinging you to a surface") end
	if ST.swingAnchor then say("Web Swing rope is out -- release the swing key") end
	if ST.airWalkPart then say("AIR WALK is on -- you are standing on its platform") end
	if ST.maceOn then say("MaceKill is mid-slam") end
	if MISC.desync then
		say("DESYNC is on -- you are flying, and the server has you"
			.. " somewhere else entirely")
	end
	if MISC.tpKill then
		say("TP KILL is on -- it teleports you several times a second"
			.. (ST.tpKillFleeing
				and ", and is running away right now because your health is low"
				or ""))
	end
	if MISC.touchFling then
		say("TOUCH FLING is on -- you are spinning, which throws you too")
	end
	if MISC.antiKnock then
		say("Anti Knockback is capping your speed at " .. (MISC.knockCap or 90))
	end
	if MISC.antiIce and (MISC.iceAnchors or 0) > 0 then
		say("Something keeps anchoring you -- Anti-Ice has undone it "
			.. MISC.iceAnchors .. " time(s), so an admin is probably freezing you")
	end
	if MISC.headTurn and MISC.headBody then
		say("Head Turn is rotating your body to follow the camera")
	end
	if ST.weldTarget then say("You are welded to " .. tostring(ST.weldTarget.Name)) end
	if ST.noclipping and MISC.noclipFloor then
		say("Noclip Floor Hold is on -- it catches you at floor level")
	end
	if MISC.glide and (MISC.glideLeft or 0) > 0 then
		say("Glide is on -- it caps your fall speed, so descent looks like floating")
	end
	if MISC.hitbox then
		say("Hitbox Expander is on (only resizes OTHERS -- but check your own size above)")
	end
	if VOID.enabled then say("Anti-Void is on -- it catches you above the void") end
	if MISC.spider and not ST.spiderHover and not ST.spiderStuck then
		say("Wall Climb is on but not holding you right now")
	end

	if #reasons == 0 then
		say("Nothing this menu does is holding you -- so it is the game itself, "
			.. "or you are simply mid-air")
	end
	return reasons
end

--[[
	Undo every hold at once.

	Deliberately narrower than PANIC: this puts movement back to normal and
	leaves your ESP, your aim settings and the rest of the menu alone, because
	being stuck in the air is not a reason to lose everything you set up.
--]]
function FN.unstick()
	MISC.spiderFloat = false
	MISC.spider = false
	MISC.swing = false
	MISC.glide = false
	MISC.frozen = false
	ST.spiderStuck = false
	ST.spiderNormal = nil
	ST.spiderHover = nil
	ST.swingAnchor = nil
	ST.maceOn = false

	if ST.swingRope then
		pcall(function() ST.swingRope:Destroy() end)
		ST.swingRope = nil
	end
	if ST.flying then pcall(disableFly) end
	if ST.airWalkPart then pcall(function() setAirWalk(false) end) end
	pcall(function() FN.disableWeld() end)

	-- Gravity last, and only if we are the ones who changed it
	if ON.gravityEnabled then
		ON.gravityEnabled = false
		pcall(function() Workspace.Gravity = ORIGINAL.gravity end)
	end

	local ch = player.Character
	if ch then
		local hum = ch:FindFirstChildOfClass("Humanoid")
		local root = ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Torso")
		if root then
			pcall(function()
				root.Anchored = false
				root.Massless = false
				-- Only if it looks like our expander left it oversized: a game
				-- with a genuinely large root part should not be shrunk
				if root.Size.X > 4 or root.Size.Z > 4 then
					root.Size = Vector3.new(2, 2, 1)
				end
			end)
		end
		-- Body movers the menu created carry our random name; anything else is
		-- the game's and is left alone rather than broken on our way past
		for _, d in ipairs(ch:GetDescendants()) do
			if (d:IsA("BodyMover") or d:IsA("LinearVelocity") or d:IsA("AlignPosition"))
				and d.Name:find(uiName, 1, true) then
				pcall(function() d:Destroy() end)
			end
		end
		if hum then
			pcall(function()
				hum.PlatformStand = false
				hum.Sit = false
				hum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end)
		end
	end

	FN.toast("Unstuck -- movement back to normal")
	FN.updateUI()
end

function FN.panicDisableAll()
	disableFly()
	FN.disableWeld()
	setNoclip(false)
	setAirWalk(false)
	if ON.freeCamEnabled then toggleFreeCam() end
	ON.tpSpamEnabled = false
	AIM.trigger = false
	ST.maceOn = false
	KILL.allOn = false
	if KILL.seatOn then killSeatStop() end
	KILL.on = false
	MISC.weldBack = false
	ON.spinbotEnabled = false
	ST.infJump = false
	-- The flag alone is not enough: infinite jump is a live JumpRequest
	-- connection, and leaving it connected leaves the feature working
	if CONN.infJumpConn then
		CONN.infJumpConn:Disconnect()
		CONN.infJumpConn = nil
	end
	ON.antiFlingEnabled = false
	ATP.enabled = false
	VOID.enabled = false
	OESP.enabled = false
	MISC.bhop = false
	MISC.sprint = false
	MISC.sprintBase = nil
	stopSpectate()
	if MISC.inspect then setInspect(false) end
	removeDummy()
	if MISC.antiCrash then MISC.antiCrash = false; restoreEffects() end
	if MISC.antiLagSigns then MISC.antiLagSigns = false end
	restoreSigns()
	MISC.antiFall = false
	MISC.waterWalk = false
	-- Destroyed here, not left to the stepped loop: on close that loop is
	-- disconnected before it runs again, orphaning the part in Workspace
	MISC.waterY = nil
	if ST.waterPart then
		pcall(function() ST.waterPart:Destroy() end)
		ST.waterPart = nil
	end

	-- Unfreeze, or the character is left anchored with no menu to release it
	if MISC.frozen then
		MISC.frozen = false
		local ch = player.Character
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		if hrp then pcall(function() hrp.Anchored = false end) end
	end

	-- Put the world back the way we found it
	ON.fovEnabled, ON.zoomEnabled, ON.gravityEnabled = false, false, false
	ON.clockTimeEnabled, ON.noFogEnabled = false, false
	FN.applyFOV(); FN.applyZoom(); FN.applyGravity(); FN.applyClockTime(); applyFog()
	if ON.fullbrightEnabled then ON.fullbrightEnabled = false
		pcall(function()
			Lighting.Ambient = ORIGINAL.ambient
			Lighting.ColorShift_Bottom = ORIGINAL.colorShiftBottom
			Lighting.ColorShift_Top = ORIGINAL.colorShiftTop
			Lighting.GlobalShadows = ORIGINAL.globalShadows
		end)
	end

	stopMusic()
	if ST.musicSound then
		pcall(function() ST.musicSound:Destroy() end)
		ST.musicSound = nil
	end
	if MISC.invisible then MISC.invisible = false; applyInvisible() end
	if MISC.xray then MISC.xray = false end
	FN.clearXray()
	if MISC.lowGfx then MISC.lowGfx = false end
	restoreGraphics()
	MISC.autoClick = false
	MISC.hoverFarmOn = false
	MISC.glide = false
	MISC.spider = false
	MISC.swing = false
	MISC.hitbox = false
	MISC.wallHop = false
	MISC.headTurn = false
	if MISC.touchFling then pcall(function() FN.setTouchFling(false) end) end
	if MISC.tpKill then pcall(function() FN.setTpKill(false) end) end
	if MISC.desync then pcall(function() FN.setDesync(false) end) end
	MACRO.playing = false
	MACRO.recording = false
	pcall(function() FN.singStop() end)
	MISC.tracers = false
	MISC.camOffset = false
	-- Panic is the button you press to look ordinary RIGHT NOW, and a player
	-- sprinting at 90 studs a second is the least ordinary thing in the game
	ON.walkSpeedEnabled = false
	ON.jumpPowerEnabled = false
	pcall(function() FN.applyWalkSpeed() end)
	pcall(function() FN.applyJumpPower() end)
	pcall(function() FN.restoreJoints() end)
	if MISC.brightness >= 0 then MISC.brightness = -1; FN.applyBrightness() end
	MISC.reach = false
	restoreReach()
	if ST.buildFolder then
		pcall(function() ST.buildFolder:Destroy() end)
		ST.buildFolder = nil
	end
	PESP.enabled = false
	clearPlayerEsp()
	KAT.alert = false
	KAT.onlyInfected = false
	KAT.autoFlee = false
	KAT.alarm = false
	if KAT.panic and KAT.panicBase then
		local kh = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if kh then pcall(function() kh.WalkSpeed = KAT.panicBase end) end
	end
	KAT.panic = false
	KAT.panicBase = nil
	katStopRun()
	-- Clears the search filter too. A filter matching nothing hides every row,
	-- and a blank menu gives you no button to press to fix it -- so the panic
	-- key, which works with the menu hidden, is the way back.
	if UI._query ~= "" then
		BOX.searchBox.Text = ""
		UI._query = ""
		if FN.applyRowVisibility then FN.applyRowVisibility() end
	end

	LW.autoMine = false
	LW.autoCollect = false
	CHEST.on = false
	chestClear()
	DET.autoKill = false
	RSPY.on = false
	MISC.watch = false
	MISC.collect = false
	MISC.watchHop = false
	KAT.autoHold = false
	KAT.bugMode = false
	katSetHold(false)
	pcall(function() DEC.bugBox:ReleaseFocus() end)
	DEC.bugBox.Text = ""
	for part, was in pairs(ST.doorOpened) do
		pcall(function()
			if part.Parent then part.CanCollide = was end
		end)
	end
	table.clear(ST.doorOpened)
	KAT.hunt = false
	KAT.track = false
	KAT.huntName = ""
	table.clear(KAT.still)
	DEC.katWarn.Visible = false
	AIM.enabled = false
	AIM.target = nil
	-- The hook stays installed -- removing a metamethod hook is riskier than
	-- leaving it -- but with this flag off it is a single boolean test
	SILENT.enabled = false
	SILENT.target = nil
	if MISC.hidePause then MISC.hidePause = false; restorePauseOverlay() end
	if MISC.instantPrompt then MISC.instantPrompt = false; restorePrompts() end
	clearObjectEsp()
	clearSpawnMarks()

	if ON.antiFirstPersonEnabled then
		ON.antiFirstPersonEnabled = false
		pcall(function()
			player.CameraMode = ORIGINAL.cameraMode or Enum.CameraMode.Classic
			if ORIGINAL.minZoom then player.CameraMinZoomDistance = ORIGINAL.minZoom end
			if ORIGINAL.zoom then player.CameraMaxZoomDistance = ORIGINAL.zoom end
		end)
	end

	-- Hand back what the game had rather than assuming false, since some games
	-- enable mouse lock themselves
	ON.antiShiftLock = false
	-- Blocking and rejoining are stopped; the hooks themselves stay installed,
	-- since removing a hook is riskier than leaving one idle
	AAC.blockRemotes = false
	AAC.rejoin = false
	MISC.aimCircle = false
	MISC.crosshair = false
	if MISC.hideClones then
		MISC.hideClones = false
		ST.setClonesHidden(false)
	end
	MISC.autoGetUp = false
	DEC.aimCircle.Visible = false
	DEC.crossH.Visible = false
	DEC.crossV.Visible = false
	MISC.autoEat = false
	MISC.hpWarn = false
	MISC.hpActive = false
	if ON.forceShiftLockEnabled then
		ON.forceShiftLockEnabled = false
		pcall(function() player.DevEnableMouseLock = ORIGINAL.mouseLock or false end)
	end

	stopAnim()
	ST.posePlaying = false
	resetPose()
	clearSitSeat()
	clearLaying()
	if ON.antiAfkEnabled then setAntiAfk(false) end
end

--[[
	Everything the close button does, as a function.

	It is here rather than inline because closing is no longer the only way
	this copy stops: a menu that has been destroyed out from under us rebuilds
	by running a fresh copy of the script, and the old one has to let go of its
	connections first or both copies drive the character at once.
--]]
function FN.teardown()
	-- Tell the watchdog this teardown is intentional, or it re-parents the GUI
	-- straight back the moment we destroy it
	MISC.closing = true
	FN.panicDisableAll()

	pcall(function() DEC.screenGui:Destroy() end)
	if CONN.steppedConn then CONN.steppedConn:Disconnect() end
	if CONN.renderConn then CONN.renderConn:Disconnect() end
	if CONN.inputConn then CONN.inputConn:Disconnect() end
	if CONN.respawnConn then CONN.respawnConn:Disconnect() end
	if CONN.infJumpConn then CONN.infJumpConn:Disconnect() end
	if CONN.deathConn then CONN.deathConn:Disconnect() end
	if CONN.playerAddedConn then CONN.playerAddedConn:Disconnect() end
	if CONN.playerRemovingConn then CONN.playerRemovingConn:Disconnect() end
	if CONN.ownCharCacheConn then CONN.ownCharCacheConn:Disconnect() end
	if CONN.chatNewConn then CONN.chatNewConn:Disconnect() end
	if CONN.chatLegacyConn then CONN.chatLegacyConn:Disconnect() end
	if CONN.noclipDescendantConn then CONN.noclipDescendantConn:Disconnect() end
	if CONN.antiAfkConn then CONN.antiAfkConn:Disconnect() end
	if CONN.clickTpConn then CONN.clickTpConn:Disconnect() end
	if CONN.inspectConn then CONN.inspectConn:Disconnect() end
	if CONN.statsConn then CONN.statsConn:Disconnect() end
	if CONN.antiPauseConn then CONN.antiPauseConn:Disconnect() end
	if CONN.chestPickConn then CONN.chestPickConn:Disconnect() end
	if CONN.dmgConn then CONN.dmgConn:Disconnect() end
	if CONN.weldTargetDeathConn then CONN.weldTargetDeathConn:Disconnect() end
	if CONN.weldTargetHumConn then CONN.weldTargetHumConn:Disconnect() end
	-- A render bind is not a connection and is not disconnected by any of the
	-- above; left bound it keeps running after the menu is gone
	pcall(function() RunService:UnbindFromRenderStep(ST.aimBind) end)
	-- Sunk keys outlive the menu if this is missed, and the character stops
	-- responding to WASD with nothing on screen to explain why
	if CONN.gameConn then CONN.gameConn:Disconnect() end
	pcall(function() FN.arcadeKeys(false) end)
	pcall(function() FN.removeTestSword() end)
	pcall(function() FN.buildSelect(nil) end)
	pcall(function() if ST.buildTool then ST.buildTool:Destroy() end end)
	pcall(function() FN.singStop() end)
end

bindAction(UI.closeBtn, function() FN.teardown() end)

-- Claiming right-click. Its own connection rather than a branch in the main
-- input handler: that one returns early on gameProcessed, and a right-click on
-- a chest the game also handles is exactly the click we need to see.
CONN.chestPickConn = UserInputService.InputBegan:Connect(function(input)
	if not CHEST.picking then return end
	if input.UserInputType ~= Enum.UserInputType.MouseButton2 then return end
	if UserInputService:GetFocusedTextBox() then return end

	local hit = mouse.Target
	if not hit then
		FN.toast("Nothing under the cursor")
		return
	end
	chestClaim(hit)
end)

CONN.inputConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
	-- Rebind capture runs before everything else, so the key being assigned
	-- doesn't also fire whatever it happens to be bound to right now.
	-- Keyboard only: otherwise the mouse click that armed the rebind could
	-- immediately bind itself.
	-- Click anywhere outside the row menu closes it. Without this it stays open
	-- over the menu until you happen to pick one of its options.
	if ROW.rowMenu.Visible and not ROW.rowBindTarget
		and (input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch) then
		local mx, my = mouse.X, mouse.Y
		local pos, size = ROW.rowMenu.AbsolutePosition, ROW.rowMenu.AbsoluteSize
		local inside = mx >= pos.X and mx <= pos.X + size.X
			and my >= pos.Y and my <= pos.Y + size.Y
		if not inside then closeRowMenu() end
	end

	-- Row bind capture, same idea as the slot rebind below and for the same
	-- reason: the key being assigned must not also fire what it is bound to.
	if ROW.rowBindTarget and input.UserInputType == Enum.UserInputType.Keyboard then
		local btn = ROW.rowBindTarget
		ROW.rowBindTarget = nil
		local c = rowCfg(btn)
		if c then
			if input.KeyCode == Enum.KeyCode.Escape then
				c.key = nil
			else
				-- One key, one action: take it off any other row first
				for _, other in pairs(UI._cfg) do
					if other.key == input.KeyCode then other.key = nil end
				end
				c.key = input.KeyCode
			end
		end
		closeRowMenu()
		FN.saveConfig()
		FN.updateUI()
		return
	end

	if MISC.rebindTarget and input.UserInputType == Enum.UserInputType.Keyboard then
		local slot = MISC.rebindTarget
		MISC.rebindTarget = nil
		if input.KeyCode ~= Enum.KeyCode.Escape then
			-- A key can only drive one action, so steal it from any other slot
			for name, code in pairs(KEYS) do
				if code == input.KeyCode and name ~= slot then KEYS[name] = nil end
			end
			KEYS[slot] = input.KeyCode
		end
		FN.saveConfig()
		FN.updateUI()
		return
	end

	-- GUI toggle works even while typing is not focused; skip only when a box is focused
	if not UserInputService:GetFocusedTextBox() and KEYS.gui and input.KeyCode == KEYS.gui then
		MISC.guiHidden = not MISC.guiHidden
		DEC.mainFrame.Visible = not MISC.guiHidden
		-- The row menu is a sibling of mainFrame, not a child, so it would be
		-- left floating on screen with the menu hidden behind it
		if MISC.guiHidden then closeRowMenu() end
		return
	end
	if gameProcessed or UserInputService:GetFocusedTextBox() then return end
	-- Custom row binds. Checked before the fixed slots so a row bind wins if
	-- both somehow point at the same key.
	for id, c in pairs(UI._cfg) do
		if c.key and input.KeyCode == c.key then
			local btn = UI._byId[id]
			local fn = btn and UI._act[btn]
			if fn then
				pcall(fn)
				FN.toast((UI._cfg[id].name or UI._label[btn] or id) .. "  [" .. c.key.Name .. "]")
				return
			end
		end
	end

	-- Remembered so anti-pause can tell a deliberate menu open from a pause
	-- the game forced on you
	if input.KeyCode == Enum.KeyCode.Escape then
		ST.escapeAt = tick()
	end

	if KEYS.panic and input.KeyCode == KEYS.panic then
		FN.panicDisableAll()
		FN.toast("PANIC - everything disabled")
		FN.updateUI()
	elseif KEYS.speed and input.KeyCode == KEYS.speed then
		ON.walkSpeedEnabled = not ON.walkSpeedEnabled
		FN.applyWalkSpeed()
		FN.updateUI()
	elseif KEYS.fly and input.KeyCode == KEYS.fly then toggleFly()
	elseif KEYS.noclip and input.KeyCode == KEYS.noclip then setNoclip(not ST.noclipping)
	elseif KEYS.hoverfarm and input.KeyCode == KEYS.hoverfarm then
		MISC.hoverFarmOn = not MISC.hoverFarmOn
		if MISC.hoverFarmOn then MISC.hoverHits = 0; MISC.hoverWarned = false end
		FN.toast("Green Square Farm: " .. (MISC.hoverFarmOn and "ON" or "OFF"))
		FN.updateUI()
	elseif KEYS.unstick and input.KeyCode == KEYS.unstick then
		FN.unstick()
	elseif KEYS.spiderzip and input.KeyCode == KEYS.spiderzip then
		FN.spiderZip()
	elseif KEYS.spider and input.KeyCode == KEYS.spider then
		MISC.spider = not MISC.spider
		FN.toast("Wall Climb: " .. (MISC.spider and "ON" or "OFF"))
		FN.updateUI()
	elseif KEYS.shiftlock and input.KeyCode == KEYS.shiftlock then
		ON.antiShiftLock = not ON.antiShiftLock
		-- Same pairing the button does: the two write the same property, so
		-- one of them has to give way
		if ON.antiShiftLock and ON.forceShiftLockEnabled then
			toggleForceShiftLock()
		end
		if not ON.antiShiftLock then
			pcall(function() player.DevEnableMouseLock = ORIGINAL.mouseLock or false end)
		end
		FN.toast("Anti Shift Lock: " .. (ON.antiShiftLock and "ON" or "OFF"))
		FN.updateUI()
	end
end)

CONN.respawnConn = player.CharacterAdded:Connect(function(newCharacter)
	disableFly()
	-- The Backpack is rebuilt on respawn, so our tool went with it. Drop the
	-- reference or the button claims a sword you do not have.
	ST.swordTool = nil

	-- Dying mid-swing drops the rope. The swing code cannot do it: it lives
	-- inside the character guard, and a dead player has no character.
	ST.swingAnchor = nil
	if ST.swingRope then
		pcall(function() ST.swingRope:Destroy() end)
		ST.swingRope = nil
	end
	FN.disableWeld()
	setAirWalk(false)
	-- New rig, new root part: drop the old anchors or they'd drag the fresh
	-- character back to where the previous one died
	-- The game rebuilds its interface right about now, so re-assert ours. Both
	-- writes are guarded: a game that re-parents PlayerGui can make either throw.
	if not MISC.closing then
		pcall(function()
			if DEC.screenGui.Parent == nil then FN.homeGui() end
			if DEC.screenGui.DisplayOrder ~= 2147483647 then
				DEC.screenGui.DisplayOrder = 2147483647
			end
		end)
	end

	markIntentionalTeleport()
	VOID.lastSafe = nil
	-- The new root part isn't anchored, so the flag would otherwise be a lie
	MISC.frozen = false
	-- Height and rig measurements belong to the old character
	MISC.airFloorY = nil
	MISC.standOffset = nil
	-- New humanoid: a base captured from the old one means nothing
	MISC.sprintBase = nil
	KAT.panicBase = nil
	-- A key held when you died stays held on the new character otherwise
	KAT.holding = false
	-- The route belonged to the character that just died
	KAT.running = false
	KAT.runToken = (KAT.runToken or 0) + 1
	-- New humanoid of our own, so the camera has to be handed back
	stopSpectate()
	stopAnim()
	ST.posePlaying = false
	resetPose()
	-- Only the home-pose cache is dropped: it keys off the old character's
	-- motors and would otherwise grow by a full set on every respawn. The
	-- saved frames are keyed by name, so they carry over intact.
	table.clear(ST.poseHome)
	clearSitSeat()
	clearLaying()
	-- The seat belonged to the character that just died
	if KILL.seatOn then killSeatStop("you died") end
	if ON.freeCamEnabled then toggleFreeCam() end
	ON.tpSpamEnabled = false
	ON.spinbotEnabled = false
	ST.aacApplied = false
	ON.aacEnabled = false
	ST.cachedTargetPart = nil
	ST.lastTargetSearchTime = 0

	-- Old character's parts are gone; drop the table and rebind to the new body
	ST.noclipOriginalCollide = {}
	-- Same for the reach handles: those tools went with the old body, and the
	-- entries would otherwise pile up one dead part at a time per death
	table.clear(ST.reachOrig)
	-- R6 scale originals too: sizes and joint offsets recorded from a rig that
	-- no longer exists would be applied to the new one on the next press
	table.clear(ST.r6Parts)
	table.clear(ST.r6Motors)
	table.clear(ST.r6Atts)
	ST.r6Hip = nil
	if CONN.noclipDescendantConn then
		CONN.noclipDescendantConn:Disconnect()
		CONN.noclipDescendantConn = nil
	end

	task.spawn(function()
		local hum = newCharacter:WaitForChild("Humanoid", 5)
		if hum then
			-- New rig, new default: re-learn the game's speed before applying
			-- ours, or the baseline carries over from the last character
			ST.baseWalkSpeed = nil
			FN.applyWalkSpeed()
			if ON.jumpPowerEnabled then FN.applyJumpPower() end
			if ST.noclipping then setNoclip(true) end
			-- The new rig comes back at default size, so a scale you set before
			-- dying was silently lost while the menu still showed it. Quiet,
			-- since an R6 game would otherwise toast on every respawn.
			if MISC.bodyScale ~= 100 then FN.applyBodyScale(true) end
			-- A fresh character starts empty-handed, and the first thing you
			-- want after dying is the weapon back in your hand
			if MISC.autoEquip then ST.equipBest(newCharacter, hum) end
		end
		-- Fresh body, fresh parts: the transparency has to go back on. The
		-- decal table keys off the old character's decals, so drop it first.
		if MISC.invisible then
			table.clear(ST.invisDecals)
			applyInvisible()
		end
		setupDeathTracking(newCharacter)
	end)

	FN.updateUI()
end)

if player.Character then
	setupDeathTracking(player.Character)
end

