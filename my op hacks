end)

renderConn = RunService.RenderStepped:Connect(function(deltaTime)
	local character = player.Character
	local currentCamera = Workspace.CurrentCamera

	if antiFirstPersonEnabled then
		pcall(function()
			player.CameraMode = Enum.CameraMode.Classic
			if player.CameraMaxZoomDistance < 128 then
				player.CameraMaxZoomDistance = 400
			end
		end)
	end

	if forceShiftLockEnabled then
		pcall(function()
			player.DevEnableMouseLock = true
		end)
	end

	if fullbrightEnabled then
		Lighting.Ambient = Color3.new(1, 1, 1)
		Lighting.ColorShift_Bottom = Color3.new(1, 1, 1)
		Lighting.ColorShift_Top = Color3.new(1, 1, 1)
		Lighting.GlobalShadows = false
	end

	if freeCamEnabled and currentCamera then
		currentCamera.CameraType = Enum.CameraType.Scriptable
		local moveVector = Vector3.new()
		local camCFrame = currentCamera.CFrame

		if not UserInputService:GetFocusedTextBox() then
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVector = moveVector + camCFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVector = moveVector - camCFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVector = moveVector - camCFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVector = moveVector + camCFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveVector = moveVector + Vector3.new(0, 1, 0) end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
				moveVector = moveVector - Vector3.new(0, 1, 0)
			end
		end

		if moveVector.Magnitude > 0 then moveVector = moveVector.Unit end
		freeCamPos = freeCamPos + (moveVector * (freeCamSpeed * deltaTime))

		if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrent
			local delta = UserInputService:GetMouseDelta()
			freeCamRotY = freeCamRotY - (delta.X * 0.003)
			freeCamRotX = math.clamp(freeCamRotX - (delta.Y * 0.003), -math.rad(89), math.rad(89))
		else
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end

		currentCamera.CFrame = CFrame.new(freeCamPos) * CFrame.Angles(0, freeCamRotY, 0) * CFrame.Angles(freeCamRotX, 0, 0)
		return
	end

	if not character or not currentCamera then return end

	if flying and flyPart then
		if not UserInputService:GetFocusedTextBox() then
			local moveVector = Vector3.new()
			local camLook = currentCamera.CFrame.LookVector
			local camRight = currentCamera.CFrame.RightVector

			if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVector = moveVector + camLook end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVector = moveVector - camLook end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVector = moveVector - camRight end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVector = moveVector + camRight end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveVector = moveVector + Vector3.new(0, 1, 0) end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
				moveVector = moveVector - Vector3.new(0, 1, 0)
			end

			if moveVector.Magnitude > 0 then moveVector = moveVector.Unit end
			local newPos = flyPart.Position + (moveVector * (flySpeed * deltaTime))
			local newCFrame = CFrame.new(newPos) * currentCamera.CFrame.Rotation
			flyPart.CFrame = newCFrame

			if flyMode == "Full Body" then
				character:PivotTo(newCFrame)
			end
		end
	end

	if spinbotEnabled and not flying then
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(spinSpeed * deltaTime), 0)
		end
	end
end)

-- Throttled & Cached TP Spam Task (Prevents Missing-Target Lag)
task.spawn(function()
	while true do
		if tpSpamEnabled then
			pcall(function()
				local currentTime = tick()
				if not cachedTargetPart or not cachedTargetPart.Parent or (currentTime - lastTargetSearchTime > 1.5) then
					cachedTargetPart = resolveTargetPart()
					lastTargetSearchTime = currentTime
				end

				local character = player.Character
				if cachedTargetPart and character then
					local hrp = character:FindFirstChild("HumanoidRootPart")
					if hrp then
						local tPos = cachedTargetPart.Position
						local currentPos = (flying and flyPart) and flyPart.Position or hrp.Position
						local newPos = Vector3.new(tPos.X, currentPos.Y, tPos.Z)

						if flying and flyPart then
							flyPart.CFrame = CFrame.new(newPos) * flyPart.CFrame.Rotation
						else
							local targetCFrame = CFrame.new(newPos) * hrp.CFrame.Rotation
							character:PivotTo(targetCFrame)
							hrp.AssemblyLinearVelocity = Vector3.zero
						end
					end
				end
			end)
		end
		task.wait(0.05)
	end
end)

