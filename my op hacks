-- Universal Target Solver
local function resolveTargetPart()
	local mainQuery = tpBox.Text:lower():gsub("%s+", "")
	local subQuery = targetPartBox.Text:lower():gsub("%s+", "")

	if mainQuery == "" then return nil end

	local targetPlayer = nil
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local pName = p.Name:lower()
			local pDisp = p.DisplayName:lower()
			local pId = tostring(p.UserId)
			if pName:sub(1, #mainQuery) == mainQuery or pDisp:sub(1, #mainQuery) == mainQuery or pId == mainQuery then
				targetPlayer = p
				break
			end
		end
	end

	if targetPlayer and targetPlayer.Character then
		local char = targetPlayer.Character
		if subQuery ~= "" then
			for _, desc in ipairs(char:GetDescendants()) do
				if desc:IsA("BasePart") and (desc.Name:lower() == subQuery or desc.Name:lower():find(subQuery, 1, true)) then
					return desc
				end
			end
		end
		return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildOfClass("BasePart")
	end

	for _, obj in ipairs(Workspace:GetDescendants()) do
		local objName = obj.Name:lower()
		local isMatch = (objName == mainQuery or objName:find(mainQuery, 1, true))

		if not isMatch then
			for _, p in ipairs(Players:GetPlayers()) do
				if objName == tostring(p.UserId) and (mainQuery == tostring(p.UserId) or mainQuery == "") then
					isMatch = true
					break
				end
			end
		end

		if isMatch then
			if obj:IsA("BasePart") then
				if subQuery == "" or obj.Name:lower():find(subQuery, 1, true) then
					return obj
				end
			elseif obj:IsA("Model") or obj:IsA("Folder") then
				if subQuery ~= "" then
					for _, desc in ipairs(obj:GetDescendants()) do
						if desc:IsA("BasePart") and desc.Name:lower():find(subQuery, 1, true) then
							return desc
						end
					end
				end
				local foundPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj:FindFirstChildOfClass("BasePart")
				if foundPart then return foundPart end
			end
		end
	end

	return nil
end

local function cycleTargetParts()
	local mainQuery = tpBox.Text:lower():gsub("%s+", "")
	if mainQuery == "" then return end

	local partsList = {}

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and (p.Name:lower():find(mainQuery, 1, true) or p.DisplayName:lower():find(mainQuery, 1, true) or tostring(p.UserId) == mainQuery) then
			if p.Character then
				for _, desc in ipairs(p.Character:GetDescendants()) do
					if desc:IsA("BasePart") then table.insert(partsList, desc.Name) end
				end
			end
		end
	end

	if #partsList == 0 then
		for _, desc in ipairs(Workspace:GetDescendants()) do
			if desc:IsA("BasePart") then
				local partName = desc.Name:lower()
				local isIdMatch = false
				for _, p in ipairs(Players:GetPlayers()) do
					if partName == tostring(p.UserId) and tostring(p.UserId) == mainQuery then
						isIdMatch = true
						break
					end
				end
				if isIdMatch or partName:find(mainQuery, 1, true) then
					table.insert(partsList, desc.Name)
				end
			end
		end
	end

	if #partsList > 0 then
		local currentName = targetPartBox.Text:lower()
		local currentIndex = 0
		for idx, name in ipairs(partsList) do
			if name:lower() == currentName then
				currentIndex = idx
				break
			end
		end

		local nextIndex = (currentIndex % #partsList) + 1
		targetPartBox.Text = partsList[nextIndex]

		if weldEnabled then
			pcall(function() enableWeld() end)
		end
	end
end

local function disableWeld()
	weldEnabled = false
	if weldConstraint then
		pcall(function() weldConstraint:Destroy() end)
		weldConstraint = nil
