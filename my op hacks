bindAction(UI.resetCfgBtn, function()
	-- Put every persisted value back to its shipped default and drop the file,
	-- so a bad config can always be recovered from without editing anything.
	KEYS.fly, KEYS.noclip, KEYS.gui = Enum.KeyCode.G, Enum.KeyCode.N, Enum.KeyCode.RightShift
	VAL.walkSpeed, VAL.jumpPower, VAL.spinSpeed = 16, 50, 500
	VAL.flySpeed, VAL.freeCamSpeed = 50, 50
	VAL.fov, VAL.zoomDistance, VAL.gravityValue, VAL.clockTimeValue = 70, 128, 196, 14
	ATP.speed, VOID.y = 60, -150

	-- Turn the world overrides off and restore what they changed
	if ON.fullbrightEnabled then toggleFullbright() end
	ON.noFogEnabled, ON.fovEnabled, ON.zoomEnabled = false, false, false
	ON.gravityEnabled, ON.clockTimeEnabled = false, false
	ON.walkSpeedEnabled, ON.jumpPowerEnabled = false, false
	ON.antiFlingEnabled, ATP.enabled, VOID.enabled = false, false, false
	if ON.antiAfkEnabled then setAntiAfk(false) end
	applyFog()
	FN.applyGravity()
	FN.applyClockTime()
	FN.applyFOV()
	FN.applyZoom()
	-- These two need applying as well: clearing the flag without writing the
	-- property leaves the character fast with the button reading OFF
	FN.applyWalkSpeed()
	FN.applyJumpPower()

	table.clear(CFG)
	pcall(function()
		if type(delfile) == "function" and type(isfile) == "function" and isfile(CONFIG_FILE) then
			delfile(CONFIG_FILE)
		end
	end)

	UI.resetCfgBtn.Text = "Settings reset"
	task.delay(2, function()
		if UI.resetCfgBtn.Parent then FN.updateUI() end
	end)
	FN.updateUI()
end)

