		pcall(function() ST.musicSound:Stop() end)
	end
	ST.musicPlaying = false
end

-- Audio search. Roblox's own HttpService is server-only, so this uses the
-- request function the executor injects. Every known name is tried because they
-- differ between executors, and the whole thing degrades to a clear message
-- rather than an error when none exists.
local function httpGet(url)
	local fn = (syn and syn.request)
		or (http and http.request)
		or http_request
		or request
	if type(fn) ~= "function" then
		return nil, "this executor has no http function"
	end

	local ok, res = pcall(fn, { Url = url, Method = "GET" })
	if not ok or type(res) ~= "table" then return nil, "request failed" end
	if res.StatusCode ~= 200 then return nil, "http " .. tostring(res.StatusCode) end
	return res.Body
end


-- ==========================================
-- CHAT (log / translate / trace / send)
-- ==========================================
-- Records a message into the rolling log, updates the on-screen panel, runs the
-- trace check, and -- if auto-translate is on -- translates it in place. One
-- entry point for every source of chat, so the two capture paths below agree.
-- Strips Roblox rich-text tags (<font ...>, <b>, ...) so a chat prefix that
-- carries the game's tag markup logs as plain "[VIP] Name" instead of a wall
-- of angle brackets.
ST.stripRich = function(str)
	return (tostring(str):gsub("<[^>]->", ""))
end

ST.chatRecord = function(who, text, tags)
	who = tostring(who or "?")
	text = tostring(text or "")
	if text == "" then return end
	-- Our own translation line, echoed back by the chat system: skip it, or it
	-- would be logged, then translated, then echoed, forever
	if text:sub(1, 4) == "[TR]" then return end

	-- Tags in front of the name, so the log reads the way the chat did:
	-- "[Owner] Someone: hi"
	local label = who
	if tags and tags ~= "" then label = tags .. " " .. who end

	CHATL.log[#CHATL.log + 1] = { who = label, text = text, at = os.time() }
	while #CHATL.log > 40 do table.remove(CHATL.log, 1) end

	-- Trace: a named player said something. Highlight and toast, no auto aim --
	-- that was left out on purpose.
	if CHATL.trace ~= "" then
		local w = who:lower()
		if w:find(CHATL.trace:lower(), 1, true) then
			DEC.katWarn.Text = label .. ": " .. text:sub(1, 40)
			DEC.katWarn.BackgroundColor3 = THEME.accent
			DEC.katWarn.BackgroundTransparency = 0.15
			DEC.katWarn.Visible = true
			CHATL.traceHideAt = os.clock() + 5
		end
	end

	-- Auto translate incoming messages to your language, appended so the
	-- original is still there
	if CHATL.autoTranslate then
		local entry = CHATL.log[#CHATL.log]
		local origLabel = label
		ST.translate(text, CHATL.lang, function(out)
			if out and out ~= text then
				entry.text = text .. "  ->  " .. out
				-- And into the real chat window, prefixed so it is obviously
				-- the translation and so our own capture hook skips it
				if CHATL.realChat then
					ST.chatDisplay("[TR] " .. origLabel .. ": " .. out)
				end
			end
		end)
	end
end

-- Translate via the free Google endpoint. It answers a nested JSON array; the
-- translated text is the first string of the first row. Best-effort: any
-- failure just leaves the original, since a mistranslation or a dead endpoint
-- must never eat the message.
-- Puts a line into the game's own chat window, visible only to you. This is
-- how the translation lands in the REAL chat instead of just the menu panel.
-- Both chat systems have a local-display path that never touches the server.
ST.chatDisplay = function(text)
	local shown = false
	pcall(function()
		local tcs = game:GetService("TextChatService")
		if tcs.ChatVersion == Enum.ChatVersion.TextChatService then
			local chans = tcs:FindFirstChild("TextChannels")
			local ch = chans and (chans:FindFirstChild("RBXGeneral")
				or chans:FindFirstChildWhichIsA("TextChannel"))
			if ch then ch:DisplaySystemMessage(text) shown = true end
		end
	end)
	if not shown then
		pcall(function()
			game:GetService("StarterGui"):SetCore("ChatMakeSystemMessage", {
				Text = text,
				Color = Color3.fromRGB(120, 200, 255),
				Font = Enum.Font.SourceSansItalic,
			})
			shown = true
		end)
	end
	return shown
end

ST.translate = function(text, lang, cb)
	task.spawn(function()
		local out
		pcall(function()
			local url = "https://translate.googleapis.com/translate_a/single"
				.. "?client=gtx&sl=auto&tl=" .. SERV.HttpService:UrlEncode(lang or "en")
				.. "&dt=t&q=" .. SERV.HttpService:UrlEncode(text)
			local body = httpGet(url)
			if body then
				local ok, data = pcall(function() return SERV.HttpService:JSONDecode(body) end)
				if ok and type(data) == "table" and type(data[1]) == "table" then
					local pieces = {}
					for _, row in ipairs(data[1]) do
						if type(row) == "table" and row[1] then pieces[#pieces + 1] = row[1] end
					end
					out = table.concat(pieces)
				end
			end
		end)
		if cb then cb(out) end
	end)
end

-- Send a chat message as yourself, optionally translated first. Tries the new
-- TextChatService, then the legacy chat remote -- one of the two exists in any
-- game. The message still passes through Roblox's own filter on the way; this
-- only changes the words, not who checks them.
--[[
	Finding a channel that will actually take a message.

	RBXGeneral is the usual one, but it is not the only one and it is not
	always the one you are in: a game with team chat, or its own channels, can
	leave RBXGeneral present and unusable. A channel you have no TextSource in
	silently accepts SendAsync and does nothing with it, which is exactly the
	"it says Sent and nothing appears" case.

	So: prefer a channel this player has a source in, and fall back to
	RBXGeneral only if none of them say yes.
--]]
function FN.chatChannel()
	local tcs = game:GetService("TextChatService")
	local holder = tcs:FindFirstChild("TextChannels")
	if not holder then return nil, "no TextChannels folder" end

	local general, mine
	for _, ch in ipairs(holder:GetChildren()) do
		if ch:IsA("TextChannel") then
			if ch.Name == "RBXGeneral" then general = ch end
			-- A TextSource named after us means we are actually in this channel
			local src = ch:FindFirstChild(tostring(player.UserId))
			if src and src:IsA("TextSource") and src.CanSend then
				mine = mine or ch
			end
		end
	end

	if mine then return mine, "in channel " .. mine.Name end
	if general then return general, "RBXGeneral (no TextSource found)" end
	local any = holder:FindFirstChildWhichIsA("TextChannel")
	if any then return any, "first channel " .. any.Name end
	return nil, "no TextChannel at all"
end

--[[
	What the chat actually looks like from here.

	Written because "it says Sent and nothing appears" has too many possible
	causes to guess at: wrong chat version, wrong channel, no TextSource, a
	muted account, or a game with no send path at all. This reports each of
	them separately instead of one unhelpful failure.
--]]
function FN.chatTest()
	local out = {}
	local function line(t) out[#out + 1] = t end

	local tcs = game:GetService("TextChatService")
	local ver = "unknown"
	pcall(function() ver = tostring(tcs.ChatVersion) end)
	line("ChatVersion: " .. ver)

	local holder = tcs:FindFirstChild("TextChannels")
	if holder then
		local names = {}
		for _, ch in ipairs(holder:GetChildren()) do
			if ch:IsA("TextChannel") then
				local src = ch:FindFirstChild(tostring(player.UserId))
				names[#names + 1] = ch.Name
					.. (src and (src.CanSend and " (can send)" or " (muted here)")
						or " (not joined)")
			end
		end
		line("channels: " .. (#names > 0 and table.concat(names, ", ") or "none"))
	else
		line("channels: no TextChannels folder")
	end

	local chan, why = FN.chatChannel()
	line("would use: " .. why)

	local legacy = false
	pcall(function()
		local ev = game:GetService("ReplicatedStorage")
			:FindFirstChild("DefaultChatSystemChatEvents")
		legacy = (ev and ev:FindFirstChild("SayMessageRequest")) ~= nil
	end)
	line("legacy remote: " .. (legacy and "present" or "absent"))

	print("[ModMenu] chat test --")
	for i, l in ipairs(out) do print("  " .. i .. ". " .. l) end
	if type(setclipboard) == "function" then
		pcall(setclipboard, table.concat(out, "\n"))
	end
	FN.toast(out[1] .. " | " .. (out[3] or ""))

	-- Then actually try one, and say what came back rather than assuming
	task.spawn(function()
		local ok, err = pcall(function()
			if chan then
				chan:SendAsync("chat test " .. tostring(math.random(100, 999)))
			else
				error("no channel")
			end
		end)
		FN.toast(ok and "Test sent -- look in chat" or ("Send threw: " .. tostring(err)))
	end)
end

ST.sendChat = function(text)
	if text == "" then return end
	local function fire(msg)
		local sent = false
		pcall(function()
			local tcs = game:GetService("TextChatService")
			if tcs.ChatVersion == Enum.ChatVersion.TextChatService then
				local chan = FN.chatChannel()
				if chan then
					-- SendAsync YIELDS. This is called from the Stepped handler
					-- by the singer, and yielding in there stalls every other
					-- feature for as long as the call takes -- then the pcall
					-- eats whatever went wrong and the caller is told nothing.
					-- Its own thread: the send still happens, the frame does not
					-- wait for it, and a failure gets said out loud.
					sent = true
					task.spawn(function()
						local ok, err = pcall(function() chan:SendAsync(msg) end)
						if not ok then
							FN.toast("Chat refused it: " .. tostring(err))
							warn("[ModMenu] SendAsync failed: " .. tostring(err))
						end
					end)
				end
			end
		end)
		if not sent then
			pcall(function()
				local ev = game:GetService("ReplicatedStorage")
					:FindFirstChild("DefaultChatSystemChatEvents")
				local say = ev and ev:FindFirstChild("SayMessageRequest")
				if say then say:FireServer(msg, "All") sent = true end
			end)
		end
		return sent
	end

	if CHATL.sendLang ~= "" and CHATL.sendLang:lower() ~= "off" then
		ST.translate(text, CHATL.sendLang, function(out)
			local msg = (out and out ~= "") and out or text
			if not fire(msg) then FN.toast("Chat: no send path in this game")
			else FN.toast("Sent: " .. msg:sub(1, 30)) end
		end)
	else
		if not fire(text) then FN.toast("Chat: no send path in this game")
		else FN.toast("Sent") end
	end
end

-- Server hop. Roblox has no way to make a server on demand -- there is no API
-- for it, client or server, and anything claiming otherwise is really doing
-- this: reading the public server list and picking from it.
--
-- Three ways to pick, because "the server I want" means opposite things:
--   EMPTY  fewest players -- one spun up moments ago, effectively yours
--   SMALL  quiet but not empty
--   FULL   the fullest one that still has room, ideally exactly one slot
--
-- FULL sorts descending so the busiest come back first. It is also the one that
-- fails most: a single free slot is a race against everyone else joining, so
-- candidates are collected and tried in order rather than betting on one.
local function hopServer(mode)
	local base = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId)
		.. "/servers/Public?limit=100&sortOrder="
		.. ((mode == "FULL") and "Desc" or "Asc")

	FN.toast("Looking for a " .. string.lower(mode) .. " server...")

	task.spawn(function()
		local cursor, pages = nil, 0
		local candidates = {}

		repeat
			pages = pages + 1
			local url = base .. (cursor and ("&cursor=" .. cursor) or "")
			local body, problem = httpGet(url)
			if not body then
				FN.toast("Hop failed: " .. tostring(problem))
				return
			end

			local ok, data = pcall(function()
				return SERV.HttpService:JSONDecode(body)
			end)
			if not ok or type(data) ~= "table" or type(data.data) ~= "table" then
				FN.toast("Hop failed: server list unreadable")
				return
			end

			for _, entry in ipairs(data.data) do
				-- The one we are already in is not a hop, and a full one cannot
				-- be joined at all
				if entry.id ~= game.JobId
					and type(entry.playing) == "number"
					and type(entry.maxPlayers) == "number"
					and entry.playing < entry.maxPlayers then
					candidates[#candidates + 1] = {
						id = entry.id,
						playing = entry.playing,
						free = entry.maxPlayers - entry.playing,
					}
				end
			end

			cursor = data.nextPageCursor
		until not cursor or pages >= 5 or #candidates >= 200

		if #candidates == 0 then
			FN.toast("No joinable server found -- try again in a moment")
			return
		end

		-- Ranked by what was asked for. FULL wants the fewest free slots, which
		-- is not the same as the most players: a 12-player server with one slot
		-- beats a 40-player one with six.
		table.sort(candidates, function(a, b)
			if mode == "FULL" then return a.free < b.free end
			return a.playing < b.playing
		end)

		local wanted = candidates[1]
		FN.toast(string.format("Joining: %d playing, %d slot(s) free",
			wanted.playing, wanted.free))

		-- Tried in order. A teleport into a server that filled up between the
		-- read and the join throws, and with one free slot that is the likely
		-- case rather than the unlucky one -- so the next candidate is tried
		-- instead of reporting failure.
		FN.armRejoin(true)
		for i = 1, math.min(#candidates, 5) do
			local entry = candidates[i]
			local okTp = pcall(function()
				SERV.TeleportService:TeleportToPlaceInstance(game.PlaceId, entry.id, player)
			end)
			if okTp then return end
			task.wait(0.4)
		end

		FN.toast("Every candidate refused -- they filled up")
	end)
end

local function searchAudio(andPlay)
	local query = BOX.musicSearchBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
	if query == "" then
		FN.toast("Type something to search for")
		return
	end

	--[[
		A YouTube link cannot play, and this is the only place anybody would
		think to look for the reason.

		A Roblox Sound takes rbxassetid:// and nothing else. There is no web
		audio, no streaming, no element to point at a URL -- the client cannot
		reach youtube.com at all, and the id in the link names a video on a
		service that is simply not addressable from in here. No executor
		changes that; it is the engine, not a permission.

		So the link is turned into the thing that CAN work: search the Roblox
		audio library by name instead. Whatever the song is called, type that.
	--]]
	if query:lower():find("youtu", 1, true) or query:find("://", 1, true) then
		FN.toast("Links cannot play -- type the song NAME and press it again")
		print("[ModMenu] A Roblox Sound only accepts rbxassetid://. There is no"
			.. " way to stream YouTube (or any URL) into a Roblox game -- that"
			.. " is the engine, not a setting. Search by name instead, or use"
			.. " Find Songs: in this game, which returns ids that are already"
			.. " loaded here and are guaranteed to play.")
		return
	end

	FN.toast("Searching...")
	task.spawn(function()
		-- Roblox's toolbox marketplace endpoint; 3 is the audio category
		local url = "https://apis.roblox.com/toolbox-service/v1/marketplace/3"
			.. "?limit=20&keyword=" .. SERV.HttpService:UrlEncode(query)

		local body, problem = httpGet(url)
		if not body then
			FN.toast("Search failed: " .. problem)
			return
		end

		local ok, data = pcall(function() return SERV.HttpService:JSONDecode(body) end)
		if not ok or type(data) ~= "table" or type(data.data) ~= "table" then
			FN.toast("Search returned nothing usable")
			return
		end

		table.clear(ST.results)
		for _, item in ipairs(data.data) do
			local asset = item.Asset or item.asset
			if asset and asset.Id then
				table.insert(ST.results, {
					id = tostring(asset.Id),
					name = tostring(asset.Name or "?"),
				})
			end
		end

		ST.resultIndex = 1
		FN.updateUI()

		if not andPlay then
			FN.toast(#ST.results .. " result(s)")
			return
		end

		-- One press instead of five. Search, then Next Result, then Add To
		-- Playlist, then Play was the old route to hearing a song you could
		-- already name.
		if #ST.results == 0 then
			FN.toast("Nothing found for that")
			return
		end
		local pick = ST.results[1]
		local at
		for i, id in ipairs(ST.tracks) do
			if id == pick.id then
				at = i
				break
			end
		end
		if not at then
			ST.tracks[#ST.tracks + 1] = pick.id
			at = #ST.tracks
		end
		FN.toast("Playing " .. pick.name)
		FN.playTrack(at, 0)
	end)
end

--[[
	Song finder.

	The same problem as the animation finder, and the same answer: playing a
	sound was never the hard part, knowing WHICH id is.

	It matters more for audio than it did for animations, because of the 2022
	audio privacy change. Most uploaded sounds are private now and will not
	play in a game you do not own, so an id found by searching the library is
	a coin flip -- it loads, or it silently does not. An id that is ALREADY IN
	THIS GAME is not a coin flip. The game is using it, so it is allowed to,
	and so are you while you are standing in it.

	That is what these two buttons are for, and why they come first.
--]]
function FN.songFind(mode)
	local hits, byId = {}, {}
	local function add(id, name, where)
		local num = tostring(id or ""):match("(%d+)")
		if not num or byId[num] then return end
		byId[num] = true
		hits[#hits + 1] = { id = num, name = name or "?", where = where or "?" }
	end

	local looked = 0
	if mode == "GAME" then
		local roots = {
			Workspace,
			game:FindService("ReplicatedStorage"),
			game:FindService("SoundService"),
			game:FindService("Lighting"),
			player.Character,
		}
		local found
		found, looked = FN.assetWalk(roots, MISC.assetBudget or 20000, "SOUND")
		for _, f in ipairs(found) do add(f.id, f.name, f.where) end
	else
		-- Playing right now. Narrower on purpose: whatever you can actually
		-- hear at this moment is a much shorter list than every sound the map
		-- contains, and it is usually the one you were asking about.
		local found
		found, looked = FN.assetWalk({ Workspace,
			game:FindService("SoundService") },
			MISC.assetBudget or 20000, "PLAYING")
		for _, f in ipairs(found) do add(f.id, f.name, f.where) end
	end

	local added = 0
	for _, h in ipairs(hits) do
		local have = false
		for _, id in ipairs(ST.tracks) do
			if id == h.id then
				have = true
				break
			end
		end
		if not have then
			ST.tracks[#ST.tracks + 1] = h.id
			added = added + 1
		end
	end

	local out = { "[ModMenu] sound ids found (" .. mode .. ") --" }
	if #hits == 0 then
		out[#out + 1] = "  none"
	end
	for i, h in ipairs(hits) do
		out[#out + 1] = string.format("  %3d. %-14s %-24s in %s",
			i, h.id, h.name, h.where)
	end
	for _, l in ipairs(out) do print(l) end
	if type(setclipboard) == "function" then
		pcall(setclipboard, table.concat(out, "\n"))
	end

	FN.toast(#hits .. " found, " .. added .. " new -- added to the playlist")
	FN.updateUI()
end

local function addSearchResult()
	local pick = ST.results[ST.resultIndex]
	if not pick then
		FN.toast("No result selected")
		return
	end
	for _, existing in ipairs(ST.tracks) do
		if existing == pick.id then
			FN.toast("Already in the playlist")
			return
		end
	end
	table.insert(ST.tracks, pick.id)
	FN.toast("Added " .. pick.name)
end

-- Declared first: an unplayable track advances by calling this again
function FN.playTrack(index, attempts)
	if #ST.tracks == 0 then
		FN.toast("No tracks in the list")
		return
	end

	-- Counts how many we have skipped. Without this a playlist where nothing
	-- loads would hop track to track forever.
	attempts = attempts or 0
	if attempts >= #ST.tracks then
		ST.musicPlaying = false
		FN.toast("No playable tracks in the list")
		return
	end
	-- Wraps both ways so next/prev cycle rather than dead-ending
	ST.trackIndex = ((index - 1) % #ST.tracks) + 1

	local snd = ensureSound()
	local id = ST.tracks[ST.trackIndex]

	local ok = pcall(function()
		snd:Stop()
		snd.SoundId = "rbxassetid://" .. id
		snd.Volume = (MISC.musicVolume or 50) / 100
		snd.Looped = MISC.musicLoop
	end)
	if not ok then
		FN.toast("Bad sound id")
		ST.musicPlaying = false
		return
	end

	ST.musicPlaying = true
	FN.toast("Loading track " .. ST.trackIndex .. "...")

	-- Loading is asynchronous and Play() on an unloaded Sound does nothing, so
	-- this waits for the asset before starting it.
	--
	-- The check afterwards matters: since Roblox's audio privacy rules, an
	-- asset you do not own and that is not public simply refuses to load. No
	-- error is raised and Play() reports success -- it is just silent forever.
	-- TimeLength staying 0 is the only signal you get, so it is surfaced here
	-- rather than leaving you wondering whether the button works.
	task.spawn(function()
		pcall(function()
			SERV.ContentProvider:PreloadAsync({ snd })
		end)

		if snd.SoundId ~= "rbxassetid://" .. id then return end -- track changed

		if snd.TimeLength <= 0 then
			-- Not authorised, or not audio. Move on rather than stopping dead:
			-- one restricted id in a playlist should not end playback.
			FN.toast("Skipping " .. id .. " (not authorised)")
			FN.playTrack(ST.trackIndex + 1, attempts + 1)
			return
		end

		pcall(function() snd:Play() end)
		FN.toast("Playing " .. ST.trackIndex .. " of " .. #ST.tracks)
		FN.updateUI()
	end)
end

local function addTrack()
	local id = BOX.musicIdBox.Text:match("(%d+)")
	if not id then
		FN.toast("Enter a sound id")
		return
	end
	for _, existing in ipairs(ST.tracks) do
		if existing == id then
			FN.toast("Already in the list")
			return
		end
	end
	table.insert(ST.tracks, id)
	BOX.musicIdBox.Text = ""
	FN.toast("Added, " .. #ST.tracks .. " tracks")
end

local function removeTrack()
	if #ST.tracks == 0 then return end
	table.remove(ST.tracks, ST.trackIndex)
	if ST.trackIndex > #ST.tracks then ST.trackIndex = math.max(1, #ST.tracks) end
	stopMusic()
	FN.toast("Removed, " .. #ST.tracks .. " left")
end

