-- Single owner of row visibility: the search filter and the per-row hidden flag
-- both feed into this, so neither can clobber the other.
FN.applyRowVisibility = function()
	local query = UI._query or ""
	for _, row in ipairs(UI._rows) do
		if row.obj.Parent then
			local visible
			if row.header then
				-- Headers hide entirely while searching: with their sections
				-- filtered down, a lone header over unrelated rows reads as noise
				visible = (query == "")
			else
				visible = (query == "") or row.text:find(query, 1, true) ~= nil
			end

			-- A row hidden via its right-click menu stays hidden either way
			local id = UI._id[row.obj]
			if id and UI._cfg[id] and UI._cfg[id].hidden then
				visible = false
			end

			row.obj.Visible = visible
		end
	end
end

BOX.searchBox:GetPropertyChangedSignal("Text"):Connect(function()
	UI._query = BOX.searchBox.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
	FN.applyRowVisibility()
end)

