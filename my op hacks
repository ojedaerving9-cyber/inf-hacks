bindAction(UI.lwWriteBtn, function()
	local slot, why = lwSlotValue()
	if not slot then
		FN.toast("Write: " .. why)
		return
	end

	local text = BOX.lwJsonBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
	if text == "" then
		FN.toast("Write: box is empty")
		return
	end

	-- Validated before writing: a malformed value in a slot the game parses on
	-- every frame is a good way to break your own client
	local okJson = pcall(function() return SERV.HttpService:JSONDecode(text) end)
	if not okJson then
		FN.toast("Write: that is not valid JSON")
		return
	end

	local before = tostring(slot.Value)
	local okWrite = pcall(function() slot.Value = text end)
	if not okWrite then
		FN.toast("Write: refused by the game")
		return
	end

	-- Checked a moment later: if the server owns the value it overwrites ours
	-- straight back, and saying "written" when it did not stick is a lie
	task.delay(0.6, function()
		pcall(function()
			if not slot.Parent then return end
			if tostring(slot.Value) == text then
				FN.toast("Slot" .. LW.slot .. " holding (client-side at least)")
			else
				FN.toast("Server overwrote it -- value is server-owned")
			end
		end)
	end)
	FN.toast("Wrote Slot" .. LW.slot .. " (was " .. before:sub(1, 20) .. "...)")
end)

