end

-- ---- Click-to-teleport ----
-- Part inspector. Click a part and it reports what the part actually is --
-- class, size, position, plus any attributes and Value children. Those last
-- two are usually where a game keeps per-block state like a hit counter, so
-- this answers "what changes when I hit it" directly.
local function describePart(part)
	local lines = {
		part.Name .. "  (" .. part.ClassName .. ")",
		string.format("pos %.1f, %.1f, %.1f", part.Position.X, part.Position.Y, part.Position.Z),
		string.format("size %.1f x %.1f x %.1f", part.Size.X, part.Size.Y, part.Size.Z),
	}

	local parent = part.Parent
	if parent then
		lines[#lines + 1] = "in: " .. parent.Name .. " (" .. parent.ClassName .. ")"
	end

	-- Attributes first: the modern way to store per-instance state
	local attrs = {}
	pcall(function()
		for key, value in pairs(part:GetAttributes()) do
			attrs[#attrs + 1] = key .. "=" .. tostring(value)
		end
	end)
	if #attrs > 0 then
		lines[#lines + 1] = "attrs: " .. table.concat(attrs, ", ")
	end

	-- Value objects: the older way, and still common
	local vals = {}
	for _, child in ipairs(part:GetChildren()) do
		if child:IsA("ValueBase") then
			vals[#vals + 1] = child.Name .. "=" .. tostring(child.Value)
		end
	end
	if #vals > 0 then
		lines[#lines + 1] = "values: " .. table.concat(vals, ", ")
	end

	return table.concat(lines, "\n")
end

-- Local test dummy. Cloned from your own character, so it matches whatever rig
-- the game uses instead of a hand-built R6 that might not take damage the same
-- way. Created client-side only: nothing here replicates, so no other player
-- ever sees it or is involved.
--[[
	Test sword.

	The dummy is a client-only model, so the thing that kills it has to be
	client-only too: a Tool built here, put in your own Backpack, doing its
	damage with a plain Humanoid:TakeDamage on your machine. No remote is
	fired and nothing is asked of the server, which is exactly why it works on
	a model the server has never heard of.

	The flip side is worth saying plainly: for the same reason it cannot hurt a
	real player. Their Humanoid is owned by the server, your TakeDamage moves a
	number in your client's copy, and the next replication overwrites it. That
	is why DUMMY ONLY is the default -- swinging at someone and watching their
	health bar drop on your screen only is a good way to believe something that
	is not true.
--]]
function FN.removeTestSword()
	if ST.swordTool then
		pcall(function() ST.swordTool:Destroy() end)
		ST.swordTool = nil
	end
	-- Equipped tools live on the character, not in the Backpack
	local ch = player.Character
	for _, where in ipairs({ player:FindFirstChild("Backpack"), ch }) do
		if where then
			for _, t in ipairs(where:GetChildren()) do
				if t:IsA("Tool") and t.Name == "TestSword" .. uiName then
					pcall(function() t:Destroy() end)
				end
			end
		end
	end
end

function FN.giveTestSword()
	FN.removeTestSword()

	local backpack = player:FindFirstChild("Backpack")
	if not backpack then
		FN.toast("Sword: no Backpack yet")
		return
	end

	local tool = Instance.new("Tool")
	-- Named with this copy's tag so Remove can find it again, and so a second
	-- copy of the menu never deletes this one's sword
	tool.Name = "TestSword" .. uiName
	tool.ToolTip = "Client-side. Kills test dummies only."
	tool.RequiresHandle = true
	tool.CanBeDropped = false

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.3, 0.3, 5)
	handle.Material = Enum.Material.Metal
	handle.Color = Color3.fromRGB(200, 205, 215)
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool

	local guard = Instance.new("Part")
	guard.Name = "Guard"
	guard.Size = Vector3.new(1.4, 0.25, 0.3)
	guard.Material = Enum.Material.Metal
	guard.Color = Color3.fromRGB(120, 95, 40)
	guard.CanCollide = false
	guard.Massless = true
	guard.Parent = tool

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = guard
	weld.Parent = handle
	guard.CFrame = handle.CFrame * CFrame.new(0, 0, 2.1)

	-- Purely cosmetic: puts the blade out of the fist rather than through it
	tool.Grip = CFrame.new(0, 0, 2.2) * CFrame.Angles(math.rad(90), 0, 0)

	tool.Activated:Connect(function()
		if tick() - (ST.swordAt or 0) < 0.35 then return end
		ST.swordAt = tick()

		local ch = player.Character
		local root = ch and ch:FindFirstChild("HumanoidRootPart")
		if not root then return end

		local reach = MISC.swordReach or 8
		-- A sphere just in front of you, not a ray: a ray misses a dummy you
		-- are standing inside, which is exactly where you end up while testing
		local centre = root.Position + root.CFrame.LookVector * (reach * 0.5)

		local params = OverlapParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { ch }
		params.MaxParts = 200

		local hits = {}
		pcall(function()
			hits = Workspace:GetPartBoundsInRadius(centre, reach * 0.7, params)
		end)

		local seen = {}
		local dealt = 0
		for _, part in ipairs(hits) do
			local model = part:FindFirstAncestorOfClass("Model")
			local hum = model and model:FindFirstChildOfClass("Humanoid")
			if hum and not seen[hum] and hum.Health > 0 then
				seen[hum] = true

				local allowed = true
				if MISC.swordTarget == "DUMMY" then
					allowed = (model == ST.dummy)
				end

				if allowed then
					pcall(function() hum:TakeDamage(MISC.swordDamage or 25) end)
					dealt = dealt + 1
				end
			end
		end

		if dealt == 0 then
			FN.toast("Swing: nothing in reach"
				.. ((MISC.swordTarget == "DUMMY") and " (dummy only)" or ""))
		end
	end)

	tool.Parent = backpack
	ST.swordTool = tool
	FN.toast("Test sword in your backpack")
end

local function removeDummy()
	if ST.dummyHealthConn then
		ST.dummyHealthConn:Disconnect()
		ST.dummyHealthConn = nil
	end
	if ST.dummy then
		pcall(function() ST.dummy:Destroy() end)
		ST.dummy = nil
	end
end

-- Builds the dummy. A username (or blank for your own avatar) plus a rig type,
-- via HumanoidDescription -- that is what lets R6 and R15 both work, since a
-- straight clone can only ever reproduce the rig you already have.
local function spawnDummy()
	removeDummy()

	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		FN.toast("Dummy: no character to place it near")
		return
	end

	local spawnCF = hrp.CFrame * CFrame.new(0, 0, -5)
	local wanted = BOX.dummySkinBox.Text:gsub("%s+", "")
	local rig = (MISC.dummyRig == "R6") and Enum.HumanoidRigType.R6 or Enum.HumanoidRigType.R15

	-- These calls hit Roblox web APIs and yield, so the whole thing runs off
	-- the click handler. Blocking here would freeze the menu for the round trip.
	task.spawn(function()
		local model
		local ok, err = pcall(function()
			local userId = player.UserId
			if wanted ~= "" then
				userId = Players:GetUserIdFromNameAsync(wanted)
			end
			local desc = Players:GetHumanoidDescriptionFromUserId(userId)
			model = Players:CreateHumanoidModelFromDescription(desc, rig)
		end)

		if not ok or not model then
			FN.toast(wanted ~= "" and ("Dummy: no user '" .. wanted .. "'") or "Dummy: avatar load failed")
			warn("[ModMenu] dummy build failed: " .. tostring(err))
			return
		end

		model.Name = "TestDummy" .. uiName
		local dummyHum = model:FindFirstChildOfClass("Humanoid")
		local dummyRoot = model:FindFirstChild("HumanoidRootPart")
		if not dummyHum or not dummyRoot then
			model:Destroy()
			FN.toast("Dummy: built model had no humanoid")
			return
		end

		dummyHum.DisplayName = (wanted ~= "" and wanted or "Test Dummy")
		dummyHum.MaxHealth = MISC.dummyHealth or 100
		dummyHum.Health = dummyHum.MaxHealth

		model:PivotTo(CFrame.new(spawnCF.Position, hrp.Position))
		-- Anchored only when standing still; wandering needs physics
		dummyRoot.Anchored = not MISC.dummyMove

		local tag = Instance.new("BillboardGui")
		tag.Name = "DummyHealth"
		tag.Adornee = dummyRoot
		tag.AlwaysOnTop = true
		tag.Size = UDim2.new(0, 140, 0, 34)
		tag.StudsOffset = Vector3.new(0, 3.5, 0)
		tag.Parent = model

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.fromRGB(120, 255, 140)
		label.Font = Enum.Font.GothamBold
		label.TextSize = 13
		label.TextStrokeTransparency = 0.4
		label.Text = math.floor(dummyHum.Health) .. " / " .. math.floor(dummyHum.MaxHealth)
		label.Parent = tag

		model.Parent = Workspace
		ST.dummy = model

		-- The damage readout is the point: exact numbers beat watching a bar
		local last = dummyHum.Health
		ST.dummyHealthConn = dummyHum.HealthChanged:Connect(function(hp)
			label.Text = math.floor(hp) .. " / " .. math.floor(dummyHum.MaxHealth)
			local dealt = last - hp
			last = hp
			if dealt > 0 then
				FN.toast(string.format("Dummy took %.1f  (%.0f left)", dealt, hp))
			end
			if hp <= 0 then FN.toast("Dummy died") end
		end)

		-- The dummy is only useful if you can hit it, and the only thing that
		-- can hit a client-only model is a client-only weapon
		if MISC.swordWithDummy then FN.giveTestSword() end

		FN.toast("Dummy spawned (" .. (MISC.dummyRig or "R15") .. ")")
		FN.updateUI()
	end)
end

-- Instant ProximityPrompts. HoldDuration is what makes you hold E for a few
-- seconds; zeroing it fires the prompt the moment you press.
--
-- Every original is recorded and restored on toggle-off, because a prompt's
-- hold time is often deliberate design -- a long channel on a chest, say -- and
-- leaving it zeroed permanently would quietly change how the game plays.
local function restorePrompts()
	for prompt, held in pairs(ST.promptHolds) do
		pcall(function()
			if prompt.Parent then prompt.HoldDuration = held end
		end)
	end
	table.clear(ST.promptHolds)
end

local function applyInstantPrompts()
	local found = searchWorkspace(function(n)
		return n:IsA("ProximityPrompt")
	end, 60000, true)

	ST.promptCount = #found
	for _, prompt in ipairs(found) do
		if ST.promptHolds[prompt] == nil then
			pcall(function()
				ST.promptHolds[prompt] = prompt.HoldDuration
				prompt.HoldDuration = 0
			end)
		end
	end
end

local function setInstantPrompts(state)
	MISC.instantPrompt = state
	if state then
		MISC.promptScan = 0 -- pick them up immediately, not on the next tick
	else
		restorePrompts()
	end
	FN.updateUI()
end

