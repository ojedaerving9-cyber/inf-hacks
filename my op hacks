--[[
	Random name, for anti-detection.

	The old seed was tick() + os.time(), and both of those move slowly. The
	seed is truncated to an integer, so every run inside the same second got
	the SAME seed and produced the SAME "random" name -- three copies in a
	place all called aiQ2KLsPPy68, which defeats the point of randomising it
	and makes two copies impossible to tell apart.

	A fresh table's address is the one thing here that genuinely differs on
	every execution, so it goes in the mix alongside the clock. tostring on it
	gives "table: 0x...", and folding those hex digits together turns an
	address into a number.
--]]
local seedMix = 0
for c in tostring({}):gmatch("%x") do
	seedMix = (seedMix * 31 + tonumber(c, 16)) % 2147483647
end
math.randomseed((math.floor(tick() * 1000) + os.time() + seedMix) % 2147483647)
local function generateRandomString(length)
	local charset = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
	local sb = {}
	for i = 1, length do
		local randIndex = math.random(1, #charset)
		table.insert(sb, charset:sub(randIndex, randIndex))
	end
	return table.concat(sb)
end

