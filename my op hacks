-- ==========================================
-- 5. LOGIC & FUNCTIONS
-- ==========================================

function FN.updateUI()
	local function toggle(btn, state, onText, offText)
		btn.Text = state and onText or offText
		setButtonColor(btn, state and THEME.on or THEME.off)
	end

	-- Says which hook took, and what it has actually stopped. "ACTIVE" on its
	-- own is a claim; a count is evidence.
	UI.aacBtn.Text = ON.aacEnabled
		and ("Anti Anti-Cheat: " .. (AAC.viaMeta and "META" or AAC.viaFunc and "FUNC" or "NO HOOK")
			.. ((AAC.blocked > 0) and ("  " .. AAC.blocked .. " kick(s) blocked") or ""))
		or "Anti Anti-Cheat: OFF"
	local killedCount = 0
	for _ in pairs(AAC.killed) do killedCount = killedCount + 1 end
	UI.aacKillBtn.Text = (killedCount > 0)
		and ("Anti-Cheat Scripts Disabled: " .. killedCount)
		or "Disable Anti-Cheat Scripts"
	setButtonColor(UI.aacKillBtn, (killedCount > 0) and THEME.on or THEME.raised)
	toggle(UI.aacRemoteBtn, AAC.blockRemotes,
		"Block Anti-Cheat Remotes: ON (" .. AAC.dropped .. " dropped)",
		"Block Anti-Cheat Remotes: OFF")
	toggle(UI.aacRejoinBtn, AAC.rejoin,
		"Auto Rejoin If Kicked: ON", "Auto Rejoin If Kicked: OFF")
	-- The WHY matters more than the ON: armed with no source is the failure
	-- everyone hits, and it is invisible until you teleport and lose the menu
	local rWhy = MISC.reexecWhy
	local rOn = "Come Back After Teleport: ON"
	if rWhy and rWhy ~= "off" then rOn = rOn .. " (" .. rWhy .. ")" end
	toggle(UI.reexecBtn, MISC.reexec, rOn, "Come Back After Teleport: OFF")
	toggle(UI.tpRetryBtn, MISC.tpRetry,
		"Retry Failed Teleports: ON", "Retry Failed Teleports: OFF")
	setButtonColor(UI.aacListBtn, THEME.raised)
	setButtonColor(UI.aacBtn, ON.aacEnabled and THEME.warn or THEME.off)

	toggle(UI.spinBtn, ON.spinbotEnabled, "Spinbot: ON", "Spinbot: OFF")
	-- Key name is read live so rebinding updates these labels too
	local fk = KEYS.fly and KEYS.fly.Name or "NONE"
	toggle(UI.flyBtn, ST.flying, "Fly (" .. fk .. "): ON", "Fly (" .. fk .. "): OFF")
	UI.flyModeBtn.Text = "Fly Mode: " .. ST.flyMode
	toggle(UI.flyFacingBtn, MISC.flyLockFacing, "Fly Locks Facing: ON", "Fly Locks Facing: OFF")
	-- Says whether it is actually doing it, since the difference only shows up
	-- while you are sitting in something
	do
		local flyHum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		local seated = flyHum and flyHum.SeatPart ~= nil
		toggle(UI.flyVehicleBtn, MISC.flyVehicle,
			"Fly Moves Vehicle: ON" .. (seated and "  [seated]" or ""),
			"Fly Moves Vehicle: OFF")
	end
	-- Says what it costs, because the trade is the whole decision: slower, but
	-- it looks like walking
	toggle(UI.flyNoPhysBtn, MISC.flyNoPhysics,
		"Fly Without BodyVelocity: ON (no object)", "Fly Without BodyVelocity: OFF (adds bodyvel)")
	toggle(UI.legitFlyBtn, MISC.legitFly,
		"Legit Fly: ON (" .. MISC.legitSpeed .. " cap)",
		"Legit Fly (speed capped): OFF")
	BOX.legitSpeedBox.Text = "Legit Speed Cap: " .. MISC.legitSpeed

