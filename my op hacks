function FN.obbyLoad(n)
	GAME.level = math.clamp(n, 1, #GAME.levels)
	local L = GAME.levels[GAME.level]
	GAME.ox, GAME.oy = L.start[1], L.start[2]
	GAME.ovx, GAME.ovy = 0, 0
	GAME.oGround = false
	GAME.moverT = 0
	GAME.moverOff = {}
	GAME.moverWas = {}
	for i = 1, #L.movers do
		GAME.moverOff[i] = 0
		GAME.moverWas[i] = 0
	end
	GAME.msg = L.name
	GAME.levelStart = tick()
	FN.obbyBuild()
end

function FN.obbyDie()
	GAME.deaths = (GAME.deaths or 0) + 1
	local L = GAME.levels[GAME.level]
	GAME.ox, GAME.oy = L.start[1], L.start[2]
	GAME.ovx, GAME.ovy = 0, 0
	GAME.msg = "Died -- " .. GAME.deaths .. " total"
end

function FN.obbyStep(dt)
	local L = GAME.levels[GAME.level]
	local accel, maxSpeed, gravity, jump = 70, 11, 46, 16.5
	local w, h = 0.7, 1.6

	GAME.moverT = GAME.moverT + dt

	-- Offsets computed once, here, and read by the draw. Two copies of this
	-- formula drift apart the moment either is touched, and a platform drawn
	-- where it is not is the worst bug a platformer can have.
	for i, m in ipairs(L.movers) do
		GAME.moverWas[i] = GAME.moverOff[i] or 0
		GAME.moverOff[i] = math.sin(GAME.moverT * (m[6] / math.max(m[5], 0.001))) * m[5]
	end

	local left = GAME.keys[Enum.KeyCode.A] or GAME.keys[Enum.KeyCode.Left]
	local right = GAME.keys[Enum.KeyCode.D] or GAME.keys[Enum.KeyCode.Right]
	local up = GAME.keys[Enum.KeyCode.W] or GAME.keys[Enum.KeyCode.Space]
		or GAME.keys[Enum.KeyCode.Up]

	if left then GAME.ovx = GAME.ovx - accel * dt end
	if right then GAME.ovx = GAME.ovx + accel * dt end
	if not left and not right then
		GAME.ovx = GAME.ovx * math.max(0, 1 - 14 * dt)
	end
	GAME.ovx = math.clamp(GAME.ovx, -maxSpeed, maxSpeed)

	if up and GAME.oGround then
		GAME.ovy = -jump
		GAME.oGround = false
	end
	GAME.ovy = math.min(GAME.ovy + gravity * dt, 45)

	-- Carried by the platform you are standing on. Without this every mover is
	-- a treadmill that slides you off, and level 4 is not merely hard, it is
	-- impossible.
	if GAME.rideMover then
		local d = (GAME.moverOff[GAME.rideMover] or 0) - (GAME.moverWas[GAME.rideMover] or 0)
		GAME.ox = GAME.ox + d
	end

	-- Everything solid this frame, movers at their current offset
	local solids = {}
	for _, p in ipairs(L.plats) do
		solids[#solids + 1] = { p[1], p[2], p[3], p[4] }
	end
	for i, m in ipairs(L.movers) do
		solids[#solids + 1] = { m[1] + GAME.moverOff[i], m[2], m[3], m[4], mover = i }
	end

	local nx = GAME.ox + GAME.ovx * dt
	for _, sd in ipairs(solids) do
		if rectHit(nx, GAME.oy, w, h, sd[1], sd[2], sd[3], sd[4]) then
			GAME.ovx = 0
			nx = GAME.ox
			break
		end
	end
	GAME.ox = nx

	local ny = GAME.oy + GAME.ovy * dt
	GAME.oGround = false
	GAME.rideMover = nil
	for _, sd in ipairs(solids) do
		if rectHit(GAME.ox, ny, w, h, sd[1], sd[2], sd[3], sd[4]) then
			if GAME.ovy > 0 then
				ny = sd[2] - h
				GAME.oGround = true
				GAME.rideMover = sd.mover
			else
				ny = sd[2] + sd[4]
			end
			GAME.ovy = 0
			break
		end
	end
	GAME.oy = ny

	for _, sp in ipairs(L.spikes) do
		if rectHit(GAME.ox, GAME.oy, w, h, sp[1], sp[2], sp[3], sp[4]) then
			FN.obbyDie()
			return
		end
	end

	if GAME.oy > 20 then
		FN.obbyDie()
		return
	end

	local g = L.goal
	if rectHit(GAME.ox, GAME.oy, w, h, g[1], g[2], g[3], g[4]) then
		local took = tick() - (GAME.levelStart or tick())
		if GAME.level >= #GAME.levels then
			local runDeaths = GAME.deaths or 0
			GAME.best = math.min(GAME.best or math.huge, runDeaths)
			GAME.deaths = 0
			FN.obbyLoad(1)
			GAME.msg = string.format("ALL CLEAR -- %d deaths. Back to level 1.", runDeaths)
		else
			FN.obbyLoad(GAME.level + 1)
			GAME.msg = string.format("Level %d -- last one took %.1fs", GAME.level, took)
		end
	end
end

