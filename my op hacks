-- ---- Session actions ----
-- Setting Humanoid.Sit only forces the seated state. The game's Animate script
-- plays the sit animation off the Seated event with a real seat attached, so
-- without one you get the pose and no animation. Park an invisible Seat under
-- the character instead and let the normal sit path run.
-- Animation player. Loads an asset id onto your own Animator and plays it,
-- optionally anchoring you so the animation is not dragged around by walking.
-- Custom emote builder. Rotate a joint, save the pose, rotate again, save
-- again -- then play the saved poses back in a loop, easing between them.
--
-- This drives Motor6D.C0 directly rather than loading an animation asset, so
-- nothing needs uploading. The trade-off is that C0 is a property change, and
-- property changes made on the client do not replicate: you will see it, other
-- players will not. Use the animation-id player above for anything others need
-- to see.
local function collectMotors()
	local character = player.Character
	if not character then return {} end

	local motors = {}
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("Motor6D") and d.Part0 and d.Part1 then
			-- The fly motor is ours, not part of the rig
			if not d.Name:find("FlyMotor", 1, true) then
				motors[#motors + 1] = d
				-- Remembered once so Reset Pose can always get back
				if ST.poseHome[d] == nil then ST.poseHome[d] = d.C0 end
			end
		end
	end
	table.sort(motors, function(a, b) return a.Name < b.Name end)
	return motors
end

function FN.currentMotor()
	local motors = collectMotors()
	if #motors == 0 then return nil, 0 end
	local index = math.clamp(MISC.poseJoint or 1, 1, #motors)
	return motors[index], #motors
end

function FN.applyPoseRotation()
	local motor = FN.currentMotor()
	if not motor or not ST.poseHome[motor] then return end
	pcall(function()
		motor.C0 = ST.poseHome[motor] * CFrame.Angles(
			math.rad(MISC.poseX), math.rad(MISC.poseY), math.rad(MISC.poseZ)
		)
	end)
end

local function resetPose()
	for motor, home in pairs(ST.poseHome) do
		pcall(function()
			if motor.Parent then motor.C0 = home end
		end)
	end
	MISC.poseX, MISC.poseY, MISC.poseZ = 0, 0, 0
end

-- A frame is every joint's current C0, so playback restores whole poses rather
-- than only the joint that happened to be selected when it was saved
local function addPoseFrame()
	-- Keyed by joint NAME, not by the Motor6D itself. Instance keys die with
	-- the character, so a respawn used to leave frames that still counted but
	-- silently did nothing. Names survive, and they can be written to a file.
	local frame = {}
	for _, motor in ipairs(collectMotors()) do
		frame[motor.Name] = motor.C0
	end
	table.insert(ST.poseFrames, frame)
	FN.toast("Pose " .. #ST.poseFrames .. " saved")
end

-- Emotes survive a restart. A CFrame cannot go into a key=value file as-is,
-- so each is flattened to its 12 components; joints are separated by ";" and
-- frames by "/", none of which appear in a joint name.
local function serialisePoses()
	local out = {}
	for _, frame in ipairs(ST.poseFrames) do
		local joints = {}
		for name, cf in pairs(frame) do
			joints[#joints + 1] = name .. "," .. table.concat({ cf:GetComponents() }, ",")
		end
		out[#out + 1] = table.concat(joints, ";")
	end
	return table.concat(out, "/")
end

local function deserialisePoses(text)
	local frames = {}
	for chunk in text:gmatch("[^/]+") do
		local frame = {}
		for joint in chunk:gmatch("[^;]+") do
			local parts = {}
			for piece in joint:gmatch("[^,]+") do parts[#parts + 1] = piece end
			-- A name plus 12 numbers; anything else is a corrupted entry
			if #parts == 13 then
				local nums = {}
				for i = 2, 13 do nums[i - 1] = tonumber(parts[i]) end
				if #nums == 12 then
					local ok, cf = pcall(function() return CFrame.new(table.unpack(nums)) end)
					if ok then frame[parts[1]] = cf end
				end
			end
		end
		if next(frame) then frames[#frames + 1] = frame end
	end
	return frames
end

local function clearPoseFrames()
	ST.poseFrames = {}
	ST.posePlaying = false
	resetPose()
	FN.toast("Poses cleared")
end

--[[
	Animation asset finder.

	Playing an animation was never the hard part -- that is four lines and this
	menu has had them for a while. The hard part is knowing WHICH id, and the
	usual answer is trawling a website for a number to paste in.

	Almost none of that needs a website. The ids are already in the game you
	are standing in, and there are three separate places to find them:

	IN THIS GAME    Animation instances and the StringValues the default Animate
	                script keeps its ids in. This is where a game's real walk,
	                run, jump and attack animations live.

	PLAYING NOW     Every Animator in range, asked what it is currently playing.
	                This is the one for "somebody just did something and I want
	                it" -- the id is on their character while it runs.

	EQUIPPED EMOTES Every humanoid's applied HumanoidDescription, which carries
	                the eight animation slots of their avatar package plus every
	                emote they have equipped. Reads other people's avatars as
	                happily as your own.

	All three are local reads. Nothing is fetched, nothing is sent.

	Results go somewhere useful rather than only to the console: Use Next Found
	walks the list and drops each id straight into the play box, so finding one
	and trying it is two clicks and no typing.
--]]
function FN.assetWalk(roots, budget, kind)
	-- Same queue shape as searchWorkspace, over several roots instead of one.
	-- Bounded for the same reason: these trees include ReplicatedStorage on
	-- games that keep a few hundred thousand instances in it.
	local out, queue, head, seen = {}, {}, 1, 0
	for _, r in ipairs(roots) do
		if r then
			pcall(function()
				for _, c in ipairs(r:GetChildren()) do queue[#queue + 1] = c end
			end)
		end
	end

	local maxQueue = math.min(budget * 2, 50000)
	while head <= #queue and seen < budget do
		local node = queue[head]
		head = head + 1
		seen = seen + 1

		pcall(function()
			local function keep(id)
				out[#out + 1] = { id = id, name = node.Name,
					where = node.Parent and node.Parent.Name or "?" }
			end
			if kind == "SOUND" or kind == "PLAYING" then
				if node:IsA("Sound") and node.SoundId ~= "" then
					-- PLAYING is the same walk with one more condition. Whatever
					-- you can hear right now is a far shorter list than every
					-- sound in the map, and usually the one being asked about.
					if kind == "SOUND" or node.IsPlaying then
						keep(node.SoundId)
					end
				end
			elseif node:IsA("Animation") and node.AnimationId ~= "" then
				keep(node.AnimationId)
			elseif node:IsA("StringValue")
				and node.Value:match("rbxassetid://%d+") then
				keep(node.Value)
			end
		end)

		if seen < budget and #queue < maxQueue then
			pcall(function()
				for _, child in ipairs(node:GetChildren()) do
					queue[#queue + 1] = child
					if #queue >= maxQueue then break end
				end
			end)
		end
	end
	return out, seen
end

function FN.assetFind(mode)
	local hits, byId = {}, {}
	local function add(id, name, where)
		local num = tostring(id or ""):match("(%d+)")
		-- Deduplicated through a set, not a scan of the list. A game with two
		-- hundred animations would otherwise be forty thousand comparisons.
		if not num or byId[num] then return end
		byId[num] = true
		hits[#hits + 1] = { id = num, name = name or "?", where = where or "?" }
	end

	local me = player.Character
	local looked = 0

	if mode == "GAME" then
		local roots = {
			Workspace,
			game:FindService("ReplicatedStorage"),
			game:FindService("ReplicatedFirst"),
			game:FindService("StarterPlayer"),
			game:FindService("Lighting"),
			me,
			player:FindFirstChildOfClass("Backpack"),
		}
		local found
		found, looked = FN.assetWalk(roots, MISC.assetBudget or 20000)
		for _, f in ipairs(found) do add(f.id, f.name, f.where) end

	elseif mode == "PLAYING" then
		local chars = { me }
		for _, entry in ipairs(ST.charList()) do chars[#chars + 1] = entry.model end
		for _, ch in ipairs(chars) do
			pcall(function()
				local hum = ch and ch:FindFirstChildOfClass("Humanoid")
				local animator = hum and hum:FindFirstChildOfClass("Animator")
				if not animator then return end
				looked = looked + 1
				for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
					if track.Animation then
						add(track.Animation.AnimationId,
							track.Animation.Name, ch.Name)
					end
				end
			end)
		end

	elseif mode == "AVATARS" then
		local chars = { me }
		for _, entry in ipairs(ST.charList()) do chars[#chars + 1] = entry.model end
		for _, ch in ipairs(chars) do
			pcall(function()
				local hum = ch and ch:FindFirstChildOfClass("Humanoid")
				if not hum then return end
				local desc = hum:GetAppliedDescription()
				if not desc then return end
				looked = looked + 1
				-- The eight animation slots of an avatar package
				for _, slot in ipairs({ "Idle", "Walk", "Run", "Jump", "Fall",
					"Swim", "Climb", "Mood" }) do
					local v = desc[slot .. "Animation"]
					if v and v ~= 0 then add(v, slot, ch.Name) end
				end
				-- and every emote they have equipped
				for name, ids in pairs(desc:GetEmotes()) do
					for _, one in ipairs(ids) do add(one, name, ch.Name) end
				end
			end)
		end
	end

	ST.assetHits = hits
	ST.assetAt = 0

	local lines = { "[ModMenu] animation ids found (" .. mode .. ") --" }
	if #hits == 0 then
		lines[#lines + 1] = "  none"
		if mode == "GAME" then
			lines[#lines + 1] = "  (nothing stores its ids as Animation objects"
				.. " here -- try PLAYING NOW while someone moves)"
		end
	end
	for i, h in ipairs(hits) do
		lines[#lines + 1] = string.format("  %3d. %-12s %-22s in %s",
			i, h.id, h.name, h.where)
	end
	for _, l in ipairs(lines) do print(l) end
	if type(setclipboard) == "function" then
		pcall(setclipboard, table.concat(lines, "\n"))
	end

	FN.toast(#hits .. " animation ids found -- press Use Next Found")
	FN.updateUI()
end

function FN.assetNext()
	local hits = ST.assetHits
	if #hits == 0 then
		FN.toast("Nothing found yet -- run one of the Find buttons")
		return
	end
	ST.assetAt = (ST.assetAt % #hits) + 1
	local h = hits[ST.assetAt]
	BOX.animIdBox.Text = h.id
	FN.toast(ST.assetAt .. "/" .. #hits .. ": " .. h.name .. "  (" .. h.where .. ")")
	FN.updateUI()
end

--[[
	What is this id?

	The one part of the finder that has to leave the machine, and the only one
	that needs the executor to provide an HTTP function -- HttpService is
	server-side only, so there is no fallback to fall back to.

	Worth having anyway: "could not load that id" is the same message whether
	the id is a hat, a deleted asset, or an animation that simply is not yours
	to play, and those want three different responses from you.
--]]
function FN.assetIdentify()
	local id = (BOX.animIdBox.Text or ""):match("(%d+)")
	if not id then
		FN.toast("Put an id in the animation box first")
		return
	end

	-- Every executor spells this differently and half of them are nil, so each
	-- one is fetched behind its own pcall rather than indexed blind
	local req
	for _, get in ipairs({
		function() return syn.request end,
		function() return http.request end,
		function() return http_request end,
		function() return request end,
	}) do
		local ok, fn = pcall(get)
		if ok and type(fn) == "function" then
			req = fn
			break
		end
	end
	if not req then
		FN.toast("No HTTP function here -- this one needs the executor's request()")
		return
	end

	task.spawn(function()
		local ok, res = pcall(req, {
			Url = "https://economy.roblox.com/v2/assets/" .. id .. "/details",
			Method = "GET",
		})
		if not ok or not res or not res.Body then
			FN.toast("Lookup failed -- no answer from Roblox")
			return
		end

		local parsed
		local decoded = pcall(function()
			parsed = SERV.HttpService:JSONDecode(res.Body)
		end)
		if not decoded or type(parsed) ~= "table" then
			FN.toast("Lookup failed -- could not read the answer")
			return
		end

		-- 24 is Animation, 61 is EmoteAnimation. Anything else will not play,
		-- and saying so beats a load error that looks like the menu's fault.
		local kind = parsed.AssetTypeId
		local what = (kind == 24 and "Animation")
			or (kind == 61 and "Emote Animation")
			or ("asset type " .. tostring(kind) .. " -- NOT an animation")
		local creator = parsed.Creator and parsed.Creator.Name or "?"
		local msg = id .. ": " .. tostring(parsed.Name)
			.. "  [" .. what .. ", by " .. creator .. "]"
		print("[ModMenu] " .. msg)
		FN.toast(msg)
	end)
end

local function stopAnim()
	if ST.animTrack then
		pcall(function() ST.animTrack:Stop() end)
		ST.animTrack = nil
	end
	-- Only release the anchor if this feature took it. Freeze and fly both
	-- drive Anchored too, and stealing it back from them would break them.
	if ST.animAnchored then
		ST.animAnchored = false
		local ch = player.Character
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		if hrp and not MISC.frozen and not ST.flying then
			pcall(function() hrp.Anchored = false end)
		end
	end
end

local function playAnim()
	local raw = BOX.animIdBox.Text:gsub("%s+", "")
	-- Accept a bare id, a full rbxassetid:// string, or a pasted library URL
	local id = raw:match("(%d+)")
	if not id then
		FN.toast("Animation: enter an asset id")
		return
	end

	local character = player.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then
		FN.toast("Animation: no character")
		return
	end

	-- Animator is what actually plays tracks; Humanoid:LoadAnimation is the
	-- deprecated path and is ignored on newer rigs
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = hum
	end

	stopAnim()

	local ok, err = pcall(function()
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://" .. id
		local track = animator:LoadAnimation(anim)
		track.Looped = MISC.animLoop
		-- Action outranks the default walk/idle tracks, so the emote keeps
		-- playing while you move. On the default priority the walk animation
		-- wins the moment you touch a key and the emote visually vanishes.
		track.Priority = MISC.animOverride
			and Enum.AnimationPriority.Action
			or Enum.AnimationPriority.Idle
		track:Play()
		track:AdjustSpeed(MISC.animSpeed / 100)
		ST.animTrack = track
	end)

	if not ok or not ST.animTrack then
		FN.toast("Animation: could not load that id")
		warn("[ModMenu] animation load failed: " .. tostring(err))
		return
	end

	if MISC.animAnchor then
		ST.animAnchored = true
		pcall(function() hrp.Anchored = true end)
	end
	FN.toast("Playing " .. id)
end

-- Local invisibility. LocalTransparencyModifier is a client-only property, so
-- this hides you from yourself without touching what anyone else sees --
-- reapplied on a timer because the engine resets it as parts stream and the
-- character's own scripts write to it.
local function applyInvisible()
	local ch = player.Character
	if not ch then return end
	local want = MISC.invisible and 1 or 0
	-- Descendants, not children: hats, hair and tool handles are BaseParts
	-- nested inside Accessory/Tool models, so a children-only pass left them
	-- floating in mid-air with the body gone. A character is a few dozen
	-- instances, so this walk is cheap.
	for _, d in ipairs(ch:GetDescendants()) do
		if d:IsA("BasePart") then
			pcall(function() d.LocalTransparencyModifier = want end)
		elseif d:IsA("Decal") or d:IsA("Texture") then
			-- Decals ignore the part's modifier, so the face would otherwise
			-- hang in the air. No LocalTransparencyModifier on these, so the
			-- original is recorded and handed back rather than assumed to be 0.
			pcall(function()
				if MISC.invisible then
					if ST.invisDecals[d] == nil then ST.invisDecals[d] = d.Transparency end
					d.Transparency = 1
				elseif ST.invisDecals[d] ~= nil then
					d.Transparency = ST.invisDecals[d]
				end
			end)
		end
	end
	if not MISC.invisible then table.clear(ST.invisDecals) end
end

-- Body scale, R15 only: the scale values live under the Humanoid and R6 rigs
-- simply do not have them, so this reports rather than silently doing nothing.
-- quiet: set when this runs on its own (respawn), where a toast about the rig
-- would fire unprompted every time you die on an R6 game.
function FN.applyBodyScale(quiet)
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	local found = false
	for _, name in ipairs({ "BodyHeightScale", "BodyWidthScale", "BodyDepthScale" }) do
		local v = hum:FindFirstChild(name)
		if v then
			found = true
			pcall(function() v.Value = MISC.bodyScale / 100 end)
		end
	end
	local head = hum:FindFirstChild("HeadScale")
	if head then pcall(function() head.Value = MISC.bodyScale / 100 end) end

	-- R6 has no scale values at all -- they are an R15 feature -- so the rig is
	-- resized by hand instead: every part scaled from its original size, and
	-- every joint offset scaled to match.
	--
	-- The joints are the part people forget. A Motor6D's C0/C1 hold where the
	-- limb attaches in studs; leave them alone while the parts grow and the
	-- arms and legs stay pinned at the old offsets, so a scaled-up R6 comes
	-- apart at the shoulders. Rotation is preserved and only the position is
	-- scaled, or the whole rig twists.
	if not found then
		local factor = MISC.bodyScale / 100
		found = true

		-- Descendants, not children. Hair, hats and every other accessory keep
		-- their part inside an Accessory object, so a children-only pass scaled
		-- the body and left the hair at its original size sitting on top of a
		-- giant head.
		--
		-- Tools are skipped outright: their handle is not part of the rig, and
		-- resizing it drags the character around when the grip re-solves --
		-- which is what "tools teleport me" was.
		for _, part in ipairs(ch:GetDescendants()) do
			if part:IsA("BasePart") and not part:FindFirstAncestorOfClass("Tool") then
				-- Originals recorded once. Scaling from the current size
				-- compounds: two presses of +10% would give 121%, not 120%,
				-- and there would be no way back to the real proportions.
				if ST.r6Parts[part] == nil then
					ST.r6Parts[part] = part.Size
				end
				pcall(function() part.Size = ST.r6Parts[part] * factor end)
			end
		end

		-- Accessory attachment points. An Accessory is positioned by matching
		-- an Attachment on its handle to one on the head, and those offsets are
		-- in studs -- so scaled hair sits at the old offset and floats off the
		-- head unless these move with it.
		for _, att in ipairs(ch:GetDescendants()) do
			if att:IsA("Attachment") and not att:FindFirstAncestorOfClass("Tool") then
				if ST.r6Atts[att] == nil then
					ST.r6Atts[att] = att.CFrame
				end
				local orig = ST.r6Atts[att]
				pcall(function()
					att.CFrame = CFrame.new(orig.Position * factor)
						* (orig - orig.Position)
				end)
			end
		end

		for _, d in ipairs(ch:GetDescendants()) do
			-- Grips hold a tool onto a hand. They are not rig joints, and
			-- scaling one moves the tool somewhere odd -- and with a Reach
			-- handle on it, moves you with it.
			if d:IsA("Motor6D") and not d.Name:find("Grip") then
				if ST.r6Motors[d] == nil then
					ST.r6Motors[d] = { c0 = d.C0, c1 = d.C1 }
				end
				local orig = ST.r6Motors[d]
				pcall(function()
					d.C0 = CFrame.new(orig.c0.Position * factor)
						* (orig.c0 - orig.c0.Position)
					d.C1 = CFrame.new(orig.c1.Position * factor)
						* (orig.c1 - orig.c1.Position)
				end)
			end
		end

		-- Hip height has to follow, or the feet end up through the floor at
		-- large scales and hovering at small ones
		pcall(function()
			if ST.r6Hip == nil then ST.r6Hip = hum.HipHeight end
			hum.HipHeight = ST.r6Hip * factor
		end)
	end

	-- The character just changed size, so any measured stand height belongs to
	-- the old one. Cleared rather than kept: a stale offset is what puts you
	-- knee-deep in the floor until something happens to re-measure.
	MISC.standOffset = nil

	-- Worth knowing, and said once rather than every respawn: a client-side
	-- size change does not replicate. You will see the new size; other players
	-- and the server still see the original.
	if not quiet and not ST.r6Warned and ST.r6Parts and next(ST.r6Parts) then
		ST.r6Warned = true
		FN.toast("R6 scaled locally -- others still see your normal size")
	end
end

-- ==========================================
-- X-RAY / LOW GRAPHICS / AUTO CLICKER
-- ==========================================
-- X-Ray. LocalTransparencyModifier again, so the walls only turn see-through
-- on this client. Every part touched is remembered, and switching off puts
-- back exactly that set rather than blanket-clearing the modifier on
-- everything -- which would undo Invisible and anything else using it.
function FN.clearXray()
	for part in pairs(ST.xrayParts) do
		pcall(function()
			if part.Parent then part.LocalTransparencyModifier = 0 end
		end)
	end
	table.clear(ST.xrayParts)
end

function FN.scanXray()
	local amount = math.clamp((MISC.xrayAmount or 72) / 100, 0, 1)

	-- Characters stay solid: seeing through walls is the point, seeing through
	-- people just makes them harder to spot.
	local chars = {}
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Character then chars[pl.Character] = true end
	end

	-- Budgeted walk, same reason as everywhere else in this file: a plain
	-- GetDescendants() on a voxel map closes the client with no error.
	local parts = searchWorkspace(function(node)
		if not node:IsA("BasePart") then return false end
		-- Our own spawned parts all carry uiName; leave them alone
		if node.Name:find(uiName, 1, true) then return false end
		local model = node:FindFirstAncestorWhichIsA("Model")
		if model and chars[model] then return false end
		-- Already invisible or nearly so: nothing to gain, and writing to it
		-- would mean restoring it to 0 later and making it solid
		if node.Transparency >= 0.9 then return false end
		return true
	end, 3000, true)

	for _, part in ipairs(parts) do
		pcall(function()
			part.LocalTransparencyModifier = amount
			ST.xrayParts[part] = true
		end)
	end

	-- Streaming destroys parts as you move away, leaving keys pointing at dead
	-- instances. Pruned here rather than in clearXray: this runs every couple
	-- of seconds, that only runs when the feature is switched off.
	for part in pairs(ST.xrayParts) do
		if part.Parent == nil then ST.xrayParts[part] = nil end
	end
end

-- Low Graphics. Nothing is destroyed -- each original value is recorded and
-- handed back, so a game that leans on its own effects gets them intact.
local function restoreGraphics()
	for inst, old in pairs(ST.gfxMuted) do
		pcall(function()
			if inst.Parent then
				if inst:IsA("PostEffect") or inst:IsA("ParticleEmitter") or inst:IsA("Trail")
					or inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles")
					or inst:IsA("Beam") then
					inst.Enabled = old
				elseif inst:IsA("Terrain") then
					inst.Decoration = old
				elseif inst:IsA("Lighting") then
					inst.GlobalShadows = old
				end
			end
		end)
	end
	table.clear(ST.gfxMuted)
end

local function applyLowGraphics()
	pcall(function()
		if ST.gfxMuted[Lighting] == nil then ST.gfxMuted[Lighting] = Lighting.GlobalShadows end
		Lighting.GlobalShadows = false
	end)
	pcall(function()
		local terrain = Workspace:FindFirstChildOfClass("Terrain")
		if terrain then
			if ST.gfxMuted[terrain] == nil then ST.gfxMuted[terrain] = terrain.Decoration end
			terrain.Decoration = false
		end
	end)
	for _, effect in ipairs(Lighting:GetChildren()) do
		if effect:IsA("PostEffect") and effect.Enabled then
			pcall(function()
				if ST.gfxMuted[effect] == nil then ST.gfxMuted[effect] = effect.Enabled end
				effect.Enabled = false
			end)
		end
	end
	-- Budgeted, and re-run on a timer because effects stream in as you move
	local fx = searchWorkspace(function(node)
		return ST.EFFECT_CLASSES[node.ClassName] == true and node.Enabled
	end, 3000, true)
	for _, node in ipairs(fx) do
		pcall(function()
			if ST.gfxMuted[node] == nil then ST.gfxMuted[node] = node.Enabled end
			node.Enabled = false
		end)
	end

	-- Same pruning as X-Ray, for the same reason
	for inst in pairs(ST.gfxMuted) do
		if inst.Parent == nil then ST.gfxMuted[inst] = nil end
	end
end

-- Brightness. -1 means "never touched", so the original is captured the first
-- time rather than at load, where a game that sets it later would overwrite
-- whatever we had recorded.
function FN.applyBrightness()
	pcall(function()
		if ORIGINAL.brightness == nil then ORIGINAL.brightness = Lighting.Brightness end
		if MISC.brightness < 0 then
			Lighting.Brightness = ORIGINAL.brightness
		else
			Lighting.Brightness = MISC.brightness / 100 * 2
		end
	end)
end

-- Auto clicker. Activates the equipped tool, and falls back to VirtualUser for
-- games that read raw clicks instead. Both are pcall'd: VirtualUser is not
-- reachable in every execution context.
local function autoClickOnce()
	local ch = player.Character
	local tool = ch and ch:FindFirstChildOfClass("Tool")
	if tool then
		pcall(function() tool:Activate() end)
		return
	end
	if VirtualUser then
		pcall(function()
			VirtualUser:Button1Down(Vector2.new(0, 0), Workspace.CurrentCamera.CFrame)
			VirtualUser:Button1Up(Vector2.new(0, 0), Workspace.CurrentCamera.CFrame)
		end)
	end
end

-- ==========================================
-- REACH
-- ==========================================
-- Grows the equipped tool's Handle so a touch-based weapon registers from
-- further out. Worth being straight about what this can and cannot do: games
-- that decide hits on the client will honour the bigger handle, and games that
-- re-check the swing on the server will not -- there the handle looks normal
-- from the server's side and nothing changes. It costs nothing to leave on.
--
-- The original size is recorded per handle and put back exactly, the same way
-- noclip restores CanCollide. Massless, or a 20-stud handle drags you around.
local function restoreReach()
	for handle, old in pairs(ST.reachOrig) do
		pcall(function()
			if handle.Parent then
				handle.Size = old.size
				handle.Transparency = old.transparency
				handle.Massless = old.massless
				handle.CanCollide = old.canCollide
			end
		end)
	end
	table.clear(ST.reachOrig)
end

-- Why the size trick alone was not enough: a Size change made on the client
-- does not replicate. Your handle looks huge here and completely normal to the
-- server, so any game that decides hits server-side sees nothing at all. That
-- is most games, which is why it appeared to do nothing.
--
-- firetouchinterest is the part that actually reaches the server: it fires the
-- engine's own touch event between two parts, which is exactly what walking
-- into something produces. The server cannot tell it apart from a real touch,
-- so a Touched-based weapon registers at whatever range you set.
--
-- Executor-provided, so it is guarded -- without it this falls back to size,
-- and the toggle says which mode is actually doing anything.
local function reachTouch(handle)
	if type(firetouchinterest) ~= "function" then return 0 end

	local ch = player.Character
	local myRoot = ch and ch:FindFirstChild("HumanoidRootPart")
	if not myRoot then return 0 end

	local studs = math.clamp(MISC.reachStuds or 8, 1, 40)
	local fired = 0

	-- Characters, not players: a clone has no Player behind it and was being
	-- skipped entirely, which is the same blind spot the aim had
	for _, entry in ipairs(ST.charList()) do
		local char, hum, other = entry.model, entry.hum, entry.plr
		do
			local root = char and char:FindFirstChild("HumanoidRootPart")
			-- Corpses do not need hitting, and a team-mate is not a target:
			-- the same check the aim features use, so one setting covers both.
			-- A clone has no team, so the check simply does not apply to it.
			local sameTeam = other and other.Team and player.Team
				and other.Team == player.Team
			local skip = (hum and hum.Health <= 0)
				or (AIM.teamMode == "ENEMIES" and sameTeam)
				or (AIM.teamMode == "TEAM" and not sameTeam)

			if root and not skip and (root.Position - myRoot.Position).Magnitude <= studs then
				-- The parts a weapon is actually checked against. Firing at every
				-- limb meant a dozen touch events per player per tick, which is
				-- both wasted and a very loud pattern on the server's side.
				for _, part in ipairs(ST.hitParts(char)) do
					if part then
						pcall(function()
							-- 0 then 1 is touch-begin then touch-end, which is
							-- what a real brush past produces. Sending only the
							-- begin leaves the game thinking you are still
							-- standing inside them.
							firetouchinterest(handle, part, 0)
							firetouchinterest(handle, part, 1)
						end)
						fired = fired + 1
					end
				end
			end
		end
	end

	return fired
end

local function applyReach()
	local ch = player.Character
	if not ch then return end

	-- Only the equipped tool: growing every handle in the backpack would
	-- change nothing you can hit with and cost a walk of the whole inventory.
	local tool = ch:FindFirstChildOfClass("Tool")
	-- Handle is the convention, not a rule: plenty of tools put their hitbox in
	-- a differently named part, and looking only for "Handle" meant Reach was
	-- silently a no-op on those
	local handle = tool and (tool:FindFirstChild("Handle")
		or tool:FindFirstChildWhichIsA("BasePart"))

	-- Anything no longer held goes back to its own size, so swapping weapons
	-- does not leave a giant handle behind on the last one
	for old in pairs(ST.reachOrig) do
		if old ~= handle then
			local entry = ST.reachOrig[old]
			pcall(function()
				if old.Parent then
					old.Size = entry.size
					old.Transparency = entry.transparency
					old.Massless = entry.massless
					old.CanCollide = entry.canCollide
				end
			end)
			ST.reachOrig[old] = nil
		end
	end

	if not handle or not handle:IsA("BasePart") then return end

	if ST.reachOrig[handle] == nil then
		ST.reachOrig[handle] = {
			size = handle.Size,
			transparency = handle.Transparency,
			massless = handle.Massless,
			canCollide = handle.CanCollide,
		}
	end

	local base = ST.reachOrig[handle].size
	local studs = math.clamp(MISC.reachStuds or 8, 1, 40)
	if MISC.reachMode == "TOUCH" then
		-- Nothing visible in this mode: the touch is fired directly, so growing
		-- the handle would only advertise what you are doing
		MISC.reachHits = reachTouch(handle)
		return
	end
	pcall(function()
		local want = base + Vector3.new(studs, studs, studs)
		-- Only written when it drifted: assigning Size every pass re-runs the
		-- engine's collision rebuild for the part, which is not free
		if (handle.Size - want).Magnitude > 0.05 then handle.Size = want end
		handle.Massless = true
		handle.CanCollide = false
		-- Without this the bigger box cannot register a touch at all, which
		-- made the size mode useless even in games that do check client-side
		handle.CanTouch = true
		-- Semi-transparent rather than invisible: you want to see how far the
		-- box actually extends, otherwise a miss is unreadable
		handle.Transparency = 0.8
	end)

	if MISC.reachMode ~= "SIZE" then
		MISC.reachHits = reachTouch(handle)
	else
		MISC.reachHits = 0
	end
end

-- ==========================================
-- KILL COMBO
-- ==========================================
-- One button that runs the three things in sequence instead of by hand:
-- TP spam to close the distance, weld onto their back once you are there, then
-- auto click. Written as a state machine driven from the stepped loop rather
-- than a task.wait() chain, so switching it off takes effect immediately
-- instead of after whatever sleep it happened to be sitting in.
--
-- Every stage is the existing feature, not a reimplementation: the combo only
-- decides when each one turns on.
-- Picks the best weapon you have and equips it. Two completely different
-- inventories to handle, so both are tried:
--
--   1. Backpack Tools -- the ordinary Roblox way, EquipTool.
--   2. Slot JSON -- Lucky World keeps items as JSON in StringValues and the
--      held item is whichever slot SelectedSlot points at. There are no Tools
--      in the Backpack to equip at all, so a Backpack-only search finds
--      nothing and the attack swings barehanded.
--
-- Ranked, not just "anything sharp": Hacker gear is the strongest set in Lucky
-- World, so it wins over a plain sword, which wins over an axe, and a torch
-- only gets picked when there is nothing else.
--
-- A field on ST rather than its own local: the file is at 190 of Luau's 200
-- locals per scope and this is not worth one of the ten that are left.
-- The inventory folder sits in the character model in Workspace, and the game
-- calls it either "Inventory" or "Inv" depending where you look. Checking only
-- the long name reads as "this player has no inventory" on every character
-- using the short one, which is silently wrong rather than visibly broken.
-- Lucky World's remotes, by name, from the game's own Explorer:
--   RemoteFunctions: ChangeSlot, MoveItem, SortItem, UseBlock, PlaceBlock,
--                    ConsumeItem, DropItem, CraftItems, LoadBlock, ExitBlock,
--                    CancelBlock, GetBiome, SetBedPos, DailyRewards
--   RemoteEvents:    BreakBlock, OnBreakBlock, OnPlaceBlock, BeingAttacked,
--                    MobKilled
--
-- Found by recursive FindFirstChild, which returns as soon as it hits rather
-- than building a table of everything the way GetDescendants would.
-- How far the character's feet sit below the root part.
--
-- The old code fell back to a flat 3, which is an R6 number: R6 legs are two
-- studs and its root is two tall, so 3 happens to be right. R15 is a different
-- rig with a different hip height, and a scaled R15 -- Body Scale, or a game
-- that resizes you -- is different again. Standing an R15 at an R6 offset puts
-- you knee-deep in the surface or floating above it.
--
-- HipHeight is the engine's own answer and it already accounts for scaling, so
-- it is asked first. R6 reports 0 for it, which is the only case that needs the
-- legs measured by hand.
ST.standOffset = function(character)
	-- A live measurement from the air-walk calibration beats any formula,
	-- since it came from the character actually standing on something
	local measured = MISC.standOffset
	if measured and measured > 0.5 and measured < 12 then return measured end

	local hum = character and character:FindFirstChildOfClass("Humanoid")
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return 3 end

	local hip = hum.HipHeight
	if hip <= 0 then
		-- R6: no HipHeight, and its legs are two studs before scaling. Read the
		-- leg if it is there rather than assuming the default size, so a scaled
		-- or custom R6 still lands right.
		local leg = character:FindFirstChild("Left Leg") or character:FindFirstChild("Right Leg")
		hip = leg and leg.Size.Y or 2
	end

	return hip + (hrp.Size.Y / 2)
end

ST.findRemote = function(name)
	local found
	pcall(function()
		local rs = game:GetService("ReplicatedStorage")
		found = rs:FindFirstChild(name, true)
	end)
	if found and (found:IsA("RemoteFunction") or found:IsA("RemoteEvent")) then
		return found
	end
	return nil
end

-- World position -> block coordinates. The game addresses blocks by grid
-- coordinate, not studs: OnBreakBlock(player, -15, 165, -115) is a grid cell.
--
-- The grid size is read off the block itself rather than hardcoded. Every block
-- in a game like this is one cube, so its own Size is the scale -- which means
-- this keeps working if the game is ever rebuilt at a different resolution.
-- Calls one of the game's remotes directly, by name, with your own arguments.
--
-- This is the path that needs nothing exotic: no metamethod hook, no signal
-- firing, none of what Xeno is missing. We know the remote names from the
-- game's own Explorer and we know the argument shape from OnBreakBlock, so
-- there is nothing left to intercept -- just ask.
--
-- Fired in separate threads on purpose: with a RemoteFunction, InvokeServer
-- yields until the server answers, so spawning them puts both in flight at
-- once. That overlap is the race the chest dupe depends on.
ST.callRemote = function(name, times, ...)
	local remote = ST.findRemote(name)
	if not remote then
		FN.toast("Remote not found: " .. name)
		return 0
	end

	local packed = table.pack(...)
	local sent = 0

	for _ = 1, math.clamp(times or 1, 1, 20) do
		task.spawn(function()
			pcall(function()
				if remote:IsA("RemoteFunction") then
					local answer = remote:InvokeServer(table.unpack(packed, 1, packed.n))
					if answer ~= nil then
						FN.toast(name .. " -> " .. tostring(answer):sub(1, 24))
					end
				else
					remote:FireServer(table.unpack(packed, 1, packed.n))
				end
			end)
		end)
		sent = sent + 1
	end

	return sent
end

ST.blockCoords = function(part)
	if not part or not part:IsA("BasePart") then return nil end
	local scale = part.Size.X
	if scale < 0.1 then scale = 3 end
	local p = part.Position
	return math.floor(p.X / scale + 0.5),
		math.floor(p.Y / scale + 0.5),
		math.floor(p.Z / scale + 0.5)
end

-- Fires the client's OWN handler for a server event, without the server being
-- involved at all. Worth being clear about the limit: this convinces your
-- client that something happened. Whether that is worth anything depends
-- entirely on what the client's handler does with it -- if it grants the drop
-- locally and something later trusts that state, it matters; if the handler
-- only updates visuals, you get a block that looks broken and nothing else.
ST.fireClientBreak = function(part, times)
	-- Three ways to reach a client handler, tried in order, because executors
	-- disagree about which of them they ship. Xeno in particular is missing
	-- firesignal, which is why a snippet written for another executor does
	-- nothing there and gives no error either.
	--
	--   1. firesignal        -- fires every connection on the signal
	--   2. getconnections    -- reach the connections and fire them yourself
	--   3. replicatesignal   -- newer, and not everywhere
	local haveFire = type(firesignal) == "function"
	local haveConns = type(getconnections) == "function"
	if not haveFire and not haveConns then
		FN.toast("Executor has neither firesignal nor getconnections")
		return false
	end

	local x, y, z = ST.blockCoords(part)
	if not x then
		FN.toast("No block to break")
		return false
	end

	local remote = ST.findRemote("OnBreakBlock")
	if not remote or not remote:IsA("RemoteEvent") then
		FN.toast("OnBreakBlock not found")
		return false
	end

	local sent = 0
	for _ = 1, math.clamp(times or 1, 1, 20) do
		local ok = false

		if haveFire then
			ok = pcall(function()
				firesignal(remote.OnClientEvent, player, x, y, z)
			end)
		end

		-- getconnections hands back the individual listeners. Firing each one
		-- is the same end result: every handler the game registered runs with
		-- these arguments. :Fire is the usual name; .Function is the older
		-- shape, so both are attempted per connection.
		if not ok and haveConns then
			ok = pcall(function()
				local conns = getconnections(remote.OnClientEvent)
				if #conns == 0 then error("nothing is listening") end
				for _, conn in ipairs(conns) do
					local fired = pcall(function() conn:Fire(player, x, y, z) end)
					if not fired and conn.Function then
						pcall(conn.Function, player, x, y, z)
					end
				end
			end)
		end

		if ok then sent = sent + 1 end
	end

	if sent == 0 then
		FN.toast("Nothing fired -- press Executor Check to see what is missing")
		return false
	end

	FN.toast(string.format("Client break %d,%d,%d x%d", x, y, z, sent))
	return sent > 0
end

-- The parts worth aiming a hit at, for any rig.
--
-- The standard names cover R6 and R15 and nothing else. A custom rig can call
-- its torso anything -- "Body", "Chassis", "Middle" -- and a hit list of fixed
-- names then finds nothing, which is why reach and the seat attack quietly do
-- nothing against some characters.
--
-- Standard names first because they are right most of the time and cost one
-- lookup; the rig's own PrimaryPart and largest part as the fallback, since
-- every rig has a biggest piece and that is almost always its body.
-- Every character in the world, not just the ones in the player list.
--
-- Players:GetPlayers() only knows about real players. A cloned character, an
-- NPC, or a body someone spawned in has a Humanoid and limbs and can be hit
-- like anything else -- but it has no Player, so a player-list scan cannot see
-- it and the aim slides straight past.
--
-- Found by looking for Humanoids and taking their parents, which is what makes
-- a character a character. Cached for half a second: the aim runs every frame
-- and this walks part of the world.
ST.charList = function()
	if ST.charCache and (os.clock() - (ST.charAt or 0)) < 0.5 then
		return ST.charCache
	end

	local list, seen = {}, {}
	local myChar = player.Character

	local function add(model, hum, plr)
		if model and model ~= myChar and not seen[model] then
			seen[model] = true
			list[#list + 1] = { model = model, hum = hum, plr = plr }
		end
	end

	-- Real players first, straight from the player list. They are guaranteed
	-- and they cost nothing to find, so there is no reason to go looking.
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			if hum then add(p.Character, hum, p) end
		end
	end

	-- The Workspace pass is skipped unless something actually wants clones.
	--
	-- Workspace:GetChildren() allocates a table of every top-level instance,
	-- and on a map made of blocks that is enormous -- worth paying for when
	-- you are hunting clones, pure waste when nothing is looking for them.
	local wantClones = (AIM.scope ~= "PLAYERS")
		or DET.on or PESP.enabled or LW.autoCollect
	if not wantClones then
		ST.charCache = list
		ST.charAt = os.clock()
		return list
	end

	-- Then everything else character-shaped.
	--
	-- Deliberately NOT a searchWorkspace walk. That is breadth-first with a
	-- node budget, and on a map made of blocks the budget is spent on blocks
	-- long before it reaches a character -- which is why the counter read
	-- "0p 0c" with clones standing in front of the camera, and why it cost
	-- frames to find nothing.
	--
	-- Characters sit at the top of Workspace, or one level inside a folder
	-- someone dropped them in. Two shallow levels with a hard cap finds them
	-- for a fraction of the work.
	local examined = 0
	local function scanForChars(node, depth)
		if depth > 4 or examined > 6000 then return end
		for _, child in ipairs(node:GetChildren()) do
			examined = examined + 1
			if examined > 6000 then return end

			if child:IsA("Model") then
				local hum = child:FindFirstChildOfClass("Humanoid")
				if hum then
					add(child, hum, Players:GetPlayerFromCharacter(child))
					-- Deliberately not descending into it. Below a Humanoid
					-- there are limbs, accessories and tools -- never another
					-- character -- and a rig is dozens of instances to spend
					-- the budget on for nothing.
				else
					scanForChars(child, depth + 1)
				end
			elseif child:IsA("Folder") then
				scanForChars(child, depth + 1)
			end
		end
	end
	scanForChars(Workspace, 1)

	ST.charCache = list
	ST.charAt = os.clock()
	return list
end

-- Hides clones locally. LocalTransparencyModifier and disabling their
-- nametags, not deletion: this is entirely client-side, nothing replicates,
-- and switching it off puts everything back. Deleting someone else's model
-- would also work locally, but there is no way back from it if the detection
-- was wrong -- and misjudging a real player's character is the one mistake
-- worth designing around.
ST.setClonesHidden = function(hidden)
	for _, entry in ipairs(ST.charList()) do
		if entry.plr == nil then
			-- Named for what it is: a character, which is a few dozen instances
			-- and safe to walk. The bare "entry.model" read as an arbitrary
			-- model, which is the shape that has crashed this client twice.
			local cloneChar = entry.model
			for _, d in ipairs(cloneChar:GetDescendants()) do
				if d:IsA("BasePart") then
					pcall(function() d.LocalTransparencyModifier = hidden and 1 or 0 end)
				elseif d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
					-- Nametags are the loud part: a dozen overlapping names is
					-- most of what makes a clone crowd unreadable
					pcall(function()
						if hidden then
							if ST.cloneGuis[d] == nil then ST.cloneGuis[d] = d.Enabled end
							d.Enabled = false
						elseif ST.cloneGuis[d] ~= nil then
							d.Enabled = ST.cloneGuis[d]
						end
					end)
				end
			end
		end
	end

	if not hidden then table.clear(ST.cloneGuis) end
end

-- Which side someone is on.
--
-- Player.Team is the obvious answer and it is wrong in most games: plenty
-- never touch Teams at all, so Team is nil for everybody. "Same team" is then
-- never true, everyone reads as an enemy, and the aim locks onto your own side
-- while looking like it is working correctly.
--
-- So a tag can be named instead: a value, attribute or child on the character
-- or the player that says which side they are on. Whatever it holds is
-- compared -- "Red" against "Red" -- rather than assumed to mean anything.
ST.sideOf = function(model, plr)
	local tag = AIM.teamTag
	if tag and tag ~= "" then
		local found
		pcall(function()
			if model then
				local v = model:FindFirstChild(tag)
				if v and v:IsA("ValueBase") then found = tostring(v.Value) end
				if not found and model:GetAttribute(tag) ~= nil then
					found = tostring(model:GetAttribute(tag))
				end
			end
			if not found and plr then
				local v = plr:FindFirstChild(tag)
				if v and v:IsA("ValueBase") then found = tostring(v.Value) end
				if not found and plr:GetAttribute(tag) ~= nil then
					found = tostring(plr:GetAttribute(tag))
				end
				-- leaderstats is where a lot of games keep this
				local stats = plr:FindFirstChild("leaderstats")
				local statVal = stats and stats:FindFirstChild(tag)
				if not found and statVal and statVal:IsA("ValueBase") then
					found = tostring(statVal.Value)
				end
			end
		end)
		return found
	end

	return plr and plr.Team and plr.Team.Name or nil
end

ST.hitParts = function(char)
	if not char then return {} end

	local out, seen = {}, {}
	local function add(part)
		if part and part:IsA("BasePart") and not seen[part] then
			seen[part] = true
			out[#out + 1] = part
		end
	end

	for _, name in ipairs({ "HumanoidRootPart", "UpperTorso", "Torso", "Head" }) do
		add(char:FindFirstChild(name))
	end

	if #out == 0 then
		add(char.PrimaryPart)

		-- Largest part by volume. Children only: a walk of every descendant on
		-- a heavy custom rig is the allocation this file avoids everywhere.
		local biggest, biggestSize
		for _, d in ipairs(char:GetChildren()) do
			if d:IsA("BasePart") then
				local vol = d.Size.X * d.Size.Y * d.Size.Z
				if not biggestSize or vol > biggestSize then
					biggest, biggestSize = d, vol
				end
			end
		end
		add(biggest)
	end

	return out
end

-- Does this remote look like an anti-cheat channel? Name and full path both,
-- because the telling name is often the folder rather than the remote:
-- "Security/Report" reads as innocent on the remote alone.
-- Save / Load Build. Serialises the parts around you into a string you can copy
-- out, and rebuilds them from one you paste in. The thing every "build string"
-- conversation this project has had was circling, finally written.
--
-- Format, one part per "|", fields by ";":
--   hexcolour ; sizeX,sizeY,sizeZ ; posX,posY,posZ ; material ; transparency
-- Positions are RELATIVE to where you stood when you saved, so a build drops in
-- around you wherever you are, not back at its old world coordinates.
-- GUI hover farm. Games like the accelerator panel reward the cursor sitting on
-- a green square and punish it touching a red one, then move the squares around.
-- This finds the target-coloured square each tick and parks the real cursor on
-- its centre, staying off the others.
--
-- Colour, not name or position: the squares move and are usually unnamed, but
-- "the green one" is stable. Scores every small visible frame by how close its
-- colour is to the target and takes the best.
ST.hoverFarm = function()
	local best, bestScore, bestCentre

	-- Everywhere a GUI can live, not just PlayerGui. The panel can be in CoreGui
	-- (executor-drawn or some game UIs), in the hidden executor container, or on
	-- a SurfaceGui in the world. Each is guarded so a blocked one is skipped.
	local roots = { playerGui }
	pcall(function() roots[#roots + 1] = game:GetService("CoreGui") end)
	pcall(function() if type(gethui) == "function" then roots[#roots + 1] = gethui() end end)
	pcall(function() roots[#roots + 1] = game:GetService("StarterGui") end)

	--[[
		Three ways to find the square, tried best-first.

		OBJECT is the one worth having. A panel that tracks its own current
		target keeps an ObjectValue pointing at it -- the Accelerator has one
		called TargetObject -- and reading that is not a guess at all: it is the
		game telling you which square it means. No colour tolerance, no
		confusion between the fast shade and the slow one, and it keeps working
		when the artist changes the palette.

		NAME is second: the element is called "Green", and a name is still a far
		better signal than a shade.

		COLOUR is last and stays because it is the only one that needs no
		knowledge of the panel at all -- it works on a game nobody has looked
		inside yet.
	--]]
	local function centreOf(el)
		local sz = el.AbsoluteSize
		if sz.X < 2 or sz.Y < 2 then return nil end
		return el.AbsolutePosition + sz * 0.5
	end

	-- Never target our own interface. Without this the farm hovers the menu,
	-- and because the main frame is draggable, "hover" means "drag".
	local function isOurs(el)
		local ok, mine = pcall(function()
			return DEC.screenGui and el:IsDescendantOf(DEC.screenGui)
		end)
		if ok and mine then return true end
		-- Anything else this copy made carries the tag in its name
		return el.Name:find(uiName, 1, true) ~= nil
	end

	if MISC.hoverFind ~= "COLOUR" then
		local looked = 0
		for _, root in ipairs(roots) do
			if best or looked > 8000 then break end
			local ok = pcall(function()
				for _, d in ipairs(root:GetDescendants()) do
					looked = looked + 1
					if looked > 8000 then break end
					-- The panel's own pointer at what it currently wants
					if d:IsA("ObjectValue") and d.Name == (MISC.hoverPointer or "TargetObject") then
						local v = d.Value
						if v and v:IsA("GuiObject") and v.Visible and not isOurs(v) then
							local c = centreOf(v)
							if c then
								best, bestCentre = v, c
								break
							end
						end
					end

					-- Or the element by name, which is what you can see in the
					-- explorer without knowing how the panel is wired
					if MISC.hoverFind ~= "OBJECT" and d:IsA("GuiObject") and d.Visible
						and not isOurs(d) then
						for raw in (MISC.hoverNames or ""):gmatch("[^,]+") do
							local want = raw:gsub("^%s+", ""):gsub("%s+$", "")
							if want ~= "" and d.Name:lower() == want:lower() then
								local c = centreOf(d)
								if c then
									best, bestCentre = d, c
									break
								end
							end
						end
						if best then break end
					end
				end
			end)
			if not ok then best = nil end
		end
	end

	-- Colour, only if the precise ways found nothing
	if not best then
	local examined = 0
	for _, root in ipairs(roots) do
		if examined > 8000 then break end
		for _, d in ipairs(root:GetDescendants()) do
			examined = examined + 1
			if examined > 8000 then break end

			if (d:IsA("Frame") or d:IsA("ImageLabel") or d:IsA("ImageButton")
				or d:IsA("TextButton")) and d.Visible then
				local size = d.AbsoluteSize
				-- Squares: small and roughly square. Widened, since panels build
				-- their grid at all sorts of sizes.
				if size.X > 4 and size.X < 200 and size.Y > 4 and size.Y < 200
					and math.abs(size.X - size.Y) < math.max(size.X, size.Y) * 0.7 then
					local ok, c = pcall(function() return d.BackgroundColor3 end)
					if ok and isOurs(d) then ok = false end
					-- On screen at all: a zero-area element is not rendered
					if ok and c and (size.X * size.Y) > 16 then
						-- Distance to the exact target colour. These game greens
						-- are dark -- 092600 barely reads as green -- so a
						-- generic "greenness" test misses them; matching the
						-- precise shade is what finds the right square AND tells
						-- the fast one from the slow one.
						local want = MISC.hoverColor
						local dr, dg, db = c.R - want.R, c.G - want.G, c.B - want.B
						local score = dr * dr + dg * dg + db * db
						-- Tolerance tight enough to keep fast and slow apart
						-- (they sit ~0.05 squared-distance from each other)
						if score < (MISC.hoverTol or 0.012)
							and (not bestScore or score < bestScore) then
							bestScore = score
							best = d
							bestCentre = d.AbsolutePosition + size * 0.5
						end
					end
				end
			end
		end
	end
	end

	if not best or not bestCentre then return end

	-- CURSOR mode: the old way -- move the real mouse onto the square. Works
	-- against any game, including ones that read hover by polling position, but
	-- it takes your cursor over, which is why the keybind below exists.
	if MISC.hoverMode == "CURSOR" then
		-- A held button plus a moved cursor is a drag, whatever is underneath.
		-- Wait for the button to come up rather than dragging something across
		-- the screen on the player's behalf.
		if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
			or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			return
		end
		local vim
		if pcall(function() vim = game:GetService("VirtualInputManager") end) and vim then
			local inset = SERV.GuiService:GetGuiInset()
			pcall(function()
				vim:SendMouseMoveEvent(bestCentre.X + inset.X, bestCentre.Y + inset.Y, game)
			end)
			MISC.hoverHits = (MISC.hoverHits or 0) + 1
		end
		return
	end

	-- EVENT mode: fire the square's OWN hover handlers instead of moving the
	-- cursor. The
	-- game listens for MouseEnter / MouseMoved on the square; firing those
	-- makes it register a hover while your real mouse never moves.
	--
	-- getconnections reaches the listeners the game attached and lets us call
	-- them. Both signals are tried because games use one or the other, and the
	-- coordinates passed are the square's centre so anything reading them lands
	-- inside it.
	local fired = 0
	for _, sig in ipairs({ best.MouseEnter, best.MouseMoved }) do
		pcall(function()
			for _, conn in ipairs(getconnections(sig)) do
				local ok = pcall(function() conn:Fire(bestCentre.X, bestCentre.Y) end)
				if not ok and conn.Function then
					pcall(conn.Function, bestCentre.X, bestCentre.Y)
				end
				fired = fired + 1
			end
		end)
	end

	-- Some games poll GuiObject:IsHovered() rather than listening for an event,
	-- and that cannot be faked without the real cursor -- nothing was fired, so
	-- say so once instead of looking broken.
	if fired == 0 then
		if not MISC.hoverWarned then
			MISC.hoverWarned = true
			FN.toast("This game reads hover by position, not events -- cannot fake it")
		end
	else
		MISC.hoverHits = (MISC.hoverHits or 0) + 1
	end
end

ST.saveBuild = function()
	local ch = player.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	if not root then FN.toast("No character to measure from") return end
	local origin = root.Position

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { ch }
	params.MaxParts = 4000

	local nearby = {}
	pcall(function()
		nearby = Workspace:GetPartBoundsInRadius(origin, MISC.buildRange or 60, params)
	end)

	local out, count = {}, 0
	for _, part in ipairs(nearby) do
		if part:IsA("BasePart") and not part.Name:find(MISC.uiTag or "~none~", 1, true) then
			-- Skip characters: a saved build should be scenery, not the players
			-- standing in it
			local model = part:FindFirstAncestorOfClass("Model")
			local isChar = model and model:FindFirstChildOfClass("Humanoid") ~= nil
			if not isChar then
				local rel = part.Position - origin
				local hex = part.Color:ToHex()
				out[#out + 1] = table.concat({
					hex,
					string.format("%.2f,%.2f,%.2f", part.Size.X, part.Size.Y, part.Size.Z),
					string.format("%.2f,%.2f,%.2f", rel.X, rel.Y, rel.Z),
					tostring(part.Material.Value),
					string.format("%.2f", part.Transparency),
				}, ";")
				count = count + 1
				if count >= 1500 then break end
			end
		end
	end

	local text = table.concat(out, "|")
	local copied = false
	pcall(function()
		if type(setclipboard) == "function" then setclipboard(text) copied = true end
	end)
	BOX.buildBox.Text = text
	FN.toast(count .. " parts saved" .. (copied and " + copied" or ""))
end

ST.loadBuild = function()
	local ch = player.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	if not root then FN.toast("No character to build around") return end
	local origin = root.Position

	local text = BOX.buildBox.Text
	if text == "" then FN.toast("Paste a build string first") return end

	-- Cleared and re-parented under one folder, so Undo Build is a single
	-- Destroy rather than tracking every part
	if ST.buildFolder then pcall(function() ST.buildFolder:Destroy() end) end
	local folder = Instance.new("Folder")
	folder.Name = "LoadedBuild" .. (MISC.uiTag or "")
	folder.Parent = Workspace
	ST.buildFolder = folder

	local built = 0
	for chunk in text:gmatch("[^|]+") do
		local f = {}
		for field in chunk:gmatch("[^;]+") do f[#f + 1] = field end
		if #f >= 5 then
			pcall(function()
				local part = Instance.new("Part")
				part.Anchored = true
				part.Color = Color3.fromHex(f[1])

				local sx, sy, sz = f[2]:match("([%-%d%.]+),([%-%d%.]+),([%-%d%.]+)")
				part.Size = Vector3.new(tonumber(sx), tonumber(sy), tonumber(sz))

				local px, py, pz = f[3]:match("([%-%d%.]+),([%-%d%.]+),([%-%d%.]+)")
				part.Position = origin + Vector3.new(tonumber(px), tonumber(py), tonumber(pz))

				local mat = tonumber(f[4])
				if mat then pcall(function() part.Material = Enum.Material:FromValue(mat) end) end
				part.Transparency = tonumber(f[5]) or 0

				part.Parent = folder
				built = built + 1
			end)
		end
	end

	FN.toast(built .. " parts built around you")
end

-- Avatar morpher. Applies another user's look to your own character by loading
-- their HumanoidDescription and applying it to your Humanoid.
--
-- Honest about the reach: ApplyDescription changes what YOU see, and in many
-- games it replicates because the humanoid drives its own appearance -- but a
-- game that reapplies its own description on a loop will overwrite it, and a
-- server that never asked for the change is not obliged to show it to others.
-- It is a costume, not a new identity.
ST.morphTo = function(nameOrId)
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum then FN.toast("Morph: no character") return end

	FN.toast("Loading avatar...")
	task.spawn(function()
		local ok, err = pcall(function()
			local userId = tonumber(nameOrId)
			if not userId then
				userId = Players:GetUserIdFromNameAsync(nameOrId)
			end
			local desc = Players:GetHumanoidDescriptionFromUserId(userId)
			hum:ApplyDescription(desc)
		end)

		if ok then
			ST.morphed = true
			FN.toast("Morphed into " .. tostring(nameOrId))
		else
			FN.toast("Morph failed: no such user, or the game blocks it")
			warn("[ModMenu] morph failed: " .. tostring(err))
		end
	end)
end

-- Back to your own avatar.
ST.morphReset = function()
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	task.spawn(function()
		pcall(function()
			local desc = Players:GetHumanoidDescriptionFromUserId(player.UserId)
			hum:ApplyDescription(desc)
		end)
		ST.morphed = false
		FN.toast("Back to your own avatar")
	end)
end

-- Rig swap. The one that cannot be done cleanly client-side, said plainly.
--
-- HumanoidRigType is fixed when the character is built, and the character is
-- built by the SERVER. Nothing here restructures a live rig -- the Motor6D
-- layout of R6 and R15 are genuinely different skeletons, and rebuilding one
-- into the other on a moving character breaks animation, tools and collision.
--
-- What this does instead is the only reliable route: apply a description
-- carrying the wanted rig and reset, which asks the game to rebuild you. Games
-- that let their humanoids drive rig type will honour it; games that force a
-- rig on spawn will not, and it says so rather than pretending.
ST.rigSwap = function(toRig)
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum then FN.toast("Rig: no character") return end

	local current = (hum.RigType == Enum.HumanoidRigType.R6) and "R6" or "R15"
	if current == toRig then
		FN.toast("Already " .. toRig)
		return
	end

	local ok = pcall(function()
		hum.RigType = (toRig == "R6") and Enum.HumanoidRigType.R6 or Enum.HumanoidRigType.R15
	end)

	-- The property set is the honest attempt. Whether it takes is the game's
	-- call, and reading it straight back tells you which happened.
	task.wait(0.1)
	local nowRig = (hum and hum.Parent and hum.RigType == Enum.HumanoidRigType.R6) and "R6" or "R15"
	if ok and nowRig == toRig then
		FN.toast(toRig .. " set -- reset your character to rebuild it")
	else
		FN.toast("This game controls the rig -- swap refused")
	end
end

-- Lists every client-side script by name and path. When "Disabled: 2" turns
-- out to be the wrong two, this is how you find the right one: read the names,
-- spot the anti-cheat, put its name in the filter.
ST.listScripts = function()
	local rows, examined = {}, 0
	local places = {
		player:FindFirstChildOfClass("PlayerScripts"),
		player:FindFirstChildOfClass("PlayerGui"),
		player.Character,
		game:GetService("ReplicatedStorage"),
	}
	for _, place in ipairs(places) do
		if place and examined < 6000 then
			for _, d in ipairs(place:GetDescendants()) do
				examined = examined + 1
				if examined > 6000 then break end
				if d:IsA("LocalScript") or d:IsA("ModuleScript") then
					local state = d:IsA("LocalScript")
						and (d.Disabled and " [off]" or " [ON]") or " [mod]"
					rows[#rows + 1] = d.Name .. state
				end
			end
		end
	end
	table.sort(rows)
	return rows
end

ST.aacBlocks = function(remote)
	local terms = {}
	for raw in (AAC.filter or ""):lower():gmatch("[^,]+") do
		local t = raw:gsub("^%s+", ""):gsub("%s+$", "")
		if t ~= "" then terms[#terms + 1] = t end
	end
	if #terms == 0 then return false end

	local path = ""
	pcall(function() path = remote:GetFullName():lower() end)
	local name = ""
	pcall(function() name = remote.Name:lower() end)

	for _, term in ipairs(terms) do
		if name:find(term, 1, true) or path:find(term, 1, true) then
			return true
		end
	end
	return false
end

ST.invOf = function(char)
	if not char then return nil end
	return char:FindFirstChild("Inventory") or char:FindFirstChild("Inv")
end

ST.WEAPON_RANK = { "hacker", "sword", "katana", "blade", "scythe", "axe", "knife" }

-- Finds something edible in the slot inventory and uses it. Same shape as
-- equipBest: names are a box because a game's food is its own business, and
-- ChangeSlot is asked rather than SelectedSlot poked.
ST.useFood = function(ch, hum)
	if not ch or not hum then return false end

	local inv = ST.invOf(ch)
	local selected = ch:FindFirstChild("SelectedSlot")
	if not inv then return false end

	local terms = {}
	for raw in (MISC.eatNames or ""):lower():gmatch("[^,]+") do
		local t = raw:gsub("^%s+", ""):gsub("%s+$", "")
		if t ~= "" then terms[#terms + 1] = t end
	end
	if #terms == 0 then return false end

	local foodSlot
	for _, slotVal in ipairs(inv:GetChildren()) do
		local n = tonumber(slotVal.Name:match("^Slot(%d+)$"))
		if n and n < 100 and slotVal:IsA("StringValue") then
			local ok, decoded = pcall(function()
				return SERV.HttpService:JSONDecode(slotVal.Value)
			end)
			if ok and type(decoded) == "table" and decoded.name then
				local lower = tostring(decoded.name):lower()
				for _, term in ipairs(terms) do
					if lower:find(term, 1, true) then foodSlot = n break end
				end
			end
		end
		if foodSlot then break end
	end

	if not foodSlot then return false end

	-- Switch to it, then use it. Both go through the game's own remotes where
	-- they exist, since a local edit is not something the server acts on.
	local changeSlot = ST.findRemote("ChangeSlot")
	if changeSlot and changeSlot:IsA("RemoteFunction") then
		pcall(function() changeSlot:InvokeServer(foodSlot) end)
	elseif selected then
		pcall(function() selected.Value = foodSlot end)
	end

	task.wait(0.15)
	local tool = ch:FindFirstChildOfClass("Tool")
	if tool then pcall(function() tool:Activate() end) end

	local consume = ST.findRemote("ConsumeItem")
	if consume then
		pcall(function()
			if consume:IsA("RemoteFunction") then
				consume:InvokeServer(foodSlot)
			else
				consume:FireServer(foodSlot)
			end
		end)
	end
	return true
end

ST.equipBest = function(ch, hum)
	if not ch or not hum then return false end

	local function rankOf(name)
		local lower = tostring(name):lower()
		for i, term in ipairs(ST.WEAPON_RANK) do
			if lower:find(term, 1, true) then return i end
		end
		return nil
	end

	-- 1. Backpack tools
	local pack = player:FindFirstChildOfClass("Backpack")
	if pack then
		local best, bestRank, fallback
		for _, item in ipairs(pack:GetChildren()) do
			if item:IsA("Tool") then
				fallback = fallback or item
				local r = rankOf(item.Name)
				if r and (not bestRank or r < bestRank) then best, bestRank = item, r end
			end
		end
		local chosen = best or fallback
		if chosen then
			local ok = pcall(function() hum:EquipTool(chosen) end)
			if ok and ch:FindFirstChildOfClass("Tool") then return true end
		end
	end

	-- 2. Slot JSON, pointed at by SelectedSlot
	local inv = ST.invOf(ch)
	local selected = ch:FindFirstChild("SelectedSlot")
	if not inv or not selected then return false end

	local bestSlot, bestRank
	for _, slotVal in ipairs(inv:GetChildren()) do
		-- Hotbar slots only: 100-103 are armour and cannot be swung
		local n = tonumber(slotVal.Name:match("^Slot(%d+)$"))
		if n and n < 100 and slotVal:IsA("StringValue") then
			local ok, decoded = pcall(function()
				return SERV.HttpService:JSONDecode(slotVal.Value)
			end)
			if ok and type(decoded) == "table" and decoded.name then
				local r = rankOf(decoded.name)
				if r and (not bestRank or r < bestRank) then bestSlot, bestRank = n, r end
			end
		end
	end

	if not bestSlot then return false end
	if selected.Value == bestSlot then return true end

	-- ChangeSlot is a RemoteFunction the game exposes for exactly this, so ask
	-- properly rather than writing the IntValue and hoping something reads it
	-- back. A request the server accepts beats a local edit it never sees.
	local changeSlot = ST.findRemote("ChangeSlot")
	if changeSlot and changeSlot:IsA("RemoteFunction") then
		local ok = pcall(function() changeSlot:InvokeServer(bestSlot) end)
		if ok then return true end
	end

	-- No remote, or it refused: fall back to the local write, which holds only
	-- if the game's own LocalScript reads it back
	local ok = pcall(function() selected.Value = bestSlot end)
	return ok
end

-- ==========================================
-- REMOTE SPY & REPLAY
-- ==========================================
-- Records every remote the game fires, with its arguments, and can fire any of
-- them again. Nothing is ever blocked or altered on the way through -- the
-- game behaves exactly as it would with this off.
--
-- Replaying the game's own call with the game's own arguments is what makes
-- this general: nothing has to be reverse engineered, because the client
-- already knew how to ask. Two of the same call in one frame is the same race
-- two players produce by clicking together.
RSPY.record = function(remote, method, packed)
	if typeof(remote) ~= "Instance" then return end

	local entry = {
		remote = remote,
		method = method,
		args = packed,
		n = packed.n or #packed,
		at = os.clock(),
		name = remote.Name,
	}

	-- Newest first, capped: this fires as often as the game talks to the
	-- server, and an uncapped log is a memory leak with a nice view
	table.insert(RSPY.log, 1, entry)
	while #RSPY.log > RSPY.max do table.remove(RSPY.log) end
	RSPY.last = entry
end

-- The most recent recorded call for a given remote name. "Whatever fired last"
-- is whatever the game happened to chatter about a moment ago -- movement,
-- biome checks -- and almost never the one you want.
function ST.rspyFind(name)
	for _, e in ipairs(RSPY.log) do
		if e.name == name then return e end
	end
	return nil
end

-- Fires a recorded call again. Same frame by default: a gap of zero is what
-- reproduces the race, and anything above it is for games that reject bursts.
local function rspyReplay(entry, times, gap)
	entry = entry or RSPY.last
	if not entry then
		FN.toast("Remote spy: nothing recorded yet")
		return
	end
	if not entry.remote or not entry.remote.Parent then
		FN.toast("That remote is gone")
		return
	end

	local sent = 0
	for i = 1, math.clamp(times or 2, 1, 20) do
		-- Each call in its own thread. This is the whole trick with a
		-- RemoteFunction: InvokeServer yields until the server answers, so
		-- spawning them means both are in flight at once rather than one
		-- politely waiting for the other to come back.
		task.spawn(function()
			pcall(function()
				if entry.method == "InvokeServer" then
					local answer = entry.remote:InvokeServer(table.unpack(entry.args, 1, entry.n))
					-- Worth surfacing: a server that has already been told to
					-- hand the item over usually answers the second call
					-- differently, and that difference is the whole test
					if answer ~= nil then
						FN.toast("answer: " .. tostring(answer):sub(1, 24))
					end
				else
					entry.remote:FireServer(table.unpack(entry.args, 1, entry.n))
				end
			end)
		end)
		sent = sent + 1
		if gap and gap > 0 then task.wait(gap) end
	end

	RSPY.fired = RSPY.fired + sent
	FN.toast("Fired " .. entry.name .. " x" .. sent)
end

-- Remote spy, second implementation: hookfunction instead of __namecall.
--
-- Xeno has no hookmetamethod, so the version above cannot install there. It
-- does have hookfunction and newcclosure, which reach the same calls by a
-- different door: FireServer and InvokeServer are single C functions shared by
-- every remote in the game, so hooking the one taken off a throwaway instance
-- hooks all of them at once.
--
-- newcclosure is what makes the replacement acceptable. The originals are
-- native code; a bare Lua function in their place is both frequently rejected
-- by the hook itself and trivially spotted -- iscclosure on something that
-- should be built in is about the cheapest check an anti-cheat can run.
local function installRemoteSpy()
	if RSPY.hooked then return true end

	local ok = pcall(function()
		if type(hookfunction) ~= "function" or type(newcclosure) ~= "function" then
			error("executor has no hookfunction/newcclosure")
		end

		-- Throwaway instances, purely to get at the methods. They are never
		-- parented and never used for anything else.
		local sampleEvent = Instance.new("RemoteEvent")
		local sampleFunc = Instance.new("RemoteFunction")

		local oldFire
		oldFire = hookfunction(sampleEvent.FireServer, newcclosure(function(self, ...)
			-- checkcaller keeps our own replays out of the log. Without it,
			-- firing a recorded call records it again, and the log fills with
			-- echoes of itself.
			if not checkcaller() then
				if RSPY.on then
					local packed = table.pack(...)
					pcall(RSPY.record, self, "FireServer", packed)
				end

				-- Dropped, not altered: a report that never leaves cannot be
				-- argued with. Only remotes whose name matches the filter --
				-- blocking everything would break the game instantly, since
				-- movement, damage and inventory all travel this way.
				if AAC.blockRemotes and ST.aacBlocks(self) then
					AAC.dropped = AAC.dropped + 1
					return nil
				end
			end
			return oldFire(self, ...)
		end))

		local oldInvoke
		oldInvoke = hookfunction(sampleFunc.InvokeServer, newcclosure(function(self, ...)
			if not checkcaller() and AAC.blockRemotes and ST.aacBlocks(self) then
				AAC.dropped = AAC.dropped + 1
				-- A RemoteFunction expects an answer, and returning nothing is
				-- a valid one. Yielding forever here would hang the caller,
				-- which on the game's own code path means hanging the game.
				return nil
			end

			if RSPY.on and not checkcaller() then
				local packed = table.pack(...)
				pcall(RSPY.record, self, "InvokeServer", packed)
				-- The answer is the useful half of a RemoteFunction, so it is
				-- captured and then passed back untouched
				local res = table.pack(oldInvoke(self, ...))
				if RSPY.last then RSPY.last.ret = res end
				return table.unpack(res, 1, res.n)
			end
			return oldInvoke(self, ...)
		end))
	end)

	RSPY.hooked = ok
	return ok
end

-- ==========================================
-- EXPLOIT DETECTOR
-- ==========================================
-- Runs a few times a second per player. Three signals, all of them things a
-- normal character never does for long:
--
--   SPEED     covering ground faster than the game's own walkspeed allows
--   TELEPORT  moving further in one sample than any speed could explain
--   FLY       no floor underneath, for seconds, without falling
--
-- Strikes accumulate and decay. One bad sample is lag; a dozen is a pattern.
local function stepDetect()
	local now = os.clock()

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local char = other.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")

			if root and hum and hum.Health > 0 then
				local mark = DET.watch[other]
				if not mark then
					mark = { pos = root.Position, at = now, strikes = 0, air = 0, why = "" }
					DET.watch[other] = mark
				end

				local dt = now - mark.at
				if dt > 0.05 then
					local moved = (root.Position - mark.pos).Magnitude
					local speed = moved / dt

					-- Their own WalkSpeed is the yardstick where it can be read:
					-- a game that hands out speed boosts would otherwise flag
					-- everyone who picked one up. Doubled, plus headroom, so
					-- ordinary lag spikes do not count.
					local allowed = math.max(DET.speedCap, (hum.WalkSpeed or 16) * 2 + 20)

					if moved > DET.tpJump then
						mark.strikes = mark.strikes + 2
						mark.why = "teleport"
					elseif speed > allowed then
						mark.strikes = mark.strikes + 1
						mark.why = "speed " .. math.floor(speed)
					else
						-- Decay. Without it a long session flags everyone
						-- eventually, because lag never stops happening.
						mark.strikes = math.max(0, mark.strikes - 0.5)
					end

					-- Airborne with nothing underneath. FloorMaterial alone is
					-- not enough -- jumping reads as Air too -- so this also
					-- checks the height is not falling.
					local params = ST.rayDetect
					if not params then
						params = RaycastParams.new()
						params.FilterType = Enum.RaycastFilterType.Exclude
						ST.rayDetect = params
					end
					params.FilterDescendantsInstances = { char, player.Character }
					local below = Workspace:Raycast(root.Position, Vector3.new(0, -12, 0), params)

					local rising = (root.Position.Y - mark.pos.Y) > -0.5
					if not below and rising then
						mark.air = mark.air + dt
						if mark.air > DET.flyFor then
							mark.strikes = mark.strikes + 1
							mark.why = string.format("airborne %.1fs", mark.air)
						end
					else
						mark.air = 0
					end

					mark.pos = root.Position
					mark.at = now

					-- Decayed back to nothing: they have behaved for long enough
					-- that the flag is stale. Without this a single lag spike
					-- marks someone permanently -- and with Auto Attack on,
					-- permanently marks them for attack.
					if mark.strikes <= 0 and DET.flagged[other] then
						DET.flagged[other] = nil
						DET.count = math.max(0, DET.count - 1)
					end

					if mark.strikes >= DET.strikesNeeded and not DET.flagged[other] then
						DET.flagged[other] = mark.why
						DET.count = DET.count + 1
						FN.toast("FLAGGED " .. other.Name .. " -- " .. mark.why)

						-- Straight onto them. Deliberately only when the toggle
						-- is on: a false positive that starts an attack on an
						-- innocent player is worse than a missed cheater.
						if DET.autoKill and not KILL.seatOn then
							FN.killSeatStart(other)
						end
					end
				end
			else
				-- Dead or unloaded: drop the sample so a respawn across the map
				-- does not read as a teleport
				DET.watch[other] = nil
			end
		end
	end

	-- Clone spam. A player with copies of themselves in the world is not a
	-- movement anomaly at all -- it is the clearest signal here, because no
	-- normal game gives one account several bodies. Counted by name, since a
	-- clone is a copy of a character and carries the original's name.
	do
		local byName = {}
		for _, entry in ipairs(ST.charList()) do
			local n = entry.model.Name
			byName[n] = (byName[n] or 0) + 1
		end

		DET.clones = 0
		for n, count in pairs(byName) do
			-- More than one body with a name means at least one is a copy. Two
			-- is worth noting; a crowd of them is what the screenshot shows.
			if count > 1 then
				DET.clones = DET.clones + (count - 1)
				local owner
				for _, p in ipairs(Players:GetPlayers()) do
					if p.Name == n or p.DisplayName == n then owner = p break end
				end
				if owner and not DET.flagged[owner] then
					DET.flagged[owner] = count .. " clones"
					DET.count = DET.count + 1
					FN.toast("FLAGGED " .. owner.Name .. " -- " .. count .. " bodies")
					if DET.autoKill and not KILL.seatOn then
						FN.killSeatStart(owner)
					end
				end
			end
		end
	end

	-- Players who left
	for other in pairs(DET.watch) do
		if other.Parent == nil then DET.watch[other] = nil end
	end
	for other in pairs(DET.flagged) do
		if other.Parent == nil then DET.flagged[other] = nil end
	end
end

-- ==========================================
-- CHEST AUTO-HOLD
-- ==========================================
-- Right mouse is sent through VirtualInputManager, which produces the same
-- input events the game's own handlers listen for. The cursor is walked onto
-- the chest every frame as well: a held button means nothing if the pointer
-- has drifted off what it is meant to be held on, and chests do not always
-- stay still.
local function chestRelease()
	if not CHEST.holding then return end
	CHEST.holding = false
	pcall(function()
		local vim = game:GetService("VirtualInputManager")
		vim:SendMouseButtonEvent(0, 0, 1, false, game, 0)
	end)
	if VirtualUser then
		pcall(function() VirtualUser:Button2Up(Vector2.new(0, 0), Workspace.CurrentCamera.CFrame) end)
	end
end

local function chestClear(why)
	chestRelease()
	if CHEST.adorn then
		pcall(function() CHEST.adorn:Destroy() end)
		CHEST.adorn = nil
	end
	CHEST.target = nil
	CHEST.picking = false
	if why then FN.toast("Chest: " .. why) end
	FN.updateUI()
end

-- Marks the claimed chest. A box on the thing itself rather than a note in the
-- menu: the menu is usually hidden, and the question you actually have while
-- playing is "is it still on the right one".
local function chestClaim(part)
	if not part or not part:IsA("BasePart") then return false end

	chestClear()
	CHEST.target = part
	CHEST.broke = 0

	pcall(function()
		local a = Instance.new("BoxHandleAdornment")
		a.Name = "ChestClaim" .. uiName
		a.Adornee = part
		a.AlwaysOnTop = true
		a.ZIndex = 6
		a.Size = part.Size + Vector3.new(0.3, 0.3, 0.3)
		a.Transparency = 0.5
		a.Color3 = Color3.fromRGB(255, 200, 60)
		a.Parent = Workspace
		CHEST.adorn = a
	end)

	CHEST.picking = false
	FN.toast("Chest claimed -- holding")
	FN.updateUI()
	return true
end

-- Runs every frame while a chest is claimed.
local function stepChest()
	if not CHEST.on then
		if CHEST.holding then chestRelease() end
		return
	end
	if not CHEST.target then return end

	-- Gone: destroyed, or streamed out of the chunk. Either way there is
	-- nothing left to hold the button on, and holding it into empty air is how
	-- you end up breaking whatever you walk past next.
	if not CHEST.target.Parent then
		CHEST.broke = CHEST.broke + 1
		chestClear("BOOM -- broke it")
		return
	end

	local cam = Workspace.CurrentCamera
	local ch = player.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	if not cam or not root then return end

	-- Out of reach: hold, but stop pretending. Most games ignore a click on
	-- something 200 studs away, so this saves the input rather than spending it.
	if (CHEST.target.Position - root.Position).Magnitude > 60 then
		chestRelease()
		return
	end

	local screenPos, onScreen = cam:WorldToViewportPoint(CHEST.target.Position)
	if not onScreen then
		chestRelease()
		return
	end

	pcall(function()
		local vim = game:GetService("VirtualInputManager")
		-- Cursor onto the chest first, then the button. Order matters: a button
		-- down at the old cursor position clicks whatever was there.
		vim:SendMouseMoveEvent(screenPos.X, screenPos.Y, game)
		if not CHEST.holding then
			CHEST.holding = true
			vim:SendMouseButtonEvent(screenPos.X, screenPos.Y, 1, true, game, 0)
		end
	end)

	-- Some games act on press rather than hold, so the press is re-sent on a
	-- slow timer. Cheap, and it covers both designs without needing to know
	-- which one this is.
	if os.clock() >= (CHEST.at or 0) then
		CHEST.at = os.clock() + 0.35
		pcall(function()
			local vim = game:GetService("VirtualInputManager")
			vim:SendMouseButtonEvent(screenPos.X, screenPos.Y, 1, false, game, 0)
			vim:SendMouseButtonEvent(screenPos.X, screenPos.Y, 1, true, game, 0)
		end)
		if VirtualUser then
			pcall(function()
				VirtualUser:Button2Down(Vector2.new(0, 0), cam.CFrame)
			end)
		end
	end
end

-- Kill all. Teleports to a perch, then works through every player in turn:
-- point at them, swing, move on.
--
-- The perch is the reason it is a sweep and not a chase. From 50 studs up there
-- is line of sight to most of a map, which is what a click or ray weapon needs.
-- A touch weapon still needs contact, so touches are fired as well -- they land
-- only when someone is close, and cost nothing when they are not.
--
-- Written as a spawned loop with a cancel flag rather than a chain of waits, so
-- pressing the button again stops it immediately instead of at the end of
-- whatever sleep it happens to be sitting in.
local function killAll()
	if KILL.allOn then
		KILL.allOn = false
		FN.toast("Kill all: stopped")
		return
	end

	local ch = player.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then
		FN.toast("Kill all: no character")
		return
	end

	KILL.allOn = true
	KILL.allDone = 0

	task.spawn(function()
		-- Where you were, so it can put you back afterwards
		local home = hrp.CFrame

		-- Straight up from where you are standing, not to a fixed point in the
		-- world: a hardcoded coordinate is only useful if the map happens to be
		-- built around the origin, and drops you into empty sky when it is not.
		if KILL.allMode == "PERCH" then
			safeTeleport(hrp.Position + Vector3.new(0, KILL.allHeight, 0))
			task.wait(0.3)
		end

		ST.equipBest(ch, hum)

		-- Characters, so clones are swept too, filtered by the same Aim At scope
		-- the assist uses. Set that to CLONES and this becomes a clone sweep
		-- without needing a mode of its own.
		for _, sweepEntry in ipairs(ST.charList()) do
			if not KILL.allOn then break end

			local other, tchar, thum = sweepEntry.plr, sweepEntry.model, sweepEntry.hum
			local isClone = (other == nil)
			-- cfg, not AIM: this function is called with AIM or with SILENT, and
			-- reading AIM here meant silent aim ignored its own scope and
			-- borrowed the assist's. They are kept in sync by the toggle, so
			-- nothing looked wrong -- until one of them was loaded from a
			-- config written before the other existed.
			local inScope =
				(cfg.scope == "ALL")
				or (cfg.scope == "PLAYERS" and not isClone)
				or (cfg.scope == "CLONES" and isClone)

			if inScope then
				local troot = tchar and tchar:FindFirstChild("HumanoidRootPart")

				-- Skip the dead and, if the aim filters say so, your own side.
				-- Sharing that setting means one place decides who counts.
				-- A clone has no team, so the check cannot apply to it.
				-- Same rule as the aim, from the same setting
			local sameTeam = other and other.Team and player.Team
					and other.Team == player.Team
			local wrongSide = (AIM.teamMode == "ENEMIES" and sameTeam)
					or (AIM.teamMode == "TEAM" and not sameTeam)

				if troot and thum and thum.Health > 0 and not wrongSide then
					KILL.allName = (other and other.Name or tchar.Name)
						.. (isClone and " [clone]" or "")
					FN.updateUI()

					-- VISIT goes to them. Behind and slightly above, the same
					-- placement the seat attack uses, so a contact weapon is
					-- actually in range -- which from a perch it never is.
					if KILL.allMode == "VISIT" then
						local spot = (troot.CFrame * CFrame.new(0, 0.5, 2.5)).Position
						safeTeleport(spot)
						task.wait(0.15)
					end

					local cam = Workspace.CurrentCamera
					local tool = ch:FindFirstChildOfClass("Tool")
					local handle = tool and (tool:FindFirstChild("Handle")
						or tool:FindFirstChildWhichIsA("BasePart"))

					for _ = 1, math.clamp(KILL.allClicks or 6, 1, 30) do
						if not KILL.allOn then break end
						if not troot.Parent or thum.Health <= 0 then break end

						-- Camera written directly rather than through the aim
						-- assist: this is a scripted sweep, so there is nothing
						-- to be smooth about and no player input to fight
						if cam then
							pcall(function()
								cam.CFrame = CFrame.lookAt(cam.CFrame.Position, troot.Position)
							end)
						end

						if tool then pcall(function() tool:Activate() end) end
						if VirtualUser and cam then
							pcall(function()
								VirtualUser:Button1Down(Vector2.new(0, 0), cam.CFrame)
								VirtualUser:Button1Up(Vector2.new(0, 0), cam.CFrame)
							end)
						end

						-- Contact weapons: only lands if you are close, which
						-- from a perch usually means it does nothing. Left in
						-- because it is free and some maps are small.
						if handle and type(firetouchinterest) == "function" then
							for _, part in ipairs(ST.hitParts(tchar)) do
								pcall(function()
									firetouchinterest(handle, part, 0)
									firetouchinterest(handle, part, 1)
								end)
							end
						end

						task.wait(0.12)
					end

					KILL.allDone = KILL.allDone + 1
				end
			end
		end

		-- Back where you started, unless it was stopped early -- being dropped
		-- somewhere unexpected after cancelling is worse than staying put.
		-- STAY never moved, so there is nothing to undo.
		if KILL.allOn then
			task.wait(0.2)
			if KILL.allMode ~= "STAY" then safeTeleport(home.Position) end
			FN.toast("Kill all: swept " .. KILL.allDone .. " player(s)")
		end

		KILL.allOn = false
		KILL.allName = ""
		FN.updateUI()
	end)
end

-- ==========================================
-- SEAT ATTACK
-- ==========================================
-- An anchored Seat that follows a target every frame, with you sitting in it.
--
-- Why a seat rather than a weld: nothing is attached to them, so there is no
-- joint for a game to strip and nothing that needs their character to accept
-- it. The seat is ours, in Workspace, and the only thing it touches is our own
-- humanoid. That is why this works in games where welding does not.
--
-- The other half is the facing. A seat's occupant faces wherever the seat
-- faces, so pointing the seat at the target means every swing is aimed at them
-- without anything having to move the camera.
local function killSeatStop(why, keepPlace)
	KILL.seatOn = false
	KILL.seatTarget = nil

	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if hum then
		-- Stand up first, then drop the seat: destroying it while seated can
		-- leave the humanoid stuck in the Seated state with nothing under it
		pcall(function()
			hum.Sit = false
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
	end

	if KILL.seatPart then
		pcall(function() KILL.seatPart:Destroy() end)
		KILL.seatPart = nil
	end

	-- Back where you started, if we remembered it. Skipped when this is a
	-- restart rather than a stop: the tidy-up at the top of killSeatStart used
	-- to schedule this, and it fired 0.2s later -- dragging you off the target
	-- you had just attached to.
	if keepPlace then KILL.seatBack = nil end
	if KILL.seatBack and ch then
		local back = KILL.seatBack
		KILL.seatBack = nil
		task.delay(0.2, function()
			pcall(function()
				local nowChar = player.Character
				local root = nowChar and nowChar:FindFirstChild("HumanoidRootPart")
				if root then
					markIntentionalTeleport()
					nowChar:PivotTo(back)
					root.AssemblyLinearVelocity = Vector3.zero
				end
			end)
		end)
	end

	if why then FN.toast("Seat attack: " .. why) end
	FN.updateUI()
end

-- forced: attack this player specifically, whatever the box says. The detector
-- passes the player it flagged; everything else leaves it nil and gets the
-- usual named-or-nearest behaviour.
function FN.killSeatStart(forced)
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hum or not root then
		FN.toast("Seat: no character")
		return
	end

	-- Named target if one is typed, nearest player otherwise: chasing whoever
	-- is closest is the common case and typing a name every time is friction
	local query = BOX.tpBox.Text:lower():gsub("%s+", "")
	local target, bestDist
	if forced and forced.Parent and forced.Character then target = forced end
	for _, p in ipairs(Players:GetPlayers()) do
		if target then break end
		-- seatSkip is the one you just asked to move on from; without it the
		-- "next player" button re-picks whoever is nearest, which is them
		if p ~= player and p ~= KILL.seatSkip and p.Character then
			local troot = p.Character:FindFirstChild("HumanoidRootPart")
			local thum = p.Character:FindFirstChildOfClass("Humanoid")
			if troot and thum and thum.Health > 0 then
				if query ~= "" then
					if p.Name:lower():sub(1, #query) == query
						or p.DisplayName:lower():sub(1, #query) == query then
						target = p
						break
					end
				else
					local d = (troot.Position - root.Position).Magnitude
					if not bestDist or d < bestDist then target, bestDist = p, d end
				end
			end
		end
	end

	if not target then
		FN.toast(query ~= "" and "Seat: no player matching that" or "Seat: nobody alive nearby")
		return
	end

	killSeatStop(nil, true)

	if KILL.attach == "CFRAME" then
		-- Nothing to create. The hold is a CFrame write each frame, so there is
		-- no part, no weld and nothing for the game to strip or notice.
		KILL.seatClass = "cframe"
		KILL.seatBack = root.CFrame
		KILL.seatTarget = target
		KILL.seatOn = true
		KILL.seatHits = 0
		FN.toast("Attacking " .. target.Name .. " (cframe)")
		FN.updateUI()
		return
	end

	-- Seat first, VehicleSeat second. Both seat an occupant and both drive the
	-- occupant's facing; a game that strips foreign seats usually filters one
	-- class by name and not the other, so the second is a real second chance
	-- rather than the same attempt twice.
	local made
	for _, className in ipairs({ "Seat", "VehicleSeat" }) do
		local ok = pcall(function()
			local seat = Instance.new(className)
			seat.Name = "KillSeat" .. uiName
			seat.Size = Vector3.new(2, 0.2, 2)
			seat.Transparency = 1
			seat.CanCollide = false
			seat.CanQuery = false
			seat.CanTouch = false
			seat.Anchored = true
			seat.CFrame = root.CFrame
			-- A VehicleSeat with a driver takes the controls; disabled so it
			-- cannot eat your movement input
			if className == "VehicleSeat" then seat.Disabled = false end
			seat.Parent = Workspace
			KILL.seatPart = seat
			seat:Sit(hum)
		end)

		-- Sat down is the test that matters, not "the instance was created":
		-- a game can allow the part and still refuse the sit
		task.wait(0.05)
		if ok and KILL.seatPart and KILL.seatPart.Parent and hum.Sit then
			made = className
			break
		end

		if KILL.seatPart then
			pcall(function() KILL.seatPart:Destroy() end)
			KILL.seatPart = nil
		end
	end

	if not made then
		FN.toast("Seat: refused -- neither Seat nor VehicleSeat took")
		killSeatStop(nil, true)
		return
	end
	KILL.seatClass = made

	KILL.seatBack = root.CFrame
	KILL.seatTarget = target
	KILL.seatOn = true
	KILL.seatHits = 0
	FN.toast("Seat attack on " .. target.Name .. " (" .. made .. ")")
	FN.updateUI()
end

-- Runs every frame while active: keep the seat on them, keep facing them, and
-- swing on a timer.
local function stepKillSeat()
	if not KILL.seatOn then return end

	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local seat = KILL.seatPart
	local target = KILL.seatTarget

	-- The seat only has to exist in SEAT mode. CFRAME mode holds you there by
	-- writing your own root, which is the point: nothing is attached at all.
	if not hum or not target or target.Parent == nil
		or (KILL.attach == "SEAT" and (not seat or not seat.Parent)) then
		killSeatStop("lost the target")
		return
	end

	-- Your health, checked before theirs. Everything else in this function
	-- asks whether the TARGET is still worth holding; nothing asked whether
	-- holding on was still survivable for you.
	if MISC.weldFlee and hum.MaxHealth > 0
		and (hum.Health / hum.MaxHealth * 100) < MISC.weldFleeHp then
		-- A real stop, so it puts you back where you attached from rather than
		-- dropping you on their head at low health
		killSeatStop("your health is low -- let go")
		return
	end

	local tchar = target.Character
	local troot = tchar and tchar:FindFirstChild("HumanoidRootPart")
	local thum = tchar and tchar:FindFirstChildOfClass("Humanoid")

	-- They died: this is the whole point of stopping automatically. Standing on
	-- a corpse swinging is both pointless and the most obvious thing on screen.
	if thum and thum.Health <= 0 then
		if KILL.chain then
			-- Straight onto the next one rather than dropping to the floor.
			-- The restart keeps your position: only a real stop returns you,
			-- and mid-chain is not a real stop.
			KILL.seatTarget = nil
			killSeatStop(nil, true)
			FN.toast("Target down -- next")
			task.defer(FN.killSeatStart)
		else
			killSeatStop("target down")
		end
		return
	end
	if not troot then
		killSeatStop("their character is gone")
		return
	end

	KILL.seatHp = thum and math.floor(thum.Health) or 0

	-- Your own health. Sitting on someone while they kill you is the failure
	-- mode this whole thing has: you cannot see your own bar while watching
	-- theirs, and the attack does not stop just because it is going badly.
	if KILL.bail then
		local myHum = ch:FindFirstChildOfClass("Humanoid")
		if myHum and myHum.MaxHealth > 0
			and (myHum.Health / myHum.MaxHealth) < KILL.bailAt then
			killSeatStop("bailed -- your health is low")
			return
		end
	end

	-- Where to sit. Behind is the default because it is out of their view and
	-- still in range; above is for games that block contact at ground level;
	-- inside is maximum reach and maximum obviousness.
	local offset
	if KILL.seatMode == "ABOVE" then
		offset = CFrame.new(0, KILL.seatDist + 2, 0)
	elseif KILL.seatMode == "INSIDE" then
		offset = CFrame.new(0, 0, 0)
	else
		-- +Z is backwards in Roblox, so this sits on their back
		offset = CFrame.new(0, 0, KILL.seatDist)
	end

	local spot = (troot.CFrame * offset).Position
	local want
	if KILL.seatMode == "INSIDE" then
		want = troot.CFrame
	else
		want = CFrame.lookAt(spot, troot.Position)
	end

	if KILL.attach == "CFRAME" then
		-- Write our own root, every frame. This is the mode that actually holds
		-- up on the server: your client owns your character's physics, so a
		-- CFrame you write here is replicated as your real position.
		--
		-- A seat cannot do that. Sitting welds your character into an assembly
		-- anchored to a part the server has never seen, and an anchored
		-- assembly is not simulated by its owner -- so the client shows you on
		-- top of them while the server still has you where you were standing.
		-- That is the desync: every swing then misses, because the server is
		-- swinging from the old position.
		local myRoot = ch:FindFirstChild("HumanoidRootPart")
		if myRoot then
			pcall(function()
				myRoot.CFrame = want
				-- Physics would otherwise fight the write and fling you the
				-- moment it stops
				myRoot.AssemblyLinearVelocity = Vector3.zero
				myRoot.AssemblyAngularVelocity = Vector3.zero
			end)
			markIntentionalTeleport()
		end
	else
		pcall(function() seat.CFrame = want end)

		-- Games knock you out of seats -- a respawn, a state reset, their own
		-- anti exploit. Re-sitting every frame it is not seated costs nothing
		-- and makes the attach stick.
		if not hum.Sit then
			pcall(function() seat:Sit(hum) end)
		end
	end

	if os.clock() >= (KILL.seatAt or 0) then
		-- Perfectly even clicks are a signature no human produces. The jitter is
		-- small enough not to cost you swings and uneven enough not to look
		-- like a metronome.
		local gap = 1 / math.clamp(KILL.seatCps or 10, 1, 30)
		if KILL.jitter then gap = gap * (0.8 + math.random() * 0.4) end
		KILL.seatAt = os.clock() + gap
		local tool = ch:FindFirstChildOfClass("Tool")
		if not tool then ST.equipBest(ch, hum) end
		tool = ch:FindFirstChildOfClass("Tool")

		if tool then
			pcall(function() tool:Activate() end)
			-- Touch-based weapons need contact, and the handle is right on them
			local handle = tool:FindFirstChild("Handle")
				or tool:FindFirstChildWhichIsA("BasePart")
			if handle and type(firetouchinterest) == "function" then
				for _, part in ipairs(ST.hitParts(tchar)) do
					pcall(function()
						firetouchinterest(handle, part, 0)
						firetouchinterest(handle, part, 1)
					end)
				end
			end
		end
		if VirtualUser then
			pcall(function()
				VirtualUser:Button1Down(Vector2.new(0, 0), Workspace.CurrentCamera.CFrame)
				VirtualUser:Button1Up(Vector2.new(0, 0), Workspace.CurrentCamera.CFrame)
			end)
		end
		KILL.seatHits = KILL.seatHits + 1
	end
end

local function stepKill()
	if not KILL.on then return end

	local ch = player.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	-- The TP spam task keeps this fresh; falling back to a resolve covers the
	-- first frame, before that task has run once
	local target = ST.cachedTargetPart
	if not target or not target.Parent then
		target = resolveTargetPart()
	end
	if not target then
		FN.toast("Kill: no target -- put a name in the box")
		KILL.on = false
		ON.tpSpamEnabled = false
		FN.updateUI()
		return
	end

	local targetModel = target:FindFirstAncestorOfClass("Model")
	local targetHum = targetModel and targetModel:FindFirstChildOfClass("Humanoid")

	-- They died: the job is done. TP spam does its own return-to-start, so this
	-- only has to stand the rest of the combo down.
	if targetHum and targetHum.Health <= 0 then
		KILL.on = false
		MISC.autoClick = KILL.hadClicker or false
		MISC.weldBack = false
		if ON.weldEnabled then FN.disableWeld() end
		FN.toast("Kill: target down")
		FN.updateUI()
		return
	end

	if KILL.stage == 1 then
		-- Approach. TP spam is what actually moves you; this just watches the
		-- distance and hands over once you are on top of them.
		if not ON.tpSpamEnabled then
			ON.tpSpamEnabled = true
			ST.tpSpamReturn = hrp.CFrame
			ST.cachedTargetPart = nil
			ST.lastTargetSearchTime = 0
		end

		local close = (target.Position - hrp.Position).Magnitude < 10
		-- Timeout as well as a distance check: a target behind a wall the spam
		-- cannot reach would otherwise leave the combo stuck in stage one
		if close or os.clock() > KILL.at + 5 then
			ON.tpSpamEnabled = false
			KILL.stage = 2
			KILL.at = os.clock()
		end

	elseif KILL.stage == 2 then
		-- CFRAME attach skips the weld entirely and goes straight to the seat
		-- follow, which holds position by writing our own root.
		--
		-- The weld has the same replication problem the seat did, for the same
		-- reason: it joins your character to a part owned by THEIR client, so
		-- your assembly stops being yours to simulate. Locally you are stuck to
		-- them; on the server you are still standing where you welded. That is
		-- why the combo sometimes did nothing -- every swing was thrown from a
		-- position the server had already moved on from.
		if KILL.attach == "CFRAME" then
			KILL.stage = 3
			KILL.at = os.clock()
			if not KILL.seatOn then FN.killSeatStart(ST.cachedTargetPart
				and ST.cachedTargetPart:FindFirstAncestorOfClass("Model")
				and Players:GetPlayerFromCharacter(
					ST.cachedTargetPart:FindFirstAncestorOfClass("Model")) or nil) end
			return
		end

		-- Weld. Aimed at the torso specifically: welding to a head or a hand
		-- puts you somewhere useless, and the torso is the part every rig has.
		local torso = targetModel and (targetModel:FindFirstChild("UpperTorso")
			or targetModel:FindFirstChild("Torso"))
		-- Custom rig: fall back to whatever the shared resolver considers the
		-- body. An empty box here does not mean "no preference" -- it means the
		-- weld attaches to whichever part the target search happens to return.
		if not torso and targetModel then
			torso = ST.hitParts(targetModel)[1]
		end
		BOX.targetPartBox.Text = torso and torso.Name or ""
		ST.cachedTargetPart = nil

		MISC.weldBack = true
		pcall(function() FN.enableWeld() end)

		if ON.weldEnabled then
			KILL.stage = 3
			KILL.at = os.clock()
		elseif os.clock() > KILL.at + 3 then
			-- Some games strip foreign welds outright. Rather than retrying
			-- forever, carry on without it: being on top of them and clicking
			-- is most of the value anyway.
			FN.toast("Kill: weld refused, attacking anyway")
			KILL.stage = 3
			KILL.at = os.clock()
		end

	elseif KILL.stage == 3 then
		if not MISC.autoClick then MISC.autoClick = true end
		-- Weld dropped on its own (they teleported, or the game removed it):
		-- go back to chasing rather than clicking at nothing
		if not ON.weldEnabled and os.clock() > KILL.at + 1 then
			KILL.stage = 1
			KILL.at = os.clock()
			MISC.autoClick = false
		end
	end
end

-- Copy Position. setclipboard is executor-provided, so the coordinates are
-- toasted as well -- on a client without it you can still read them off.
local function copyPosition()
	local ch = player.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp then
		FN.toast("No character")
		return
	end
	local p = hrp.Position
	local text = string.format("%.1f, %.1f, %.1f", p.X, p.Y, p.Z)
	local copied = false
	pcall(function()
		if type(setclipboard) == "function" then
			setclipboard(text)
			copied = true
		end
	end)
	FN.toast(copied and ("Copied " .. text) or text)
end

local function tpVertical(amount)
	local ch = player.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	safeTeleport(hrp.Position + Vector3.new(0, amount, 0))
end

local function sitToggle()
	local character = player.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return end

	if ST.sitSeat then
		hum.Sit = false
		pcall(function() ST.sitSeat:Destroy() end)
		ST.sitSeat = nil
		return
	end

	-- Can't be laid down and sat at once; stand up first
	if ST.laying then
		ST.laying = false
		pcall(function()
			hum.PlatformStand = false
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
	end

	local ok = pcall(function()
		local seat = Instance.new("Seat")
		seat.Name = "SitSeat" .. uiName
		seat.Size = Vector3.new(2, 0.2, 2)
		seat.Transparency = 1
		seat.CanCollide = false
		-- Anchored so sitting holds position instead of sliding off
		seat.Anchored = true
		seat.CFrame = hrp.CFrame * CFrame.new(0, -1.6, 0)
		seat.Parent = Workspace
		ST.sitSeat = seat
		seat:Sit(hum)
	end)

	-- Games that block foreign seats: fall back to the plain state change
	if not ok or not ST.sitSeat then
		if ST.sitSeat then
			pcall(function() ST.sitSeat:Destroy() end)
			ST.sitSeat = nil
		end
		hum.Sit = not hum.Sit
	end
end

-- Shared cleanup: the seat is anchored in Workspace, so it has to be removed on
-- respawn, panic and close or it is left floating with nobody in it
local function clearSitSeat()
	if ST.sitSeat then
		pcall(function() ST.sitSeat:Destroy() end)
		ST.sitSeat = nil
	end
end

-- Lay down. There is no engine state for this the way there is for sitting, so
-- it is PlatformStand (which stops the humanoid standing itself back up) plus a
-- 90-degree pitch on the root.
local function layToggle()
	local character = player.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return end

	-- Weld and fly both drive PlatformStand themselves; laying would fight them
	-- and leave whichever loses in a state it never restores
	if ON.weldEnabled or ST.flying then return end

	if ST.laying then
		ST.laying = false
		pcall(function()
			hum.PlatformStand = false
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
	else
		-- Can't be sat and laid down at once
		if ST.sitSeat then
			hum.Sit = false
			clearSitSeat()
		end
		ST.laying = true
		pcall(function()
			hum.PlatformStand = true
			hrp.CFrame = hrp.CFrame * CFrame.Angles(math.rad(-90), 0, 0)
		end)
	end
	FN.updateUI()
end

-- Put the humanoid back on its feet; shared by panic, respawn and close
local function clearLaying()
	if not ST.laying then return end
	ST.laying = false
	local character = player.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	if hum then
		pcall(function()
			hum.PlatformStand = false
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
	end
end

local function resetCharacter()
	local character = player.Character
	if character then
		local hum = character:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.Health = 0
		else
			pcall(function() character:BreakJoints() end)
		end
	end
end

-- Reset, then come back to where you were. Clears whatever state the character
-- got stuck in without costing you the walk back.
local function resetAndReturn()
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then
		UI.resetReturnBtn.Text = "Reset & Return: no character"
		task.delay(2, function()
			if UI.resetReturnBtn.Parent then FN.updateUI() end
		end)
		return
	end

	local savedCFrame = hrp.CFrame

	-- Hook the respawn BEFORE dying, or a fast respawn fires before we listen
	player.CharacterAdded:Once(function(newChar)
		local newHrp = newChar:WaitForChild("HumanoidRootPart", 10)
		if not newHrp then return end
		-- Let the game finish placing the character at its spawn first,
		-- otherwise its own positioning lands after ours and wins
		task.wait(0.25)
		pcall(function()
			markIntentionalTeleport()
			newChar:PivotTo(savedCFrame)
			newHrp.AssemblyLinearVelocity = Vector3.zero
			newHrp.AssemblyAngularVelocity = Vector3.zero
		end)
	end)

	hum.Health = 0
end

--[[
	Coming back after a teleport.

	A teleport tears the whole Lua state down: server hop, rejoin, the game
	sending you to a lobby -- all of them land you in a fresh place with no
	menu. Executors expose queue_on_teleport for exactly this: hand it a string
	of code and it runs that code once, automatically, on the other side.

	The catch is that a running script cannot read its own source, so the code
	we queue has to fetch the menu from somewhere. Two somewheres, in order:

	  1. A loader URL -- queue a HttpGet of it. Survives updates to the script.
	  2. A file in the executor's workspace folder -- queue a readfile of it.

	Armed once at startup so a teleport the GAME starts is covered too, and
	re-armed right before each of our own teleports in case a setting changed.
--]]
function FN.queueFn()
	if type(queue_on_teleport) == "function" then return queue_on_teleport end
	if type(queueonteleport) == "function" then return queueonteleport end
	-- Older executors kept it behind their own table
	if type(syn) == "table" and type(syn.queue_on_teleport) == "function" then
		return syn.queue_on_teleport
	end
	if type(fluxus) == "table" and type(fluxus.queue_on_teleport) == "function" then
		return fluxus.queue_on_teleport
	end
	return nil
end

-- The code string to run on the other side, plus a word for where it came from
function FN.rejoinSource()
	local url = MISC.reexecUrl or ""
	if url ~= "" then
		return string.format("loadstring(game:HttpGet(%q))()", url), "loader URL"
	end
	local file = MISC.reexecFile or ""
	if file ~= "" and type(isfile) == "function" and type(readfile) == "function" then
		local ok, exists = pcall(isfile, file)
		if ok and exists then
			return string.format("loadstring(readfile(%q))()", file), "saved file"
		end
	end
	return nil, nil
end

--[[
	quiet: arming as a side effect of something else, so say nothing unless it
	matters. A failure to arm is worth one toast when you press the button and
	is pure noise when it happens before every teleport.
--]]
function FN.armRejoin(quiet)
	MISC.reexecWhy = nil
	if not MISC.reexec then
		MISC.reexecWhy = "off"
		return false
	end

	local q = FN.queueFn()
	if not q then
		MISC.reexecWhy = "executor has no queue_on_teleport"
		if not quiet then FN.toast("Re-run: this executor cannot queue scripts") end
		return false
	end

	local code, how = FN.rejoinSource()
	if not code then
		MISC.reexecWhy = "no source set"
		if not quiet then
			FN.toast("Re-run: set a loader URL, or save the script and name the file")
		end
		return false
	end

	local ok, err = pcall(q, code)
	if not ok then
		MISC.reexecWhy = "queue refused"
		if not quiet then FN.toast("Re-run: queue refused -- " .. tostring(err)) end
		return false
	end

	MISC.reexecWhy = how
	if not quiet then FN.toast("Re-run armed via " .. how) end
	return true
end

--[[
	A teleport that fails leaves you standing in the old server with nothing to
	show for it: TeleportInitFailed fires, nothing is listening, and the hop
	button just looks broken. Two things are worth doing about that.

	Say what happened. "Full" and "Flooded" are ordinary -- a server filled up
	between the listing and the join -- and knowing that is the difference
	between pressing the button again and assuming the feature is dead.

	Then try once more, by matchmaking rather than by the same instance. The
	instance is exactly the thing that just refused us, so retrying it is the
	one choice guaranteed not to work.
--]]
pcall(function()
	SERV.TeleportService.TeleportInitFailed:Connect(function(plr, result, message)
		if plr ~= player then return end

		local why = "unknown"
		pcall(function() why = result and result.Name or "unknown" end)
		FN.toast("Teleport failed: " .. why)
		warn("[ModMenu] teleport failed (" .. why .. "): " .. tostring(message))

		if not MISC.tpRetry then return end
		if tick() - (ST.tpRetryAt or 0) < 10 then
			-- One retry, not a loop: a place that refuses every teleport would
			-- otherwise have us hammering it until the game closes
			return
		end
		ST.tpRetryAt = tick()

		task.delay(2, function()
			FN.toast("Retrying by matchmaking")
			pcall(function()
				FN.armRejoin(true)

-- Destroying is the only warning we get before the menu is gone for good
FN.guardGui()

-- Watchlist names come from the config, so the first scan has to be after it
-- has loaded -- and it has to happen at all, because the common case is that
-- the person you are watching for was here before you were
FN.watchScan()

-- Reads the bookmark a break-out or a kick left behind. Does nothing at
-- all on an ordinary join: the file only exists if we wrote it on the way
-- out, and it expires after ten minutes.
FN.returnToSpot()
				SERV.TeleportService:Teleport(game.PlaceId, player)
			end)
		end)
	end)
end)

--[[
	Anti-Delete: putting the menu back after something destroys it.

	Two different failures wear the same face on screen.

	ORPHANED -- the ScreenGui is alive but its parent went nil. Recoverable:
	parent it back and the menu returns exactly as it was, every toggle intact.

	DESTROYED -- Destroy() ran. The Parent property is locked from then on, all
	the children are gone, and no amount of re-parenting brings it back. The
	only way to have a menu again is to build a new one, and the only thing that
	knows how to build one is the script itself.

	So a real rebuild re-runs the script, from the same loader URL or file the
	teleport re-run uses. That needs a source configured; without one there is
	nothing honest to do except say so, and point out that the keybinds are all
	still live -- fly, noclip, panic keep working with no menu on screen, which
	is why this went unnoticed long enough to be reported as "the GUI vanished".
--]]
function FN.guiAlive()
	local gui = DEC.screenGui
	if not gui then return false end
	local ok, parent = pcall(function() return gui.Parent end)
	if not ok then return false end
	return parent ~= nil
end

function FN.rebuildGui(reason)
	if MISC.closing then return end
	-- One rebuild at a time, and never in a loop: a script that fails on load
	-- would otherwise respawn itself forever
	if ST.rebuilding then return end
	if tick() - (ST.rebuiltAt or 0) < 8 then return end

	local code, how = FN.rejoinSource()
	if not code then
		if tick() - (ST.rebuildSaidAt or 0) > 15 then
			ST.rebuildSaidAt = tick()
			warn("[ModMenu] menu destroyed (" .. tostring(reason) .. ") and no "
				.. "source is set -- add a loader URL or filename under "
				.. "Come Back After Teleport to make this rebuildable")
		end
		return
	end

	ST.rebuilding = true
	ST.rebuiltAt = tick()

	task.spawn(function()
		-- The new copy has to come up before this one lets go, or a failure
		-- leaves you with no menu AND no connections
		local fn = loadstring(code)
		if not fn then
			ST.rebuilding = false
			warn("[ModMenu] rebuild source would not compile")
			return
		end

		local ok, err = pcall(fn)
		if not ok then
			ST.rebuilding = false
			warn("[ModMenu] rebuild failed: " .. tostring(err))
			return
		end

		-- New copy is up. Drop ours, or both drive the character at once.
		MISC.closing = true
		pcall(function() FN.teardown() end)
	end)
end

--[[
	The watchdog. AncestryChanged catches the orphan case the instant it
	happens; Destroying is the only warning we get for the other one, and it
	fires while the instance still exists, so the rebuild has to be deferred
	out of the signal.
--]]
function FN.guardGui()
	if ST.guiGuarded then return end
	ST.guiGuarded = true

	pcall(function()
		DEC.screenGui.Destroying:Connect(function()
			if MISC.closing or not MISC.antiDelete then return end
			task.defer(function() FN.rebuildGui("destroyed") end)
		end)
	end)
end

local function rejoinServer()
	FN.armRejoin(true)
	pcall(function()
		SERV.TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
	end)
end

-- Join a specific server by its Job ID -- the code Server Info copies, so
-- someone can hand you theirs and you land in the same instance.
local function joinByJobId()
	local id = BOX.jobIdBox.Text:gsub("%s+", "")
	if id == "" then
		FN.toast("Job ID: paste one first")
		return
	end
	if id == game.JobId then
		FN.toast("Already in that server")
		return
	end

	-- Teleport throws on a malformed or dead id, and an uncaught throw here
	-- would take the button handler down with it
	FN.armRejoin(true)
	local ok, err = pcall(function()
		SERV.TeleportService:TeleportToPlaceInstance(game.PlaceId, id, player)
	end)
	if not ok then
		FN.toast("Join failed: server may be full or gone")
		warn("[ModMenu] job id join failed: " .. tostring(err))
	end
end

