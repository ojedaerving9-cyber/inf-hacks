	One convention for both games, written down because getting it wrong is a
	whole evening: world units ARE tile units, and tile (x, y) covers the world
	rectangle [x-1, x] by [y-1, y]. So the tile holding a world coordinate w is
	floor(w) + 1, and a tile's pixel position is (index - 1) * TILE.

	Player boxes are stored as (centre x, top y) with an explicit width and
	height, so landing means putting the FEET on a surface, not the origin.
--]]
GAME.PW, GAME.PH = 0.8, 1.8

local function rectHit(ax, ay, aw, ah, bx, by, bw, bh)
	return ax < bx + bw and ax + aw > bx and ay < by + bh and ay + ah > by
end

-- ---------- 2D MINECRAFT ----------

function FN.mineSolid(x, y)
	-- Off the sides and below the bottom is solid, so you cannot walk out of
	-- the world; above the top is open, so jumping is not a headbutt
	if x < 1 or x > GAME.W or y > GAME.H then return true end
	if y < 1 then return false end
	local col = GAME.map and GAME.map[x]
	return (col and col[y] or 0) ~= 0
end

function FN.mineAt(wx, wy)
	return FN.mineSolid(math.floor(wx) + 1, math.floor(wy) + 1)
end

function FN.mineGen()
	GAME.map = {}
	-- math.noise gives a smooth hill line; the seed shift makes every new world
	-- different without needing a noise implementation of our own
	local seed = math.random() * 500
	for x = 1, GAME.W do
		GAME.map[x] = {}
		local n = math.noise(x * 0.12, seed) -- roughly -0.5 .. 0.5
		local ground = math.clamp(math.floor(GAME.H * 0.45 + n * 9), 4, GAME.H - 3)
		for y = 1, GAME.H do
			local b = 0
			if y == ground then
				b = 1
			elseif y > ground and y <= ground + 2 then
				b = 2
			elseif y > ground + 2 then
				b = 3
				-- Ores get rarer as they get deeper, which is the progression
				local r = math.random()
				local depth = y - ground
				if r < 0.05 then
					b = 6
				elseif r < 0.075 and depth > 3 then
					b = 7
				elseif r < 0.088 and depth > 5 then
					b = 8
				elseif r < 0.094 and depth > 7 then
					b = 9
				end
			end
			GAME.map[x][y] = b
		end

		-- A tree here and there, never at the edge where half of it is cut off
		if x > 2 and x < GAME.W - 2 and math.random() < 0.14 then
			for t = 1, 3 do
				if ground - t >= 1 then GAME.map[x][ground - t] = 4 end
			end
			for lx = -1, 1 do
				for ly = -5, -4 do
					local cx, cy = x + lx, ground + ly
					if cx >= 1 and cx <= GAME.W and cy >= 1 then
						GAME.map[cx][cy] = 5
					end
				end
			end
		end
	end

	GAME.inv = {}
	for i = 1, 10 do GAME.inv[i] = 0 end
	GAME.hold = 1
	GAME.mined = 0
	GAME.breaking = nil
	GAME.breakHits = 0
	GAME.msg = "New world"

	-- Stand on the surface of the middle column: feet on top of the first
	-- solid tile, which in world units is its upper edge
	local mid = math.floor(GAME.W / 2)
	local top = GAME.H
	for y = 1, GAME.H do
		if GAME.map[mid][y] ~= 0 then
			top = y
			break
		end
	end
	GAME.px = mid - 0.5
	GAME.py = (top - 1) - GAME.PH
	GAME.vx, GAME.vy = 0, 0
	GAME.onGround = true
end

function FN.mineStep(dt)
	local accel, maxSpeed, gravity, jump = 60, 9, 42, 14
	local w, h = GAME.PW, GAME.PH

	local left = GAME.keys[Enum.KeyCode.A] or GAME.keys[Enum.KeyCode.Left]
	local right = GAME.keys[Enum.KeyCode.D] or GAME.keys[Enum.KeyCode.Right]
	local up = GAME.keys[Enum.KeyCode.W] or GAME.keys[Enum.KeyCode.Space]
		or GAME.keys[Enum.KeyCode.Up]

	if left then GAME.vx = GAME.vx - accel * dt end
	if right then GAME.vx = GAME.vx + accel * dt end
	if not left and not right then
		-- Friction rather than a hard stop: a little slide reads as weight
		GAME.vx = GAME.vx * math.max(0, 1 - 12 * dt)
	end
	GAME.vx = math.clamp(GAME.vx, -maxSpeed, maxSpeed)

	if up and GAME.onGround then
		GAME.vy = -jump
		GAME.onGround = false
	end
	GAME.vy = math.min(GAME.vy + gravity * dt, 40)

	-- One axis at a time, or a diagonal move tunnels through a corner. Only the
	-- LEADING edge is tested: testing both sides makes a player who is already
	-- touching a wall unable to walk away from it.
	local nx = GAME.px + GAME.vx * dt
	local edgeX = (GAME.vx >= 0) and (nx + w * 0.5) or (nx - w * 0.5)
	local blockedX = false
	for _, sy in ipairs({ GAME.py + 0.05, GAME.py + h * 0.5, GAME.py + h - 0.05 }) do
		if FN.mineAt(edgeX, sy) then blockedX = true end
	end
	if blockedX then
		GAME.vx = 0
	else
		GAME.px = nx
	end

	local ny = GAME.py + GAME.vy * dt
	local edgeY = (GAME.vy >= 0) and (ny + h) or ny
	local blockedY = false
	for _, sx in ipairs({ GAME.px - w * 0.5 + 0.02, GAME.px, GAME.px + w * 0.5 - 0.02 }) do
		if FN.mineAt(sx, edgeY) then blockedY = true end
	end
	if blockedY then
		if GAME.vy >= 0 then
			-- Feet land exactly on the tile's upper edge rather than somewhere
			-- inside it, which is what stops the sink-into-the-floor bug
			GAME.py = math.floor(edgeY) - h
			GAME.onGround = true
		else
			GAME.py = math.floor(edgeY) + 1
		end
		GAME.vy = 0
	else
		GAME.py = ny
		GAME.onGround = false
	end

	if GAME.py > GAME.H + 4 then FN.mineGen() end
end

-- One click on a tile: break what is there, or place what you are holding.
-- Reach is checked here rather than at the button so every path shares it.
function FN.mineClick(x, y)
	local cx, cy = x - 0.5, y - 0.5
	local dx = cx - GAME.px
	local dy = cy - (GAME.py + GAME.PH * 0.5)
	if (dx * dx + dy * dy) > 30 then
		GAME.msg = "Too far away"
		return
	end

	local b = GAME.map[x][y]
	if b ~= 0 then
		-- Hardness: the same tile takes a few clicks, and switching targets
		-- resets progress so you cannot chip everything down at once
		if GAME.breaking ~= (x * 1000 + y) then
			GAME.breaking = x * 1000 + y
			GAME.breakHits = 0
		end
		GAME.breakHits = GAME.breakHits + 1
		if GAME.breakHits >= (GAME.blocks[b].hard or 1) then
			GAME.map[x][y] = 0
			GAME.inv[b] = (GAME.inv[b] or 0) + 1
			GAME.mined = GAME.mined + 1
			GAME.breaking = nil
			GAME.msg = "+1 " .. GAME.blocks[b].name
		else
			GAME.msg = GAME.blocks[b].name .. " "
				.. GAME.breakHits .. "/" .. GAME.blocks[b].hard
		end
		return
	end

	local hold = GAME.hold
	if (GAME.inv[hold] or 0) <= 0 then
		GAME.msg = "No " .. GAME.blocks[hold].name .. " left"
		return
	end
	-- Placing a block inside yourself would trap you in it
	if rectHit(GAME.px - GAME.PW * 0.5, GAME.py, GAME.PW, GAME.PH,
		x - 1, y - 1, 1, 1) then
		GAME.msg = "You are standing there"
		return
	end
	GAME.map[x][y] = hold
	GAME.inv[hold] = GAME.inv[hold] - 1
	GAME.msg = "Placed " .. GAME.blocks[hold].name
end

function FN.mineDraw()
	for x = 1, GAME.W do
		for y = 1, GAME.H do
			local btn = GAME.tiles[x] and GAME.tiles[x][y]
			if btn then
				local b = GAME.map[x][y]
				if b == 0 then
					-- Sky fades with depth, so a cave reads as underground
					local t = y / GAME.H
					btn.BackgroundColor3 = (y > GAME.H * 0.5)
						and Color3.fromRGB(24, 22, 30)
						or Color3.fromRGB(96 - t * 40, 140 - t * 50, 200 - t * 60)
				else
					btn.BackgroundColor3 = GAME.blocks[b].colour
				end
			end
		end
	end

	GAME.playerBox.Position = UDim2.new(0, (GAME.px - GAME.PW * 0.5) * GAME.TILE,
		0, GAME.py * GAME.TILE)

	local held = GAME.blocks[GAME.hold]
	GAME.hud.Text = string.format("%s  x%d   |   mined %d   |   %s",
		held.name, GAME.inv[GAME.hold] or 0, GAME.mined, GAME.msg or "")
	GAME.hint.Text = "A/D move   W jump   click to mine   1-0 pick block   R new world"
end

