-- caught. Without it a handler that errors does nothing visible at all: the
-- click is consumed, the error goes to a console you are probably not
-- watching, and the button looks like it simply does not work.
local function bindAction(btn, fn)
	local wrapped = function(...)
		local ok, err = pcall(fn, ...)
		if not ok then
			ST.lastError = tostring(err)
			-- Trimmed to the message: the full string starts with the script
			-- path and line, which is noise on a 30-character toast
			local short = ST.lastError:match("[^:]+$") or ST.lastError
			FN.toast("ERROR: " .. short:sub(1, 40))
			warn("[ModMenu] " .. ST.lastError)
		end
	end
	UI._act[btn] = wrapped
	btn.MouseButton1Click:Connect(wrapped)
end

