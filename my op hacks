		FN.toast("Already in the pinned server")
		return
	end

	-- Servers do not live forever: an empty one is shut down within minutes,
	-- so a pin from yesterday will usually be gone. Said plainly on failure
	-- rather than leaving you pressing a dead button.
	FN.armRejoin(true)
	local ok, err = pcall(function()
		SERV.TeleportService:TeleportToPlaceInstance(game.PlaceId, MISC.pinnedJob, player)
