--[[
	Setting profiles.

	Three hundred settings and one config file, across games that want opposite
	things: Kat wants the infected tools and a short ESP range, Lucky World
	wants the block tools and a long one, an obby wants none of it and a high
	jump. Retuning by hand every time you switch is the actual cost, and it is
	paid every single time.

	So: name the current setup, save it, load it back later. It reuses the
	config writer rather than serialising a second time -- one list of what
	counts as a setting, which is the only way the two stay in step when the
	next feature is added.

	Deliberately NOT automatic per game. Loading a profile changes what your
	character does, and having that happen on its own because you joined a
	place is how you end up flying in front of an admin.
--]]
function FN.profileFile(name)
	-- Only characters that are safe in a file name on every executor, and
	-- short enough that the name is readable in a listing
	local clean = tostring(name or ""):gsub("[^%w_%-]", ""):sub(1, 24)
	if clean == "" then return nil, nil end
	return "MMPP_profile_" .. clean .. ".txt", clean
end

function FN.profileSave()
	local file, clean = FN.profileFile(BOX.profileBox.Text)
	if not file then
		FN.toast("Name it first -- letters, numbers, - and _")
		return
	end
	if type(writefile) ~= "function" then
		FN.toast("This executor cannot write files")
		return
	end
	-- The same writer the main config uses, pointed at a different file
	FN.saveConfig(file)
	FN.toast("Saved profile: " .. clean)
	FN.updateUI()
end

function FN.profileLoad()
	local file, clean = FN.profileFile(BOX.profileBox.Text)
	if not file then
		FN.toast("Type the profile name to load")
		return
	end
	if type(readfile) ~= "function" or type(isfile) ~= "function" then
		FN.toast("This executor cannot read files")
		return
	end

	local ok, raw = pcall(function()
		if not isfile(file) then return nil end
		return readfile(file)
	end)
	if not ok or not raw then
		FN.toast("No profile called " .. clean)
		return
	end

	-- Cleared first: leaving the old keys in would mean a setting absent from
	-- the profile silently keeps whatever the last profile set it to, and
	-- "load" would depend on what you loaded before it
	table.clear(CFG)
	local count = 0
	for line in tostring(raw):gmatch("[^\r\n]+") do
		local k, v = line:match("^([%w_]+)=(.*)$")
		if k then
			CFG[k] = v
			count = count + 1
		end
	end

	if count == 0 then
		FN.toast("Profile " .. clean .. " is empty")
		return
	end

	applyConfig()
	FN.toast("Loaded " .. clean .. " (" .. count .. " settings)")
	FN.updateUI()
end

function FN.profileList()
	if type(listfiles) ~= "function" then
		FN.toast("This executor cannot list files -- type the name to load it")
		return
	end
	local ok, files = pcall(listfiles, "")
	if not ok or type(files) ~= "table" then
		FN.toast("Could not list files")
		return
	end

	local names = {}
	for _, path in ipairs(files) do
		local n = tostring(path):match("MMPP_profile_([%w_%-]+)%.txt$")
		if n then names[#names + 1] = n end
	end

	if #names == 0 then
		FN.toast("No profiles saved yet")
		return
	end
	table.sort(names)
	FN.toast(#names .. " profiles: " .. table.concat(names, ", "):sub(1, 60))
	print("[ModMenu] profiles --")
	for i, n in ipairs(names) do print("  " .. i .. ". " .. n) end
	if type(setclipboard) == "function" then
		pcall(setclipboard, table.concat(names, "\n"))
	end
end

function FN.profileDelete()
	local file, clean = FN.profileFile(BOX.profileBox.Text)
	if not file then
		FN.toast("Type the profile name to delete")
		return
	end
	if type(delfile) ~= "function" or type(isfile) ~= "function" then
		FN.toast("This executor cannot delete files")
		return
	end
	if not isfile(file) then
		FN.toast("No profile called " .. clean)
		return
	end
	-- Two presses, like Go Back To The Old Days: a profile is a setup you
	-- built, and one misplaced click should not be the end of it
	if ST.profileArmed ~= clean then
		ST.profileArmed = clean
		FN.toast("Press delete again to remove " .. clean)
		task.delay(5, function()
			if ST.profileArmed == clean then
				ST.profileArmed = nil
				FN.updateUI()
			end
		end)
		FN.updateUI()
		return
	end
	ST.profileArmed = nil
	pcall(delfile, file)
	FN.toast("Deleted " .. clean)
	FN.updateUI()
end

-- Stock values, recorded before the config touches anything: everything
-- after this that differs is something you or your config changed.
FN.snapshotDefaults()

--[[
	Setups as text.

	Profiles are files, and files need writefile, isfile and -- to list them --
	listfiles, which plenty of executors do not have. This is the same settings
	data with none of that: copy it out as text, paste it back later or on
	another machine.

	It reuses the config writer, so a setup exported here is exactly what a
	profile would contain. Nothing to keep in step.
--]]
function FN.setupCopy()
	local text = FN.saveConfig(false)
	if not text or text == "" then
		FN.toast("Could not build the settings text")
		return
	end
	if type(setclipboard) ~= "function" then
		-- Still worth printing: the console can be selected and copied by hand
		print("[ModMenu] setup --\n" .. text)
		FN.toast("No clipboard here -- printed to console instead")
		return
	end
	pcall(setclipboard, text)
	local n = select(2, text:gsub("\n", "")) + 1
	FN.toast("Copied " .. n .. " settings to the clipboard")
end

function FN.setupPaste()
	local raw = BOX.setupBox.Text
	if not raw or #raw < 5 then
		FN.toast("Paste a setup into the box first")
		return
	end

	-- Cleared first, same reason as loading a profile: a setting absent from
	-- the pasted text would otherwise keep whatever is live, and the result
	-- would depend on what you had before rather than on what you pasted
	table.clear(CFG)
	local count = 0
	for line in tostring(raw):gmatch("[^\r\n]+") do
		local k, v = line:match("^([%w_]+)=(.*)$")
		if k then
			CFG[k] = v
			count = count + 1
		end
	end

	if count == 0 then
		FN.toast("That does not look like a setup -- no key=value lines")
		return
	end

	applyConfig()
	FN.toast("Applied " .. count .. " settings")
	FN.updateUI()
end

applyConfig()

