-- Settings survive between runs when the executor exposes a file API. Not all
-- of them do, so every touch of it is pcall'd and simply skipped on failure --
-- a missing writefile must never take the menu down with it.
local CONFIG_FILE = "ModMenuProPlus_config.txt"

-- Raw key=value pairs read off disk at startup. Parsed here (before anything
-- else exists) and pushed into the live variables by applyConfig() at the very
-- bottom, once every value and apply function has actually been defined.
local CFG = {}

local function loadConfig()
	pcall(function()
		if type(readfile) ~= "function" or type(isfile) ~= "function" then return end
		if not isfile(CONFIG_FILE) then return end
		for line in tostring(readfile(CONFIG_FILE)):gmatch("[^\r\n]+") do
			local k, v = line:match("^([%w_]+)=(.*)$")
			if k then CFG[k] = v end
		end
	end)
end

loadConfig()

-- Keybinds are the one thing applied immediately, since KEYS is right here
for _, slot in ipairs({ "fly", "noclip", "gui", "panic", "speed", "sprint", "zoom", "shiftlock", "hoverfarm", "glide", "spider", "spiderzip", "swing", "unstick" }) do
	local keyName = CFG["key_" .. slot]
	if keyName == "NONE" then
		KEYS[slot] = nil
	elseif keyName then
		-- Indexing Enum.KeyCode with a bad name throws, so guard it
		local ok, code = pcall(function() return Enum.KeyCode[keyName] end)
		if ok and typeof(code) == "EnumItem" then KEYS[slot] = code end
	end
end

