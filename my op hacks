-- Joining, leaving and respawning all change who is targetable. The character
-- list is cached for half a second, and half a second is a long time in a
-- fight -- so these events drop the cache instead of waiting it out.
--
-- Dropping it rather than rebuilding it: the next thing that needs the list
-- rebuilds it, and rebuilding here would do the work even when nothing is
-- looking.
local function dropCharCache()
	ST.charAt = 0
end

-- Chat capture. New games use TextChatService; old ones fire a legacy event.
-- Both are hooked, guarded, so whichever the game uses is caught and the other
-- simply never fires.
pcall(function()
	local tcs = game:GetService("TextChatService")
	CONN.chatNewConn = tcs.MessageReceived:Connect(function(msg)
		local who, tags = "?", ""
		pcall(function()
			local src = msg.TextSource
			local p = src and Players:GetPlayerByUserId(src.UserId)
			who = p and p.Name or who
			-- PrefixText is the rendered "[Tag] Name" the chat shows. Whatever
			-- it holds beyond the name is the game's tags, so strip the markup
			-- and keep it as the tag prefix.
			local pref = ST.stripRich(msg.PrefixText or "")
			pref = pref:gsub(":%s*$", "")
			if pref ~= "" and pref ~= who then
				-- Everything before the name is the tag portion
				local cut = pref:find(who, 1, true)
				tags = cut and pref:sub(1, cut - 1):gsub("%s+$", "") or ""
			end
		end)
		ST.chatRecord(who, msg.Text, tags)
	end)
end)

pcall(function()
	local ev = game:GetService("ReplicatedStorage")
		:FindFirstChild("DefaultChatSystemChatEvents")
	local onMsg = ev and ev:FindFirstChild("OnMessageDoneFiltering")
	if onMsg then
		CONN.chatLegacyConn = onMsg.OnClientEvent:Connect(function(packet)
			pcall(function()
				local tags = ""
				local extra = packet.ExtraData
				if extra and type(extra.Tags) == "table" then
					local parts = {}
					for _, t in ipairs(extra.Tags) do
						local tt = (type(t) == "table") and t.TagText or t
						if tt and tostring(tt) ~= "" then
							parts[#parts + 1] = "[" .. tostring(tt) .. "]"
						end
					end
					tags = table.concat(parts)
				end
				ST.chatRecord(packet.FromSpeaker, packet.Message, tags)
			end)
		end)
	end
end)

