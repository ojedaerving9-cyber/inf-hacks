-- Platforms change per level, so they are rebuilt rather than pooled: five
-- levels of thirty parts is nothing next to the tile grid.
function FN.obbyBuild()
	if not GAME.built then return end
	for _, p in ipairs(GAME.obbyParts) do pcall(function() p:Destroy() end) end
	table.clear(GAME.obbyParts)

	local L = GAME.levels[GAME.level]
	local function box(x, y, w, h, colour, z)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(0, w * GAME.TILE, 0, h * GAME.TILE)
		f.Position = UDim2.new(0, x * GAME.TILE, 0, y * GAME.TILE)
		f.BackgroundColor3 = colour
		f.BorderSizePixel = 0
		f.ZIndex = z or 42
		f.Parent = GAME.obbyLayer
		GAME.obbyParts[#GAME.obbyParts + 1] = f
		return f
	end

	for _, p in ipairs(L.plats) do
		box(p[1], p[2], p[3], p[4], Color3.fromRGB(88, 92, 110))
	end
	for _, sp in ipairs(L.spikes) do
		box(sp[1], sp[2], sp[3], sp[4], Color3.fromRGB(226, 72, 72), 43)
	end

	GAME.moverBoxes = {}
	for i, m in ipairs(L.movers) do
		GAME.moverBoxes[i] = box(m[1], m[2], m[3], m[4], Color3.fromRGB(210, 168, 72))
	end

	local g = L.goal
	box(g[1], g[2], g[3], g[4], Color3.fromRGB(96, 224, 128))
end

function FN.obbyDraw()
	local L = GAME.levels[GAME.level]
	-- Offsets come from the step, never recomputed here: a platform drawn
	-- anywhere other than where the collision thinks it is makes the game lie
	for i, m in ipairs(L.movers) do
		local f = GAME.moverBoxes and GAME.moverBoxes[i]
		if f then
			local off = (GAME.moverOff and GAME.moverOff[i]) or 0
			f.Position = UDim2.new(0, (m[1] + off) * GAME.TILE, 0, m[2] * GAME.TILE)
		end
	end

	GAME.obbyBox.Position = UDim2.new(0, GAME.ox * GAME.TILE, 0, GAME.oy * GAME.TILE)

	-- Camera: keep the player a third of the way in, and never scroll past the
	-- left edge -- a level that starts by scrolling backwards looks broken
	local viewW = GAME.W * GAME.TILE
	local want = -(GAME.ox * GAME.TILE - viewW * 0.35)
	GAME.obbyLayer.Position = UDim2.new(0, math.min(want, 0), 0, 0)

	GAME.hud.Text = string.format("Level %d/%d: %s   |   deaths %d   |   %s",
		GAME.level, #GAME.levels, L.name, GAME.deaths or 0, GAME.msg or "")
	GAME.hint.Text = "A/D move  W jump  R restart level  best clear: "
		.. ((GAME.best and GAME.best < 1e9) and (GAME.best .. " deaths") or "none yet")
end

-- ---------- SHELL ----------
function FN.arcadePick(which)
	GAME.which = which
	GAME.mineLayer.Visible = (which == "MINE")
	GAME.obbyLayer.Visible = (which == "OBBY")
	GAME.mineTab.BackgroundColor3 = (which == "MINE") and THEME.accent or THEME.raised
	GAME.obbyTab.BackgroundColor3 = (which == "OBBY") and THEME.accent or THEME.raised
	GAME.msg = ""
	if which == "MINE" then
		if not GAME.map then FN.mineGen() end
	else
		if not GAME.level then
			GAME.deaths = 0
			FN.obbyLoad(1)
		else
			FN.obbyBuild()
		end
	end
end

--[[
	Keys. ContextActionService at a high priority with Sink is the whole reason
	this works: the same W that jumps in the obby would otherwise also jump your
	real character, and you would come back from a game to find yourself in a
	lake. Bound only while the window is open.
--]]
function FN.arcadeKeys(on)
	local cas = SERV.ContextActionService
	if not cas then return end
	if on then
		pcall(function()
			cas:BindActionAtPriority("MMPArcade" .. uiName, function(_, state, input)
				GAME.keys[input.KeyCode] = (state == Enum.UserInputState.Begin)
				return Enum.ContextActionResult.Sink
			end, false, 4000,
				Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
				Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.Left,
				Enum.KeyCode.Right, Enum.KeyCode.Space, Enum.KeyCode.R,
				Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three,
				Enum.KeyCode.Four, Enum.KeyCode.Five, Enum.KeyCode.Six,
				Enum.KeyCode.Seven, Enum.KeyCode.Eight, Enum.KeyCode.Nine,
				Enum.KeyCode.Zero)
		end)
	else
		pcall(function() cas:UnbindAction("MMPArcade" .. uiName) end)
		table.clear(GAME.keys)
	end
end

function FN.arcadeToggle(want)
	FN.arcadeBuild()
	if want == nil then want = not GAME.open end
	GAME.open = want
	GAME.win.Visible = want
	FN.arcadeKeys(want)

	if want then
		FN.arcadePick(GAME.which)
		if not CONN.gameConn then
			CONN.gameConn = RunService.RenderStepped:Connect(function(dt)
				if not GAME.open then return end
				-- Clamped: a frame that took half a second would otherwise
				-- teleport the player through a wall
				dt = math.min(dt, 1 / 30)

				-- R restarts, and is edge triggered off a held flag so holding
				-- it does not regenerate the world sixty times a second
				if GAME.keys[Enum.KeyCode.R] then
					if not GAME.rHeld then
						GAME.rHeld = true
						if GAME.which == "MINE" then
							FN.mineGen()
						else
							FN.obbyDie()
						end
					end
				else
					GAME.rHeld = false
				end

				if GAME.which == "MINE" then
					-- Number keys pick the held block
					local digits = { Enum.KeyCode.One, Enum.KeyCode.Two,
						Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five,
						Enum.KeyCode.Six, Enum.KeyCode.Seven, Enum.KeyCode.Eight,
						Enum.KeyCode.Nine, Enum.KeyCode.Zero }
					for i, code in ipairs(digits) do
						if GAME.keys[code] then GAME.hold = i end
					end
					FN.mineStep(dt)
					FN.mineDraw()
				else
					FN.obbyStep(dt)
					FN.obbyDraw()
				end
			end)
		end
	else
		if CONN.gameConn then
			CONN.gameConn:Disconnect()
			CONN.gameConn = nil
		end
	end
end

