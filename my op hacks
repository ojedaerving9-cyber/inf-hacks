CONN.statsConn = RunService.RenderStepped:Connect(function(dt)
	CAM.fpsAccum = CAM.fpsAccum + dt
	CAM.fpsFrames = CAM.fpsFrames + 1
	CAM.fpsTimer = CAM.fpsTimer + dt
	if CAM.fpsTimer >= 0.5 then
		local fps = math.floor((CAM.fpsFrames / CAM.fpsAccum) + 0.5)
		local pingText = ""
		pcall(function()
			if SERV.Stats and SERV.Stats.Network and SERV.Stats.Network.ServerStatsItem then
