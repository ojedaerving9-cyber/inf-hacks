local function disableFly()
	-- Was fly actually on? disableFly runs on every close/panic whether or not
	-- you were flying, and forcing GettingUp when you were NOT flying stands you
	-- up out of a real seat -- which is why closing the menu popped you out of a
	-- chair or vehicle.
	local wasFlying = ST.flying
	ST.flying = false
	-- Drop momentum, or the next takeoff inherits the last flight
	CAM.flyVel = nil
	CAM.flyPos = nil
	local character = player.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local rootPart = character:FindFirstChild("HumanoidRootPart")

		if humanoid then
			-- Hand AutoRotate back exactly as it was. Assuming true would
			-- switch it on in games that deliberately keep it off.
			if ST.flyAutoRotate ~= nil then
				pcall(function() humanoid.AutoRotate = ST.flyAutoRotate end)
				ST.flyAutoRotate = nil
			end
			-- Only undo the flight state if there was flight to undo. Untouched
			-- otherwise, so a seated player stays seated.
			if wasFlying then
				humanoid.PlatformStand = false
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end

		if rootPart then
			-- Same as disableWeld: Freeze owns Anchored if it's on
			rootPart.Anchored = MISC.frozen
			rootPart.AssemblyLinearVelocity = Vector3.zero
			rootPart.AssemblyAngularVelocity = Vector3.zero
		end

		for _, v in ipairs(character:GetDescendants()) do
			if v:IsA("Motor6D") and v.Name == "FlyMotor" .. uiName then
				pcall(function() v:Destroy() end)
			end
		end
	end

	-- The BodyVelocity outlives the fly toggle otherwise, and a force still
	-- holding your velocity after you land reads as being stuck
	if ST.flyBodyVel then
		pcall(function() ST.flyBodyVel:Destroy() end)
		ST.flyBodyVel = nil
	end

	if ST.flyMotor then
		pcall(function() ST.flyMotor:Destroy() end)
		ST.flyMotor = nil
	end

	if ST.flyPart then
		pcall(function() ST.flyPart:Destroy() end)
		ST.flyPart = nil
	end

	local ch = player.Character
	local strayRoot = ch and ch:FindFirstChild("HumanoidRootPart")
	if strayRoot then
		local stray = strayRoot:FindFirstChild("FlyVel" .. uiName)
		if stray then pcall(function() stray:Destroy() end) end
	end

	local strayPart = Workspace:FindFirstChild("MotorFlyPart" .. uiName)
	if strayPart then pcall(function() strayPart:Destroy() end) end

	FN.updateUI()
end

local function toggleFly()
	if ST.flying then
		disableFly()
		return
	end

	local character = player.Character
	if not character then return end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not rootPart or not humanoid then return end

	ST.flying = true
	humanoid.PlatformStand = true

	-- Shift lock keeps turning the body to face the camera. Motor and Full Body
	-- overwrite the CFrame every frame so it never shows, but Velocity leaves
	-- the body free and the auto-turn spins you. Off while flying, restored after.
	if MISC.flyLockFacing then
		ST.flyAutoRotate = humanoid.AutoRotate
		pcall(function() humanoid.AutoRotate = false end)
	end

	ST.flyPart = Instance.new("Part")
	ST.flyPart.Name = "MotorFlyPart" .. uiName
	ST.flyPart.Size = Vector3.new(1, 1, 1)
	ST.flyPart.Transparency = 1
	ST.flyPart.CanCollide = false
	ST.flyPart.Anchored = true
	ST.flyPart.CFrame = rootPart.CFrame
	ST.flyPart.Parent = Workspace

	if ST.flyMode == "Motor" then
		rootPart.Anchored = false
		ST.flyMotor = Instance.new("Motor6D")
		ST.flyMotor.Name = "FlyMotor" .. uiName
		ST.flyMotor.Part0 = ST.flyPart
		ST.flyMotor.Part1 = rootPart
		ST.flyMotor.Parent = ST.flyPart
	elseif ST.flyMode == "Full Body" then
		rootPart.Anchored = true
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
	elseif ST.flyMode == "Velocity" or ST.flyMode == "CFrame" then
		-- Nothing anchored and no joint: the body is driven each frame, which
		-- is the mode that still works in games that undo anchoring or strip
		-- foreign Motor6Ds. CFrame moves it by position (no physics object at
		-- all -- nothing an anti-cheat scan can find); Velocity uses a
		-- BodyVelocity, which some checks flag as "not added by the server".
		rootPart.Anchored = false
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
	end

	FN.updateUI()
end

local function toggleFlyMode()
	local wasFlying = ST.flying
	if wasFlying then
		disableFly()
	end

	if ST.flyMode == "Motor" then
		ST.flyMode = "Full Body"
	elseif ST.flyMode == "Full Body" then
		ST.flyMode = "Velocity"
	elseif ST.flyMode == "Velocity" then
		ST.flyMode = "CFrame"
	else
		ST.flyMode = "Motor"
	end
	FN.updateUI()

	if wasFlying then
		task.wait(0.05)
		if not ST.flying then
			toggleFly()
		end
	end
end

-- Cleared when the menu closes, so the grace period does not outlive the open
SERV.GuiService:GetPropertyChangedSignal("MenuIsOpen"):Connect(function()
	if not SERV.GuiService.MenuIsOpen then ST.escapeAt = nil end
end)

-- Stream Ahead. The "Gameplay Paused: please wait while the game content
-- loads" overlay is the streaming system, not the Escape menu -- outrun the
-- streamed region and Roblox freezes you until chunks arrive. Nothing can
-- dismiss that overlay; the only cure is for the content to already be there.
--
-- RequestStreamAroundAsync asks the server to stream around a point. Aimed
-- ahead of your travel instead of at your feet, the region loads before you
-- reach it, so the pause never triggers.
-- Hides the "Gameplay Paused" overlay and the blur behind it.
--
-- Worth knowing what this does and does not do: the overlay is a notice, not
-- the cause. Roblox genuinely halts local simulation while content streams, so
-- hiding it leaves you frozen with no explanation. Stream Ahead is what
-- prevents the pause; this only removes the sight of it.
local function restoreBlur()
	for effect, wasEnabled in pairs(ST.blurWas) do
		pcall(function()
			if effect.Parent then effect.Enabled = wasEnabled end
		end)
	end
	table.clear(ST.blurWas)
end

local function restorePauseOverlay()
	restoreBlur()
	for gui in pairs(ST.hiddenGuis) do
		pcall(function()
			if gui.Parent then gui.Enabled = true end
		end)
	end
	table.clear(ST.hiddenGuis)
end

local function hidePauseOverlay()
	-- Blur lives in Lighting. Originals recorded, since plenty of games use
	-- blur deliberately and killing it permanently would change how they look.
	for _, effect in ipairs(Lighting:GetChildren()) do
		if effect:IsA("BlurEffect") and effect.Enabled then
			if ST.blurWas[effect] == nil then
				pcall(function()
					ST.blurWas[effect] = effect.Enabled
					effect.Enabled = false
				end)
			end
		end
	end

	-- The overlay is a CoreGui ScreenGui. Reaching it needs executor
	-- permissions, so the search is guarded: without them this does nothing
	-- rather than erroring. Purchase prompts are skipped by name so a buy
	-- dialog never gets hidden out from under you.
	pcall(function()
		local coreGui = game:GetService("CoreGui")
		for _, gui in ipairs(coreGui:GetChildren()) do
			local name = gui.Name:lower()
			if not name:find("purchase")
				and (name:find("pause") or name:find("loading")) then
				if gui:IsA("ScreenGui") and gui.Enabled then
					ST.hiddenGuis[gui] = true
					gui.Enabled = false
				end
			end
		end
	end)
end

local function streamAhead()
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local vel = hrp.AssemblyLinearVelocity
	local speed = vel.Magnitude
	-- Below walking pace there is nothing to outrun, and the call is not free
	if speed < 30 then return end

	-- Further ahead the faster you travel, capped so the request stays local
	local lookahead = math.min(speed * 1.5, 400)
	local target = hrp.Position + (vel.Unit * lookahead)

	task.spawn(function()
		-- Yields, and throws if the place has streaming disabled entirely
		pcall(function()
			player:RequestStreamAroundAsync(target)
		end)
	end)
end

local function enableAntiPause()
	if CONN.antiPauseConn then CONN.antiPauseConn:Disconnect() end

	-- Throttled to a few times a second. Calling these every frame is what
	-- locked the client in the original version.
	--
	-- The important part is WHICH opens get closed. Closing every open menu
	-- makes Escape useless -- settings, volume and Leave Game all snap shut a
	-- quarter-second after you open them. So a menu that follows an Escape
	-- press is left alone; only ones that appear on their own get closed, which
	-- is the involuntary pause this is actually for.
	local lastAntiPauseCheck = 0
	CONN.antiPauseConn = RunService.Heartbeat:Connect(function()
		if not ON.antiPauseEnabled then return end

		local now = tick()
		if now - lastAntiPauseCheck < 0.25 then return end
		lastAntiPauseCheck = now

		-- Deliberate open: leave it be until they close it themselves
		if ST.escapeAt and (now - ST.escapeAt) < 30 then return end

		pcall(function()
			if SERV.GuiService.MenuIsOpen then
				SERV.GuiService:SetMenuIsOpen(false)
			end
		end)
	end)
end

local function toggleAntiPause()
	ON.antiPauseEnabled = not ON.antiPauseEnabled

	-- It drove the overlay hiding while on, so it has to restore on the way out
	-- unless the standalone toggle is holding it
	if not ON.antiPauseEnabled and not MISC.hidePause then
		restorePauseOverlay()
	end
	if ON.antiPauseEnabled then
		enableAntiPause()
	elseif CONN.antiPauseConn then
		CONN.antiPauseConn:Disconnect()
		CONN.antiPauseConn = nil
	end
	FN.updateUI()
end

local function toggleAntiFirstPerson()
	ON.antiFirstPersonEnabled = not ON.antiFirstPersonEnabled

	if not ON.antiFirstPersonEnabled then
		-- Put the camera back the way the game had it. Without this the forced
		-- Classic mode and widened zoom stayed applied after switching off.
		pcall(function()
			player.CameraMode = ORIGINAL.cameraMode or Enum.CameraMode.Classic
			if ORIGINAL.minZoom then
				player.CameraMinZoomDistance = ORIGINAL.minZoom
			end
			-- Max Zoom Override owns this value when it's on, so don't fight it
			if not ON.zoomEnabled and ORIGINAL.zoom then
				player.CameraMaxZoomDistance = ORIGINAL.zoom
			end
		end)
	end

	FN.updateUI()
end

local function toggleForceShiftLock()
	ON.forceShiftLockEnabled = not ON.forceShiftLockEnabled
	-- Opposites: the other one is switched off rather than left fighting
	if ON.forceShiftLockEnabled then ON.antiShiftLock = false end

	if not ON.forceShiftLockEnabled then
		-- Same gap Anti-First Person had: it set DevEnableMouseLock while on and
		-- never put it back, so shift lock stayed available after switching off
		pcall(function()
			player.DevEnableMouseLock = ORIGINAL.mouseLock or false
		end)
	end

	FN.updateUI()
end

MISC.playerListButtons = {}

local function refreshPlayerList()
	for _, btn in ipairs(MISC.playerListButtons) do
		pcall(function() btn:Destroy() end)
	end
	MISC.playerListButtons = {}

	-- Matched against username and display name, so either works
	local query = MISC.playerQuery or ""

	local order = 0
	for _, p in ipairs(Players:GetPlayers()) do
		local shown = p ~= player
		if shown and query ~= "" then
			shown = p.Name:lower():find(query, 1, true) ~= nil
				or p.DisplayName:lower():find(query, 1, true) ~= nil
		end

		if shown then
			order = order + 1

			local entry = Instance.new("TextButton")
			entry.Size = UDim2.new(1, -8, 0, 26)
			entry.BackgroundColor3 = THEME.raised
			entry.AutoButtonColor = false
			entry.TextColor3 = THEME.text
			entry.Font = Enum.Font.Gotham
			entry.TextSize = 12
			entry.TextTruncate = Enum.TextTruncate.AtEnd
			entry.LayoutOrder = order
			entry.Parent = DEC.playerListFrame
			Instance.new("UICorner", entry).CornerRadius = UDim.new(0, 6)

			entry.MouseEnter:Connect(function()
				entry.BackgroundColor3 = THEME.hover
				entry.TextColor3 = THEME.accent
			end)
			entry.MouseLeave:Connect(function()
				entry.BackgroundColor3 = THEME.raised
				entry.TextColor3 = THEME.text
			end)

			-- Distance and health on the row. Picking a target from a list of
			-- bare names means opening the list, clicking one, and finding out
			-- afterwards that they are across the map or already dead.
			local label = (p.DisplayName ~= p.Name)
				and (p.DisplayName .. " (@" .. p.Name .. ")")
				or p.Name

			local pChar = p.Character
			local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")
			local pHum = pChar and pChar:FindFirstChildOfClass("Humanoid")
			local myChar = player.Character
			local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

			if pRoot and myRoot then
				label = label .. string.format("  %.0fst", (pRoot.Position - myRoot.Position).Magnitude)
			end
			if pHum then
				if pHum.Health <= 0 then
					label = label .. "  DEAD"
					entry.TextColor3 = THEME.textDim
				else
					label = label .. string.format("  %dhp", math.floor(pHum.Health))
				end
			end
			entry.Text = label

			local targetName = p.Name
			entry.MouseButton1Click:Connect(function()
				BOX.tpBox.Text = targetName
				ST.cachedTargetPart = nil
				ST.lastTargetSearchTime = 0
			end)

			table.insert(MISC.playerListButtons, entry)
		end
	end

	if order == 0 then
		local empty = Instance.new("TextLabel")
		empty.Size = UDim2.new(1, -8, 0, 26)
		empty.BackgroundTransparency = 1
		empty.TextColor3 = THEME.textDim
		empty.Font = Enum.Font.Gotham
		empty.TextSize = 12
		empty.Text = "No other players in server"
		empty.LayoutOrder = 1
		empty.Parent = DEC.playerListFrame
		table.insert(MISC.playerListButtons, empty)
	end
end

local function teleportToTarget()
	local targetPart = resolveTargetPart()
	if targetPart then
		-- Exactly on them: X, Y and Z. The old 3-stud Z offset put you beside
		-- the target, and offsetting Y is what made you drop and take fall
		-- damage on arrival.
		safeTeleport(targetPart.Position)
	end
end

local function toggleTpSpam()
	ON.tpSpamEnabled = not ON.tpSpamEnabled
	ST.cachedTargetPart = nil
	ST.lastTargetSearchTime = 0

	if ON.tpSpamEnabled then
		-- Where to come back to if the target dies
		local ch = player.Character
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		ST.tpSpamReturn = hrp and hrp.CFrame or nil
	else
		ST.tpSpamReturn = nil
	end
	FN.updateUI()
end

-- ==========================================
-- 6. BACKGROUND LOOPS & EVENT BINDINGS
-- ==========================================
-- Stepped passes (time, deltaTime); the glide needs the second one
CONN.steppedConn = RunService.Stepped:Connect(function(_, deltaTime)
	-- Menu watchdog. This is now the ONLY thing that re-parents the menu:
	-- doing it from inside AncestryChanged meant setting Parent while a parent
	-- change was already running, which Roblox warns about every single time.
	-- Out here there is no operation in flight and nothing to object to. Twice
	-- a second, two property reads, so it costs nothing to leave on.
	if MISC.antiDelete and not MISC.closing and tick() - (ST.guiCheckAt or 0) > 0.5 then
		ST.guiCheckAt = tick()
		if not FN.guiAlive() then
			-- Orphaned is recoverable and destroyed is not, and the difference
			-- is whether the parent write is allowed to land
			local ok = pcall(function() FN.homeGui() end)
			if not ok or not FN.guiAlive() then
				FN.rebuildGui("watchdog")
			end

		else
			-- Alive, parented, and gutted. Some admin systems empty a foreign
			-- ScreenGui rather than deleting it, which passes every test above.
			local hollow = false
			pcall(function()
				if not DEC.screenGui.Enabled then
					-- Never ours: the menu hides with mainFrame.Visible
					DEC.screenGui.Enabled = true
					MISC.guiRevived = (MISC.guiRevived or 0) + 1
				end
				if not DEC.mainFrame or DEC.mainFrame.Parent == nil then
					hollow = true
				end
			end)

			if hollow then
				-- The window itself is gone. Nothing can put those children
				-- back one by one, so this is the rebuild case whether or not
				-- the ScreenGui survived.
				if tick() - (MISC.hollowSaid or 0) > 15 then
					MISC.hollowSaid = tick()
					warn("[ModMenu] the menu's window was removed but the "
						.. "ScreenGui left behind -- this place strips foreign "
						.. "GUIs. Move it with Menu Lives In, or set a rebuild "
						.. "source under Come Back After Teleport.")
				end
				FN.rebuildGui("hollowed")
			end
		end
	end

	-- World overrides re-asserted here (cheap: only write when the value drifted)
	if ON.gravityEnabled and Workspace.Gravity ~= VAL.gravityValue then
		Workspace.Gravity = VAL.gravityValue
	end
	if ON.clockTimeEnabled and math.abs(Lighting.ClockTime - VAL.clockTimeValue) > 0.01 then
		pcall(function() Lighting.ClockTime = VAL.clockTimeValue end)
	end
	if ON.noFogEnabled and Lighting.FogEnd < 1e6 then
		Lighting.FogEnd = 1e6
		Lighting.FogStart = 0
	end
	if ON.zoomEnabled and player.CameraMaxZoomDistance ~= VAL.zoomDistance then
		pcall(function() player.CameraMaxZoomDistance = VAL.zoomDistance end)
	end

	-- X-Ray and Low Graphics re-scan on a slow timer: parts and effects stream
	-- in as you move, so a single pass at toggle time only covers what was
	-- loaded at that moment. Both walks are budgeted. Deliberately above the
	-- character guard below -- these are world features and have no reason to
	-- stop working while you are dead.
	if MISC.xray and os.clock() >= (MISC.xrayAt or 0) then
		MISC.xrayAt = os.clock() + 2
		FN.scanXray()
	end
	if MISC.lowGfx and os.clock() >= (MISC.gfxAt or 0) then
		MISC.gfxAt = os.clock() + 2
		applyLowGraphics()
	end

	-- Player ESP. Five times a second rather than every frame -- the distance
	-- readout is the only part that changes fast, and no walk is involved:
	-- Players:GetPlayers() is a handful of entries the engine hands us.
	if PESP.enabled and os.clock() >= PESP.nextScan then
		PESP.nextScan = os.clock() + 0.2
		refreshPlayerEsp()
	end

	-- Watched player readout. Twice a second: health and slot change fast
	-- enough to matter, and reading a handful of children is nearly free.
	if MISC.watch and os.clock() >= (MISC.watchAt or 0) then
		MISC.watchAt = os.clock() + 0.5
		watchStep()
	end

	-- Clone hiding, re-applied because a spammer keeps making more and the
	-- engine resets the modifier as parts stream
	if MISC.hideClones and os.clock() >= (MISC.hideAt or 0) then
		MISC.hideAt = os.clock() + 1
		ST.setClonesHidden(true)
	end

	-- Detector. Five times a second is enough to catch a sustained pattern and
	-- slow enough that the raycast per player is nothing.
	if DET.on and os.clock() >= (DET.nextScan or 0) then
		DET.nextScan = os.clock() + 0.2
		stepDetect()
	end

	-- Lucky World. The scan is the expensive part, so it runs on its own slower
	-- timer and the two actions read whatever it last found.
	-- Deliberately not "or LW.count > 0": that kept the scan running for the
	-- rest of the session after a single manual press, for nothing.
	if (LW.autoMine or LW.autoCollect) and os.clock() >= LW.nextScan then
		LW.nextScan = os.clock() + 0.4
		lwScan()
	end
	if LW.autoMine and os.clock() >= (LW.mineAt or 0) then
		LW.mineAt = os.clock() + 0.15
		lwMine()
	end
	if LW.autoCollect and os.clock() >= (LW.collectAt or 0) then
		LW.collectAt = os.clock() + 0.5
		lwCollect()
	end

	-- GUI hover farm, ~15 a second: fast enough to catch a moving square, slow
	-- enough that the interface walk costs nothing.
	if MISC.hoverFarmOn and os.clock() >= (MISC.hoverAt or 0) then
		MISC.hoverAt = os.clock() + 0.06
		ST.hoverFarm()
	end

	-- Kat scan. Four times a second: it walks the player list, and the warning
	-- only has to beat someone running at you, not a bullet.
	if (KAT.alert or KAT.onlyInfected or KAT.autoFlee or KAT.panic or KAT.alarm
		or KAT.track or KAT.hunt or KAT.autoHold or KAT.holding
		or PESP.enabled) and os.clock() >= KAT.nextScan then
		KAT.nextScan = os.clock() + 0.25
		stepKat()

		local close = KAT.near ~= nil and KAT.nearDist <= KAT.range

		-- Auto flee. Cooldown'd, or it re-fires the moment it lands and you
		-- spend the round teleporting instead of playing.
		-- Not while a run is already under way: katRunAway cancels and restarts,
		-- so re-firing every 3 seconds meant the route was thrown away and
		-- recomputed before it could ever finish. In TP mode there is no run to
		-- interrupt, so the cooldown alone is the right gate there.
		if KAT.autoFlee and close and os.clock() > (KAT.fleeAt or 0)
			and not (KAT.escapeMode == "RUN" and KAT.running) then
			KAT.fleeAt = os.clock() + 3
			katRunAway()
		end

		-- Panic sprint. Stands down while Auto Sprint is holding the speed,
		-- since two features writing WalkSpeed fight and the loser's base value
		-- is whatever the winner happened to set.
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if KAT.panic and hum and not MISC.sprintBase then
			if close then
				if not KAT.panicBase then KAT.panicBase = hum.WalkSpeed end
				local want = KAT.panicBase * KAT.panicMult
				if math.abs(hum.WalkSpeed - want) > 0.01 then hum.WalkSpeed = want end
			elseif KAT.panicBase then
				-- Clear: hand back exactly what was taken, then stop writing
				if math.abs(hum.WalkSpeed - KAT.panicBase) > 0.01 then
					hum.WalkSpeed = KAT.panicBase
				end
				KAT.panicBase = nil
			end
		end

		if KAT.alarm and close then katAlarm() end

		-- Auto-hold. The side you are on decides what "near" means: a survivor
		-- reacts to the nearest hunter, a hunter to the nearest survivor --
		-- which is the same rule read from opposite ends.
		if KAT.autoHold then
			local threat, threatDist
			if KAT.imInfected then
				threat, threatDist = KAT.prey, KAT.preyDist
			else
				threat, threatDist = KAT.near, KAT.nearDist
			end

			local want = threat ~= nil and threatDist <= KAT.range
			-- No character means no ability to use anyway
			if not player.Character then want = false end

			local focused = UserInputService:GetFocusedTextBox()
			if KAT.bugMode then
				-- The focused box is the point here, not a hazard -- but only
				-- ours. Typing into any other field is left alone rather than
				-- being stolen mid-word.
				if focused and focused ~= DEC.bugBox then want = false end

				if want and focused ~= DEC.bugBox then
					pcall(function() DEC.bugBox:CaptureFocus() end)
				elseif not want and focused == DEC.bugBox then
					pcall(function() DEC.bugBox:ReleaseFocus() end)
					DEC.bugBox.Text = ""
				end
			else
				-- Normal mode: never while typing, or the key lands in the box
				if focused then want = false end
			end

			katSetHold(want)
		elseif KAT.holding then
			katSetHold(false)
		end

		-- Auto hunt. Retargets rather than locking on: the survivor you picked
		-- gets infected by someone else, or dies, and a fixed target leaves you
		-- teleport-spamming at a corpse for the rest of the round.
		if KAT.hunt then
			if KAT.prey then
				if KAT.huntName ~= KAT.prey.Name then
					KAT.huntName = KAT.prey.Name
					BOX.tpBox.Text = KAT.prey.Name
					ST.cachedTargetPart = nil
					ST.lastTargetSearchTime = 0
					FN.toast("Hunting " .. KAT.huntName)
				end
				if not ON.tpSpamEnabled then
					ON.tpSpamEnabled = true
					local hrp = player.Character
						and player.Character:FindFirstChild("HumanoidRootPart")
					ST.tpSpamReturn = hrp and hrp.CFrame or nil
				end
			elseif KAT.huntName ~= "" then
				-- Round over, or everyone is turned
				KAT.huntName = ""
				ON.tpSpamEnabled = false
				FN.toast("Nobody left to hunt")
			end
		end

		if KAT.alert and close then
			-- SEEN and the closing arrow are the two things that change what
			-- you should do: a hunter facing away is not a threat yet, and one
			-- losing ground does not need you to burn a panic sprint.
			local extra = ""
			if KAT.seen then extra = "  SEEN" end
			if KAT.closing > 4 then
				extra = extra .. "  >> CLOSING"
			elseif KAT.closing < -4 then
				extra = extra .. "  << losing you"
			end
			DEC.katWarn.Text = string.format("%s  %s  --  %.0f studs%s",
				KAT.near.Name, KAT.dir, KAT.nearDist, extra)
			-- Solid red up close, faded further out, so it reads at a glance
			-- without having to look at the number
			local urgency = 1 - math.clamp(KAT.nearDist / math.max(KAT.range, 1), 0, 1)
			DEC.katWarn.BackgroundColor3 = THEME.danger
			DEC.katWarn.BackgroundTransparency = 0.55 - (urgency * 0.45)
			DEC.katWarn.Visible = true
		elseif KAT.track and KAT.prey then
			-- Same label, other direction: green, and it does not hide itself
			-- past a range, because when hunting you want to know where the
			-- last survivor is even when they are across the map
			DEC.katWarn.Text = string.format("PREY  %s  %s  --  %.0f studs",
				KAT.prey.Name, KAT.preyDir, KAT.preyDist)
			DEC.katWarn.BackgroundColor3 = THEME.on
			DEC.katWarn.BackgroundTransparency = 0.25
			DEC.katWarn.Visible = true
		elseif not MISC.hpActive then
			-- Only hide what this block put up. Low health is the more urgent
			-- message anyway: a hunter 60 studs away matters less than dying.
			DEC.katWarn.Visible = false
		end
	end

	-- Silent aim picks its target on a timer so the cost never lands inside the
	-- hook, which runs in the middle of the game's own shooting code
	if SILENT.enabled and os.clock() >= (SILENT.nextScan or 0) then
		SILENT.nextScan = os.clock() + 0.1
		stepSilent()
	end

	-- Kicked anyway? Get back in.
	--
	-- There is no signal for being kicked -- by the time it happens the client
	-- is already tearing down -- but the prompt is a CoreGui frame, and it
	-- appearing is the earliest thing observable. Teleporting from there
	-- usually beats the disconnect.
	--
	-- Reaching CoreGui needs executor permissions, so it is guarded and simply
	-- does nothing without them.
	if AAC.rejoin and os.clock() >= (AAC.rejoinAt or 0) then
		AAC.rejoinAt = os.clock() + 1
		pcall(function()
			local coreGui = game:GetService("CoreGui")
			local prompt = coreGui:FindFirstChild("RobloxPromptGui", true)
			local errorFrame = prompt and prompt:FindFirstChild("ErrorPrompt", true)
			if errorFrame and errorFrame.Visible then
				AAC.rejoinAt = os.clock() + 15
				FN.toast("Kicked -- rejoining")
				FN.armRejoin(true)
				-- Bookmark first: after the teleport there is no character to
				-- read a position off, and a kick gives no other warning
				if MISC.tpBack then FN.savePosFile() end
				-- The same server if we know it, matchmaking otherwise
				local jobId = MISC.pinnedJob
				if jobId and jobId ~= "" then
					SERV.TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, player)
				else
					SERV.TeleportService:Teleport(game.PlaceId, player)
				end
			end
		end)
	end

	-- Periodic activity, separate from the Idled signal above.
	--
	-- Deliberately ABOVE the character guard below. It used to sit under it, so
	-- the nudge stopped the moment you had no character -- dead, respawning, or
	-- still loading -- which is exactly when you are most likely to be away and
	-- about to be kicked.
	--
	-- Idled only fires for Roblox's own twenty-minute idle kick. A game with
	-- its own AFK check -- watching for input, or for the character moving --
	-- never sees that signal and disconnects you anyway. This produces real
	-- input events on a timer, which both kinds of check accept.
	if ON.antiAfkEnabled and os.clock() >= (MISC.afkAt or 0) then
		MISC.afkAt = os.clock() + math.clamp(MISC.afkEvery or 60, 10, 600)

		pcall(function()
			local vim = game:GetService("VirtualInputManager")
			-- A one-pixel move and back. Real enough to count as input,
			-- small enough not to disturb aiming or a menu you have open.
			local cam = Workspace.CurrentCamera
			local cx = cam and (cam.ViewportSize.X / 2) or 100
			local cy = cam and (cam.ViewportSize.Y / 2) or 100
			vim:SendMouseMoveEvent(cx + 1, cy, game)
			vim:SendMouseMoveEvent(cx, cy, game)
		end)

		-- Some checks watch the character rather than the input, so this hops
		-- in place. Off by default: a jump is a real action, and in the wrong
		-- game that means falling off something you were standing on.
		if MISC.afkMove then
			local afkChar = player.Character
			local afkHum = afkChar and afkChar:FindFirstChildOfClass("Humanoid")
			if afkHum and afkHum.FloorMaterial ~= Enum.Material.Air then
				pcall(function() afkHum.Jump = true end)
			end
		end
	end

	local character = player.Character
	if not character then return end

	-- Auto clicker. On an interval rather than every frame: at 30 CPS it still
	-- fires less often than a 60fps frame would.
	-- Reach re-applies on a timer because equipping a different weapon hands
	-- you a different handle, and the old one has to be given its size back
	-- Was every half second, which is slower than a swing: a target could walk
	-- through your range and out again between two passes and never be touched
	if MISC.reach and os.clock() >= (MISC.reachAt or 0) then
		MISC.reachAt = os.clock() + ((MISC.reachMode == "SIZE") and 0.5 or 0.12)
		applyReach()
	end

	-- Seat attack is per frame, not on a timer: the seat has to keep up with a
	-- moving target, and a quarter-second of lag is a quarter-second of you
	-- swinging at where they used to be
	if KILL.seatOn then stepKillSeat() end
	-- Every frame, not on a timer: the cursor has to stay on the chest, and a
	-- quarter second of drift is a click on whatever is behind it
	stepChest()

	-- Kill combo, ten times a second: it only makes decisions, the features it
	-- switches on do the per-frame work themselves
	if KILL.on and os.clock() >= (MISC.killAt or 0) then
		MISC.killAt = os.clock() + 0.1
		stepKill()
	end

	if MISC.autoClick and os.clock() >= (MISC.clickAt or 0) then
		MISC.clickAt = os.clock() + (1 / math.clamp(MISC.cps or 8, 1, 30))
		autoClickOnce()
	end

	-- Stand height, measured rather than calculated. HipHeight only tracks
	-- scaling done through the R15 scale values -- an admin size command that
	-- resizes the parts directly leaves it reporting the old rig, and every
	-- formula built on it is then confidently wrong.
	--
	-- Measuring while genuinely on the ground sidesteps all of that: whatever
	-- the character is now, this is how far its feet are below its root. One
	-- step on solid ground after a resize and it is correct again.
	--
	-- Our own platforms are excluded, or it calibrates against the thing it
	-- just placed and ratchets upward frame by frame.
	if (MISC.waterWalk or ON.airWalkEnabled) and os.clock() >= (MISC.calAt or 0) then
		MISC.calAt = os.clock() + 0.5
		local calHum = character:FindFirstChildOfClass("Humanoid")
		local calRoot = character:FindFirstChild("HumanoidRootPart")
		if calHum and calRoot and calHum.FloorMaterial ~= Enum.Material.Air
			and not ST.airWalkPart and not ST.waterPart then
			local cp = RaycastParams.new()
			cp.FilterType = Enum.RaycastFilterType.Exclude
			cp.FilterDescendantsInstances = { character, ST.airWalkPart, ST.waterPart }
			local floor = Workspace:Raycast(calRoot.Position, Vector3.new(0, -20, 0), cp)
			if floor then
				local measured = calRoot.Position.Y - floor.Position.Y
				-- Sanity bounds: a ray that slipped through geometry returns
				-- something absurd, and storing it would be worse than the
				-- formula it replaces
				if measured > 0.5 and measured < 30 then
					MISC.standOffset = measured
				end
			end
		end
	end

	--[[
		CFrame speed. Walking faster without touching WalkSpeed: the humanoid
		keeps whatever number the game gave it, and the extra distance comes
		from nudging the root part every frame.

		Being straight about what that buys you -- an anti-cheat that READS
		Humanoid.WalkSpeed sees a perfectly ordinary player, and that is most
		of them. One that measures how far you actually moved between two
		samples still sees exactly what you did, and no amount of cleverness
		here changes that. Use the speed slider accordingly.
	--]]
	if ON.walkSpeedEnabled and MISC.speedMode == "CFRAME"
		and not ST.flying and not MISC.frozen and not ST.spiderStuck then
		local cHum = character:FindFirstChildOfClass("Humanoid")
		local cRoot = character:FindFirstChild("HumanoidRootPart")
		if cHum and cRoot and not cHum.Sit and cHum.Health > 0 then
			local base = ST.baseWalkSpeed or 16
			local extra = (VAL.walkSpeed or base) - base
			local dir = cHum.MoveDirection

			if extra > 0 and dir.Magnitude > 0.1 then
				dir = dir.Unit
				local step = dir * extra * deltaTime

				-- Two rays, because a kerb and a wall are not the same thing.
				-- Chest blocked means stop; only the shin blocked means a low
				-- step, and being nudged up over it is what walking does.
				local blocked = false
				if not ST.noclipping then
					local params = RaycastParams.new()
					params.FilterType = Enum.RaycastFilterType.Exclude
					params.FilterDescendantsInstances =
						{ character, ST.airWalkPart, ST.waterPart }

					local len = step.Magnitude + 1.5
					local chest = Workspace:Raycast(cRoot.Position, dir * len, params)
					local shin = Workspace:Raycast(
						cRoot.Position - Vector3.new(0, 1.6, 0), dir * len, params)

					if chest then
						blocked = true
					elseif shin then
						step = step + Vector3.new(0, 6 * deltaTime, 0)
					end
				end

				if not blocked then
					pcall(function() cRoot.CFrame = cRoot.CFrame + step end)
				end
			end
		end
	end

	-- ESP tracers. A line from the bottom of the screen to each player the ESP
	-- is already tracking, drawn per frame because a line updated five times a
	-- second lags visibly behind the thing it points at -- the boxes get away
	-- with the slow refresh only because they are attached to the target.
	--
	-- A rotated Frame, not the Drawing API: Drawing is missing on plenty of
	-- executors, and a one-pixel Frame with a Rotation is available everywhere.
	if PESP.enabled and MISC.tracers then
		local tCam = Workspace.CurrentCamera
		if tCam then
			local view = tCam.ViewportSize
			local originX, originY = view.X * 0.5, view.Y - 4

			for key, marker in pairs(PESP.tracked) do
				local head = marker.bb and marker.bb.Adornee
				local line = marker.line

				-- Shown by EITHER marker: the billboard is disabled in BOX
				-- style and the box is hidden in NAME style, so testing only
				-- one of them makes tracers vanish in half the ESP modes
				local marked = (marker.bb and marker.bb.Enabled)
					or (marker.box and marker.box.Visible)

				if head and head.Parent and marked then
					if not line or not line.Parent then
						line = Instance.new("Frame")
						line.Name = "Tracer" .. uiName
						line.AnchorPoint = Vector2.new(0, 0.5)
						line.BorderSizePixel = 0
						line.ZIndex = 1
						line.Parent = DEC.screenGui
						marker.line = line
					end

					local point, onScreen = tCam:WorldToViewportPoint(head.Position)
					if onScreen then
						local dx, dy = point.X - originX, point.Y - originY
						local len = math.sqrt(dx * dx + dy * dy)
						line.Visible = true
						line.BackgroundColor3 = marker.label and marker.label.TextColor3
							or Color3.fromRGB(235, 235, 235)
						line.BackgroundTransparency = 0.25
						line.Position = UDim2.fromOffset(originX, originY)
						line.Size = UDim2.fromOffset(len, MISC.tracerWidth or 1)
						-- atan2 gives radians from +X; Rotation wants degrees
						line.Rotation = math.deg(math.atan2(dy, dx))
					else
						line.Visible = false
					end
				elseif line then
					line.Visible = false
				end
			end
		end
	elseif next(PESP.tracked) ~= nil then
		-- Switched off: hide them all rather than leaving a frozen line pointing
		-- at wherever the target was standing when you turned it off
		for _, marker in pairs(PESP.tracked) do
			if marker.line then marker.line.Visible = false end
		end
	end

	-- Camera offset. Over-the-shoulder without touching the camera itself:
	-- Humanoid.CameraOffset is applied by Roblox's own camera script, so it
	-- survives every camera mode and fights nothing.
	if MISC.camOffset then
		local oHum = character:FindFirstChildOfClass("Humanoid")
		if oHum then
			local want = Vector3.new(MISC.camX or 2, MISC.camY or 0, MISC.camZ or 0)
			-- Only written when it has drifted: games with their own camera
			-- code rewrite this, and an unconditional write every frame fights
			-- them for no reason
			if (oHum.CameraOffset - want).Magnitude > 0.01 then
				oHum.CameraOffset = want
			end
		end
	elseif ST.camOffsetWas then
		local oHum = character:FindFirstChildOfClass("Humanoid")
		if oHum then pcall(function() oHum.CameraOffset = Vector3.zero end) end
		ST.camOffsetWas = false
	end
	if MISC.camOffset then ST.camOffsetWas = true end

	-- Movement recorder. Sampled on a fixed interval rather than every frame:
	-- a route is a shape, not a frame log, and 20 points a second replays
	-- identically while storing a fifth of the data.
	if MACRO.recording then
		local mRoot = character:FindFirstChild("HumanoidRootPart")
		if mRoot and tick() - (MACRO.at or 0) > (MISC.macroStep or 0.05) then
			MACRO.at = tick()
			if #MACRO.points < 12000 then
				MACRO.points[#MACRO.points + 1] = {
					t = tick() - MACRO.startedAt,
					p = mRoot.Position,
					r = mRoot.CFrame.Rotation,
				}
			elseif MACRO.recording then
				-- A cap, or a forgotten recording eats memory until the client
				-- dies -- ten minutes at this rate is already generous
				MACRO.recording = false
				FN.toast("Recording stopped -- hit the point limit")
				FN.updateUI()
			end
		end
	end

	if MACRO.playing and (ST.flying or ST.swingAnchor or ST.spiderStuck) then
		-- Something else is already driving the root part. Two writers do not
		-- fight, they alternate, and the replay just looks broken.
		MACRO.playing = false
		FN.toast("Playback stopped -- another movement feature took over")
		FN.updateUI()
	end

	if MACRO.playing then
		local mRoot = character:FindFirstChild("HumanoidRootPart")
		local mHum = character:FindFirstChildOfClass("Humanoid")

		-- Bail out by walking. A replay drags you along a fixed path, and the
		-- moment you want off it you want off it NOW, not after finding the
		-- menu and then the button in it.
		if not UserInputService:GetFocusedTextBox()
			and (UserInputService:IsKeyDown(Enum.KeyCode.W)
				or UserInputService:IsKeyDown(Enum.KeyCode.A)
				or UserInputService:IsKeyDown(Enum.KeyCode.S)
				or UserInputService:IsKeyDown(Enum.KeyCode.D)) then
			MACRO.playing = false
			FN.toast("Playback cancelled")
			FN.updateUI()
		end

		if not mRoot or not mHum or mHum.Health <= 0 then
			MACRO.playing = false
			FN.updateUI()
		elseif MACRO.playing then
			local now = (tick() - MACRO.startedAt) * (MISC.macroSpeed or 1)

			-- Walk the index forward to the pair straddling "now", so a lag
			-- spike catches up instead of replaying in slow motion
			while MACRO.index < #MACRO.points
				and MACRO.points[MACRO.index + 1].t <= now do
				MACRO.index = MACRO.index + 1
			end

			local a = MACRO.points[MACRO.index]
			local b = MACRO.points[MACRO.index + 1]

			if not b then
				if MISC.macroLoop then
					MACRO.index = 1
					MACRO.startedAt = tick()
				else
					MACRO.playing = false
					FN.toast("Playback finished")
					FN.updateUI()
				end
			else
				-- Interpolated between samples: stepping point to point at 20Hz
				-- is visibly jerky, and the whole route is already known
				local span = math.max(b.t - a.t, 0.0001)
				local alpha = math.clamp((now - a.t) / span, 0, 1)
				local pos = a.p:Lerp(b.p, alpha)
				pcall(function()
					mRoot.CFrame = CFrame.new(pos) * (b.r or a.r or mRoot.CFrame.Rotation)
					mRoot.AssemblyLinearVelocity = Vector3.zero
				end)
			end
		end
	end

	--[[
		Anti-Ice / Anti-Jail. HD Admin's :ice does three separate things, and
		undoing one of them leaves you just as stuck:

		  1. anchors your root part,
		  2. sets WalkSpeed and JumpPower to zero,
		  3. drops a solid block around you.

		:freeze is (1) and (2) with no block; :jail and :cage are (3) with a
		bigger box. All three are handled, and each is counted separately --
		"it did nothing" and "it undid the anchor but you are still in a box"
		look identical from inside the box.

		The naming matters more than it looks. HD Admin names the thing after
		you: "<your username> Jail". That name is on the MODEL, and the six
		walls inside it are called whatever the script felt like -- so matching
		only the part's own name finds nothing and you stay in the cage. Every
		part's ancestry is checked, not just the part.

		What this cannot do: the walls are the SERVER's parts. They stay there
		for everyone else and the admin still sees you standing in the jail. All
		that changes locally is that they stop being solid to you and stop being
		drawn, which is enough to walk out. If the admin's script re-applies on
		a loop this fights it every frame and you keep moving; if it also
		teleports you back, that is a different fight and this one does not win
		it.
	--]]
	if MISC.antiIce and not MISC.frozen and not ST.flying then
		local iHum = character:FindFirstChildOfClass("Humanoid")
		local iRoot = character:FindFirstChild("HumanoidRootPart")

		if iHum and iRoot then
			-- 1. Anchored by someone who is not us. Fly's Full Body mode and
			-- Freeze both anchor on purpose, which is why they are guarded out
			-- of the whole block above rather than tested for here.
			if iRoot.Anchored then
				pcall(function() iRoot.Anchored = false end)
				MISC.iceAnchors = (MISC.iceAnchors or 0) + 1
			end

			-- 2. Movement zeroed. Restored to what it SHOULD be -- your own
			-- speed mod if one is on, the game's own value otherwise. Writing
			-- a flat 16 here would be its own kind of wrong.
			if iHum.WalkSpeed < 1 then
				local want = (ON.walkSpeedEnabled and MISC.speedMode == "NORMAL")
					and VAL.walkSpeed or (ST.baseWalkSpeed or 16)
				pcall(function() iHum.WalkSpeed = want end)
				MISC.iceSpeeds = (MISC.iceSpeeds or 0) + 1
			end
			if iHum.JumpPower < 1 and iHum.UseJumpPower then
				pcall(function()
					iHum.JumpPower = ON.jumpPowerEnabled and VAL.jumpPower or 50
				end)
			end

			-- 3. The box. Throttled: a spatial query every frame, for a thing
			-- that arrives once, is a lot of query for very little ice.
			if tick() - (MISC.iceScan or 0) > 0.3 then
				MISC.iceScan = tick()

				local params = OverlapParams.new()
				params.FilterType = Enum.RaycastFilterType.Exclude
				params.FilterDescendantsInstances = { character, ST.airWalkPart, ST.waterPart }
				params.MaxParts = 80

				local near = {}
				pcall(function()
					near = Workspace:GetPartBoundsInRadius(iRoot.Position, 10, params)
				end)

				for _, part in ipairs(near) do
					if part.CanCollide then
						-- The part, then its ancestors: "<username> Jail" is a
						-- model name, and the walls under it are not called
						-- anything useful
						local hit = false
						local matched = nil
						local node, hops = part, 0
						while node and node ~= Workspace and hops < 4 do
							local lower = node.Name:lower()
							for raw in (MISC.iceNames or ""):gmatch("[^,]+") do
								local want = raw:gsub("^%s+", ""):gsub("%s+$", ""):lower()
								if want ~= "" and lower:find(want, 1, true) then
									hit = true
									matched = node
									break
								end
							end
							if hit then break end
							node = node.Parent
							hops = hops + 1
						end

						-- Material catches the ones named something unhelpful.
						-- It has to be anchored, solid and tall: an ice-material
						-- floor you are standing on is not a cage.
						if not hit and part.Material == Enum.Material.Ice
							and part.Anchored and part.Size.Y > 3 then
							hit = true
							matched = part
						end

						if hit then
							pcall(function()
								part.CanCollide = false
								part.LocalTransparencyModifier = 1
							end)
							MISC.iceBlocks = (MISC.iceBlocks or 0) + 1
							if tick() - (MISC.iceSaidAt or 0) > 5 then
								MISC.iceSaidAt = tick()
								FN.toast("Anti-Ice: opened " .. ((matched or part).Name))
							end
						end
					end
				end
			end
		end
	end

	--[[
		Anti admin abuse.

		The commands an HD Admin holder actually uses on people, and what can be
		done about each from here:

		  fire / smoke / sparkles  -- instances parented onto your parts. Local
		                              destroy works; they are cosmetic anyway.
		  ghost / invisible        -- your parts set transparent. Restored from
		                              LocalTransparencyModifier, which is a
		                              client-only property, so this one is
		                              clean and complete.
		  sit                      -- Humanoid.Sit forced true. Undone.
		  fling / rocket           -- a BodyVelocity or similar parented to you.
		                              Destroyed, same as Anti-Fling does.
		  blind                    -- a full-screen GUI in PlayerGui. Hidden.
		  ice / jail / freeze      -- handled above, by Anti-Ice.
		  kill / punish / kick     -- nothing to undo. Those need the rejoin.

		Kill and punish are on that list to be honest about the shape of this:
		it undoes what is undoable from a client and does not pretend about the
		rest. The things it cannot touch are exactly the ones Break Out is for.
	--]]
	if MISC.antiAbuse and tick() - (MISC.abuseScan or 0) > 0.25 then
		MISC.abuseScan = tick()
		local aHum = character:FindFirstChildOfClass("Humanoid")

		for _, d in ipairs(character:GetDescendants()) do
			-- Cosmetic effects someone hung on you
			if d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles")
				or d:IsA("ParticleEmitter") then
				-- Only ones we did not make: a game's own torch effect on a
				-- tool is not an admin having a laugh
				if not d.Name:find(uiName, 1, true) then
					pcall(function() d:Destroy() end)
					MISC.abuseFx = (MISC.abuseFx or 0) + 1
				end

			-- Fling: a mover on your character that you did not add
			elseif d:IsA("BodyVelocity") or d:IsA("BodyThrust")
				or d:IsA("BodyAngularVelocity") or d:IsA("BodyForce") then
				if not d.Name:find(uiName, 1, true) then
					pcall(function() d:Destroy() end)
					MISC.abuseFling = (MISC.abuseFling or 0) + 1
				end

			end
		end

		-- Ghosted. Counted across the WHOLE rig before anything is restored:
		-- plenty of characters have a legitimately invisible part or two --
		-- an accessory handle, a rig's spare limbs -- and forcing those
		-- visible one at a time is a bug, not a defence. A ghosted character
		-- is mostly transparent, so that is what gets tested.
		if MISC.abuseUnghost and not MISC.invisible then
			local parts, clear = 0, 0
			for _, d in ipairs(character:GetDescendants()) do
				if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart"
					and not ST.xrayParts[d] then
					parts = parts + 1
					if d.Transparency > 0.9 then clear = clear + 1 end
				end
			end

			if parts > 0 and (clear / parts) > 0.6 then
				for _, d in ipairs(character:GetDescendants()) do
					if d:IsA("BasePart") and d.Transparency > 0.9
						and d.Name ~= "HumanoidRootPart" and not ST.xrayParts[d] then
						pcall(function() d.LocalTransparencyModifier = -d.Transparency end)
					end
				end
				MISC.abuseGhost = (MISC.abuseGhost or 0) + 1
			end
		end

		-- Sat down by someone else. Guarded on our own sit features, or this
		-- fights them for the chair every quarter second.
		if aHum and aHum.Sit and MISC.abuseUnsit
			and not ST.sitSeat and not KILL.seatOn then
			pcall(function()
				aHum.Sit = false
				aHum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end)
			MISC.abuseSit = (MISC.abuseSit or 0) + 1
		end

		-- Blind: a full-screen opaque frame dropped into your PlayerGui. Ours
		-- is excluded by name; anything else covering the whole screen and
		-- solid is not something you asked for.
		if MISC.abuseUnblind then
			pcall(function()
				-- Two levels and a budget, not GetDescendants. A blind overlay
				-- is a full-screen frame sitting at the top of a ScreenGui --
				-- it is never buried -- and walking every descendant of every
				-- GUI in the game four times a second is a real cost for
				-- something that is not down there anyway.
				local looked = 0
				for _, gui in ipairs(playerGui:GetChildren()) do
					if looked > 400 then break end
					if gui:IsA("ScreenGui") and gui.Name ~= uiName and gui.Enabled then
						for _, f in ipairs(gui:GetChildren()) do
							looked = looked + 1
							if looked > 400 then break end
							local covers = f:IsA("Frame") and f.Visible
								and f.BackgroundTransparency < 0.15
								and f.Size.X.Scale >= 1 and f.Size.Y.Scale >= 1
							if covers then
								f.Visible = false
								MISC.abuseBlind = (MISC.abuseBlind or 0) + 1
							end
						end
					end
				end
			end)
		end
	end

	-- Auto break-out. Anti-Ice fights an anchor every frame and usually wins,
	-- but an admin script re-applying in a loop is a fight with no end: past
	-- the threshold, leaving and coming back is simply the better move.
	if MISC.autoBreak and MISC.antiIce and (MISC.iceAnchors or 0) >= (MISC.breakAfter or 60) then
		MISC.iceAnchors = 0
		FN.breakOut("anchored " .. (MISC.breakAfter or 60) .. " times")
	end

	--[[
		Four more antis, all aimed at the same thing: an admin making the game
		unplayable for you without ever touching your character.

		Each one only acts when the value is WRONG, and each is guarded on the
		menu's own features that write the same value. An anti that fights your
		own Fullbright is not a defence, it is a bug with a nice name.
	--]]

	-- Anti camera steal. :view, :freecam and every cutscene take the camera by
	-- setting CameraType to Scriptable and pointing CameraSubject somewhere
	-- else. Both get put back.
	if MISC.antiCam and not ON.freeCamEnabled and not ST.spectating then
		local cCam = Workspace.CurrentCamera
		local cHum = character:FindFirstChildOfClass("Humanoid")
		if cCam and cHum then
			if cCam.CameraType ~= Enum.CameraType.Custom then
				pcall(function() cCam.CameraType = Enum.CameraType.Custom end)
				MISC.camSteals = (MISC.camSteals or 0) + 1
			end
			if cCam.CameraSubject ~= cHum then
				pcall(function() cCam.CameraSubject = cHum end)
			end
		end
	end

	-- Anti lighting abuse. :fog, :night and :brightness 0 are the cheapest way
	-- to ruin a server, and every one of them is a property with a value we
	-- wrote down at startup.
	if MISC.antiLight and tick() - (MISC.lightScan or 0) > 0.5 then
		MISC.lightScan = tick()
		pcall(function()
			-- Guarded on our own overrides one at a time, not as a whole: you
			-- can have Fullbright on and still want the fog put back
			-- MISC.brightness >= 0 means our own slider is driving Brightness,
			-- and a dark setting you chose is not abuse
			if not ON.fullbrightEnabled and (MISC.brightness or -1) < 0 then
				if (Lighting.Brightness or 1) < 0.5 then
					Lighting.Brightness = 1
					MISC.lightFixes = (MISC.lightFixes or 0) + 1
				end
				if Lighting.Ambient.R < 0.02 and Lighting.Ambient.G < 0.02
					and Lighting.Ambient.B < 0.02
					and ORIGINAL.ambient and ORIGINAL.ambient ~= Lighting.Ambient then
					Lighting.Ambient = ORIGINAL.ambient
					MISC.lightFixes = (MISC.lightFixes or 0) + 1
				end
			end

			if not ON.noFogEnabled and Lighting.FogEnd < 30 then
				Lighting.FogEnd = ORIGINAL.fogEnd or 100000
				Lighting.FogStart = ORIGINAL.fogStart or 0
				MISC.lightFixes = (MISC.lightFixes or 0) + 1
			end

			if not ON.clockTimeEnabled and ORIGINAL.clockTime then
				-- Only the extremes: a game with a real day cycle moves this
				-- constantly, and fighting that would be its own nuisance
				if Lighting.ClockTime < 1 or Lighting.ClockTime > 23 then
					Lighting.ClockTime = ORIGINAL.clockTime
					MISC.lightFixes = (MISC.lightFixes or 0) + 1
				end
			end

			-- Blur and colour correction dropped into Lighting by someone else.
			-- Ours carry this copy's tag in the name; nothing else does.
			for _, fx in ipairs(Lighting:GetChildren()) do
				if (fx:IsA("BlurEffect") and fx.Size > 8)
					or (fx:IsA("ColorCorrectionEffect")
						and (fx.Brightness < -0.4 or fx.Saturation < -0.9)) then
					if not fx.Name:find(uiName, 1, true) and fx.Enabled then
						fx.Enabled = false
						MISC.lightFixes = (MISC.lightFixes or 0) + 1
					end
				end
			end
		end)
	end

	-- Anti ear-rape. :music and :sound at full volume, which is the one form of
	-- abuse that reaches you through headphones whatever you are doing.
	if MISC.antiSound and tick() - (MISC.soundScan or 0) > 1 then
		MISC.soundScan = tick()
		pcall(function()
			local cap = MISC.soundCap or 3
			local looked = 0
			-- Where a played sound actually ends up: SoundService for :music,
			-- Workspace for :sound. Both shallow, both budgeted.
			for _, where in ipairs({ SERV.SoundService, Workspace }) do
				for _, snd in ipairs(where:GetChildren()) do
					looked = looked + 1
					if looked > 300 then break end
					if snd:IsA("Sound") and snd.Playing and snd.Volume > cap
						and not snd.Name:find(uiName, 1, true) then
						snd.Volume = 0
						MISC.soundMutes = (MISC.soundMutes or 0) + 1
						if tick() - (MISC.soundSaidAt or 0) > 8 then
							MISC.soundSaidAt = tick()
							FN.toast("Muted a loud sound: " .. snd.Name)
						end
					end
				end
			end
		end)
	end

	-- Anti knockback. Not Anti-Fling: that catches the enormous spin that
	-- throws you off the map. This catches the steady shoving that keeps you
	-- from walking anywhere, by capping how fast anything can move you.
	local launchedRecently =
		tick() - math.max(ST.spiderJumpAt or 0, ST.spiderZipAt or 0) < 1.5
	if MISC.antiKnock and not ST.flying and not ST.swingAnchor
		and not ST.spiderStuck and not MACRO.playing and not launchedRecently then
		local kRoot = character:FindFirstChild("HumanoidRootPart")
		if kRoot then
			local vel = kRoot.AssemblyLinearVelocity
			local flat = Vector3.new(vel.X, 0, vel.Z)
			local cap = MISC.knockCap or 90
			if flat.Magnitude > cap then
				-- The vertical component is left alone: capping it would break
				-- jumping and turn every fall into a float
				local kept = flat.Unit * cap
				pcall(function()
					kRoot.AssemblyLinearVelocity = Vector3.new(kept.X, vel.Y, kept.Z)
				end)
				MISC.knockHits = (MISC.knockHits or 0) + 1
			end
		end
	end

	if ST.singOn then FN.singStep() end

	--[[
		Touch fling.

		Your root part is spun at an absurd angular velocity. When your
		character makes contact with someone else's, the collision is solved on
		THEIR client -- they own their character -- and their own machine throws
		them across the map and replicates the result. You never touch their
		character and never ask the server for anything; you just arrive
		spinning and let their physics do the rest.

		Which is also why it fails where it fails: a game that welds or anchors
		characters, gives them no collision, or runs its own movement controller
		has nothing for the contact to act on. It is not a stronger number that
		fixes those, so the power slider will not help.

		Two things it will happily do to YOU: kill you, and fling you. The
		position is saved on the way in and restored on the way out, which is
		the difference between a tool and an accident.
	--]]
	if MISC.touchFling and not MISC.frozen then
		local fRoot = character:FindFirstChild("HumanoidRootPart")
		local fHum = character:FindFirstChildOfClass("Humanoid")

		if fRoot and fHum then
			local power = MISC.flingPower or 9000

			pcall(function()
				-- Sustained, not a one-off: the solver needs the spin present
				-- at the moment of contact, and contact is not something we
				-- get to schedule
				fRoot.AssemblyAngularVelocity = Vector3.new(0, power, 0)
				-- A little lift, so friction with the floor does not bleed the
				-- spin away between targets
				local v = fRoot.AssemblyLinearVelocity
				fRoot.AssemblyLinearVelocity = Vector3.new(v.X, math.max(v.Y, 0.2), v.Z)
			end)

			-- AUTO: go to them rather than waiting for them to walk into you.
			-- Hovering just above the head is what makes contact reliable --
			-- level with the torso you tend to slide off before the solver
			-- registers anything.
			if MISC.flingAuto and tick() - (ST.flingAt or 0) > (MISC.flingDwell or 1) then
				ST.flingAt = tick()

				local mySide = ST.sideOf(character, player)
				local best, bestDist
				for _, entry in ipairs(ST.charList()) do
					local ch, pl = entry.model, entry.plr
					local hrp = ch and ch ~= character
						and ch:FindFirstChild("HumanoidRootPart")
					local hum = entry.hum
					if hrp and hum and hum.Health > 0 then
						local skip = false
						if MISC.flingTarget ~= "ALL" then
							local theirSide = ST.sideOf(ch, pl)
							local same = mySide ~= nil and theirSide ~= nil
								and mySide == theirSide
							skip = (MISC.flingTarget == "ENEMIES") and same or not same
						end
						-- Anyone already flung is moving fast; chasing them
						-- wastes the whole dwell on someone mid-flight
						if not skip and hrp.AssemblyLinearVelocity.Magnitude < 120 then
							local d = (hrp.Position - fRoot.Position).Magnitude
							if not bestDist or d < bestDist then
								best, bestDist = hrp, d
							end
						end
					end
				end

				if best then
					pcall(function()
						fRoot.CFrame = best.CFrame * CFrame.new(0, 2.2, 0)
					end)
					ST.flingHits = (ST.flingHits or 0) + 1
				end
			end
		end
	end

	--[[
		Auto Collect.

		Pickups are almost always a part with a Touched event, and Touched does
		not care where you are standing -- it cares that the engine registered
		contact. firetouchinterest says contact happened, so the part fires from
		wherever you are.

		Which makes TOUCH mode the interesting one: coins across the map are
		collected without your character moving an inch, so there is nothing to
		watch. TP is the fallback for pickups that use a distance check or a
		ProximityPrompt instead, where actually being there is the point.

		Everything already collected this scan is remembered, because a pickup
		that has fired but not yet been removed by the server would otherwise be
		fired again every pass -- which is what turns a collector into a remote
		spammer and gets you noticed.
	--]]
	if MISC.collect and tick() - (MISC.collectAt or 0) > 0.4 then
		MISC.collectAt = tick()
		local cRoot = character:FindFirstChild("HumanoidRootPart")

		if cRoot and type(firetouchinterest) == "function" then
			local words = {}
			for raw in (MISC.collectNames or ""):gmatch("[^,]+") do
				local w = raw:gsub("^%s+", ""):gsub("%s+$", ""):lower()
				if w ~= "" then words[#words + 1] = w end
			end

			if #words > 0 then
				local params = OverlapParams.new()
				params.FilterType = Enum.RaycastFilterType.Exclude
				params.FilterDescendantsInstances = { character, ST.airWalkPart, ST.waterPart }
				params.MaxParts = 250

				local near = {}
				pcall(function()
					near = Workspace:GetPartBoundsInRadius(cRoot.Position,
						MISC.collectRange or 60, params)
				end)

				local got = 0
				for _, part in ipairs(near) do
					if got >= 12 then break end
					if not ST.collected[part] then
						local lower = part.Name:lower()
						local hit = false
						for _, w in ipairs(words) do
							if lower:find(w, 1, true) then
								hit = true
								break
							end
						end

						-- Nothing attached to a player: their coin display, a
						-- tool called "Gem", someone's hat
						if hit and not part:FindFirstAncestorOfClass("Tool")
							and not (part:FindFirstAncestorOfClass("Model")
								and part:FindFirstAncestorOfClass("Model")
									:FindFirstChildOfClass("Humanoid")) then

							ST.collected[part] = true
							got = got + 1
							MISC.collectHits = (MISC.collectHits or 0) + 1

							if MISC.collectMode == "TP" then
								pcall(function()
									markIntentionalTeleport()
									cRoot.CFrame = part.CFrame + Vector3.new(0, 2, 0)
								end)
							end
							pcall(function()
								firetouchinterest(cRoot, part, 0)
								firetouchinterest(cRoot, part, 1)
							end)
						end
					end
				end
			end
		elseif cRoot and tick() - (MISC.collectSaid or 0) > 10 then
			MISC.collectSaid = tick()
			FN.toast("Auto Collect needs firetouchinterest -- this executor has none")
		end
	end

	--[[
		TP Kill.

		Teleport to a random point on a ring around the target, aim the camera
		at them, click, repeat. The randomness is the point: a fixed offset is
		a fixed thing to swing back at, and a new position several times a
		second is not.

		Being straight about "you cannot die", because it is half true. Melee
		that the CLIENT resolves -- a sword raycast from someone else's camera,
		a Touched event on their blade -- mostly misses you, because by the time
		their swing lands you are somewhere else. That is real and it is most of
		what kills you in a sword game.

		Everything the SERVER decides still applies: a zone that damages you, a
		distance check, fall damage, an admin. Your health is not yours to
		refuse. So this makes you hard to hit, not immortal, and the difference
		matters the first time something server-side takes an interest.
	--]]
	--[[
		TP Kill.

		Teleport to a random point on a ring around the target, aim at them,
		click, repeat. The randomness is the point: a fixed offset is a fixed
		thing to swing back at, and a new position several times a second is
		not.

		Three things this learned the hard way.

		AIM RUNS EVERY FRAME, not only on the hop. A sword's hitbox resolves
		DURING the swing -- a Touched on the blade, a raycast a moment after
		the click -- and the target keeps turning and running the whole time.
		An aim taken at arrival is already stale when the blade lands, which
		is exactly the "it stops killing" case.

		THE RING IS X AND Z ONLY. Their height, exactly. Drifting up or down
		puts a horizontal swing over your head or under your feet, and
		horizontal is what nearly all of these weapons are.

		LOW HEALTH LEAVES. Standing in a swing arc at 12 HP is how this gets
		you killed by the one hit that does connect, so below a threshold it
		backs off and waits to heal instead.

		Being straight about "you cannot die", because it is half true. Melee
		the CLIENT resolves mostly misses you -- by the time their swing lands
		you are somewhere else. Everything the SERVER decides still applies: a
		damage zone, a distance check, fall damage, an admin. Hard to hit, not
		immortal.
	--]]
	-- Weld, CFRAME mode. The same offset a joint would have held, written
	-- into our own root every frame instead. Ours to write, so it replicates.
	if ON.weldEnabled and MISC.weldMode == "CFRAME" and ST.weldOffset
		and not ST.flying and not MISC.frozen then
		local wTarget = ST.weldTarget
		if wTarget and wTarget.Parent then
			local wRoot = character:FindFirstChild("HumanoidRootPart")
			local wHum = character:FindFirstChildOfClass("Humanoid")
			if wHum and MISC.weldFlee and wHum.MaxHealth > 0
				and (wHum.Health / wHum.MaxHealth * 100) < MISC.weldFleeHp then
				-- Read first: disableWeld nils this, and the teleport below
				-- would otherwise find nothing to go back to
				local wHome = ST.weldHome
				FN.disableWeld()
				pcall(function()
					if wRoot and wHome then
						markIntentionalTeleport()
						wRoot.CFrame = wHome
						wRoot.AssemblyLinearVelocity = Vector3.zero
					end
				end)
				FN.toast("Weld let go -- low health")
			elseif wRoot then
				pcall(function()
					markIntentionalTeleport()
					wRoot.CFrame = wTarget.CFrame * ST.weldOffset
					-- Momentum left over from the last frame would drag you off
					-- the offset between writes
					wRoot.AssemblyLinearVelocity = Vector3.zero
					wRoot.AssemblyAngularVelocity = Vector3.zero
				end)
			end
		else
			-- Target gone and the Destroying signal did not fire (streamed out,
			-- reparented). Letting go beats holding an offset to nothing.
			FN.disableWeld()
		end
	end

	if MISC.tpKill and not ST.flying and not MISC.frozen
		and not ST.swingAnchor and not MACRO.playing then

		local kRoot = character:FindFirstChild("HumanoidRootPart")
		local kHum = character:FindFirstChildOfClass("Humanoid")

		if kRoot and kHum and kHum.Health > 0 then
			-- Health gate, with hysteresis. Without the gap you flicker in and
			-- out at exactly the threshold, which is worse than either staying
			-- or leaving.
			--
			-- Deliberately above the target search rather than inside it: your
			-- own health does not depend on having somebody to fight, and when
			-- this was nested you could flee, heal up alone in a corner, and
			-- have the latch stay set -- button still reading LOW HP -- until
			-- somebody happened to walk back into range.
			local pct = 100
			if kHum.MaxHealth > 0 then
				pct = kHum.Health / kHum.MaxHealth * 100
			end
			if MISC.tpKillFlee then
				if ST.tpKillFleeing then
					if pct >= math.min(100, MISC.tpKillFleeHp + 15) then
						ST.tpKillFleeing = false
						FN.toast("TP Kill: healed up, going back in")
					end
				elseif pct < MISC.tpKillFleeHp then
					ST.tpKillFleeing = true
					ST.tpKillFleeAt = 0
					FN.toast("TP Kill: low HP -- backing off")
				end
			else
				ST.tpKillFleeing = false
			end

			-- Re-pick when the target dies or leaves. Held between ticks so we
			-- are not choosing a different person every frame and teleporting
			-- between two fights.
			local t = ST.tpKillTarget
			local tRoot = t and t.Parent and t:FindFirstChild("HumanoidRootPart")
			local tHum = t and t.Parent and t:FindFirstChildOfClass("Humanoid")
			if not tRoot or not tHum or tHum.Health <= 0 then
				ST.tpKillTarget = nil
				tRoot = nil
			end

			-- Held targets get a range check too, with slack so it does not
			-- chatter on the boundary. Without it a target who simply runs away
			-- takes you with them, one hop at a time, however far they go.
			if tRoot and (tRoot.Position - kRoot.Position).Magnitude
				> (MISC.tpKillRange or 250) * 1.5 then
				ST.tpKillTarget = nil
				tRoot = nil
			end

			if not tRoot then
				local now = tick()
				-- Skipped targets expire, and dead ones are dropped outright so
				-- the table is not quietly holding character models forever
				for m, t2 in pairs(ST.tpKillSkip) do
					if t2 < now or not m.Parent then ST.tpKillSkip[m] = nil end
				end

				local mySide = ST.sideOf(character, player)
				local kCamPick = Workspace.CurrentCamera
				local best, bestScore
				for _, entry in ipairs(ST.charList()) do
					local ch, pl, hum = entry.model, entry.plr, entry.hum
					local hrp = ch and ch ~= character
						and ch:FindFirstChild("HumanoidRootPart")
					if hrp and hum and hum.Health > 0 and not ST.tpKillSkip[ch] then
						local skip = false
						if MISC.tpKillSide ~= "ALL" then
							local theirs = ST.sideOf(ch, pl)
							local same = mySide ~= nil and theirs ~= nil and mySide == theirs
							skip = (MISC.tpKillSide == "ENEMIES") and same or not same
						end
						local d = (hrp.Position - kRoot.Position).Magnitude
						if not skip and d <= (MISC.tpKillRange or 250) then
							-- Lower score wins, whatever the mode measures
							local score = d
							if MISC.tpKillPick == "WEAKEST" then
								score = hum.Health
							elseif MISC.tpKillPick == "AIMED" and kCamPick then
								local to = hrp.Position - kCamPick.CFrame.Position
								if to.Magnitude > 0.01 then
									-- 0 is dead ahead, 2 is directly behind
									score = 1 - kCamPick.CFrame.LookVector:Dot(to.Unit)
								end
							end
							if not bestScore or score < bestScore then
								best, bestScore = ch, score
							end
						end
					end
				end
				if best then
					ST.tpKillTarget = best
					tRoot = best:FindFirstChild("HumanoidRootPart")
					ST.tpKillHits = 0
				end
			end

			if tRoot then
				-- Where they are GOING. At eight hops a second a sprinting
				-- target has moved a couple of studs by the time we arrive,
				-- and an un-led ring trails permanently behind them.
				local aimAt = tRoot.Position
				if MISC.tpKillLead then
					local tv = tRoot.AssemblyLinearVelocity
					aimAt = aimAt + Vector3.new(tv.X, 0, tv.Z) * 0.15
				end

				if ST.tpKillFleeing then
					-- Somewhere else, and somewhere else again if they follow.
					-- Straight away from them, at your own height -- a retreat
					-- that changes your altitude is a retreat into fall damage.
					if (tRoot.Position - kRoot.Position).Magnitude
						< (MISC.tpKillFleeDist * 0.6)
						and tick() - (ST.tpKillFleeAt or 0) >= 0.5 then
						ST.tpKillFleeAt = tick()
						local away = kRoot.Position - tRoot.Position
						away = Vector3.new(away.X, 0, away.Z)
						if away.Magnitude < 0.1 then away = Vector3.new(1, 0, 0) end
						local spot = tRoot.Position + away.Unit * MISC.tpKillFleeDist
						pcall(function()
							markIntentionalTeleport()
							kRoot.CFrame = CFrame.new(
								Vector3.new(spot.X, kRoot.Position.Y, spot.Z))
								* kRoot.CFrame.Rotation
							kRoot.AssemblyLinearVelocity = Vector3.zero
						end)
					end
				else
					if tick() - (ST.tpKillAt or 0) >= (1 / (MISC.tpKillRate or 8)) then
						ST.tpKillAt = tick()

						local angle = math.random() * math.pi * 2
						local r = MISC.tpKillRadius or 6
						-- X and Z only: their height exactly, no vertical drift
						local spot = aimAt + Vector3.new(
							math.cos(angle) * r, 0, math.sin(angle) * r)

						pcall(function()
							markIntentionalTeleport()
							kRoot.CFrame = CFrame.lookAt(spot, aimAt)
							kRoot.AssemblyLinearVelocity = Vector3.zero
						end)
					end

					-- ---- aim, every frame ----
					local kCam = Workspace.CurrentCamera

					-- Yaw only for the body. A full lookAt tips the character
					-- over when the target jumps, and a tipped root walks
					-- strangely and reads as broken.
					local flat = Vector3.new(aimAt.X, kRoot.Position.Y, aimAt.Z)
					if (flat - kRoot.Position).Magnitude > 0.05 then
						pcall(function()
							kRoot.CFrame = CFrame.lookAt(kRoot.Position, flat)
						end)
					end

					-- The camera and the cursor are aimed in FN.tpKillAim,
					-- which runs from the render bind. Driving them from here
					-- does not work: the default camera module rewrites CFrame
					-- after this pass, so every aim written here was thrown
					-- away before it reached the screen.
					local aimCF
					if kCam then
						local eye = kCam.CFrame.Position
						if (aimAt - eye).Magnitude > 0.05 then
							aimCF = CFrame.lookAt(eye, aimAt)
						end
					end

					if MISC.tpKillClick and VirtualUser and (aimCF or kCam) then
						-- Counted only when the click actually went out. The
						-- old version incremented outside the result and
						-- happily showed a rising hit count on an executor
						-- where nothing was being sent at all.
						local shot = aimCF or kCam.CFrame
						local sent = pcall(function()
							VirtualUser:Button1Down(Vector2.new(0, 0), shot)
							VirtualUser:Button1Up(Vector2.new(0, 0), shot)
						end)
						if sent then ST.tpKillHits = (ST.tpKillHits or 0) + 1 end
					end
				end
			end
		end
	end

	-- Wall hop. Jump into a wall and kick off it -- again and again, so a wall
	-- taller than your jump becomes a staircase. Separate from Wall Climb: that
	-- one sticks you to the surface, this one never stops moving.
	--
	-- VAULT is the other thing people mean by the same word: a low wall in
	-- front of you gets hopped over instead of walked into.
	if MISC.wallHop and not ST.flying and not MISC.frozen and not ST.swingAnchor then
		local hHum = character:FindFirstChildOfClass("Humanoid")
		local hRoot = character:FindFirstChild("HumanoidRootPart")
		if hHum and hRoot and not hHum.Sit then
			-- Last frame's hop, applied now. Written on the press it would
			-- have been overwritten by the humanoid's own jump impulse, which
			-- the physics step applies after Stepped has run.
			if ST.wallHopVel then
				local v = ST.wallHopVel
				ST.wallHopVel = nil
				pcall(function() hRoot.AssemblyLinearVelocity = v end)
			end

			local grounded = hHum.FloorMaterial ~= Enum.Material.Air
			if grounded then ST.wallHops = 0 end

			local typingH = UserInputService:GetFocusedTextBox() ~= nil
			local jumpDown = not typingH and UserInputService:IsKeyDown(Enum.KeyCode.Space)
			-- Edge, not level: holding space would otherwise fire a hop every
			-- frame and shoot you into orbit
			local pressed = jumpDown and not ST.jumpHeld
			ST.jumpHeld = jumpDown

			if pressed then
				local params = RaycastParams.new()
				params.FilterType = Enum.RaycastFilterType.Exclude
				params.FilterDescendantsInstances = { character, ST.airWalkPart, ST.waterPart }

				-- Where you are going, or where you are looking if you are still
				local dir = hHum.MoveDirection
				if dir.Magnitude < 0.1 then
					local hCam = Workspace.CurrentCamera
					dir = hCam and hCam.CFrame.LookVector or hRoot.CFrame.LookVector
				end
				dir = Vector3.new(dir.X, 0, dir.Z)

				-- Says what it decided, every press. Two rounds were spent
				-- guessing which gate this was failing at from outside the
				-- game; a line of text answers it in one jump.
				local function hopSay(why)
					if MISC.wallHopDebug then FN.toast("Wall Hop: " .. why) end
				end

				if dir.Magnitude <= 0.1 then
					hopSay("no direction -- move or face the wall")
				end
				if dir.Magnitude > 0.1 then
					dir = dir.Unit
					local reach = MISC.wallHopReach or 3.5
					local hit = Workspace:Raycast(hRoot.Position, dir * reach, params)

					if not hit then
						hopSay("no wall within " .. reach .. " studs")
					elseif math.abs(hit.Normal.Y) >= 0.5 then
						hopSay("that surface is too flat to kick off")
					end

					if hit and math.abs(hit.Normal.Y) < 0.5 then
						local mode = MISC.wallHopMode or "BOTH"
						local power = MISC.wallHopPower or 55

						-- Is it something we could just hop over? Look for open
						-- air a little above the hit, with floor beyond it.
						local vaulted = false
						if mode ~= "CLIMB" then
							local overHead = hRoot.Position + Vector3.new(0, 4, 0)
							local clear = Workspace:Raycast(overHead, dir * 4, params)
							if not clear then
								-- Low wall: nothing blocking at head height
								vaulted = true
								ST.wallHopVel =
									Vector3.new(dir.X * 26, power * 0.85, dir.Z * 26)
								if tick() - (ST.vaultSaidAt or 0) > 6 then
									ST.vaultSaidAt = tick()
									FN.toast("Vaulted -- Wall Hop is on")
								end
							end
						end

						-- Kick off it. Up hard, away gently -- away too hard and
						-- you cannot chain the next hop on the same wall.
						if not vaulted and mode == "VAULT" then
							hopSay("mode is VAULT and there was nothing to vault")
						elseif not vaulted
							and (ST.wallHops or 0) >= (MISC.wallHopMax or 3) then
							hopSay("out of hops (" .. (MISC.wallHopMax or 3)
								.. " per jump) -- touch the ground to reset")
						end

						if not vaulted and mode ~= "VAULT"
							and (ST.wallHops or 0) < (MISC.wallHopMax or 3) then
							ST.wallHops = (ST.wallHops or 0) + 1
							local away = hit.Normal * (power * 0.30)
							-- Queued for next frame, not written now: see the
							-- note at the top of this block
							ST.wallHopVel = Vector3.new(away.X, power, away.Z)
							pcall(function()
								hHum:ChangeState(Enum.HumanoidStateType.Jumping)
							end)
							hopSay("hop " .. ST.wallHops .. "/"
								.. (MISC.wallHopMax or 3))
						end
					end
				end
			end
		end
	elseif ST.jumpHeld then
		ST.jumpHeld = false
	end

	--[[
		Head turn. The head follows the camera, and once it cannot turn any
		further the body comes round to meet it.

		The joint maths is the only awkward part, because R6 and R15 bake
		different rotations into their neck C0 -- multiplying a rotation onto
		the right of C0 turns the head about the JOINT's axes, which for R6 are
		rotated ninety degrees and produce a head lying on its side.

		Rebuilding C0 as (pivot) * (our rotation) * (its original rotation)
		applies the turn in the TORSO's axes instead, which are the same on
		both rigs. One formula, no rig check, no lookup table of magic angles.

		Worth knowing: C0 changes are not replicated for you, so other players
		may not see this. It is yours to look at unless the game itself
		replicates joints.
	--]]
	if MISC.headTurn and not MISC.frozen then
		local nHum = character:FindFirstChildOfClass("Humanoid")
		local nRoot = character:FindFirstChild("HumanoidRootPart")
		local nCam = Workspace.CurrentCamera

		if nHum and nRoot and nCam and nHum.Health > 0 then
			local rel = nRoot.CFrame:VectorToObjectSpace(nCam.CFrame.LookVector)
			-- Zero when looking straight ahead; positive yaw is to your left
			local yaw = math.atan2(-rel.X, -rel.Z)
			local pitch = math.asin(math.clamp(rel.Y, -1, 1))

			local maxYaw = math.rad(MISC.headMaxYaw or 70)
			local maxPitch = math.rad(MISC.headMaxPitch or 40)
			local useYaw = math.clamp(yaw, -maxYaw, maxYaw)
			local usePitch = math.clamp(pitch, -maxPitch, maxPitch)

			-- Smoothed, or every camera twitch snaps the neck
			local a = math.clamp((MISC.headSpeed or 12) * deltaTime, 0, 1)
			ST.headYaw = (ST.headYaw or 0) + (useYaw - (ST.headYaw or 0)) * a
			ST.headPitch = (ST.headPitch or 0) + (usePitch - (ST.headPitch or 0)) * a

			-- Past the limit: turn the body to absorb the difference. This is
			-- the "auto rotate" -- look far enough round and you turn to follow.
			if MISC.headBody then
				local excess = yaw - useYaw
				if math.abs(excess) > 0.01 then
					local step = math.clamp(excess,
						-(MISC.headTurnRate or 4) * deltaTime,
						(MISC.headTurnRate or 4) * deltaTime)
					pcall(function()
						nRoot.CFrame = nRoot.CFrame * CFrame.Angles(0, step, 0)
					end)
				end
			end

			-- Waist takes a share of the yaw on R15 so the whole torso leans
			-- into the look instead of the head doing all of it alone
			local share = (MISC.headWaist and 0.35) or 0
			FN.setJoint(character, "Neck", ST.headPitch, ST.headYaw * (1 - share))
			if share > 0 then
				FN.setJoint(character, "Waist", ST.headPitch * 0.3, ST.headYaw * share)
			end
		end
	elseif next(ST.jointOrig) ~= nil then
		FN.restoreJoints()
	end

	-- Web Swing. Hold the key and a line goes out to whatever is above and
	-- ahead of you; from then on it behaves like a rope rather than a tractor
	-- beam. A rope cannot push, it can only stop you leaving, so all this does
	-- is delete the part of your velocity heading away from the anchor once the
	-- line is taut -- gravity supplies the arc, and letting go keeps whatever
	-- speed the arc built. That is the whole appeal: the speed is earned.
	if MISC.swing and not ST.flying and not MISC.frozen then
		local wHum = character:FindFirstChildOfClass("Humanoid")
		local wRoot = character:FindFirstChild("HumanoidRootPart")
		local typingW = UserInputService:GetFocusedTextBox() ~= nil
		local heldW = MISC.swing and KEYS.swing
			and UserInputService:IsKeyDown(KEYS.swing) and not typingW

		if heldW and wHum and wRoot and not wHum.Sit then
			if not ST.swingAnchor then
				-- Fire up and forward. Straight up finds the ceiling of every
				-- room you stand in; straight ahead finds the wall in front of
				-- your face. The diagonal is the one that finds a rooftop.
				local params = RaycastParams.new()
				params.FilterType = Enum.RaycastFilterType.Exclude
				params.FilterDescendantsInstances = { character, ST.airWalkPart, ST.waterPart }

				local cam = Workspace.CurrentCamera
				local fwd = cam and cam.CFrame.LookVector or wRoot.CFrame.LookVector
				fwd = Vector3.new(fwd.X, 0, fwd.Z)
				if fwd.Magnitude < 0.1 then fwd = wRoot.CFrame.LookVector end
				fwd = fwd.Unit

				local reach = MISC.swingRange or 120
				local tries = {
					(fwd + Vector3.new(0, 1.4, 0)).Unit,
					(fwd + Vector3.new(0, 0.6, 0)).Unit,
					Vector3.new(0, 1, 0),
				}
				for _, d in ipairs(tries) do
					local r = Workspace:Raycast(wRoot.Position, d * reach, params)
					if r then
						ST.swingAnchor = r.Position
						ST.swingLen = math.max((r.Position - wRoot.Position).Magnitude, 6)
						break
					end
				end
				if not ST.swingAnchor then
					ST.swingMissAt = ST.swingMissAt or 0
					if tick() - ST.swingMissAt > 1 then
						ST.swingMissAt = tick()
						FN.toast("Web Swing: nothing to anchor to")
					end
				end
			end

			if ST.swingAnchor then
				local toAnchor = ST.swingAnchor - wRoot.Position
				local dist = toAnchor.Magnitude
				if dist > 0.5 then
					local dirU = toAnchor.Unit
					local vel = wRoot.AssemblyLinearVelocity

					-- Reel in and pay out. Shortening mid-arc is how you gain
					-- height, which is the one input a real swing responds to.
					if not typingW then
						if UserInputService:IsKeyDown(Enum.KeyCode.W) then
							ST.swingLen = math.max(ST.swingLen - 40 * deltaTime, 6)
						elseif UserInputService:IsKeyDown(Enum.KeyCode.S) then
							ST.swingLen = math.min(ST.swingLen + 40 * deltaTime,
								MISC.swingRange or 120)
						end
					end

					if dist > ST.swingLen then
						-- Taut. Kill only the outward component; everything
						-- across the rope is left alone, and that is the swing.
						local outward = -dirU:Dot(vel)
						if outward > 0 then vel = vel + dirU * outward end
						pcall(function()
							wRoot.CFrame = CFrame.new(ST.swingAnchor - dirU * ST.swingLen)
								* wRoot.CFrame.Rotation
						end)
					end

					-- A/D lean, so you can steer the arc instead of riding it
					if not typingW then
						local side = wRoot.CFrame.RightVector
						local lean = MISC.swingPush or 26
						if UserInputService:IsKeyDown(Enum.KeyCode.D) then
							vel = vel + side * lean * deltaTime
						end
						if UserInputService:IsKeyDown(Enum.KeyCode.A) then
							vel = vel - side * lean * deltaTime
						end
					end

					pcall(function() wRoot.AssemblyLinearVelocity = vel end)
				end

				-- The line itself. One part, reused, so a long swing does not
				-- litter the workspace with rope segments.
				if MISC.swingLine then
					if not ST.swingRope or not ST.swingRope.Parent then
						local rope = Instance.new("Part")
						rope.Name = "WebLine" .. uiName
						rope.Anchored = true
						rope.CanCollide = false
						rope.CanQuery = false
						rope.CanTouch = false
						rope.Material = Enum.Material.Neon
						rope.Color = Color3.fromRGB(240, 240, 255)
						rope.Parent = Workspace
						ST.swingRope = rope
					end
					local mid = (ST.swingAnchor + wRoot.Position) / 2
					pcall(function()
						ST.swingRope.Size = Vector3.new(0.12, 0.12, math.max(dist, 0.1))
						ST.swingRope.CFrame = CFrame.lookAt(mid, ST.swingAnchor)
					end)
				end
			end
		elseif ST.swingAnchor or ST.swingRope then
			-- Let go: the velocity stays, which is the point
			ST.swingAnchor = nil
			if ST.swingRope then
				pcall(function() ST.swingRope:Destroy() end)
				ST.swingRope = nil
			end
		end
	elseif ST.swingAnchor or ST.swingRope then
		ST.swingAnchor = nil
		if ST.swingRope then
			pcall(function() ST.swingRope:Destroy() end)
			ST.swingRope = nil
		end
	end

	-- Hitbox expander. Grows other players' root parts so a swing that passes
	-- near them still lands.
	--
	-- Worth being straight about what this can and cannot do: you do not own
	-- their character on the network, so the resized part is a LOCAL opinion.
	-- It moves hits the CLIENT decides -- a raycast or a Touched from a tool
	-- running on your machine -- and does nothing at all where the server does
	-- its own distance check. In a game that trusts the client it is the whole
	-- fight; in one that does not it is decoration.
	if MISC.hitbox then
		if tick() - (ST.hitboxAt or 0) > 0.25 then
			ST.hitboxAt = tick()
			local mySide = ST.sideOf(character, player)
			local size = math.clamp(MISC.hitboxSize or 8, 2, 40)

			for _, entry in ipairs(ST.charList()) do
				local ch = entry.model
				local pl = entry.plr
				if ch and ch ~= character then
					local want = true
					if MISC.hitboxTarget ~= "ALL" then
						local theirSide = ST.sideOf(ch, pl)
						local sameTeam = mySide ~= nil and theirSide ~= nil
							and mySide == theirSide
						if MISC.hitboxTarget == "ENEMIES" then
							want = not sameTeam
						else
							want = sameTeam
						end
					end

					local hrp = ch:FindFirstChild("HumanoidRootPart")
					if want and hrp then
						-- Everything we are about to overwrite, recorded before
						-- the first write. Size alone is not enough: putting a
						-- part back means putting ALL of it back.
						if ST.hitboxOrig[hrp] == nil then
							ST.hitboxOrig[hrp] = {
								size = hrp.Size,
								collide = hrp.CanCollide,
								massless = hrp.Massless,
								clear = hrp.Transparency,
							}
						end
						pcall(function()
							hrp.Size = Vector3.new(size, size, size)
							-- Massless and non-collidable, or a grown root part
							-- shoves people around and reads as an obvious fling
							hrp.Massless = true
							hrp.CanCollide = false
							hrp.Transparency = MISC.hitboxShow and 0.75 or 1
						end)
					elseif hrp and ST.hitboxOrig[hrp] then
						-- Stopped qualifying since the last pass. Sides are not
						-- fixed -- Kat swaps a survivor to Infected mid-round --
						-- and without this they keep the big box all game.
						local was = ST.hitboxOrig[hrp]
						ST.hitboxOrig[hrp] = nil
						pcall(function()
							hrp.Size = was.size
							hrp.CanCollide = was.collide
							hrp.Massless = was.massless
							hrp.Transparency = was.clear
						end)
					end
				end
			end
		end
	elseif next(ST.hitboxOrig) ~= nil then
		-- Switched off: put every part we touched back, then forget them
		for part, was in pairs(ST.hitboxOrig) do
			pcall(function()
				if part and part.Parent then
					part.Size = was.size
					part.CanCollide = was.collide
					part.Massless = was.massless
					part.Transparency = was.clear
				end
			end)
		end
		table.clear(ST.hitboxOrig)
	end

	-- Wall climb (Spider-Man). Cast forward for a wall; if one is there, stick
	-- to it and rotate the whole character flat against it -- belly to the wall,
	-- head pointing up the wall -- then climb with WASD along the surface.
	--
	-- PlatformStand is forced on while stuck, or the Humanoid keeps trying to
	-- stand the character upright and fights the rotation every frame.
	if MISC.spider and not ST.flying and not MISC.frozen and not ST.swingAnchor then
		local sHum = character:FindFirstChildOfClass("Humanoid")
		local sRoot = character:FindFirstChild("HumanoidRootPart")
		-- Not while seated: forcing CFrame against a seat weld desyncs you from
		-- the seat and the server drags you back, same as the fly-in-a-seat bug
		if sHum and sRoot and not sHum.Sit then
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { character, ST.airWalkPart, ST.waterPart }

			local origin = sRoot.Position
			local range = MISC.spiderRange or 6

			-- Standing on something? FloorMaterial reads Air the moment
			-- PlatformStand goes on, so once we are clung to a wall it stops being
			-- an answer -- a short ray down is the one that keeps working.
			local grounded = sHum.FloorMaterial ~= Enum.Material.Air
			if not grounded then
				grounded = Workspace:Raycast(origin, Vector3.new(0, -4.5, 0), params) ~= nil
			end

			local typing = UserInputService:GetFocusedTextBox() ~= nil
			local kW = not typing and UserInputService:IsKeyDown(Enum.KeyCode.W)
			local kS = not typing and UserInputService:IsKeyDown(Enum.KeyCode.S)
			local kA = not typing and UserInputService:IsKeyDown(Enum.KeyCode.A)
			local kD = not typing and UserInputService:IsKeyDown(Enum.KeyCode.D)
			local kJump = not typing and UserInputService:IsKeyDown(Enum.KeyCode.Space)

			-- S while your feet are on the floor means "walk away from the wall",
			-- never "climb". Without this you cannot back out of anything: facing
			-- a wall is enough to stick to it, and S just grinds you down it.
			local backingOff = kS and grounded

			local hit
			if not backingOff then
				-- The wall we are already on gets first refusal. Re-casting along
				-- the old normal stops a corner or a doorframe from flipping us
				-- between two surfaces every frame.
				local dirs = {}
				if ST.spiderNormal then dirs[#dirs + 1] = -ST.spiderNormal end
				dirs[#dirs + 1] = sRoot.CFrame.LookVector
				local sCam = Workspace.CurrentCamera
				if sCam then dirs[#dirs + 1] = sCam.CFrame.LookVector end

				for _, d in ipairs(dirs) do
					local flat = Vector3.new(d.X, 0, d.Z)
					-- Flattening a straight-up look leaves nothing to aim with; in
					-- ceiling mode the unflattened direction is the useful one
					if flat.Magnitude <= 0.1 and MISC.spiderCeiling then flat = d end
					if flat.Magnitude > 0.1 then
						local r = Workspace:Raycast(origin, flat.Unit * range, params)
						-- A wall is a near-vertical face: its normal is nearly flat.
						-- Ceiling mode drops that test so any surface will hold you,
						-- which is what crawling upside down needs.
						-- Ceiling mode only relaxes the test once your feet have
					-- left the floor. On the ground it stays walls-only, or
					-- walking past a slope snatches you onto it.
					if r and ((MISC.spiderCeiling and not grounded)
						or math.abs(r.Normal.Y) < 0.5) then
							hit = r
							break
						end
					end
				end

				-- Nothing ahead: in ceiling mode look straight up too, since a
				-- ceiling is never in front of a character standing upright
				if not hit and MISC.spiderCeiling and not grounded then
					hit = Workspace:Raycast(origin, Vector3.new(0, range, 0), params)
				end
			end

			-- Wall jump: shove off the surface you are on. Real Spider-Man
			-- traversal is wall to wall, and without this the only way off a
			-- building is to climb back down the way you came.
			if hit and kJump and MISC.spiderJump and ST.spiderStuck
				and tick() - (ST.spiderJumpAt or 0) > 0.35 then
				local N = hit.Normal
				ST.spiderJumpAt = tick()
				ST.spiderStuck = false
				ST.spiderNormal = nil
				ST.spiderHover = nil
				hit = nil
				pcall(function()
					sHum.PlatformStand = false
					sHum:ChangeState(Enum.HumanoidStateType.GettingUp)
					sRoot.AssemblyLinearVelocity =
						N * (MISC.spiderSpeed or 20) * 2 + Vector3.new(0, 45, 0)
				end)
			end

			if hit then
				ST.spiderStuck = true
				ST.spiderNormal = hit.Normal
				ST.spiderHover = nil
				pcall(function() sHum.PlatformStand = true end)

				local N = hit.Normal
				-- Up-the-wall tangent: world up with the wall-normal part removed
				local up = Vector3.yAxis - N * N:Dot(Vector3.yAxis)
				if up.Magnitude < 0.01 then
					-- Flat against a ceiling or a floor -- there is no "up the
					-- wall" left, so up-the-surface becomes whichever way you look
					local rCam = Workspace.CurrentCamera
					local ref = rCam and rCam.CFrame.LookVector or Vector3.zAxis
					up = ref - N * N:Dot(ref)
					if up.Magnitude < 0.01 then up = Vector3.xAxis end
				end
				up = up.Unit
				-- up x N, not N x up. Clinging, you face INTO the wall, so your
				-- look direction is -N and your right is look x up = -(N x up).
				-- Getting this backwards swapped A and D on every wall.
				local rightv = up:Cross(N)

				-- Flush to the wall at the current height, then climb
				local pos = hit.Position + N * 2
				local mv = Vector3.zero
				if kW then mv = mv + up end
				if kS then mv = mv - up end
				if kD then mv = mv + rightv end
				if kA then mv = mv - rightv end
				if mv.Magnitude > 0 then
					pos = pos + mv.Unit * (MISC.spiderSpeed or 20) * deltaTime
				end

				-- Mantle. Climbing past the top of a wall should put you standing
				-- ON it, not drop you off the back the instant the ray misses.
				local mantled = false
				if kW and MISC.spiderMantle and tick() - (ST.spiderMantleAt or 0) > 0.6 then
					local lip = pos + up * 3.5
					-- Floor over the lip, and nothing left in front of us: that
					-- pair is what "we just cleared the top" actually looks like
					local over = Workspace:Raycast(lip - N * 2.5, Vector3.new(0, -7, 0), params)
					local ahead = Workspace:Raycast(lip, -N * 4, params)
					if over and not ahead then
						mantled = true
						ST.spiderMantleAt = tick()
						ST.spiderStuck = false
						ST.spiderNormal = nil
						pcall(function()
							sRoot.CFrame = CFrame.new(over.Position + Vector3.new(0, 3.5, 0))
							sRoot.AssemblyLinearVelocity = Vector3.zero
							sHum.PlatformStand = false
							sHum:ChangeState(Enum.HumanoidStateType.GettingUp)
						end)
						FN.toast("Mantled the ledge")
					end
				end

				if not mantled then
					pcall(function()
						-- Face INTO the wall, up along it: the Spider-Man cling
						sRoot.CFrame = CFrame.lookAt(pos, pos - N, up)
						sRoot.AssemblyLinearVelocity = Vector3.zero
						sRoot.AssemblyAngularVelocity = Vector3.zero
					end)
				end
			else
				if ST.spiderStuck then
					-- Off the edge, backing away, or the wall simply ended: let go
					-- and stand back up so the fall is an ordinary one
					ST.spiderStuck = false
					ST.spiderNormal = nil
					pcall(function()
						sHum.PlatformStand = false
						sHum:ChangeState(Enum.HumanoidStateType.GettingUp)
					end)
				end

				-- Float. No wall, no keys, feet off the ground: hang in the air
				-- instead of dropping. Touching any movement key hands you back to
				-- gravity, so falling is always exactly one keypress away.
				--
				-- Glide does not fight this even on AUTO: glide only engages while
				-- you are descending, and a held float has no downward speed.
				-- A wall jump or a zip sets a velocity and then usually has no
				-- key held at all -- exactly what float reads as "do nothing".
				-- Without this grace window float freezes you mid-launch.
				local launched = tick() - math.max(ST.spiderJumpAt or 0, ST.spiderZipAt or 0) < 1.2
				-- Typing forces every key above to read as up, which is exactly
				-- what float treats as "doing nothing" -- so opening the search
				-- box in mid-air used to pin you there with no way to say stop
				local idle = not (kW or kS or kA or kD or kJump)
					and not launched and not typing

				if MISC.spiderFloat and idle and not grounded then
					if not ST.spiderHover then
						ST.spiderHover = sRoot.Position
						-- Say it the first time it happens. Hanging in mid-air
						-- with no idea which of thirty toggles is responsible is
						-- a worse experience than the feature is worth.
						if tick() - (ST.floatSaidAt or 0) > 20 then
							ST.floatSaidAt = tick()
							FN.toast("Idle Float is holding you -- tap WASD to drop")
						end
					end
					pcall(function()
						sRoot.CFrame = CFrame.new(ST.spiderHover) * sRoot.CFrame.Rotation
						sRoot.AssemblyLinearVelocity = Vector3.zero
					end)
				else
					ST.spiderHover = nil
				end
			end
		end
	elseif ST.spiderStuck or ST.spiderHover then
		-- Feature switched off mid-cling
		ST.spiderStuck = false
		ST.spiderNormal = nil
		ST.spiderHover = nil
		local offHum = character:FindFirstChildOfClass("Humanoid")
		if offHum then
			pcall(function()
				offHum.PlatformStand = false
				offHum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end)
		end
	end

	-- Glide. Airborne + holding the glide key = a slow, controllable fall for a
	-- limited time, refilled when you touch ground. Not real flight -- you keep
	-- descending, just gently, and you steer with WASD.
	if MISC.glide and not ST.flying and not MISC.frozen and not ST.airWalkPart then
		local gHum = character:FindFirstChildOfClass("Humanoid")
		local gRoot = character:FindFirstChild("HumanoidRootPart")
		if gHum and gRoot then
			if gHum.FloorMaterial ~= Enum.Material.Air then
				-- On the ground: recharge
				MISC.glideLeft = MISC.glideTime
			else
				-- AUTO glides on its own while falling -- no key to hold. HOLD keeps
				-- the old behaviour for anyone who wants it on demand.
				local active
				if MISC.glideAuto then
					active = true
				else
					active = KEYS.glide and UserInputService:IsKeyDown(KEYS.glide)
						and not UserInputService:GetFocusedTextBox()
				end
				local vel = gRoot.AssemblyLinearVelocity
				-- Only while descending; gliding does not cancel a jump's rise
				if active and (MISC.glideLeft or 0) > 0 and vel.Y < 0 then
					MISC.glideLeft = MISC.glideLeft - deltaTime

					-- Descent capped to a gentle rate
					local newY = math.max(vel.Y, -(MISC.glideFall or 8))

					-- Steer with WASD relative to the camera, so it feels like
					-- guiding a glide rather than sliding on rails
					local move = Vector3.zero
					local look, right = Vector3.zero, Vector3.zero
					-- Forward is where the CHARACTER faces, not the camera --
					-- you glide the way your body points, and the camera is just
					-- how you look around while doing it. Camera is the opt-in
					-- alternative for anyone who wants free-look steering.
					local src
					if MISC.glideCharFace then
						src = gRoot.CFrame
					else
						src = Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame
					end
					if src then
						look = src.LookVector
						right = src.RightVector
						look = Vector3.new(look.X, 0, look.Z)
						right = Vector3.new(right.X, 0, right.Z)
					end

					-- Forced forward: a real glider keeps moving even with your
					-- hands off the keys, so the camera's forward is the baseline.
					-- WASD steers on top of it -- A/D bank, S brakes and can back
					-- you off, W just leans harder into the same direction.
					if MISC.glideForward and look.Magnitude > 0 then
						move = look
					end

					if not UserInputService:GetFocusedTextBox() then
						if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + look end
						if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - look * 2 end
						if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - right end
						if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + right end
					end
					if move.Magnitude > 0 then move = move.Unit * (MISC.glideSpeed or 40) end

					gRoot.AssemblyLinearVelocity = Vector3.new(move.X, newY, move.Z)
				end
			end
		end
	end

	-- Auto get up. Knockback and ragdoll scripts leave PlatformStand set, and
	-- some never clear it -- you lie there until you respawn. Skipped when one
	-- of our own features is deliberately holding it, or this would fight them.
	if MISC.autoGetUp and not ST.flying and not ON.weldEnabled
		and not ST.laying and not KILL.seatOn then
		local upHum = character:FindFirstChildOfClass("Humanoid")
		if upHum and upHum.PlatformStand then
			pcall(function()
				upHum.PlatformStand = false
				upHum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end)
		end
	end

	-- Auto eat and the health warning share one read of the humanoid, on a slow
	-- timer: health changes matter in seconds, not frames.
	if (MISC.autoEat or MISC.hpWarn) and os.clock() >= (MISC.eatCd or 0) then
		MISC.eatCd = os.clock() + 1
		local eatHum = character:FindFirstChildOfClass("Humanoid")
		if eatHum and eatHum.MaxHealth > 0 and eatHum.Health > 0 then
			local pct = (eatHum.Health / eatHum.MaxHealth) * 100

			-- Shares the on-screen label with the Kat alert. Two features owning
			-- one label meant whichever ran last won: the Kat scan hid a live
			-- health warning four times a second, and the health block never
			-- cleared itself when you healed, so it also outstayed its welcome
			-- whenever the Kat scan was off. The flag decides who owns it.
			if MISC.hpWarn and pct <= MISC.hpWarnAt then
				MISC.hpActive = true
				DEC.katWarn.Text = string.format("LOW HEALTH  %d%%", math.floor(pct))
				DEC.katWarn.BackgroundColor3 = THEME.danger
				DEC.katWarn.BackgroundTransparency = 0.15
				DEC.katWarn.Visible = true
			elseif MISC.hpActive then
				-- Healed, or the feature was switched off: give the label back
				MISC.hpActive = false
				DEC.katWarn.Visible = false
			end

			if MISC.autoEat and pct <= MISC.eatAt then
				-- Spawned: using an item switches slots and waits, and this is
				-- inside the per-frame loop
				task.spawn(function()
					local ate = ST.useFood(character, eatHum)
					if ate then FN.toast(string.format("Ate at %d%%", math.floor(pct))) end
					-- Longer gap after eating, so one apple is not spent per
					-- second while the health bar catches up
					MISC.eatCd = os.clock() + 4
				end)
			end
		end
	end

	-- Anti-fling: bleed off any large spin the server/other players try to apply.
	-- Skipped while flying/spinbotting so it doesn't fight our own movement.
	if ON.antiFlingEnabled and not ST.flying and not ON.spinbotEnabled
		and not MISC.touchFling then
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if hrp then
			-- Tunable, because a fling does not have to be fast to work. The
			-- old fixed 250/40 only caught violent ones and let a slow shove
			-- through untouched. Lower these until it stops; too low and normal
			-- movement gets clipped, so the right value is the highest one that
			-- still blocks it.
			local spinCap = MISC.flingSpin or 20
			local moveCap = MISC.flingSpeed or 120

			if hrp.AssemblyAngularVelocity.Magnitude > spinCap then
				hrp.AssemblyAngularVelocity = Vector3.zero
			end
			if hrp.AssemblyLinearVelocity.Magnitude > moveCap then
				hrp.AssemblyLinearVelocity = hrp.AssemblyLinearVelocity.Unit * moveCap
			end
		end
	end

	-- Auto sprint: multiply the walk speed while Shift is held. Written only on
	-- a change, and the base is whatever Walk Speed Mod would otherwise apply,
	-- so the two features stack instead of overwriting each other.
	if MISC.sprint and not ST.flying and not UserInputService:GetFocusedTextBox() then
		local hum = character:FindFirstChildOfClass("Humanoid")
		if hum then
			-- RightShift used to count too, but that is the Toggle GUI default:
			-- holding it to sprint hid the menu. One rebindable key instead.
			local held = KEYS.sprint and UserInputService:IsKeyDown(KEYS.sprint)

			if held then
				-- Capture whatever the speed was on the first boosted frame, so
				-- the game's own value is the base. Assuming 16 meant switching
				-- sprint on silently clamped a game that runs you faster.
				if not MISC.sprintBase then MISC.sprintBase = hum.WalkSpeed end
				local want = MISC.sprintBase * MISC.sprintMult
				if math.abs(hum.WalkSpeed - want) > 0.01 then
					hum.WalkSpeed = want
				end
			elseif MISC.sprintBase then
				-- Released: hand back exactly what we took, then stop writing
				if math.abs(hum.WalkSpeed - MISC.sprintBase) > 0.01 then
					hum.WalkSpeed = MISC.sprintBase
				end
				MISC.sprintBase = nil
			end
		end
	end

	-- Anti fall damage. Most games scale the hit off landing speed, so the
	-- simplest reliable client-side fix is never letting that speed build:
	-- terminal velocity is capped rather than trying to react on impact, which
	-- is too late -- the damage is applied the same frame you land.
	if MISC.antiFall and not ST.flying and not MISC.frozen then
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if hrp then
			local cap = MISC.fallCap or 10
			local vel = hrp.AssemblyLinearVelocity
			if vel.Y < -cap then
				hrp.AssemblyLinearVelocity = Vector3.new(vel.X, -cap, vel.Z)
			end
		end
	end

	-- Bunny hop: re-jump the moment we touch down while Space is held. Gated on
	-- FloorMaterial so it can't spam Jump mid-air, and skipped while typing.
	if MISC.bhop and not ST.flying and not UserInputService:GetFocusedTextBox() then
		local hum = character:FindFirstChildOfClass("Humanoid")
		if hum and hum.FloorMaterial ~= Enum.Material.Air
			and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			hum.Jump = true
		end
	end

	-- Walk on water. Swimming is a humanoid state, so it can be detected
	-- directly rather than trying to find the water surface geometrically.
	-- Stands down while air walk has a plate out, so the two never fight over
	-- the same body.
	if MISC.waterWalk and not ST.flying and not ST.airWalkPart then
		local hum = character:FindFirstChildOfClass("Humanoid")
		local hrp = character:FindFirstChild("HumanoidRootPart")
		local swimming = hum and hum:GetState() == Enum.HumanoidStateType.Swimming

		-- Custom water: plenty of games build water out of MeshParts instead of
		-- terrain, and those never put the humanoid into the Swimming state --
		-- so the check above alone would simply never fire. Cast down for a
		-- MeshPart named Water and use its surface directly.
		local surfaceY = nil
		local extraLift = 0
		-- Runs while swimming too. It used to be skipped in that case, which
		-- meant engine water -- the one thing guaranteed to put you in the
		-- swimming state -- was the one thing the surface search never ran for.
		if hrp then
			-- Reused, not rebuilt. This runs every frame while the feature is
			-- on, and a fresh RaycastParams per frame is garbage the collector
			-- has to chase for no benefit -- only the filter list changes.
			local wp = ST.rayWater
			if not wp then
				wp = RaycastParams.new()
				wp.FilterType = Enum.RaycastFilterType.Exclude
				wp.IgnoreWater = false
				ST.rayWater = wp
			end
			wp.FilterDescendantsInstances = { character, ST.waterPart }
			-- Started above the head so it still finds the surface once we are
			-- floating on top of it, not just while submerged
			local hit = Workspace:Raycast(
				hrp.Position + Vector3.new(0, 6, 0),
				Vector3.new(0, -40, 0),
				wp
			)
			-- Any BasePart, not only MeshParts: a beach built out of ordinary
			-- Parts or a Union was never matched before, which is why naming
			-- one in the box appeared to do nothing.
			if hit and hit.Instance:IsA("BasePart") then
				local hitName = hit.Instance.Name:lower()

				-- Roblox's own terrain, by MATERIAL rather than name. Every
				-- voxel of terrain in a place belongs to one instance called
				-- "Terrain", so no word in the names box could ever match it.
				if hit.Material == Enum.Material.Water then
					surfaceY = hit.Position.Y
				elseif hit.Material == Enum.Material.CrackedLava then
					surfaceY = hit.Position.Y
					extraLift = 3
				end

				-- Named parts, for the games that build water out of geometry
				-- instead. Names come from the box so anything can be walked
				-- on -- beach, sand, void, whatever this game calls it.
				-- Hardcoding water and lava only ever covered two games' worth
				-- of naming.
				if not surfaceY then
					local names = (MISC.walkNames or "water, lava, beach"):lower()
					for raw in names:gmatch("[^,]+") do
						local term = raw:gsub("^%s+", ""):gsub("%s+$", "")
						if term ~= "" and hitName:find(term, 1, true) then
							surfaceY = hit.Position.Y
							-- Anything that reads as lava gets clearance:
							-- resting exactly on the surface still counts as
							-- touching it, and touching lava usually hurts
							if term:find("lava") or term:find("magma")
								or term:find("fire") then
								extraLift = 3
							end
							break
						end
					end
				end
			end
		end

		if hrp and (swimming or surfaceY) then
			-- Per rig, not a constant: R6, R15 and a scaled R15 all sit at
			-- different heights above their own root
			local offset = ST.standOffset(character)

			if surfaceY then
				ST.waterFrom = nil
				-- Known surface, so hold the root exactly one stand-height above
				-- it rather than wherever we happened to enter. extraLift adds
				-- clearance for lava, which hurts on contact.
				MISC.waterY = surfaceY + offset + extraLift
			else
				-- Provably swimming here: this branch only runs when there is
				-- no surfaceY, and the test above is (swimming or surfaceY).
				--
				-- Rise rather than hold. Frame-scaled so it climbs at the same
				-- rate at 30fps and 240, and capped against the height we
				-- entered at -- a game that forces the Swimming state in air
				-- would otherwise loft you into orbit with no way to tell.
				ST.waterFrom = ST.waterFrom or hrp.Position.Y
				local climbed = (MISC.waterY or hrp.Position.Y) - ST.waterFrom
				if climbed < 250 then
					MISC.waterY = (MISC.waterY or hrp.Position.Y) + 40 * deltaTime
				end
			end
			if not ST.waterPart or not ST.waterPart.Parent then
				local p = Instance.new("Part")
				p.Name = "WaterWalk" .. uiName
				p.Size = Vector3.new(10, 4, 10)
				p.Transparency = 1
				p.CanCollide = true
				p.CanQuery = false
				p.CanTouch = false
				p.Anchored = true
				p.Parent = Workspace
				ST.waterPart = p
			end
			-- Sitting is the one case where the platform must NOT follow. A seat
			-- holds the character; moving the floor under it shoves the whole
			-- assembly, and since the platform is placed from your position
			-- every frame, that shove moves you, which moves the platform
			-- again. The result is a slow drift with nobody touching the keys.
			-- Same yield as noclip: an attack that is holding your position owns
			-- it, and lifting you to a water surface mid-fight both fights it
			-- and moves you off the target
			local seated = (hum and hum.Sit) or (KILL.seatOn and KILL.attach == "CFRAME")
			if not seated then
				ST.waterPart.CFrame = CFrame.new(
					hrp.Position.X,
					MISC.waterY - offset - 2,
					hrp.Position.Z
				)
			end

			-- Swimming keeps pulling the body down, so hold the surface height.
			-- Skipped while seated for the same reason: the seat owns where you
			-- are, and rewriting the root fights it.
			if not seated and hrp.Position.Y < MISC.waterY then
				hrp.CFrame = CFrame.new(hrp.Position.X, MISC.waterY, hrp.Position.Z)
					* hrp.CFrame.Rotation
				markIntentionalTeleport()
				local vel = hrp.AssemblyLinearVelocity
				if vel.Y < 0 then
					hrp.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
				end
			end
		else
			MISC.waterY = nil
			ST.waterFrom = nil
			if ST.waterPart then
				ST.waterPart:Destroy()
				ST.waterPart = nil
			end
		end
	elseif ST.waterPart then
		MISC.waterY = nil
		ST.waterFrom = nil
		ST.waterPart:Destroy()
		ST.waterPart = nil
	end

	-- Anti-Void. Skipped while flying, since dropping low is intentional then.
	if VOID.enabled and not ST.flying then
		local hrp = character:FindFirstChild("HumanoidRootPart")
		local hum = character:FindFirstChildOfClass("Humanoid")
		if hrp and hum then
			local onFloor = hum.FloorMaterial ~= Enum.Material.Air

			if onFloor then
				-- Only record while actually on a floor, never mid-fall
				VOID.lastSafe = hrp.Position
				-- The lowest ground you have genuinely stood on. Auto mode uses
				-- it because a map's kill height is always below its floor, and
				-- nobody knows the number for a map they just joined.
				if not VOID.floor or hrp.Position.Y < VOID.floor then
					VOID.floor = hrp.Position.Y
				end
			end

			-- Where the catch sits. Auto keeps it a little under the lowest
			-- floor seen, so it is out of the way of normal play; without a
			-- floor to go on yet, the manual number stands in.
			local catchY = VOID.y
			if VOID.auto and VOID.floor then
				catchY = math.max(VOID.y, VOID.floor - 60)
			end

			if hrp.Position.Y < catchY then
				if VOID.mode == "CATCH" then
					-- Put a floor under the fall rather than undoing it.
					--
					-- Nothing here moves you: you land, keep your position, and
					-- can walk or fly out. Catching is also quieter than a
					-- teleport, which anti-cheats do watch for.
					if not VOID.pad or not VOID.pad.Parent then
						local pad = Instance.new("Part")
						pad.Name = "VoidCatch" .. MISC.uiTag
						pad.Size = Vector3.new(60, 4, 60)
						pad.Transparency = 1
						pad.CanCollide = true
						pad.CanQuery = false
						pad.CanTouch = false
						pad.Anchored = true
						pad.Parent = Workspace
						VOID.pad = pad
					end

					-- Kept under you as you drift, and just below the catch
					-- height so you land on it rather than inside it
					VOID.pad.CFrame = CFrame.new(hrp.Position.X, catchY - 4, hrp.Position.Z)

					-- Bleed the fall off. Landing at terminal velocity on a
					-- client-side platform is how you die to fall damage while
					-- being "saved".
					local vel = hrp.AssemblyLinearVelocity
					if vel.Y < -40 then
						hrp.AssemblyLinearVelocity = Vector3.new(vel.X, -40, vel.Z)
					end

				elseif VOID.lastSafe then
					-- Counts as our own move, or anti-TP would drag us back down
					markIntentionalTeleport()
					hrp.CFrame = CFrame.new(VOID.lastSafe) * hrp.CFrame.Rotation
					hrp.AssemblyLinearVelocity = Vector3.zero
					hrp.AssemblyAngularVelocity = Vector3.zero
				end

			elseif VOID.pad and hrp.Position.Y > catchY + 30 then
				-- Well clear of it again: the pad is a rescue, not scenery, and
				-- leaving it there gives you an invisible floor over the void
				pcall(function() VOID.pad:Destroy() end)
				VOID.pad = nil
			end
		end
	end

	-- Anti-TP. Skipped while flying/welding/TP-spamming, since those move the
	-- character on purpose and would otherwise fight the glide.
	if ATP.enabled and not ST.flying and not ON.weldEnabled and not ON.tpSpamEnabled then
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if hrp then
			if ATP.returning and ATP.anchor then
				local pos = hrp.Position
				local toAnchor = ATP.anchor - pos
				local dist = toAnchor.Magnitude
				local stepDist = ATP.speed * deltaTime

				if dist <= stepDist or dist < 0.5 then
					-- Close enough: land exactly and hand control back
					hrp.CFrame = CFrame.new(ATP.anchor) * hrp.CFrame.Rotation
					ATP.lastPos = ATP.anchor
					ATP.returning = false
					ATP.anchor = nil
				else
					local newPos = pos + toAnchor.Unit * stepDist
					hrp.CFrame = CFrame.new(newPos) * hrp.CFrame.Rotation
					-- Track our own movement so the glide doesn't read as a new teleport
					ATP.lastPos = newPos
				end
				-- Whatever threw the character is usually still pushing on it
				hrp.AssemblyLinearVelocity = Vector3.zero
			elseif ATP.lastPos then
				local pos = hrp.Position
				if (pos - ATP.lastPos).Magnitude > ATP.threshold then
					ATP.anchor = ATP.lastPos
					ATP.returning = true
				else
					ATP.lastPos = pos
				end
			else
				ATP.lastPos = hrp.Position
			end
		end
	elseif ATP.lastPos or ATP.returning then
		markIntentionalTeleport()
	end

	-- Both rescans below share one throttle. Parts added mid-session are still
	-- caught immediately by the DescendantAdded listener; this pass only exists
	-- to re-override collisions the game flips back server-side.
	local doScan = false
	if os.clock() >= ST.nextCharScan then
		ST.nextCharScan = os.clock() + 0.25
		doScan = true
	end

	-- Object ESP gets its own, slower timer: it walks all of Workspace, which is
	-- far heavier than the character rescans and does not need to be responsive.
	-- Custom pose playback. Eases between saved frames rather than snapping, so
	-- two poses already read as a loop instead of a flicker.
	if ST.posePlaying and #ST.poseFrames > 1 then
		local hold = math.max(0.05, (MISC.poseHold or 40) / 100)
		ST.poseT = (ST.poseT or 0) + (deltaTime / hold)

		local count = #ST.poseFrames
		local from = (math.floor(ST.poseT) % count) + 1
		local to = (from % count) + 1
		local alpha = ST.poseT % 1

		-- Resolved against the current rig, so playback keeps working after a
		-- respawn instead of pointing at motors that no longer exist
		for _, motor in ipairs(collectMotors()) do
			local targetC0 = ST.poseFrames[to][motor.Name]
			local startC0 = ST.poseFrames[from][motor.Name]
			if startC0 and targetC0 then
				pcall(function() motor.C0 = startC0:Lerp(targetC0, alpha) end)
			end
		end
	end

	-- Dummy wander. MoveTo is re-issued on a timer because the humanoid stops
	-- once it arrives, and a stationary target is no use for testing.
	if MISC.dummyMove and ST.dummy and os.clock() >= (MISC.dummyStep or 0) then
		MISC.dummyStep = os.clock() + 2
		local dHum = ST.dummy:FindFirstChildOfClass("Humanoid")
		local dRoot = ST.dummy:FindFirstChild("HumanoidRootPart")
		if dHum and dRoot then
			local spot = dRoot.Position + Vector3.new(math.random(-14, 14), 0, math.random(-14, 14))
			pcall(function() dHum:MoveTo(spot) end)
		end
	end

	-- Re-run periodically: the overlay is created when a pause starts, so one
	-- pass at toggle time would miss every pause after the first.
	if MISC.invisible and os.clock() >= (MISC.invisAt or 0) then
		MISC.invisAt = os.clock() + 0.5
		applyInvisible()
	end


	if (MISC.hidePause or ON.antiPauseEnabled) and os.clock() >= (MISC.hideAt or 0) then
		MISC.hideAt = os.clock() + 1
		hidePauseOverlay()
	end

	-- Anti Gameplay Pause drives all three defences, since on its own it only
	-- handled the Escape menu and did nothing about the streaming overlay --
	-- which is the pause people actually hit. The individual toggles still work
	-- for fine control.
	if (MISC.streamAhead or ON.antiPauseEnabled) and os.clock() >= (MISC.streamAt or 0) then
		MISC.streamAt = os.clock() + 0.4
		streamAhead()
	end

	-- Rescanned periodically because prompts stream in with the map: one pass
	-- at toggle time would miss anything loaded afterwards.
	if MISC.instantPrompt and os.clock() >= (MISC.promptScan or 0) then
		MISC.promptScan = os.clock() + 4
		applyInstantPrompts()
	end

	-- Its own timer: this walks a chunk of Workspace, so it must not run per
	-- frame. 3s is responsive enough for a spike that builds over seconds.
	-- Signs are re-ranked on a slow timer: which ones are nearest changes as you
	-- walk, and the walk itself is the expensive part
	if MISC.antiLagSigns and os.clock() >= (MISC.signScan or 0) then
		MISC.signScan = os.clock() + 3
		scanSigns()
	end

	if MISC.antiCrash and os.clock() >= (MISC.crashScan or 0) then
		MISC.crashScan = os.clock() + 3
		scanEffects()
	end

	if OESP.enabled and os.clock() >= OESP.nextScan then
		OESP.nextScan = os.clock() + 2
		scanObjectEsp()
	end

	-- Noclip floor. Turning collisions off means nothing is holding you up, so
	-- the usual result is sinking through the map until the void catches you.
	-- Rather than re-enabling collision on the ground -- which puts the walls
	-- back too -- the height is simply held, and Space/Ctrl move it.
	--
	-- Skipped while flying or air walking: those own the character's position
	-- already, and two things writing it is a fight neither wins.
	-- Seat attack in CFRAME mode writes the root every frame too, and two
	-- writers means neither wins: you get jitter between the attack position
	-- and the held height. The attack is the deliberate one, so it takes
	-- priority and the hold stands down.
	local attackHolding = KILL.seatOn and KILL.attach == "CFRAME"

	if ST.noclipping and MISC.noclipFloor and not ST.flying
		and not ST.airWalkPart and not MISC.frozen and not attackHolding then
		local hrp = character:FindFirstChild("HumanoidRootPart")
		local hum = character:FindFirstChildOfClass("Humanoid")
		local grounded = hum and hum.FloorMaterial ~= Enum.Material.Air
		if hrp then
			if not MISC.noclipY then MISC.noclipY = hrp.Position.Y end

			-- Standing on something real: follow it rather than holding a fixed
			-- height. Without this a ramp or a staircase cannot be walked --
			-- you stay level and pass straight through it, which looks like the
			-- hold is broken when it is actually working too well.
			--
			-- BUT: holding down (Ctrl) means you WANT to go through the floor,
			-- which is most of the point of noclip. While Ctrl is held the hold
			-- lets go entirely, so you sink -- otherwise the floor hold quietly
			-- cancels noclip by catching you every frame.
			local descending = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
				and not UserInputService:GetFocusedTextBox()
			if grounded and not descending then MISC.noclipY = hrp.Position.Y end
			if descending then MISC.noclipY = hrp.Position.Y - 4 end

			-- Deliberate vertical movement, which is the whole reason this is a
			-- held height rather than a frozen one: you still need to get
			-- through a ceiling or down a shaft.
			local typing = UserInputService:GetFocusedTextBox()
			if not typing then
				local rate = (MISC.noclipRate or 24) * deltaTime
				if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
					MISC.noclipY = MISC.noclipY + rate
				elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
					MISC.noclipY = MISC.noclipY - rate
				end
			end

			-- Sitting is left alone: a seat owns where you are, and rewriting
			-- the root under it drags the whole assembly. Grounded is skipped
			-- too -- the floor is already holding you, and writing the CFrame
			-- on top of that fights the humanoid's own movement.
			if not (hum and hum.Sit) and not grounded then
				hrp.CFrame = CFrame.new(hrp.Position.X, MISC.noclipY, hrp.Position.Z)
					* hrp.CFrame.Rotation
				local vel = hrp.AssemblyLinearVelocity
				-- Only the downward part: horizontal movement is yours, and
				-- cancelling all of it would make walking feel dead
				if vel.Y ~= 0 then
					hrp.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
				end
				markIntentionalTeleport()
			end
		end
	end

	if ST.noclipping and doScan then
		-- noclipPart handles the root-part exclusion and the watcher itself, so
		-- this just feeds it every part. Filtering on CanCollide here would skip
		-- a part that is currently false but has a script about to flip it back.
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				noclipPart(part)
			end
		end
	end

	if ON.airWalkEnabled and not ST.flying then
		-- Throttled rescan: catches accessories/tools equipped mid-walk and any
		-- part the game resets server-side, without walking the rig every frame
		if doScan then applyAirWalkMassless(character) end

		local hrp = character:FindFirstChild("HumanoidRootPart")
		if hrp then
			-- How far the character's lowest point sits below the root. Measured
			-- from the live bounding box rather than a HipHeight formula, so
			-- custom rigs and pose-changing items (slides, crouches) land right
			-- instead of hovering or sinking.
			--
			-- This can't drift downward: both values come from the character, so
			-- if it sags they move together and the offset stays put.
			local hum = character:FindFirstChildOfClass("Humanoid")

			local rayParams = ST.rayAir
			if not rayParams then
				rayParams = RaycastParams.new()
				rayParams.FilterType = Enum.RaycastFilterType.Exclude
				ST.rayAir = rayParams
			end
			-- The platform has to be excluded too, or it detects its own floor,
			-- deletes it, and rebuilds it every frame -- which reads as bobbing
			rayParams.FilterDescendantsInstances = { character, ST.airWalkPart }

			-- Calibrate against real ground. Whenever the character is genuinely
			-- standing on something, record the true root-to-floor distance and
			-- reuse it while airborne.
			--
			-- Both earlier attempts guessed instead of measuring: HipHeight was
			-- wrong on custom rigs, and the bounding box read too low, because a
			-- held tool or trailing accessory drags its underside below the feet.
			-- Either way the plate ended up parked under you and you dropped onto
			-- it. Measured from actual gameplay, any rig or pose works.
			-- Only while the platform is NOT out. Standing on our own plate also
			-- reads as FloorMaterial ~= Air, so measuring then calibrates against
			-- the thing we just placed: if the offset comes out even slightly
			-- short the plate lands above the feet, the collision nudges the
			-- character up, the new height gets recorded, and it ratchets upward
			-- every frame. Real ground only.
			if hum and hum.FloorMaterial ~= Enum.Material.Air and not ST.airWalkPart then
				local floorHit = Workspace:Raycast(hrp.Position, Vector3.new(0, -20, 0), rayParams)
				if floorHit then
					MISC.standOffset = hrp.Position.Y - floorHit.Position.Y
				end
				-- The height to hold on to the moment we step off an edge
				MISC.airFloorY = hrp.Position.Y
			end

			-- Nothing calibrated yet (air walk switched on mid-air), or a
			-- nonsense reading: the shared helper falls back to the rig's own
			-- hip height, which covers R6, R15 and anything rescaled
			local standOffset = ST.standOffset(character)

			-- A thin platform is what heavy custom rigs punch through: between
			-- two physics steps they move further than the plate is deep and
			-- come out the bottom. Massless can't fully solve that on its own,
			-- because Roblox ignores Massless on an assembly's root part -- the
			-- HumanoidRootPart keeps its mass no matter what. So the plate is
			-- made deep and wide instead; depth stops tunnelling, width keeps
			-- fast movement from running off the edge before it repositions.
			local thickness = 4
			local reach = standOffset + 1
			local rayResult = Workspace:Raycast(hrp.Position, Vector3.new(0, -reach, 0), rayParams)

			-- ALWAYS ignores what is underneath entirely. LOCK and FREE hand
			-- you back to real ground when there is some, which is right when
			-- the plate is only there to bridge a gap and wrong when you meant
			-- to be standing in the air over a roof.
			local overGround = rayResult and rayResult.Distance <= standOffset + 0.25
			if MISC.airWalkMode == "ALWAYS" or not overGround then
				if not ST.airWalkPart or not ST.airWalkPart.Parent then
					ST.airWalkPart = Instance.new("Part")
					ST.airWalkPart.Name = "AirWalkPlatform" .. uiName
					ST.airWalkPart.Size = Vector3.new(10, thickness, 10)
					ST.airWalkPart.Transparency = 1
					ST.airWalkPart.CanCollide = true
					ST.airWalkPart.CanQuery = false
					ST.airWalkPart.CanTouch = false
					ST.airWalkPart.Anchored = true
					ST.airWalkPart.Parent = Workspace
				end
				-- Position only: CFrame arithmetic would carry the character's
				-- pitch and roll into the platform and tilt the floor
				-- Switched on mid-air, nothing was ever measured from real ground,
				-- so take the height right now as the floor. Once only -- doing
				-- it per frame would just track the character again.
				if not MISC.airFloorY then
					MISC.airFloorY = hrp.Position.Y
				end

				-- X and Z follow so the plate stays underfoot; Y is pinned to the
				-- height you stepped off at in BOTH modes.
				--
				-- FREE used to lower the plate to match your position each frame
				-- (math.min against the current Y). That meant it tracked you
				-- down as you fell and never actually caught you -- the mode was
				-- an endless drop. The only real difference is the hard clamp
				-- below: LOCK pins your Y outright, FREE leaves it to physics so
				-- slides and jumps read naturally, with the plate still there to
				-- land on.
				--
				-- Pinning also avoids the ratchet: a plate placed from your live
				-- position creeps upward every frame once collision nudges you.
				-- The floor follows you up, and only up. Jumping raises the
				-- height it holds you at, so a jump becomes a step and you can
				-- climb; gravity can never drag the floor back down with you,
				-- which is what made the other two modes a fixed ceiling.
				if MISC.airWalkMode == "ALWAYS"
					and hrp.Position.Y > (MISC.airFloorY or hrp.Position.Y) then
					MISC.airFloorY = hrp.Position.Y
				end

				local floorY = MISC.airFloorY

				ST.airWalkPart.CFrame = CFrame.new(
					hrp.Position.X,
					floorY - standOffset - thickness / 2,
					hrp.Position.Z
				)

				-- Hard floor. The platform alone can only catch you after gravity
				-- has already pulled you into it, so there is always some drop.
				-- This holds the height you stepped off at outright.
				--
				-- Only downward motion is cancelled, so jumping still works: you
				-- rise freely, then settle back to this level instead of past it.
				-- Safety net only, NOT the thing holding you up -- the plate does
				-- that. The tolerance matters: without it this fired on the
				-- fraction of a stud you settle as you rest on the plate, so the
				-- CFrame was rewritten every frame, the humanoid never registered
				-- as grounded, and you glided along instead of walking.
				--
				-- FREE skips it outright, since pinning Y is exactly what stops a
				-- slide or a deliberate drop from working.
				local SETTLE = 1.5
				if MISC.airWalkMode ~= "FREE" and MISC.airFloorY
					and hrp.Position.Y < MISC.airFloorY - SETTLE then
					local lift = MISC.airFloorY - hrp.Position.Y
					if lift > 30 then
						-- A held height this far above means the character legitimately
						-- moved -- teleport, respawn, falling from somewhere tall. Hauling
						-- it back would fight Anti-TP frame after frame, each undoing the
						-- other. Accept the new height instead of yanking.
						MISC.airFloorY = hrp.Position.Y
					else
						hrp.CFrame = CFrame.new(hrp.Position.X, MISC.airFloorY, hrp.Position.Z)
							* hrp.CFrame.Rotation
						-- Ours, not an attack: without this Anti-TP can read the lift as a
						-- teleport and start gliding the character back down into it
						markIntentionalTeleport()
						local vel = hrp.AssemblyLinearVelocity
						if vel.Y < 0 then
							hrp.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
						end
					end
				end
			else
				if ST.airWalkPart then
					ST.airWalkPart:Destroy()
					ST.airWalkPart = nil
				end
			end
		end
	else
		if ST.airWalkPart then
			ST.airWalkPart:Destroy()
			ST.airWalkPart = nil
		end
		-- Covers switching to fly with air walk still toggled on. The next()
		-- guard keeps this from doing work on every idle frame.
		if next(ST.airWalkMassless) then restoreAirWalkMassless() end
	end
end)

-- Aim assist is bound, not connected, and this is the whole reason it did
-- nothing before. RenderStepped fires BEFORE Roblox's own camera script, which
-- runs as a BindToRenderStep at Enum.RenderPriority.Camera -- so every CFrame
-- written from a RenderStepped connection is overwritten by the default camera
-- in the same frame, and the assist looked completely dead. Binding one step
-- after the camera means we get the last word.
--[[
	TP Kill's aim, run from the render bind instead of the physics step.

	Everything else about TP Kill belongs in Stepped -- the teleport, the
	target search, the clicking. The CAMERA does not, because the default
	camera module rewrites CFrame after Stepped and before anything is drawn.
	A camera aimed from there is aimed for no frames at all.

	Binding one priority after Enum.RenderPriority.Camera is the same trick
	the aim assist uses, for the same reason: last write wins, and this is the
	last write.
--]]
function FN.tpKillAim()
	if not MISC.tpKill or ST.tpKillFleeing then return end

	local t = ST.tpKillTarget
	local tRoot = t and t.Parent and t:FindFirstChild("HumanoidRootPart")
	if not tRoot then return end

	local cam = Workspace.CurrentCamera
	if not cam then return end

	local aimAt = tRoot.Position
	if MISC.tpKillLead then
		local tv = tRoot.AssemblyLinearVelocity
		aimAt = aimAt + Vector3.new(tv.X, 0, tv.Z) * 0.15
	end

	local eye = cam.CFrame.Position
	local to = aimAt - eye
	if to.Magnitude < 0.05 then return end

	if MISC.tpKillCam ~= "OFF" then
		-- How far off we actually are, in degrees. AUTO turns when that is
		-- more than a hair, rather than only when they leave the screen --
		-- on-screen and aimed-at are not the same thing, and treating them as
		-- the same is what left the camera pointing at scenery.
		local dot = math.clamp(cam.CFrame.LookVector:Dot(to.Unit), -1, 1)
		local off = math.deg(math.acos(dot))
		if MISC.tpKillCam == "FORCE" or off > 3 then
			pcall(function() cam.CFrame = CFrame.lookAt(eye, aimAt) end)
		end
	end

	-- The cursor, after the camera has moved, so the screen point it is sent
	-- to is the one this frame will actually draw
	if MISC.tpKillMouse and type(mousemoverel) == "function" then
		pcall(function()
			local sp, onScreen = cam:WorldToViewportPoint(aimAt)
			if not onScreen then return end
			-- Viewport points start below the top bar and GetMouseLocation
			-- does not, so the two only agree once the inset is added back
			local inset = SERV.GuiService:GetGuiInset()
			local now = UserInputService:GetMouseLocation()
			local dx = (sp.X + inset.X) - now.X
			local dy = (sp.Y + inset.Y) - now.Y
			if math.abs(dx) >= 1 or math.abs(dy) >= 1 then
				mousemoverel(dx, dy)
			end
		end)
	end
end

ST.aimBind = "ModMenuAim" .. uiName
pcall(function()
	RunService:BindToRenderStep(ST.aimBind, Enum.RenderPriority.Camera.Value + 1, function(dt)
		stepAim(dt)
		-- Fired from the same pass: the trigger needs the aim to have already
		-- moved this frame, or it tests the crosshair against where the camera
		-- was pointing before the assist nudged it
		stepTrigger()
		-- Same reason, same pass. Written from Stepped this was overwritten by
		-- the default camera every frame and TP Kill never aimed at anything.
		FN.tpKillAim()
	end)
end)

CONN.renderConn = RunService.RenderStepped:Connect(function(deltaTime)
	local character = player.Character
	local currentCamera = Workspace.CurrentCamera


	-- Hold-to-zoom. Sits on top of the FOV override rather than replacing it:
	-- the resting FOV is whatever that feature would apply, so releasing the
	-- key returns to your setting, not a hardcoded default.
	if currentCamera then
		local restFov = ON.fovEnabled and VAL.fov or (ORIGINAL.fov or 70)
		local zooming = KEYS.zoom and UserInputService:IsKeyDown(KEYS.zoom)
			and not UserInputService:GetFocusedTextBox()

		if zooming then
			local want = math.max(5, restFov / MISC.zoomMult)
			if math.abs(currentCamera.FieldOfView - want) > 0.01 then
				currentCamera.FieldOfView = want
			end
		elseif ON.fovEnabled and currentCamera.FieldOfView ~= VAL.fov then
			currentCamera.FieldOfView = VAL.fov
		elseif MISC.wasZooming and not ON.fovEnabled then
			-- Only on the release frame, so we don't fight the game's own FOV
			currentCamera.FieldOfView = restFov
		end
		MISC.wasZooming = zooming
	end

	if ON.antiFirstPersonEnabled then
		-- Only write on an actual change; this used to set CameraMode every
		-- frame, which is the same redundant-write pattern that locked the
		-- client up when anti-pause did it
		if player.CameraMode ~= Enum.CameraMode.Classic then
			pcall(function() player.CameraMode = Enum.CameraMode.Classic end)
		end
		-- A forced-first-person game pins min zoom too, so it has to be released
		if player.CameraMinZoomDistance > 0.5 then
			pcall(function() player.CameraMinZoomDistance = 0.5 end)
		end
		if player.CameraMaxZoomDistance < 128 then
			pcall(function() player.CameraMaxZoomDistance = 400 end)
		end
	end

	-- These all used to be written every frame. Only writing on an actual
	-- change keeps 60fps of redundant property sets off the client, which is
	-- what made anti-pause lock things up before.
	-- Overlay. Sized from the live FOV so dragging the stepper resizes the ring
	-- as you watch, and coloured by whether the assist currently has anyone.
	if MISC.aimCircle or MISC.crosshair then
		-- Centred on the 3D viewport, not on the screen.
		--
		-- The aim code measures from ViewportSize/2, which is the middle of the
		-- rendered world. This ScreenGui has IgnoreGuiInset set, so its own
		-- middle sits about eighteen pixels lower -- the height of Roblox's top
		-- bar. Drawing the ring at the GUI centre puts it slightly below the
		-- point the assist actually aims from, which is exactly the kind of
		-- small lie that makes a tuning overlay worse than none.
		local cam = Workspace.CurrentCamera
		if cam then
			local inset = SERV.GuiService:GetGuiInset()
			local cx = cam.ViewportSize.X / 2 + inset.X
			local cy = cam.ViewportSize.Y / 2 + inset.Y
			local centre = UDim2.new(0, cx, 0, cy)
			if DEC.aimCircle.Position ~= centre then
				DEC.aimCircle.Position = centre
				DEC.crossH.Position = centre
				DEC.crossV.Position = centre
			end
		end
	end

	if MISC.aimCircle then
		local want = AIM.fov * 2
		if math.abs(DEC.aimCircle.Size.X.Offset - want) > 0.5 then
			DEC.aimCircle.Size = UDim2.new(0, want, 0, want)
		end
		DEC.aimStroke.Color = AIM.target and THEME.on or THEME.accent
		DEC.aimCircle.Visible = true
	elseif DEC.aimCircle.Visible then
		DEC.aimCircle.Visible = false
	end

	if DEC.crossH.Visible ~= MISC.crosshair then
		DEC.crossH.Visible = MISC.crosshair
		DEC.crossV.Visible = MISC.crosshair
	end

	-- Anti shift lock. The opposite of the toggle below, for games that turn
	-- mouse lock on for you and give you no way out of it. Written only on a
	-- change, and it also releases a locked cursor -- clearing the permission
	-- does not unlock a mouse that is already captured.
	if ON.antiShiftLock then
		if player.DevEnableMouseLock ~= false then
			pcall(function() player.DevEnableMouseLock = false end)
		end
		-- Not while free cam or bug mode want the cursor themselves
		if not ON.freeCamEnabled and not KAT.bugMode
			and UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
			pcall(function()
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			end)
		end
	end

	if ON.forceShiftLockEnabled and player.DevEnableMouseLock ~= true then
		pcall(function()
			player.DevEnableMouseLock = true
		end)
	end

	if ON.fullbrightEnabled then
		local white = Color3.new(1, 1, 1)
		if Lighting.Ambient ~= white then Lighting.Ambient = white end
		if Lighting.ColorShift_Bottom ~= white then Lighting.ColorShift_Bottom = white end
		if Lighting.ColorShift_Top ~= white then Lighting.ColorShift_Top = white end
		if Lighting.GlobalShadows then Lighting.GlobalShadows = false end
	end

	if ON.freeCamEnabled and currentCamera then
		if currentCamera.CameraType ~= Enum.CameraType.Scriptable then
			currentCamera.CameraType = Enum.CameraType.Scriptable
		end
		local moveVector = Vector3.new()
		local camCFrame = currentCamera.CFrame

		if not UserInputService:GetFocusedTextBox() then
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVector = moveVector + camCFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVector = moveVector - camCFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVector = moveVector - camCFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVector = moveVector + camCFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveVector = moveVector + Vector3.new(0, 1, 0) end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
				moveVector = moveVector - Vector3.new(0, 1, 0)
			end
		end

		if moveVector.Magnitude > 0 then moveVector = moveVector.Unit end
		CAM.freeCamPos = CAM.freeCamPos + (moveVector * (VAL.freeCamSpeed * deltaTime))

		-- Free look captures the mouse outright; otherwise hold right-mouse.
		-- Free look is off by default because a captured cursor can't click the
		-- menu -- the GUI toggle key is the way back out.
		if MISC.freeLook or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrent
			local delta = UserInputService:GetMouseDelta()
			CAM.freeCamRotY = CAM.freeCamRotY - (delta.X * 0.003)
			CAM.freeCamRotX = math.clamp(CAM.freeCamRotX - (delta.Y * 0.003), -math.rad(89), math.rad(89))
		else
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end

		currentCamera.CFrame = CFrame.new(CAM.freeCamPos) * CFrame.Angles(0, CAM.freeCamRotY, 0) * CFrame.Angles(CAM.freeCamRotX, 0, 0)
		return
	end

	if not character or not currentCamera then return end

	if ST.flying and ST.flyPart then
		-- Typing must not STEER you. It must not DROP you either, and this
		-- guard used to do both: the whole block sat behind it, including the
		-- per-frame position write that is the only thing holding CFrame mode
		-- up. Click the chat bar, the loop stops, gravity resumes, and you
		-- ragdoll into the floor mid-sentence.
		--
		-- Motor and Full Body never showed it -- their anchored part holds
		-- them whether this loop runs or not -- which is why it looked like a
		-- CFrame-mode bug instead of a guard covering too much.
		local flyTyping = UserInputService:GetFocusedTextBox() ~= nil
		do
			local moveVector = Vector3.new()
			local camLook = currentCamera.CFrame.LookVector
			local camRight = currentCamera.CFrame.RightVector

			-- Input only. Everything past this runs while typing, so a focused
			-- text box leaves you hovering instead of falling.
			if not flyTyping then
				if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVector = moveVector + camLook end
				if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVector = moveVector - camLook end
				if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVector = moveVector - camRight end
				if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVector = moveVector + camRight end
				if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveVector = moveVector + Vector3.new(0, 1, 0) end
				-- LeftControl only. LeftShift used to descend too, but that is
				-- the sprint key now, so holding it did both at once.
				if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
					moveVector = moveVector - Vector3.new(0, 1, 0)
				end
			end

			if moveVector.Magnitude > 0 then moveVector = moveVector.Unit end

			-- Sprint key doubles fly speed while held, so you can cross distance
			-- without having to go and change the speed value
			local speed = VAL.flySpeed
			if not flyTyping and KEYS.sprint
				and UserInputService:IsKeyDown(KEYS.sprint) then
				speed = speed * 2
			end

			-- Ease toward the target velocity instead of snapping to it. The
			-- exponential form is framerate-independent: a fixed lerp factor
			-- would accelerate faster on a high-FPS machine than a low one.
			CAM.flyVel = CAM.flyVel or Vector3.zero
			local target = moveVector * speed
			local alpha = 1 - math.exp(-14 * deltaTime)
			CAM.flyVel = CAM.flyVel:Lerp(target, alpha)

			-- Park it exactly at rest, or the lerp leaves a permanent creep
			if CAM.flyVel.Magnitude < 0.05 and moveVector.Magnitude == 0 then
				CAM.flyVel = Vector3.zero
			end

			-- Legit mode. Nothing here tells the server the movement is fine --
			-- there is no such flag, and anything claiming to send one is
			-- selling you something. The server watches where you are over
			-- time and decides for itself.
			--
			-- So this makes the movement itself pass the checks that exist:
			--
			--   speed   most checks are a distance-per-second threshold, so
			--           the horizontal speed is held near a walk
			--   climb   vertical rate is capped separately, because rising
			--           faster than a jump is the single loudest signal
			--   jitter  a few percent of noise, since a velocity that is
			--           EXACTLY the cap every frame is itself a pattern no
			--           player produces
			if MISC.legitFly then
				local cap = math.max(1, MISC.legitSpeed or 24)

				local flat = Vector3.new(CAM.flyVel.X, 0, CAM.flyVel.Z)
				if flat.Magnitude > cap then
					flat = flat.Unit * cap
				end

				local climb = math.clamp(CAM.flyVel.Y, -cap, cap * 0.6)

				-- Small and signed, so it wanders around the cap rather than
				-- sitting on it
				local noise = (math.random() - 0.5) * 0.06
				CAM.flyVel = Vector3.new(
					flat.X * (1 + noise),
					climb * (1 + noise),
					flat.Z * (1 + noise)
				)
			end

			-- Seated: fly the whole thing you are sitting in.
			--
			-- A seat welds you into an assembly, so moving your own root fights
			-- that weld and gets you nowhere -- or drags you out of the seat.
			-- The assembly's root part is the piece physics actually moves, and
			-- moving it takes every welded part with it. That is what turns
			-- this into flying a plane rather than flying a pilot.
			--
			-- Ownership is why it replicates: sitting in a vehicle normally
			-- hands you network ownership of its assembly, so the server takes
			-- the position from you.
			local flyHum = character:FindFirstChildOfClass("Humanoid")
			local seatPart = flyHum and flyHum.SeatPart

			if seatPart and MISC.flyVehicle then
				local assembly = seatPart.AssemblyRootPart or seatPart
				pcall(function()
					local newPos = assembly.Position + (CAM.flyVel * deltaTime)

					-- Rotation follows the camera only when facing is locked;
					-- otherwise the craft keeps its own heading, which is what
					-- you want in anything that is meant to bank or turn
					if MISC.flyLockFacing then
						assembly.CFrame = CFrame.new(newPos)
							* currentCamera.CFrame.Rotation
					else
						assembly.CFrame = CFrame.new(newPos) * assembly.CFrame.Rotation
					end

					-- Physics would otherwise keep the old momentum and fight
					-- every frame of this
					assembly.AssemblyLinearVelocity = Vector3.zero
					assembly.AssemblyAngularVelocity = Vector3.zero
				end)

				-- Keep the fly part with us so teleports still land correctly
				if ST.flyPart then
					ST.flyPart.CFrame = CFrame.new(assembly.Position)
				end

			elseif ST.flyMode == "Velocity" or ST.flyMode == "CFrame" then
				-- Written every frame, which also cancels gravity: the fall
				-- speed accumulated since the last frame is simply overwritten.
				local hrp = character:FindFirstChild("HumanoidRootPart")
				if hrp then
					-- A BodyVelocity rather than writing the velocity ourselves.
					--
					-- Writing AssemblyLinearVelocity once a frame does not hold
					-- against gravity: physics keeps accelerating you downward
					-- during the step, so every frame starts a little lower
					-- than the last and you sink -- most obviously when
					-- hovering, where the target velocity is zero and the only
					-- thing moving you is the gravity we never cancelled.
					--
					-- A BodyVelocity is enforced by the solver for the whole
					-- step, with enough force to cancel gravity outright.
					--
					-- But a BodyVelocity is an OBJECT on your character, and a
					-- server-side check that lists your parts sees one it never
					-- created and flags you -- "he has bodyvel", TP-back. So
					-- No-Physics mode drives position by CFrame instead: no
					-- instance is added, nothing for that check to find.
					if MISC.flyNoPhysics or ST.flyMode == "CFrame" then
						-- Drop any BodyVelocity a previous frame made
						if ST.flyBodyVel then
							pcall(function() ST.flyBodyVel:Destroy() end)
							ST.flyBodyVel = nil
						end
						-- Move the root directly, from a HELD target rather
						-- than from wherever the body currently is.
						--
						-- Reading hrp.Position each frame is what made this
						-- sink. Stepped runs before the physics step, so the
						-- position we read has already been pulled down by the
						-- gravity of the previous step -- and writing it back
						-- ratifies the drop. Idle, that is a permanent creep
						-- downward, one frame's worth of gravity at a time.
						-- Zeroing velocity below only stops it accumulating,
						-- which is why it crept instead of falling.
						pcall(function()
							CAM.flyPos = CAM.flyPos or hrp.Position
							-- Anything that legitimately moves the character --
							-- a teleport, a respawn, anti-TP hauling you back --
							-- wins outright. Without this the held target would
							-- drag you back to a place you deliberately left.
							if (hrp.Position - CAM.flyPos).Magnitude > 8 then
								CAM.flyPos = hrp.Position
							end
							CAM.flyPos = CAM.flyPos + CAM.flyVel * deltaTime

							hrp.CFrame = CFrame.new(CAM.flyPos)
								* (MISC.flyLockFacing and currentCamera.CFrame.Rotation
									or hrp.CFrame.Rotation)
							hrp.AssemblyLinearVelocity = Vector3.zero
							hrp.AssemblyAngularVelocity = Vector3.zero
						end)
					else
						if not ST.flyBodyVel or not ST.flyBodyVel.Parent then
							pcall(function()
								local bv = Instance.new("BodyVelocity")
								bv.Name = "FlyVel" .. uiName
								bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
								bv.P = 8000
								bv.Velocity = CAM.flyVel
								bv.Parent = hrp
								ST.flyBodyVel = bv
							end)
						end
						if ST.flyBodyVel then
							ST.flyBodyVel.Velocity = CAM.flyVel
						end
					end

					-- Clipping a part applies torque, and physics keeps spinning
					-- the body long after the contact. AutoRotate being off only
					-- stops the humanoid turning on purpose, so the spin has to
					-- be cancelled here as well.
					if MISC.flyLockFacing then
						hrp.AssemblyAngularVelocity = Vector3.zero
						-- Position is left to physics; only the rotation is
						-- rewritten, so this cannot cause a positional jump.
						hrp.CFrame = CFrame.new(hrp.Position) * currentCamera.CFrame.Rotation
					end

					-- Kept in step so teleports and TP-spam, which reposition
					-- flyPart, still land the character in the right place
					ST.flyPart.CFrame = CFrame.new(hrp.Position) * currentCamera.CFrame.Rotation
				end
			else
				local newPos = ST.flyPart.Position + (CAM.flyVel * deltaTime)
				-- Honours Fly Lock Facing, which this branch used to ignore.
				-- Keeping the part's own rotation is what lets you hold a
				-- heading and look around independently of it.
				local newCFrame = CFrame.new(newPos) * (MISC.flyLockFacing
					and currentCamera.CFrame.Rotation
					or ST.flyPart.CFrame.Rotation)
				ST.flyPart.CFrame = newCFrame

				if ST.flyMode == "Full Body" then
					character:PivotTo(newCFrame)
				end
			end
		end
	end

	if ON.spinbotEnabled and not ST.flying then
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(VAL.spinSpeed * deltaTime), 0)
		end
	end
end)

-- Throttled & Cached TP Spam Task (Prevents Missing-Target Lag)
task.spawn(function()
	while true do
		if ON.tpSpamEnabled then
			pcall(function()
				local currentTime = tick()
				if not ST.cachedTargetPart or not ST.cachedTargetPart.Parent or (currentTime - ST.lastTargetSearchTime > 1.5) then
					ST.cachedTargetPart = resolveTargetPart()
					ST.lastTargetSearchTime = currentTime
				end

				local character = player.Character
				if ST.cachedTargetPart and character then
					local hrp = character:FindFirstChild("HumanoidRootPart")

					-- Target dead: go back where the spam started and stop.
					-- Checked by health rather than the Died signal, because the
					-- target is re-resolved every 1.5s and a fresh part would
					-- need re-hooking each time.
					local tModel = ST.cachedTargetPart:FindFirstAncestorOfClass("Model")
					local tHum = tModel and tModel:FindFirstChildOfClass("Humanoid")
					if tHum and tHum.Health <= 0 then
						-- Spam stops immediately, but the return waits a moment
						-- so you see the kill land instead of being yanked away
						-- the same frame their health hits zero.
						ON.tpSpamEnabled = false
						ST.cachedTargetPart = nil
						local goBackTo = ST.tpSpamReturn
						ST.tpSpamReturn = nil
						FN.toast("Target died, returning...")
						FN.updateUI()

						if goBackTo then
							task.delay(0.6, function()
								local ch = player.Character
								local root = ch and ch:FindFirstChild("HumanoidRootPart")
								-- Re-fetched after the wait: a respawn in the
								-- meantime makes the old character invalid
								if root then
									markIntentionalTeleport()
									ch:PivotTo(goBackTo)
									root.AssemblyLinearVelocity = Vector3.zero
								end
							end)
						end
						return
					end

					if hrp then
						local tPos = ST.cachedTargetPart.Position
						local currentPos = (ST.flying and ST.flyPart) and ST.flyPart.Position or hrp.Position
						-- Keep Y holds your own height and only tracks X/Z, which is
						-- what you want when the target is below a floor you are on.
						-- Full snaps to the target outright, height included.
						local newPos = MISC.tpSpamKeepY
							and Vector3.new(tPos.X, currentPos.Y, tPos.Z)
							or tPos

						if ST.flying and ST.flyPart then
							ST.flyPart.CFrame = CFrame.new(newPos) * ST.flyPart.CFrame.Rotation
						else
							local targetCFrame = CFrame.new(newPos) * hrp.CFrame.Rotation
							markIntentionalTeleport()
							character:PivotTo(targetCFrame)
							hrp.AssemblyLinearVelocity = Vector3.zero
						end
					end
				end
			end)
		end
		task.wait(0.05)
	end
end)

