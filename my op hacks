-- UI Helpers
MISC.currentLayoutOrder = 0

local function getNextOrder()
	MISC.currentLayoutOrder = MISC.currentLayoutOrder + 1
	return MISC.currentLayoutOrder
end

-- Buttons remember their own base color so hover can restore it after updateUI
MISC.hoveredButton = nil

local function setButtonColor(btn, color)
	btn:SetAttribute("BaseColor", color)
	if btn == MISC.hoveredButton then
		btn.BackgroundColor3 = color:Lerp(Color3.new(1, 1, 1), 0.14)
	else
		btn.BackgroundColor3 = color
	end
end

local function createButton(text)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -8, 0, 34)
	btn.BackgroundColor3 = THEME.off
	btn.AutoButtonColor = false
	btn.TextColor3 = THEME.text
	btn.Font = Enum.Font.GothamMedium
	btn.TextSize = 12.5
	btn.Text = text
	btn.LayoutOrder = getNextOrder()
	btn.Parent = DEC.scrollFrame
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 7)

	local stroke = Instance.new("UIStroke")
	stroke.Color = THEME.stroke
	stroke.Thickness = 1
	stroke.Transparency = 0.45
	stroke.Parent = btn

	btn:SetAttribute("BaseColor", THEME.off)

	btn.MouseEnter:Connect(function()
		MISC.hoveredButton = btn
		local base = btn:GetAttribute("BaseColor") or THEME.off
		btn.BackgroundColor3 = base:Lerp(Color3.new(1, 1, 1), 0.14)
		stroke.Transparency = 0.1
	end)
	btn.MouseLeave:Connect(function()
		if MISC.hoveredButton == btn then MISC.hoveredButton = nil end
		btn.BackgroundColor3 = btn:GetAttribute("BaseColor") or THEME.off
		stroke.Transparency = 0.45
	end)

	-- Creation label kept as the rename default: the live text is no good for
	-- that, since updateUI rewrites it constantly (ON/OFF, values, statuses).
	UI._label[btn] = text
	UI._order[btn] = btn.LayoutOrder

	btn.MouseButton2Click:Connect(function()
		if FN.openRowMenu then FN.openRowMenu(btn) end
	end)

	table.insert(UI._rows, { obj = btn, text = text:lower() })
	return btn
end

local function createHeader(text)
	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1, -8, 0, 26)
	holder.BackgroundTransparency = 1
	holder.LayoutOrder = getNextOrder()
	holder.Parent = DEC.scrollFrame

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.TextColor3 = THEME.textDim
	label.Font = Enum.Font.GothamBold
	label.TextSize = 11
	label.Text = (text:gsub("%-%-", ""):gsub("^%s+", ""):gsub("%s+$", ""))
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = holder

	local rule = Instance.new("Frame")
	rule.Size = UDim2.new(1, 0, 0, 1)
	rule.Position = UDim2.new(0, 0, 1, -2)
	rule.BackgroundColor3 = THEME.stroke
	rule.BackgroundTransparency = 0.4
	rule.BorderSizePixel = 0
	rule.Parent = holder

	table.insert(UI._rows, { obj = holder, text = text:lower(), header = true })
	return label
end

-- step: how much one click moves the value. onStep(delta) applies it.
-- The row wires its own buttons so callers don't need to hold refs to them.
local function createSpeedControlRow(defaultLabelText, step, onStep)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -10, 0, 32)
	row.BackgroundTransparency = 1
	row.LayoutOrder = getNextOrder()
	row.Parent = DEC.scrollFrame

	local function makeStepper(symbol, xPos)
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(0, 30, 1, 0)
		b.Position = xPos
		b.BackgroundColor3 = THEME.raised
		b.AutoButtonColor = false
		b.TextColor3 = THEME.text
		b.Font = Enum.Font.GothamBold
		b.TextSize = 15
		b.Text = symbol
		b.Parent = row
		Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)

		local s = Instance.new("UIStroke")
		s.Color = THEME.stroke
		s.Thickness = 1
		s.Transparency = 0.45
		s.Parent = b

		b.MouseEnter:Connect(function()
			b.BackgroundColor3 = THEME.hover
			s.Transparency = 0.1
		end)
		b.MouseLeave:Connect(function()
			b.BackgroundColor3 = THEME.raised
			s.Transparency = 0.45
		end)
		return b
	end

	local btnMinus = makeStepper("–", UDim2.new(0, 0, 0, 0))
	local btnPlus = makeStepper("+", UDim2.new(1, -30, 0, 0))

	if onStep then
		btnMinus.MouseButton1Click:Connect(function() onStep(-step) end)
		btnPlus.MouseButton1Click:Connect(function() onStep(step) end)
	end

	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, -70, 1, 0)
	box.Position = UDim2.new(0, 35, 0, 0)
	box.BackgroundColor3 = THEME.panel
	box.TextColor3 = THEME.text
	box.Font = Enum.Font.Gotham
	box.TextSize = 12
	box.Text = defaultLabelText
	box.ClearTextOnFocus = false
	box.Parent = row
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 7)

	local boxStroke = Instance.new("UIStroke")
	boxStroke.Color = THEME.stroke
	boxStroke.Thickness = 1
	boxStroke.Transparency = 0.45
	boxStroke.Parent = box

	box.Focused:Connect(function()
		boxStroke.Color = THEME.accent
		boxStroke.Transparency = 0.2
	end)
	box.FocusLost:Connect(function()
		boxStroke.Color = THEME.stroke
		boxStroke.Transparency = 0.45
	end)

	table.insert(UI._rows, { obj = row, text = defaultLabelText:lower() })
	return row, box
end

