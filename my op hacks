-- Switches every active feature off and hands the world back. Shared by the
-- close button and the panic key so the two can never drift apart -- a restore
-- that only one exit performs is how the camera leaks kept happening.
--[[
	Web Zip -- fling yourself at whatever the camera is pointing at.

	It is a launch, not a teleport: you get a velocity aimed at the target and
	then you travel there, so it looks like momentum rather than a snap and the
	server sees an ordinary arc. Overshooting is normal and fine -- wall climb
	catches you when you arrive.
--]]
function FN.spiderZip()
	if not MISC.spider then
		FN.toast("Web Zip needs Wall Climb on")
		return
	end
	local ch = player.Character
	local zHum = ch and ch:FindFirstChildOfClass("Humanoid")
	local zRoot = ch and ch:FindFirstChild("HumanoidRootPart")
	local zCam = Workspace.CurrentCamera
	if not (zHum and zRoot and zCam) then return end
	if zHum.Sit then
		FN.toast("Web Zip: not while seated")
		return
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { ch, ST.airWalkPart, ST.waterPart }

	local r = Workspace:Raycast(zCam.CFrame.Position,
		zCam.CFrame.LookVector * (MISC.spiderZipRange or 250), params)
	if not r then
		FN.toast("Web Zip: nothing in range")
		return
	end

	local delta = r.Position - zRoot.Position
	local dist = delta.Magnitude
	if dist < 2 then return end

	-- Let go of the wall first, or the cling loop pins the CFrame back and
	-- eats the velocity on the very next frame
	ST.spiderStuck = false
	ST.spiderNormal = nil
	ST.spiderHover = nil
	ST.spiderZipAt = tick()

	-- Aimed a little above the target: fired flat you arrive at the wall's
	-- foot, and the arc is what makes it read as a swing rather than a dash
	local lift = math.clamp(dist * 0.25, 4, 40)
	local dir = (delta + Vector3.new(0, lift, 0)).Unit

	pcall(function()
		zHum.PlatformStand = false
		zHum:ChangeState(Enum.HumanoidStateType.GettingUp)
		zRoot.AssemblyLinearVelocity = dir * math.clamp(dist * 2.2, 60, 320)
	end)
	FN.toast(string.format("Web Zip -- %d studs", math.floor(dist)))
end

--[[
	"Why am I floating?"

	Thirty-odd toggles can hold a character off the ground, and once two of them
	are on at once, guessing which one is doing it is hopeless -- turning things
	off one at a time is the slowest possible way to find out.

	So this asks the character itself. It reports what is TRUE right now, not
	what the menu believes: an Anchored root part, a BodyPosition the game
	added, gravity someone left at zero. That matters, because the cause is
	quite often not this script at all, and a menu that can only blame its own
	switches is no use in that case.

	Ordered by how directly each thing pins you: physics first, then the
	features, then the merely suspicious.
--]]
--[[
	Turning one joint, on either rig.

	R6 keeps its Neck Motor6D on the Torso; R15 keeps it on the Head and adds a
	Waist on the UpperTorso. Rather than branch on the rig, look for the joint
	by name anywhere in the character -- there is exactly one of each.

	The rotation is applied as (pivot) * (ours) * (its original rotation), which
	turns the joint in the TORSO's axes. Doing the obvious thing instead --
	original * ours -- turns it in the joint's own axes, and R6's neck axes are
	rotated ninety degrees, so the head ends up lying on its shoulder.
--]]
function FN.setJoint(char, jointName, pitch, yaw)
	-- Cached per character. This runs sixty times a second for two joints, and
	-- walking every descendant of a rig each time to find something that only
	-- changes on respawn is the kind of cost that shows up as "the menu makes
	-- my game stutter". false is stored for a joint that does not exist, so an
	-- R6 rig with no Waist stops being searched rather than being searched
	-- forever.
	if ST.jointChar ~= char then
		ST.jointChar = char
		ST.jointFind = {}
	end

	local cached = ST.jointFind[jointName]
	if cached == nil or (cached ~= false and cached.Parent == nil) then
		local found
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("Motor6D") and d.Name == jointName then
				found = d
				break
			end
		end
		cached = found or false
		ST.jointFind[jointName] = cached
	end
	if not cached then return end
	local joint = cached

	local orig = ST.jointOrig[joint]
	if orig == nil then
		orig = joint.C0
		ST.jointOrig[joint] = orig
	end

	pcall(function()
		joint.C0 = CFrame.new(orig.Position)
			* CFrame.Angles(pitch, yaw, 0)
			* orig.Rotation
	end)
end

-- Put every joint we have touched back. Called when the feature goes off, and
-- on the way out, because a head left at forty degrees is a strange thing to
-- leave behind.
function FN.restoreJoints()
	for joint, orig in pairs(ST.jointOrig) do
		pcall(function()
			if joint and joint.Parent then joint.C0 = orig end
		end)
	end
	table.clear(ST.jointOrig)
	ST.headYaw, ST.headPitch = 0, 0
end

--[[
	Movement recorder.

	Records where you were, every so often, and plays it back. Useful for an
	obby you have already solved, a farming route you do not want to walk again,
	or proving to yourself that a jump is possible.

	Positions, not inputs. Replaying inputs would need the world to be in the
	same state and the physics to land identically, and it never does -- one
	frame of lag and the run diverges and never recovers. Positions always
	arrive; the cost is that it looks like gliding rather than walking, which
	for a route you are automating is the right trade.

	Stored as {t, pos} pairs so playback follows the ORIGINAL timing rather than
	the frame rate it happens to be replayed at.
--]]
function FN.macroClear()
	MACRO.points = {}
	MACRO.recording = false
	MACRO.playing = false
	MACRO.at = 0
	MACRO.index = 1
end

function FN.macroRecord(on)
	if on then
		FN.macroClear()
		MACRO.recording = true
		MACRO.startedAt = tick()
		FN.toast("Recording -- walk your route")
	else
		MACRO.recording = false
		FN.toast(string.format("Recorded %d points, %.1fs",
			#MACRO.points, MACRO.points[#MACRO.points] and MACRO.points[#MACRO.points].t or 0))
	end
	FN.updateUI()
end

function FN.macroPlay(on)
	if on then
		if #MACRO.points < 2 then
			FN.toast("Nothing recorded yet")
			return
		end
		MACRO.recording = false
		MACRO.playing = true
		MACRO.index = 1
		MACRO.startedAt = tick()
		FN.toast("Playing back -- move to cancel")
	else
		MACRO.playing = false
		FN.toast("Playback stopped")
	end
	FN.updateUI()
end

--[[
	Player watchlist.

	Names you want to know about the moment they walk in. The list is matched
	case-insensitively against both the username and the display name, because
	the person you remember is not always the name the server knows.

	Checked on join AND once at startup, since the more common case is that they
	were already here when you arrived.
--]]
function FN.watchMatch(plr)
	local list = MISC.watchNames or ""
	if list == "" then return false end
	local uname = plr.Name:lower()
	local dname = (plr.DisplayName or plr.Name):lower()
	for raw in list:gmatch("[^,]+") do
		local want = raw:gsub("^%s+", ""):gsub("%s+$", ""):lower()
		if want ~= "" and (uname == want or dname == want
			or uname:find(want, 1, true) or dname:find(want, 1, true)) then
			return true
		end
	end
	return false
end

function FN.watchCheck(plr, why)
	if not MISC.watchOn then return end
	if plr == player then return end
	if not FN.watchMatch(plr) then return end

	FN.toast("WATCHLIST: " .. plr.Name .. " " .. why)
	warn("[ModMenu] watchlist hit: " .. plr.Name .. " (" .. plr.DisplayName .. ") " .. why)

	if MISC.watchHop then
		-- Leaving is the whole point of the alert for most people, so it is one
		-- setting rather than something to go and do by hand while they walk over
		FN.toast("Watchlist: hopping servers")
		task.delay(0.6, function()
			FN.armRejoin(true)
			pcall(function()
				SERV.TeleportService:Teleport(game.PlaceId, player)
			end)
		end)
	end
end

function FN.watchScan()
	if not MISC.watchOn then return end
	for _, plr in ipairs(Players:GetPlayers()) do
		FN.watchCheck(plr, "is already in this server")
	end
end

