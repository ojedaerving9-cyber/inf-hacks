bindAction(UI.katCampBtn, function()
	stepKat()
	-- The longest-stationary survivor, not the nearest: someone who has not
	-- moved in a minute is in a hiding spot, and that is the one worth the walk
	local best, bestSince
	for other, mark in pairs(KAT.still) do
		if other.Parent and not FN.katIsInfected(other) then
			local char = other.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if root and os.clock() - mark.since > 6 then
				if not bestSince or mark.since < bestSince then
					best, bestSince = root, mark.since
				end
			end
		end
	end
	if not best then
		FN.toast("Nobody is hiding yet")
		return
	end
	katGoTo(best)
	FN.toast(string.format("Camper: still for %.0fs", os.clock() - bestSince))
end)

