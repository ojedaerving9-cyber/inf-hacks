bindAction(UI.closeOthersBtn, function()
	local closed = 0
	-- PlayerGui only, and only things carrying our attribute. Never by name:
	-- that is the mistake the startup scan made.
	for _, gui in ipairs(playerGui:GetChildren()) do
		if gui ~= DEC.screenGui and gui:IsA("ScreenGui")
			and gui:GetAttribute("ModMenuProPlus") then
			pcall(function() gui:Destroy() end)
			closed = closed + 1
		end
	end

	-- The old copy's loops keep running after its GUI is destroyed -- they are
	-- connections, not children -- so this cannot fully stop it. Said plainly
	-- rather than implying the copy is gone.
	if closed > 0 then
		FN.toast(closed .. " old menu(s) closed -- rejoin to clear their loops")
	else
