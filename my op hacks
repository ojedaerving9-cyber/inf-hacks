local function noclipPart(part)
	if not part:IsA("BasePart") then return end
	-- The assembly's root part keeps physics; turning its collision off is what
	-- drops you through the world uncontrollably. Matched by role, not by the
	-- name "HumanoidRootPart" -- a custom rig can call its root anything, and a
	-- name check then either misses it (you fall) or skips the wrong part.
	local ch = player.Character
	local realRoot = ch and ch:FindFirstChild("HumanoidRootPart")
	if part == realRoot or part.Name == "HumanoidRootPart" then return end
	if ST.noclipOriginalCollide[part] == nil then
		ST.noclipOriginalCollide[part] = part.CanCollide
		-- Drop the reference when the part dies so the table can't grow forever
		part.Destroying:Once(function()
			ST.noclipOriginalCollide[part] = nil
			local watch = ST.noclipWatch[part]
			if watch then
				watch:Disconnect()
				ST.noclipWatch[part] = nil
			end
		end)

		-- Watch the property rather than relying on the rescan.
		--
		-- Custom rigs often carry a script that sets CanCollide back on every
		-- frame -- ragdoll setups, weld rebuilders, the game's own limb
		-- handlers. Against that, a rescan four times a second loses for most
		-- of every interval, which is exactly the "noclip does not work on this
		-- rig" case: it works for a frame at a time and you still hit walls.
		--
		-- One connection per part, dropped when noclip is switched off or the
		-- part dies, so nothing accumulates.
		if ST.noclipWatch[part] == nil then
			ST.noclipWatch[part] = part:GetPropertyChangedSignal("CanCollide"):Connect(function()
				if ST.noclipping and part.CanCollide then
					part.CanCollide = false
				end
			end)
		end
	end
	if part.CanCollide then
		part.CanCollide = false
	end
end

local function restoreNoclipParts()
	-- Watchers first: one still listening while the originals are restored
	-- would see CanCollide go true and immediately set it false again, which
	-- would make switching noclip off do nothing at all
	for part, conn in pairs(ST.noclipWatch) do
		pcall(function() conn:Disconnect() end)
		ST.noclipWatch[part] = nil
	end

	for part, wasCollidable in pairs(ST.noclipOriginalCollide) do
		if part and part.Parent then
			pcall(function() part.CanCollide = wasCollidable end)
		end
	end
	ST.noclipOriginalCollide = {}
	-- The watcher table was already emptied at the top of this function; no
	-- second pass needed.
end

local function setNoclip(state)
	ST.noclipping = state

	-- The height to hold. Captured on the way in, because the moment collisions
	-- are off there is no floor left to measure against -- and cleared on the
	-- way out so the next run does not inherit a height from somewhere else.
	if state then
		local ch = player.Character
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		MISC.noclipY = hrp and hrp.Position.Y or nil
	else
		MISC.noclipY = nil
	end

	if CONN.noclipDescendantConn then
		CONN.noclipDescendantConn:Disconnect()
		CONN.noclipDescendantConn = nil
	end

	local character = player.Character

	if ST.noclipping then
		if character then
			for _, part in ipairs(character:GetDescendants()) do
				noclipPart(part)
			end
			-- Accessories and tools added mid-noclip get caught here
			CONN.noclipDescendantConn = character.DescendantAdded:Connect(function(desc)
				if ST.noclipping then
					noclipPart(desc)
				end
			end)
		end
	else
		restoreNoclipParts()
	end

	FN.updateUI()
end

-- Heavy custom rigs sink through the thin air-walk platform, so the character
-- is made massless while air walking. Originals are kept per-part and put back
-- exactly, the same way noclip restores CanCollide.
ST.airWalkMassless = {}
-- Shared throttle for the character rescans below. Walking GetDescendants on
-- every frame allocates a fresh table 60x a second per feature, which is real
-- CPU load on a big custom rig -- four times a second is plenty.
ST.nextCharScan = 0

local function applyAirWalkMassless(character)
	for _, part in ipairs(character:GetDescendants()) do
		-- Massless is ignored on an assembly's root part, so skip it
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
			if ST.airWalkMassless[part] == nil then
				ST.airWalkMassless[part] = part.Massless
			end
			if not part.Massless then part.Massless = true end
		end
	end
end

local function restoreAirWalkMassless()
	for part, wasMassless in pairs(ST.airWalkMassless) do
		-- Parts are gone after a respawn; writing to them would throw
		pcall(function()
			if part.Parent then part.Massless = wasMassless end
		end)
	end
	table.clear(ST.airWalkMassless)
end

local function setAirWalk(state)
	ON.airWalkEnabled = state
	if not ON.airWalkEnabled then
		if ST.airWalkPart then
			pcall(function() ST.airWalkPart:Destroy() end)
			ST.airWalkPart = nil
		end
		restoreAirWalkMassless()
	end
	FN.updateUI()
end

-- Object ESP: highlights world objects by name (chests, ores, doors).
-- Player characters are excluded outright -- without that filter this is just
-- player ESP with a text box in front of it.
-- (OESP itself is declared near the top, above updateUI, which reads it.)

-- Roblox only renders about 31 Highlight instances at once, so past that they
-- silently do nothing -- useless for a map full of ore. BoxHandleAdornment has
-- no such cap and still draws through walls via AlwaysOnTop.
-- Known materials get a colour that looks like the thing itself, so coal reads
-- black and ruby reads red instead of whatever a hash happened to produce.
-- Matched as substrings, so "CoalOre", "coal_block" and "DeepCoal" all hit.
ST.ORE_COLOURS = {
	coal      = Color3.fromRGB(22, 22, 26),
	obsidian  = Color3.fromRGB(28, 16, 44),
	ruby      = Color3.fromRGB(205, 30, 45),
	redstone  = Color3.fromRGB(215, 45, 40),
	iron      = Color3.fromRGB(196, 160, 132),
	copper    = Color3.fromRGB(198, 108, 58),
	gold      = Color3.fromRGB(242, 190, 62),
	silver    = Color3.fromRGB(206, 208, 216),
	platinum  = Color3.fromRGB(226, 232, 238),
	diamond   = Color3.fromRGB(96, 224, 232),
	sapphire  = Color3.fromRGB(48, 92, 220),
	lapis     = Color3.fromRGB(38, 78, 198),
	emerald   = Color3.fromRGB(44, 200, 96),
	jade      = Color3.fromRGB(84, 198, 148),
	amethyst  = Color3.fromRGB(162, 92, 222),
	uranium   = Color3.fromRGB(126, 232, 62),
	titanium  = Color3.fromRGB(170, 182, 196),
	quartz    = Color3.fromRGB(238, 234, 226),
	stone     = Color3.fromRGB(128, 128, 134),
	dirt      = Color3.fromRGB(122, 88, 58),
	wood      = Color3.fromRGB(150, 110, 66),
	chest     = Color3.fromRGB(196, 146, 74),
}

-- Fallback for anything not in the table: hashing the name is deterministic, so
-- a given object keeps its shade between scans rather than shifting each time
-- the scan order changes.
local function hashColour(name)
	local h = 0
	for i = 1, #name do
		h = (h * 31 + name:byte(i)) % 360
	end
	return Color3.fromHSV(h / 360, 0.8, 1)
end

local function colourForName(name, inst)
	local lower = name:lower()
	for key, colour in pairs(ST.ORE_COLOURS) do
		if lower:find(key, 1, true) then return colour end
	end

	-- Not a name we know: borrow the object's own colour, so an unfamiliar ore
	-- still reads as itself. Only when it is actually coloured -- a plain grey
	-- default would make half the map look identical.
	local ok, c = pcall(function() return inst and inst.Color end)
	if ok and typeof(c) == "Color3" then
		local _, sat, val = Color3.toHSV(c)
		if sat > 0.15 or val < 0.25 then return c end
	end

	return hashColour(name)
end

local function clearObjectEsp()
	for _, entry in ipairs(OESP.tracked) do
		if entry.adorn then pcall(function() entry.adorn:Destroy() end) end
	end
	table.clear(OESP.tracked)
end

local function scanObjectEsp()
	clearObjectEsp()
	OESP.count = 0

	-- "Blocks/" highlights everything inside a Blocks folder, "Blocks/AX" only
	-- the ones named AX* in it, and a bare "Ore" matches on name alone. The
	-- container form exists because objects are often named nothing like what
	-- they are -- ores sitting in Blocks as AX-E1 and so on.
	local raw = OESP.query:lower()
	local slash = raw:find("/", 1, true)
	local containerName, nameQuery
	if slash then
		containerName = raw:sub(1, slash - 1):gsub("^%s+", ""):gsub("%s+$", "")
		nameQuery = raw:sub(slash + 1):gsub("^%s+", ""):gsub("%s+$", "")
	else
		nameQuery = raw
	end
	-- Comma separated: "Ore, Chest" matches either. Each term keeps its own
	-- colour so two kinds of object stay distinguishable on screen.
	local terms = {}
	for raw in nameQuery:gmatch("[^,]+") do
		local term = raw:gsub("^%s+", ""):gsub("%s+$", "")
		if term ~= "" then table.insert(terms, term) end
	end

	-- Empty box: fall back to the things usually worth finding, rather than
	-- doing nothing -- which just reads as the feature being broken.
	-- Skipped when a container was given, since "Blocks/" already means
	-- "everything in here" and defaults would fight that.
	if #terms == 0 and (containerName or "") == "" then
		terms = { "chest", "ore", "coin", "loot", "crate", "gem", "key", "drop" }
	end

	local palette = {
		Color3.fromRGB(80, 200, 255),
		Color3.fromRGB(255, 190, 70),
		Color3.fromRGB(130, 255, 130),
		Color3.fromRGB(255, 120, 220),
		Color3.fromRGB(180, 150, 255),
	}

  

	-- Every player's character, so nothing inside one can be highlighted.
	-- Rebuilt each scan so players who joined since the last one are covered.
	local characters = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then characters[p.Character] = true end
	end

	-- Distance limit. Also makes the 150 cap useful rather than arbitrary: with
	-- a limit set, the cap fills with things near you instead of whatever the
	-- descendant walk happened to reach first.
	local myPos
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if myRoot then myPos = myRoot.Position end
	local maxDist = MISC.espDist or 0

	-- A spatial query, NOT Workspace:GetDescendants(). On a voxel map every
	-- block is its own instance, so a full descendant walk builds one table
	-- holding the entire game -- enough to exhaust memory and close the client
	-- outright, with no Lua error to show for it. GetPartBoundsInRadius asks
	-- the engine for nearby parts only, and caps how many it will return.
	if not myPos then return end
	local radius = (maxDist > 0) and maxDist or 500

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { myChar }
	params.MaxParts = 4000

	local nearby = {}
	pcall(function()
		nearby = Workspace:GetPartBoundsInRadius(myPos, radius, params)
	end)

	-- Models already marked this scan. Only used in MODEL mode, where the first
	-- part of a model to come out of the query draws for the whole thing.
	local seenModels = {}

	local count = 0
	for _, inst in ipairs(nearby) do
		-- Hard cap: a broad query on a big map would otherwise make thousands
		if count >= 150 then break end

		-- Which term matched, so the colour can follow it. A container-only
		-- query has no terms, in which case everything inside counts.
		local matchIdx = nil
		if #terms == 0 then
			matchIdx = 1
		else
			-- Check the part and, if it sits in a Model, that Model's name too:
			-- the spatial query returns parts, so "Chest" as a Model would
			-- otherwise never match
			local lowerName = inst.Name:lower()
			local parentModel = inst.Parent
			local parentName = (parentModel and parentModel:IsA("Model"))
				and parentModel.Name:lower() or nil

			for i, term in ipairs(terms) do
				if lowerName:find(term, 1, true)
					or (parentName and parentName:find(term, 1, true)) then
					matchIdx = i
					break
				end
			end
		end

		if (inst:IsA("BasePart") or inst:IsA("Model")) and matchIdx then
			-- The object can BE a character model, not just live inside one --
			-- a character Model is named after its player, so searching a
			-- username matched it and an ancestry walk starting at .Parent
			-- never looked at it. Check the object itself first.
			local skip = characters[inst] == true

			-- A Model holding a Humanoid is a character even if it is not in
			-- the Players list yet -- mid-join, or a game-swapped character
			if not skip and inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") then
				skip = true
			end

			-- Then the ancestry: rejects parts inside a character, and confirms
			-- the container when one was asked for
			local inContainer = (containerName or "") == ""
			local node = inst.Parent
			while not skip and node and node ~= Workspace do
				if characters[node] then
					skip = true
					break
				end
				if not inContainer and node.Name:lower() == containerName then
					inContainer = true
				end
				node = node.Parent
			end
			skip = skip or not inContainer

			if not skip then
				-- An adornment needs a real part; a Model has to resolve to one
				local target = inst
				if inst:IsA("Model") then
					target = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart")
				end

				-- Checked after resolving to a part, since a Model has no Position
				if target and maxDist > 0 and myPos
					and (target.Position - myPos).Magnitude > maxDist then
					target = nil
				end

				-- Size filter. Maps are full of one-stud decoration -- leaves,
				-- rivets, grass blades -- and on a broad query they eat the cap
				-- before anything you actually wanted gets a marker.
				if target and MISC.espMinSize > 0 then
					local sz = target.Size
					if math.max(sz.X, sz.Y, sz.Z) < MISC.espMinSize then
						target = nil
					end
				end

				-- Grouping. The spatial query hands back PARTS, never models, so
				-- a twenty-part chest is twenty separate hits: twenty boxes
				-- stacked on one object and twenty of the 150 slots gone.
				--
				-- MODEL mode collapses those to one marker for the model. PARTS
				-- mode is the old behaviour and is still the right one when the
				-- thing you are hunting IS a loose part -- ores, drops, coins.
				local ownerModel
				if target and MISC.espGroup == "MODEL" then
					ownerModel = inst:FindFirstAncestorWhichIsA("Model")
					-- Nearest model, not outermost: a lot of maps put the whole
					-- world under one Model, and grouping by that draws one box
					-- around everything and calls it a day
					if ownerModel and seenModels[ownerModel] then
						target = nil
					elseif ownerModel then
						seenModels[ownerModel] = true
					end
				end

				if target then
					-- By type: every distinct ore name gets its own shade, which is
					-- what you want when one term matches many kinds of object.
					-- By term: one colour per search term, better for telling
					-- "Ore" apart from "Chest" at a glance.
					local colour = MISC.espByType
						and colourForName(inst.Name, target)
						or palette[((matchIdx - 1) % #palette) + 1]
					-- Two render styles because the engine limits some of these.
					-- BOX draws a wireframe-ish cube via an adornment; DOT draws a
					-- BillboardGui marker, which is plain GUI rendering and has no
					-- count limit at all. If one stops appearing past a few dozen
					-- objects, the other will keep going.
					local ok, adorn = pcall(function()
						if MISC.espStyle == "DOT" then
							local bb = Instance.new("BillboardGui")
							bb.Name = "ObjEsp" .. uiName
							bb.Adornee = target
							bb.AlwaysOnTop = true
							bb.LightInfluence = 0
							bb.Size = UDim2.new(0, 12, 0, 12)
							bb.Parent = target

							local dot = Instance.new("Frame")
							dot.Size = UDim2.new(1, 0, 1, 0)
							dot.BackgroundColor3 = colour
							dot.BorderSizePixel = 0
							dot.Parent = bb
							Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
							return bb
						end

						local a = Instance.new("BoxHandleAdornment")
						a.Name = "ObjEsp" .. uiName
						a.Adornee = target
						a.AlwaysOnTop = true
						a.ZIndex = 5
						a.Size = target.Size + Vector3.new(0.15, 0.15, 0.15)

						-- One box around the whole model rather than around
						-- whichever part happened to be found first. The
						-- adornment's CFrame is relative to its adornee, so the
						-- model's bounds have to be brought into the part's space.
						if ownerModel and MISC.espModelWhole then
							local okBB, bbCf, bbSize = pcall(function()
								return ownerModel:GetBoundingBox()
							end)
							if okBB and bbSize then
								a.Size = bbSize + Vector3.new(0.15, 0.15, 0.15)
								a.CFrame = target.CFrame:ToObjectSpace(bbCf)
							end
						end
						a.Transparency = 0.55
						a.Color3 = colour
						a.Parent = target
						return a
					end)

					if ok and adorn then
						table.insert(OESP.tracked, { adorn = adorn })
						count = count + 1
					end
					-- Kept so the button can report the real number: guessing from
					-- what you can see on screen is exactly how the render-cap
					-- confusion started.
					OESP.count = count
				end
			end
		end
	end
end

-- ==========================================
-- PLAYER ESP
-- ==========================================
-- Markers are parented to PlayerGui rather than to the other player's
-- character: anything parented into their model dies with it on respawn, and
-- the marker would vanish until the next refresh caught up. Adornee is
-- re-pointed at the new head instead, so it survives their death.
local function clearPlayerEsp()
	for _, entry in pairs(PESP.tracked) do
		pcall(function() if entry.line then entry.line:Destroy() end end)
		pcall(function() if entry.bb then entry.bb:Destroy() end end)
		pcall(function() if entry.box then entry.box:Destroy() end end)
	end
	table.clear(PESP.tracked)
end

local function refreshPlayerEsp()
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local myPos = myRoot and myRoot.Position

	-- Anyone who left, or who we are no longer tracking, goes first. Iterating
	-- the table while destroying out of it is safe here because the entry is
	-- removed by key, not by position.
	for target, entry in pairs(PESP.tracked) do
		-- A game that clears PlayerGui takes the billboard with it, leaving an
		-- entry pointing at a destroyed instance. Dropping it here means the
		-- rebuild below just makes a fresh one.
		local orphaned = (entry.bb and entry.bb.Parent == nil)
			or (entry.box and entry.box.Parent == nil)
		-- Works for both key kinds: a Player leaving and a clone being deleted
		-- both show up as a nil Parent
		if target.Parent == nil or orphaned or not PESP.enabled then
			pcall(function() if entry.bb then entry.bb:Destroy() end end)
			pcall(function() if entry.box then entry.box:Destroy() end end)
			pcall(function() if entry.line then entry.line:Destroy() end end)
			PESP.tracked[target] = nil
		end
	end
	if not PESP.enabled then
		PESP.shown = 0
		return
	end

	-- Counted so the button can report the real number: on an empty server the
	-- feature otherwise looks broken rather than simply having nobody to mark.
	local shown = 0

	-- Keyed by CHARACTER rather than Player now. A clone has no Player, so a
	-- player-keyed table could not hold one at all -- which is why clones were
	-- invisible to the ESP while standing right in front of you.
	for _, entry in ipairs(ST.charList()) do
		local other, char = entry.plr, entry.model
		-- Clones get an entry too; the table key is whatever identifies them
		local key = other or char
		do
			local head = char and char:FindFirstChild("Head")
			local hum = entry.hum
			local marker = PESP.tracked[key]

			-- No head means they are dead or still loading. The marker is kept
			-- and simply hidden, so a respawn does not cost a rebuild.
			local visible = head ~= nil
			if visible and PESP.dist > 0 and myPos then
				visible = (head.Position - myPos).Magnitude <= PESP.dist
			end
			-- Infection round: everyone alive is on screen otherwise, and the
			-- only ones worth tracking are the ones hunting you
			-- Only real players have a side. Asking about a clone means an error
			-- caught by a pcall, four times a second, per clone.
			local infected = other ~= nil and FN.katIsInfected(other) or false
			if visible and KAT.onlyInfected and not infected then
				visible = false
			end

			if not marker then
				marker = {}
				pcall(function()
					local bb = Instance.new("BillboardGui")
					bb.Name = "PlayerEsp" .. uiName
					bb.AlwaysOnTop = true
					bb.LightInfluence = 0
					bb.Size = UDim2.new(0, 200, 0, 34)
					bb.StudsOffset = Vector3.new(0, 2.4, 0)
					bb.Parent = playerGui

					local label = Instance.new("TextLabel")
					label.Size = UDim2.new(1, 0, 1, 0)
					label.BackgroundTransparency = 1
					label.Font = Enum.Font.GothamBold
					label.TextSize = 13
					label.TextStrokeTransparency = 0.4
					label.Text = other and other.Name or char.Name
					label.Parent = bb

					local box = Instance.new("BoxHandleAdornment")
					box.Name = "PlayerEsp" .. uiName
					box.AlwaysOnTop = true
					box.ZIndex = 5
					box.Size = Vector3.new(4, 6, 2)
					box.Transparency = 0.65
					-- Adornments need a rendered container; Workspace is the one
					-- the game will not wipe on respawn the way it does PlayerGui
					box.Parent = Workspace

					marker.bb, marker.label, marker.box = bb, label, box
				end)
				PESP.tracked[key] = marker
			end

			pcall(function()
				if not marker.bb then return end

				-- Team colour when the game actually has teams, health colour
				-- otherwise: green through red as they take damage, which is
				-- the more useful signal in a game with no teams to tell apart.
				local colour
				-- Infected always read red and survivors green, whatever the
				-- game's team colours happen to be: in a round game that is the
				-- one distinction you need at a glance, and a game whose teams
				-- are both shades of grey would otherwise tell you nothing
				if KAT.onlyInfected or KAT.alert then
					colour = infected
						and Color3.fromRGB(255, 60, 60)
						or Color3.fromRGB(90, 230, 120)
				elseif PESP.team and other.Team then
					colour = other.TeamColor.Color
				elseif hum and hum.MaxHealth > 0 then
					colour = Color3.fromRGB(255, 60, 60):Lerp(
						Color3.fromRGB(80, 255, 120),
						math.clamp(hum.Health / hum.MaxHealth, 0, 1))
				else
					colour = Color3.fromRGB(235, 235, 235)
				end

				marker.bb.Adornee = head
				marker.box.Adornee = head and char:FindFirstChild("HumanoidRootPart") or nil
				marker.bb.Enabled = visible and (PESP.style ~= "BOX")
				marker.box.Visible = visible and (PESP.style ~= "NAME") and marker.box.Adornee ~= nil
				marker.label.TextColor3 = colour
				marker.box.Color3 = colour

				if visible and head then
					shown = shown + 1
					local dist = myPos and math.floor((head.Position - myPos).Magnitude) or 0
					local hp = hum and math.floor(hum.Health) or 0
					marker.label.Text = other.Name
						.. "\n" .. dist .. " studs  |  " .. hp .. " hp"
				end
			end)
		end
	end

	PESP.shown = shown
end

-- Reads another player's character out loud: health, armour, whatever Value
-- objects the game hangs on them, and what is in their Inventory folder. All
-- of it replicates from the server, so it is readable without any hooks -- the
-- game already told this client, the information is just not shown anywhere.
--
-- Deliberately generic rather than hardcoded to one game's names: it lists
-- whatever Value objects exist, so a game that calls it Stamina or Coins shows
-- up without this needing to know about it.
local function watchStep()
	local query = BOX.tpBox.Text:lower():gsub("%s+", "")
	if query == "" then
		BOX.watchLabel.Text = "Watch: pick a player in the box above"
		return
	end

	local target
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			if p.Name:lower():sub(1, #query) == query
				or p.DisplayName:lower():sub(1, #query) == query
				or tostring(p.UserId) == query then
				target = p
				break
			end
		end
	end

	if not target then
		BOX.watchLabel.Text = "Watch: no player matching '" .. query .. "'"
		return
	end

	local char = target.Character
	if not char then
		BOX.watchLabel.Text = target.Name .. "\nno character loaded"
		return
	end

	local rows = { target.Name .. (target.Team and ("  [" .. target.Team.Name .. "]") or "") }

	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		rows[#rows + 1] = string.format("health %d / %d", math.floor(hum.Health), math.floor(hum.MaxHealth))
	end

	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local theirRoot = char:FindFirstChild("HumanoidRootPart")
	if myRoot and theirRoot then
		rows[#rows + 1] = string.format("%.0f studs away", (theirRoot.Position - myRoot.Position).Magnitude)
	end

	-- Every Value object on the character. Children only: this runs twice a
	-- second, and a full descendant walk of a rig with accessories is wasted
	-- work when the game puts these at the top level anyway.
	local vals = {}
	for _, d in ipairs(char:GetChildren()) do
		if d:IsA("ValueBase") then
			vals[#vals + 1] = d.Name .. "=" .. tostring(d.Value)
		end
	end
	if #vals > 0 then
		rows[#rows + 1] = table.concat(vals, "  ")
	end

	-- Inventory, if the game keeps one on the character
	-- Armour slots follow the Minecraft numbering: 100 boots, 101 leggings,
	-- 102 chestplate, 103 helmet, bottom to top. Shown by name, since "Slot102"
	-- tells you nothing at a glance and the whole point of this panel is glances.
	local ARMOUR = { [100] = "boots", [101] = "legs", [102] = "chest", [103] = "helmet" }

	local inv = ST.invOf(char)
	if inv then
		local items = {}
		for _, item in ipairs(inv:GetChildren()) do
			local slot = tonumber(item.Name:match("^Slot(%d+)$"))
			local label = item.Name
			if slot and ARMOUR[slot] then
				label = ARMOUR[slot]
			elseif slot then
				label = "#" .. slot
			end
			-- The slot's value is the item, stored as JSON:
			--   {"durability":17593,"count":1,"name":"HackerHelmet"}
			-- Printing that raw fills the panel with punctuation, so it is
			-- decoded to name, count and durability. Decoding is pcall'd and
			-- falls back to the raw string: an empty slot, a different schema
			-- or a half-written value must not blank the whole readout.
			local ok, contents = pcall(function()
				if item:IsA("ValueBase") then return tostring(item.Value) end
				local first = item:FindFirstChildOfClass("StringValue")
				return first and tostring(first.Value) or nil
			end)

			if ok and contents and contents ~= "" and contents ~= "nil" then
				local decoded
				pcall(function()
					decoded = SERV.HttpService:JSONDecode(contents)
				end)

				if type(decoded) == "table" and decoded.name then
					local bit = tostring(decoded.name)
					if tonumber(decoded.count) and decoded.count > 1 then
						bit = bit .. " x" .. decoded.count
					end
					-- durability is false on items that do not wear out, which
					-- is worth seeing as "inf" rather than being hidden
					if decoded.durability == false then
						bit = bit .. " (inf)"
					elseif tonumber(decoded.durability) then
						bit = bit .. " (" .. math.floor(decoded.durability) .. ")"
					end
					label = label .. ": " .. bit
				else
					label = label .. ":" .. contents:sub(1, 24)
				end
			end
			-- Slots exist whether or not anything is in them; listing the empty
			-- ones pushes the real contents off the panel. Tested on the
			-- contents directly: the old check compared the label against the
			-- slot name, which is always different for an armour slot and so
			-- listed every empty one.
			local hasItem = ok and contents ~= nil and contents ~= ""
				and contents ~= "nil" and contents ~= "{}"
			if hasItem then
				items[#items + 1] = label
			end
			-- Capped: a full inventory would push everything else off the label
			if #items >= 10 then
				items[#items + 1] = "..."
				break
			end
		end
		rows[#rows + 1] = "inv: " .. ((#items > 0) and table.concat(items, ", ") or "empty")
	end

	-- Equipped tool is worth calling out separately: it is what they can hit
	-- you with right now
	local held = char:FindFirstChildOfClass("Tool")
	if held then rows[#rows + 1] = "holding: " .. held.Name end

	BOX.watchLabel.Text = table.concat(rows, "\n")
end

-- ==========================================
-- LUCKY WORLD
-- ==========================================
-- Nearby blocks matching the filter, nearest first. GetPartBoundsInRadius, not
-- a descendant walk: on a block game every block is its own instance, and
-- materialising all of them is what closes the client with no error.
local function lwScan()
	local ch = player.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	if not root then
		LW.nearest, LW.count = nil, 0
		return
	end

	local terms = {}
	for raw in LW.filter:lower():gmatch("[^,]+") do
		local term = raw:gsub("^%s+", ""):gsub("%s+$", "")
		if term ~= "" then terms[#terms + 1] = term end
	end
	if #terms == 0 then
		LW.nearest, LW.count = nil, 0
		return
	end

	-- Characters excluded: a player called "Emerald" would otherwise be the
	-- nearest "block" and the auto miner would swing at them all day
	local chars = { ch }
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then chars[#chars + 1] = p.Character end
	end

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = chars
	params.MaxParts = 3000

	local nearby = {}
	pcall(function()
		nearby = Workspace:GetPartBoundsInRadius(root.Position, LW.range, params)
	end)

	local best, bestDist, count = nil, math.huge, 0
	for _, part in ipairs(nearby) do
		-- The model name counts too: blocks are often a Model called
		-- "LuckyBlock" holding parts named "Part"
		local model = part.Parent
		local name = (part.Name .. " " .. ((model and model.Name) or "")):lower()
		for _, term in ipairs(terms) do
			if name:find(term, 1, true) then
				count = count + 1
				local d = (part.Position - root.Position).Magnitude
				if d < bestDist then best, bestDist = part, d end
				break
			end
		end
	end

	LW.nearest = best
	LW.count = count
end

-- Auto mine. Equips a tool if one is in the backpack, points at the block and
-- activates -- plus a fired touch, since plenty of block games break on contact
-- rather than on a click.
local function lwMine()
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	local block = LW.nearest
	if not hum or not root or not block or not block.Parent then return end

	-- Out of arm's reach: mining something across the map is what Go To is for
	if (block.Position - root.Position).Magnitude > 40 then return end

	local tool = ch:FindFirstChildOfClass("Tool")
	if not tool then
		-- Same problem as the seat attack had: this game keeps items as slot
		-- JSON, not Backpack Tools, so a Backpack-only search mines barehanded
		ST.equipBest(ch, hum)
		tool = ch:FindFirstChildOfClass("Tool")
	end

	-- Facing matters in games that raycast from the character forward. Yaw
	-- only: pitching the root tips the whole rig over.
	if LW.face then
		pcall(function()
			local flat = Vector3.new(block.Position.X, root.Position.Y, block.Position.Z)
			root.CFrame = CFrame.lookAt(root.Position, flat)
		end)
	end

	if tool then
		pcall(function() tool:Activate() end)
		local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
		if handle and type(firetouchinterest) == "function" then
			pcall(function()
				firetouchinterest(handle, block, 0)
				firetouchinterest(handle, block, 1)
			end)
		end
	end
end

-- Auto collect. Drops are picked up by touching them, so the touch is fired
-- directly instead of walking over each one. Tools on the floor are included
-- because that is how most of these games hand out rewards.
local function lwCollect()
	if type(firetouchinterest) ~= "function" then return end

	local ch = player.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { ch }
	params.MaxParts = 500

	local nearby = {}
	pcall(function()
		nearby = Workspace:GetPartBoundsInRadius(root.Position, 40, params)
	end)

	-- Drops are destroyed as they are picked up, so the cooldown table is
	-- pruned here rather than growing one dead key per item for the session
	for part, at in pairs(ST.lwTouched) do
		if part.Parent == nil or at < os.clock() - 30 then ST.lwTouched[part] = nil end
	end

	for _, part in ipairs(nearby) do
		local parent = part.Parent
		local isDrop = false
		if parent and parent:IsA("Tool") then
			isDrop = true
		else
			local n = part.Name:lower()
			isDrop = n:find("drop", 1, true) or n:find("coin", 1, true)
				or n:find("gem", 1, true) or n:find("orb", 1, true)
				or n:find("pickup", 1, true) or n:find("reward", 1, true)
		end

		-- Each drop is touched once, then left alone for a few seconds. Without
		-- this the same item was touched twice a second forever, the counter
		-- climbed on nothing, and the server saw a stream of repeats.
		if isDrop and (ST.lwTouched[part] or 0) < os.clock() then
			ST.lwTouched[part] = os.clock() + 3
			pcall(function()
				firetouchinterest(root, part, 0)
				firetouchinterest(root, part, 1)
			end)
			LW.collected = LW.collected + 1
		end
	end
end

-- ==========================================
-- KAT INFECTION
-- ==========================================
-- Is this player on the hunting side? Three ways, in order of how reliable
-- they are: the tag you typed, their team, then their character. The character
-- check exists because plenty of infection games swap the model instead of
-- moving anyone between teams, and a team-only test reports nobody infected
-- in those -- which reads as the feature being broken.
function FN.katIsInfected(other)
	local tag = KAT.tag
	if tag == "" then tag = nil end

	local ok, result = pcall(function()
		local teamName = other.Team and other.Team.Name:lower() or ""
		if tag then
			local want = tag:lower()
			if teamName:find(want, 1, true) then return true end
			local char = other.Character
			if char then
				-- Name, a child (a tool or marker part), or an attribute
				if char.Name:lower():find(want, 1, true) then return true end
				if char:FindFirstChild(tag) then return true end
				if char:GetAttribute(tag) then return true end
			end
			return false
		end

		if teamName:find("infect", 1, true) or teamName:find("kat", 1, true) then
			return true
		end
		local char = other.Character
		if char then
			for _, d in ipairs(char:GetChildren()) do
				local n = d.Name:lower()
				if n:find("infect", 1, true) or n:find("kat", 1, true) then return true end
			end
		end
		return false
	end)

	return ok and result or false
end

-- One pass over the player list: counts both sides and finds the closest
-- infected. Runs on a timer, and everything else just reads the result --
-- the warning label, the ESP filter and the escape teleport all want the same
-- answer, and working it out three times would be three walks of the list.
-- Which way to look, relative to where the camera is pointing. A distance on
-- its own tells you something is there but not where, which in a Backrooms map
-- is most of the problem -- the corridors all look the same and the wrong guess
-- is fatal. Shared by both sides: running away and chasing want the same arrow.
local function katDirTo(fromPos, targetPos)
	local cam = Workspace.CurrentCamera
	if not cam or not fromPos or not targetPos then return "" end

	local flat = targetPos - fromPos
	flat = Vector3.new(flat.X, 0, flat.Z)
	if flat.Magnitude < 0.1 then return "" end
	flat = flat.Unit

	local look = cam.CFrame.LookVector
	look = Vector3.new(look.X, 0, look.Z)
	if look.Magnitude < 0.1 then return "" end
	look = look.Unit

	-- Dot gives front/back, the cross product's Y gives the side
	local dot = look:Dot(flat)
	if dot > 0.5 then return "AHEAD" end
	if dot < -0.5 then return "BEHIND YOU" end
	return (look:Cross(flat).Y > 0) and "RIGHT" or "LEFT"
end

local function stepKat()
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

	local infected, survivors = 0, 0
	local near, nearDist = nil, math.huge
	-- The hunting half: nearest survivor, and how many are standing still.
	-- One pass does both sides -- which side you are on changes what you read
	-- off it, not what has to be walked.
	local prey, preyDist, campers = nil, math.huge, 0

	KAT.imInfected = FN.katIsInfected(player)

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			if FN.katIsInfected(other) then
				infected = infected + 1
				local char = other.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				-- Dead ones are not chasing anybody
				if root and myRoot and (not hum or hum.Health > 0) then
					local d = (root.Position - myRoot.Position).Magnitude
					if d < nearDist then near, nearDist = other, d end
				end
			else
				survivors = survivors + 1
				local char = other.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if root and (not hum or hum.Health > 0) then
					if myRoot then
						local d = (root.Position - myRoot.Position).Magnitude
						if d < preyDist then prey, preyDist = other, d end
					end

					-- Camping check. Hiding is the whole survivor strategy, so
					-- the ones who have not moved are the ones worth walking
					-- to. Position is sampled per scan and compared against
					-- the last sample, so it costs a subtraction per player.
					local mark = KAT.still[other]
					if not mark or (root.Position - mark.pos).Magnitude > 4 then
						KAT.still[other] = { pos = root.Position, since = os.clock() }
					elseif os.clock() - mark.since > 6 then
						campers = campers + 1
					end
				end
			end
		end
	end

	KAT.infected = infected
	KAT.survivors = survivors
	KAT.near = near
	KAT.nearDist = near and nearDist or 0
	KAT.prey = prey
	KAT.preyDist = prey and preyDist or 0
	KAT.campers = campers

	-- Players who left keep an entry otherwise, and this table is walked by the
	-- camper button. One round is nothing; a long session adds up.
	for other in pairs(KAT.still) do
		if other.Parent == nil then KAT.still[other] = nil end
	end

	-- Are they looking at you, and are they gaining? A hunter facing away at 20
	-- studs is less dangerous than one sprinting at you from 50, and a bare
	-- distance readout says nothing about either.
	KAT.seen = false
	if near and myRoot then
		local root = near.Character and near.Character:FindFirstChild("HumanoidRootPart")
		if root then
			local toMe = myRoot.Position - root.Position
			toMe = Vector3.new(toMe.X, 0, toMe.Z)
			local look = root.CFrame.LookVector
			look = Vector3.new(look.X, 0, look.Z)
			if toMe.Magnitude > 0.1 and look.Magnitude > 0.1 then
				-- Roughly a 30 degree cone in front of them
				KAT.seen = look.Unit:Dot(toMe.Unit) > 0.86
			end
		end
	end

	-- Closing speed in studs per second. Positive means the gap is shrinking.
	local now = os.clock()
	-- Same hunter as last sample, or the numbers are not comparable: when the
	-- nearest swaps from someone 50 studs out to someone at 20, the difference
	-- is not movement, and it read as 120 studs/sec of closing.
	if near and near == KAT.lastNear and KAT.lastDist and (now - KAT.lastAt) > 0.05 then
		KAT.closing = (KAT.lastDist - nearDist) / (now - KAT.lastAt)
	else
		KAT.closing = 0
	end
	KAT.lastNear = near
	KAT.lastDist = near and nearDist or nil
	KAT.lastAt = now

	-- Round tally. There is no round event to listen to from the client, so
	-- these are inferred: getting turned is your own side flipping, and
	-- surviving is the infected count dropping back to zero while you are not
	-- one of them. Approximate by nature -- a scoreboard, not a source of truth.
	-- Only while you actually have a character. Mid-respawn every side test
	-- reports false, so counting through that gap turned one infection into
	-- two: infected, dead, not-infected, alive, infected again.
	if myChar then
		if KAT.imInfected and not KAT.wasInfected then
			KAT.caught = KAT.caught + 1
			FN.toast("Infected -- caught " .. KAT.caught .. " times")
		end
		if KAT.hadInfected and infected == 0 and not KAT.imInfected then
			KAT.survived = KAT.survived + 1
			FN.toast("Round survived (" .. KAT.survived .. ")")
		end
		KAT.wasInfected = KAT.imInfected
		KAT.hadInfected = infected > 0
	end

	-- Both arrows, from the one helper
	KAT.dir = ""
	if near and myRoot then
		local root = near.Character and near.Character:FindFirstChild("HumanoidRootPart")
		if root then KAT.dir = katDirTo(myRoot.Position, root.Position) end
	end
	KAT.preyDir = ""
	if prey and myRoot then
		local root = prey.Character and prey.Character:FindFirstChild("HumanoidRootPart")
		if root then KAT.preyDir = katDirTo(myRoot.Position, root.Position) end
	end

	-- Last one standing. survivors counts other players only, so zero means
	-- everybody else has been turned.
	local last = (survivors == 0 and infected > 0)
	if last and not KAT.wasLast then
		FN.toast("LAST SURVIVOR -- " .. infected .. " hunting you")
	end
	KAT.wasLast = last
end

-- Holds a key down for as long as something is near, and releases it the
-- moment it is not. Down and up are sent once each on the edges, never per
-- scan: a game reading InputBegan would otherwise see the ability re-pressed
-- four times a second instead of held.
--
-- VirtualInputManager is the one that produces real input events the game's own
-- UserInputService handlers see. VirtualUser is the fallback for executors that
-- expose only that; both are guarded, since neither is reachable everywhere.
local function katSetHold(down)
	if KAT.holding == down then return end
	KAT.holding = down

	local key = KAT.holdKey or Enum.KeyCode.Q
	local sent = false
	pcall(function()
		local vim = game:GetService("VirtualInputManager")
		vim:SendKeyEvent(down, key, false, game)
		sent = true
	end)

	if not sent and VirtualUser then
		pcall(function()
			-- VirtualUser takes the character, not the KeyCode
			local letter = key.Name:lower()
			if down then
				VirtualUser:SetKeyDown(letter)
			else
				VirtualUser:SetKeyUp(letter)
			end
			sent = true
		end)
	end

	if not sent and down then
		FN.toast("Auto-hold: no virtual input on this executor")
		KAT.autoHold = false
		KAT.holding = false
	end
end

-- Alarm. Its own Sound rather than the music player's, or switching it on
-- would stop whatever track was playing. A built-in engine asset is used so
-- there is no id to load and nothing to fail.
local function katAlarm()
	if os.clock() < (KAT.alarmAt or 0) then return end
	-- Faster the closer they are, down to a beep every fifth of a second
	local closeness = 1 - math.clamp(KAT.nearDist / math.max(KAT.range, 1), 0, 1)
	local gap = 0.9 - (closeness * 0.7)
	-- Being looked at is worth more urgency than being merely near
	if KAT.seen then gap = gap * 0.5 end
	KAT.alarmAt = os.clock() + gap

	pcall(function()
		if not ST.katSound or not ST.katSound.Parent then
			local snd = Instance.new("Sound")
			snd.Name = "KatAlarm" .. uiName
			snd.SoundId = "rbxasset://sounds/electronicpingshort.wav"
			snd.Volume = 0.6
			snd.Parent = SERV.SoundService
			ST.katSound = snd
		end
		ST.katSound:Play()
	end)
end

-- ==========================================
-- AIM ASSIST
-- ==========================================
-- Line of sight. Raycast from the camera to the target part, ignoring both
-- characters: without the filter the ray hits your own shoulder or their own
-- limb and every target reads as behind a wall.
local function aimVisible(camPos, targetPart, targetChar)
	local myChar = player.Character
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { myChar, targetChar }
	params.IgnoreWater = true

	local dir = targetPart.Position - camPos
	local hit
	local ok = pcall(function()
		hit = Workspace:Raycast(camPos, dir, params)
	end)
	if not ok then return true end
	-- Nothing in between means clear. Something in between is a wall.
	return hit == nil
end

-- Picks the target nearest the crosshair, not the nearest in the world: a
-- player standing next to you but behind your back is not who you are aiming
-- at, and world-distance selection is what makes an assist feel like it is
-- fighting you.
-- Takes the config table rather than reading AIM directly, so aim assist and
-- silent aim can each have their own FOV, range and filters while sharing one
-- selection routine -- two copies of this drifting apart is how a "why does
-- silent aim pick someone else" bug gets written.
-- Friend lookups, cached. See the note in pickAimTarget for why this is not
-- called inline.
ST.friendCache = {}
ST.isFriend = function(plr)
	-- A mob has no user id and cannot be anyone's friend, so it is never
	-- pending and never filtered on this
	if not plr then return false end

	local id = plr.UserId
	local known = ST.friendCache[id]
	if known ~= nil then
		if known == "pending" then return nil end
		return known
	end

	ST.friendCache[id] = "pending"
	task.spawn(function()
		local ok, res = pcall(function() return player:IsFriendsWith(id) end)
		ST.friendCache[id] = (ok and res) and true or false
	end)
	return nil
end

local function pickAimTarget(cfg)
	local cam = Workspace.CurrentCamera
	if not cam then return nil end

	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end

	local viewport = cam.ViewportSize
	local centre = Vector2.new(viewport.X / 2, viewport.Y / 2)
	local best, bestDist = nil, cfg.fov

	-- Reset each pass: these describe this pick, not the session
	AIM.seen, AIM.skipDead, AIM.skipTeam, AIM.skipRange, AIM.skipWall = 0, 0, 0, 0, 0
	AIM.skipFriend = 0

	-- Everything with a Humanoid, which is what Aim At always claimed to mean.
	-- charList already excludes our own character, so there is no self check.
	for _, entry in ipairs(ST.charList()) do
		local char, hum, other = entry.model, entry.hum, entry.plr

		local scopeOk = true
		if cfg.scope == "PLAYERS" then
			scopeOk = (other ~= nil)
		elseif cfg.scope == "CLONES" then
			scopeOk = (other == nil)
		end

		if char and hum and scopeOk then
			-- R15 calls it UpperTorso and R6 calls it Torso, so torso mode tries
			-- both rather than working on one rig type and silently not the other
			local part
			if cfg.part == "TORSO" then
				part = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
			else
				part = char:FindFirstChild("Head")
			end
			-- Neither name is guaranteed off a player. Root first because
			-- every Humanoid rig has one, then whatever the shared resolver
			-- considers a body part -- otherwise a mob with no "Head" was
			-- dropped here without ever reaching the counters below, so the
			-- menu could not even tell you it had been skipped.
			if not part then
				part = char:FindFirstChild("HumanoidRootPart")
					or (ST.hitParts(char) or {})[1]
			end

			-- Dead players are skipped: the body is still there for a few
			-- seconds and the camera would lock onto a corpse mid-fight
			local alive = hum and hum.Health > 0

			-- "other" is nil for a clone, and this line used to index it
			-- without checking -- which threw inside the aim pass the moment a
			-- clone existed, killing the whole frame's targeting.
			-- Sides via the shared resolver, so a tagged game and a Teams game
			-- both work. Unknown on either side means no opinion: an unknown
			-- side must not silently become "enemy" and make the filter useless.
			local mySide = ST.sideOf(myChar, player)
			local theirSide = ST.sideOf(char, other)
			local sameTeam = (mySide ~= nil and theirSide ~= nil and mySide == theirSide)

			-- Explicit rather than a single "skip teammates" flag. A boolean
			-- cannot say which side it kept, so when it behaves backwards there
			-- is nothing to check -- and a game where everyone shares one team
			-- makes "skip teammates" mean "skip everyone", which looks exactly
			-- like the aim being broken.
			local teamOk
			if cfg.teamMode == "TEAM" then
				teamOk = sameTeam
			elseif cfg.teamMode == "ENEMIES" then
				teamOk = not sameTeam
			else
				teamOk = true
			end

			-- Friends. Only meaningful for real players, so NPCs pass
			-- untouched whatever the mode is. A pending lookup counts as a
			-- skip rather than a guess -- see ST.isFriend.
			local friendOk = true
			if cfg.friendMode and cfg.friendMode ~= "ALL" and other then
				local fr = ST.isFriend(other)
				if fr == nil then
					friendOk = false
				elseif cfg.friendMode == "NOFRIENDS" then
					friendOk = not fr
				else
					friendOk = fr
				end
			end

			-- Counted so the menu can say why nothing is being picked
			AIM.seen = (AIM.seen or 0) + 1
			if not alive then AIM.skipDead = (AIM.skipDead or 0) + 1 end
			if not teamOk then AIM.skipTeam = (AIM.skipTeam or 0) + 1 end
			if not friendOk then AIM.skipFriend = (AIM.skipFriend or 0) + 1 end

			if part and alive and teamOk and friendOk then
				local worldDist = (part.Position - myRoot.Position).Magnitude
				if worldDist > cfg.dist then
					AIM.skipRange = (AIM.skipRange or 0) + 1
				end
				if worldDist <= cfg.dist then
					local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
					if onScreen then
						local flat = Vector2.new(screenPos.X, screenPos.Y)
						local pixels = (flat - centre).Magnitude
						if pixels < bestDist then
							if not cfg.wallCheck or aimVisible(cam.CFrame.Position, part, char) then
								best, bestDist = part, pixels
							else
								AIM.skipWall = (AIM.skipWall or 0) + 1
							end
						end
					end
				end
			end
		end
	end

	return best
end

-- Called every frame from the render loop. Smoothed rather than snapped: a
-- hard snap is both unusable to play with and the single most obvious thing
-- on anyone else's screen.
local function stepAim(deltaTime)
	if not AIM.enabled then
		AIM.target = nil
		return
	end

	-- Hold mode uses right mouse, which is where an aim button already lives in
	-- most games -- and it avoids spending one of the rebindable key slots.
	if AIM.hold and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		AIM.target = nil
		return
	end

	-- Free cam owns the camera outright; two things writing CFrame in the same
	-- frame is a fight neither wins
	if ON.freeCamEnabled then return end

	local cam = Workspace.CurrentCamera
	if not cam then return end

	local target = pickAimTarget(AIM)
	AIM.target = target
	if not target then return end

	-- MOUSE: turn by moving the mouse, and let the game's own camera script do
	-- the turning. CFRAME: write the camera directly.
	--
	-- Writing CFrame only wins when nothing else is driving the camera. Shift
	-- lock, first person, and any custom camera module all recompute it from
	-- the mouse afterwards, so the write is overwritten in the same frame and
	-- the assist looks like it is fighting the camera and losing -- which is
	-- exactly what it does. Moving the mouse instead means the game turns
	-- itself, and there is nothing to fight.
	local useMouse = (AIM.method == "MOUSE") and type(mousemoverel) == "function"

	if useMouse then
		pcall(function()
			local screenPos, onScreen = cam:WorldToViewportPoint(target.Position)
			if not onScreen then return end

			local viewport = cam.ViewportSize
			local dx = screenPos.X - (viewport.X / 2)
			local dy = screenPos.Y - (viewport.Y / 2)

			-- A fraction of the gap per frame, which is what makes it a pull
			-- rather than a snap. Frame-time scaled so it behaves the same at
			-- 30 and 240fps.
			local pull = math.clamp((AIM.smooth / 100) * (deltaTime * 60), 0, 1)

			-- Under a pixel is not worth sending: rounding turns tiny moves
			-- into a permanent jitter around the target
			if math.abs(dx * pull) < 1 and math.abs(dy * pull) < 1 then return end
			mousemoverel(dx * pull, dy * pull)
		end)
		return
	end

	pcall(function()
		local from = cam.CFrame
		local want = CFrame.lookAt(from.Position, target.Position)
		-- Scaled by frame time so the pull is the same on 30fps and 240fps
		local alpha = math.clamp((AIM.smooth / 100) * (deltaTime * 60), 0, 1)
		cam.CFrame = from:Lerp(want, alpha)
	end)
end

-- Fires only when the crosshair is genuinely on the target. Aiming at someone
-- does not hit them -- something still has to swing -- and a plain auto clicker
-- swings constantly whether or not anything is in front of you, which in a
-- melee game means you are mostly hitting air on cooldown.
--
-- Kept separate from stepAim so the trigger can be used on its own, with the
-- assist switched off entirely and you doing the aiming.
local function stepTrigger()
	if not AIM.trigger then return end
	if os.clock() < (AIM.fireAt or 0) then return end

	local cam = Workspace.CurrentCamera
	local ch = player.Character
	local myRoot = ch and ch:FindFirstChild("HumanoidRootPart")
	if not cam or not myRoot then return end

	-- Its own target pick, not stepAim's: with the assist off there is no
	-- target to borrow, and the trigger still has to know what is in front
	local target = pickAimTarget(AIM)
	if not target or not target.Parent then return end

	local screenPos, onScreen = cam:WorldToViewportPoint(target.Position)
	if not onScreen then return end

	local viewport = cam.ViewportSize
	local pixels = (Vector2.new(screenPos.X, screenPos.Y)
		- Vector2.new(viewport.X / 2, viewport.Y / 2)).Magnitude
	if pixels > AIM.triggerPx then return end

	AIM.fireAt = os.clock() + (1 / math.clamp(AIM.fireRate or 6, 1, 20))

	-- Activate is what a real click does to a tool; the virtual click is the
	-- fallback for games that read raw input instead
	local tool = ch:FindFirstChildOfClass("Tool")
	if tool then
		pcall(function() tool:Activate() end)
	end
	if VirtualUser then
		pcall(function()
			VirtualUser:Button1Down(Vector2.new(0, 0), cam.CFrame)
			VirtualUser:Button1Up(Vector2.new(0, 0), cam.CFrame)
		end)
	end
	AIM.fired = (AIM.fired or 0) + 1
end

-- ==========================================
-- SILENT AIM
-- ==========================================
-- Installed once, on first enable, and left in place: a metamethod hook is not
-- something to be putting on and taking off repeatedly. Every path checks
-- SILENT.enabled first, so with the feature off the hook is a single boolean
-- test and the original is called straight through.
local function installSilentAim()
	if SILENT.hooked then return true end

	local ok = pcall(function()
		if type(hookmetamethod) ~= "function"
			or type(getnamecallmethod) ~= "function"
			or type(checkcaller) ~= "function" then
			error("executor has no metamethod hooks")
		end

		-- Raycast path. Most modern gun scripts cast a ray from the muzzle or
		-- camera toward the mouse; rewriting the DIRECTION and re-running the
		-- game's own call returns a genuine RaycastResult -- one cannot be
		-- constructed by hand, so redirecting the question is the only way to
		-- change the answer.
		local oldNamecall
		oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
			-- The method name is fetched once, for whichever feature wants it.
			-- Both the spy and silent aim sit on this hook, and calling
			-- getnamecallmethod twice per call for no reason is waste on a path
			-- that runs for every method call the game makes.
			if (RSPY.on or SILENT.enabled) and not checkcaller() then
				local method = getnamecallmethod()

				-- Remote spy. Recorded, never blocked: the call still goes
				-- through untouched, so nothing the game does changes while
				-- this is on. What it buys is knowing which remote does what,
				-- which is otherwise guesswork.
				if RSPY.on and (method == "FireServer" or method == "InvokeServer") then
					-- Packed before the pcall, not inside it: "..." cannot be
					-- referenced from a nested closure at all -- that is a
					-- compile error, and it would take the whole script down
					-- rather than failing quietly at runtime.
					local packed = table.pack(...)
					pcall(RSPY.record, self, method, packed)

					-- A RemoteFunction answers, and the answer is the useful
					-- half: it is what the server decided to hand back. Passed
					-- through untouched -- every return value is captured and
					-- then returned to the caller exactly as it arrived, so the
					-- game cannot tell the difference.
					if method == "InvokeServer" then
						local res = table.pack(oldNamecall(self, ...))
						if RSPY.last then RSPY.last.ret = res end
						return table.unpack(res, 1, res.n)
					end
				end

				local target = SILENT.target
				if SILENT.enabled and target and target.Parent
					and method == "Raycast" and self == Workspace then
					-- select("#") rather than #args: a nil RaycastParams in the
					-- middle would shorten the table and silently drop the
					-- game's own filter, which changes what its ray can hit
					local count = select("#", ...)
					local args = table.pack(...)
					local origin, dir = args[1], args[2]
					if typeof(origin) == "Vector3" and typeof(dir) == "Vector3" then
						-- The game's own range is preserved: lengthening the ray
						-- is exactly the kind of impossible shot a server-side
						-- distance check rejects outright.
						local aimed = (target.Position - origin)
						if aimed.Magnitude > 0.01 then
							args[2] = aimed.Unit * dir.Magnitude
							SILENT.hits = SILENT.hits + 1
							return oldNamecall(self, table.unpack(args, 1, count))
						end
					end
				end
			end
			return oldNamecall(self, ...)
		end)

		-- Mouse path. Older weapon scripts read mouse.Hit / mouse.Target rather
		-- than casting for themselves, so both are answered with the target.
		--
		-- __index fires for every property read in the game, which is why the
		-- enabled flag is tested before anything else here: with the feature
		-- off this adds one boolean check per index and nothing more.
		local oldIndex
		oldIndex = hookmetamethod(game, "__index", function(self, key)
			if SILENT.enabled and not checkcaller() then
				local target = SILENT.target
				if target and target.Parent and (key == "Hit" or key == "Target") then
					-- self:IsA("Mouse") would recurse: fetching the IsA method
					-- is itself an index, so the hook re-enters itself once per
					-- property read in the entire game and blows the stack.
					-- ClassName is read through the ORIGINAL __index, which does
					-- not come back through here.
					local isMouse = false
					if typeof(self) == "Instance" then
						if rawequal(self, mouse) then
							isMouse = true
						else
							-- Tools hand out their own Mouse object, so identity
							-- alone is not enough
							local ok2, class = pcall(oldIndex, self, "ClassName")
							isMouse = ok2 and class == "Mouse"
						end
					end
					if isMouse then
						if key == "Hit" then return CFrame.new(target.Position) end
						return target
					end
				end
			end
			return oldIndex(self, key)
		end)
	end)

	SILENT.hooked = ok
	return ok
end

-- Target refresh. Deliberately not run inside the hook: the hook fires on every
-- shot (and, for __index, constantly), and picking a target walks the player
-- list and raycasts. Chosen on a timer instead and simply read when a shot
-- happens, so the cost never lands in the middle of the game's own code.
local function stepSilent()
	if not SILENT.enabled then
		SILENT.target = nil
		return
	end
	SILENT.target = pickAimTarget(SILENT)
end

local function toggleFreeCam()
	local currentCamera = Workspace.CurrentCamera
	-- CurrentCamera is briefly nil around respawns; writing to it would throw
	-- and leave ON.freeCamEnabled flipped with the camera untouched
	if not currentCamera then
		FN.updateUI()
		return
	end

	ON.freeCamEnabled = not ON.freeCamEnabled
	if ON.freeCamEnabled then
		CAM.originalCameraType = currentCamera.CameraType
		currentCamera.CameraType = Enum.CameraType.Scriptable
		CAM.freeCamPos = currentCamera.CFrame.Position
		local rx, ry, rz = currentCamera.CFrame:ToOrientation()
		CAM.freeCamRotX, CAM.freeCamRotY = rx, ry
	else
		currentCamera.CameraType = CAM.originalCameraType
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
	FN.updateUI()
end

local function performDowngrade(targetVersionName, behaviorModifierFunc)
	if ON.freeCamEnabled then toggleFreeCam() end
	MISC.activeVersion = targetVersionName
	DEC.title.Text = "Mod Menu Pro+ (" .. MISC.activeVersion .. ") #" .. MISC.uiTag
	FN.toast("Downgraded to " .. MISC.activeVersion)
	if behaviorModifierFunc then
		pcall(behaviorModifierFunc)
	end
	FN.updateUI()
end

-- Universal Target Solver
-- Bounded breadth-first search over Workspace.
--
-- Workspace:GetDescendants() builds a table of EVERY instance in the game
-- before the loop even starts, so a cap inside the loop cannot save you -- the
-- allocation is the problem. On a voxel map, where each block is an instance,
-- that is enough to close the client outright with no Lua error. This walks
-- level by level with a hard budget and stops early once it has enough.
local function searchWorkspace(test, budget, wantAll)
	local found = {}
	local queue = Workspace:GetChildren()
	local head, seen = 1, 0

	-- The queue needs its own cap, and not having one is what still crashed the
	-- client on a voxel map. budget only limits how many nodes are VISITED --
	-- every visited node appends all of its children, so with 60000 visits the
	-- queue can hold several hundred thousand entries. That table is the
	-- allocation this whole function exists to avoid, one level further down.
	--
	-- Capped at twice the budget: enough slack that a normal map is walked in
	-- full, low enough that a pathological one stops growing instead of eating
	-- the process.
	local maxQueue = math.min(budget * 2, 50000)

	while head <= #queue and seen < budget do
		local node = queue[head]
		head = head + 1
		seen = seen + 1

		local ok = pcall(function()
			if test(node) then
				table.insert(found, node)
			end
		end)
		if ok and #found > 0 and not wantAll then return found end

		-- Children are appended rather than recursed into, so deep trees cannot
		-- blow the Lua stack the way a recursive walk would
		if seen < budget and #queue < maxQueue then
			for _, child in ipairs(node:GetChildren()) do
				queue[#queue + 1] = child
				if #queue >= maxQueue then break end
			end
		end
	end

	return found
end

-- Anti-crash. Purely defensive and purely local: mass-spawned visual effects
-- are a common way to tank or kill a client, so past a threshold the surplus
-- ones are switched off for you. Nothing is destroyed -- each original is
-- recorded and restored when the feature is turned off, so a game that relies
-- on its own effects gets them back intact.
ST.EFFECT_CLASSES = {
	ParticleEmitter = true, Trail = true, Fire = true,
	Smoke = true, Sparkles = true, Beam = true,
}

local function restoreEffects()
	for inst, wasEnabled in pairs(ST.crashMuted) do
		pcall(function()
			if inst.Parent then inst.Enabled = wasEnabled end
		end)
	end
	table.clear(ST.crashMuted)
end

local function scanEffects()
	local found = searchWorkspace(function(n)
		return ST.EFFECT_CLASSES[n.ClassName] == true
	end, 40000, true)

	local limit = MISC.crashLimit or 60
	ST.crashCount = #found

	-- Under the limit, undo any muting from an earlier spike
	if #found <= limit then
		if next(ST.crashMuted) then restoreEffects() end
		return
	end

	-- Over it: mute everything past the limit, remembering each original
	for i = limit + 1, #found do
		local inst = found[i]
		if ST.crashMuted[inst] == nil then
			pcall(function()
				ST.crashMuted[inst] = inst.Enabled
				inst.Enabled = false
			end)
		end
	end
end

-- Anti-lag: signs. A build with hundreds of text signs costs real frames --
-- every one is a SurfaceGui the engine lays out and draws whether or not you
-- can read it from where you are standing.
--
-- Nearest ones are kept, the rest are switched off, and every original is
-- recorded so turning this off puts the build back exactly. Nothing is
-- destroyed: someone else's sign is not ours to delete, and a game that reads
-- its own signs would break if they vanished.
local function restoreSigns()
	for gui, wasEnabled in pairs(ST.signMuted) do
		pcall(function()
			if gui.Parent then gui.Enabled = wasEnabled end
		end)
	end
	table.clear(ST.signMuted)
end

local function scanSigns()
	local ch = player.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local myPos = root.Position

	-- Both classes count: a sign is a SurfaceGui on a board or a BillboardGui
	-- floating above one, and a build usually mixes them
	-- Budget cut hard, and distance filtered during the walk rather than after:
	-- ranking every sign on the map only to hide all but thirty is work done to
	-- be thrown away, and this runs every few seconds forever.
	local found = searchWorkspace(function(n)
		if not (n:IsA("SurfaceGui") or n:IsA("BillboardGui")) then return false end
		local anchor = n.Adornee or n.Parent
		if anchor and anchor:IsA("BasePart") then
			return (anchor.Position - myPos).Magnitude < 1500
		end
		return true
	end, 8000, true)

	MISC.signCount = #found
	local limit = math.max(1, MISC.signLimit or 30)

	if #found <= limit then
		-- Under the limit there is nothing to gain, and anything muted earlier
		-- should come back rather than staying off because you walked away once
		if next(ST.signMuted) then restoreSigns() end
		return
	end

	-- Distance is measured to whatever the gui is attached to. Adornee first,
	-- then the parent part: a BillboardGui with no adornee still hangs off its
	-- parent, and one with neither cannot be placed at all.
	local ranked = {}
	for _, gui in ipairs(found) do
		local anchor
		pcall(function()
			anchor = gui.Adornee or gui.Parent
		end)
		local pos
		if anchor and anchor:IsA("BasePart") then
			pos = anchor.Position
		end
		ranked[#ranked + 1] = {
			gui = gui,
			-- No position means it cannot be judged on distance, so it sorts
			-- last and gets muted first
			dist = pos and (pos - myPos).Magnitude or math.huge,
		}
	end

	table.sort(ranked, function(a, b) return a.dist < b.dist end)

	for i, entry in ipairs(ranked) do
		local gui = entry.gui
		if i <= limit then
			-- Inside the keep window: if we muted it earlier, give it back
			if ST.signMuted[gui] ~= nil then
				pcall(function()
					if gui.Parent then gui.Enabled = ST.signMuted[gui] end
				end)
				ST.signMuted[gui] = nil
			end
		elseif ST.signMuted[gui] == nil then
			pcall(function()
				ST.signMuted[gui] = gui.Enabled
				gui.Enabled = false
			end)
		end
	end
end

local function resolveTargetPart()
	local mainQuery = BOX.tpBox.Text:lower():gsub("%s+", "")
	local subQuery = BOX.targetPartBox.Text:lower():gsub("%s+", "")

	if mainQuery == "" then return nil end

	local targetPlayer = nil
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local pName = p.Name:lower()
			local pDisp = p.DisplayName:lower()
			local pId = tostring(p.UserId)
			if pName:sub(1, #mainQuery) == mainQuery or pDisp:sub(1, #mainQuery) == mainQuery or pId == mainQuery then
				targetPlayer = p
				break
			end
		end
	end

	if targetPlayer and targetPlayer.Character then
		local char = targetPlayer.Character
		if subQuery ~= "" then
			for _, desc in ipairs(char:GetDescendants()) do
				if desc:IsA("BasePart") and (desc.Name:lower() == subQuery or desc.Name:lower():find(subQuery, 1, true)) then
					return desc
				end
			end
		end
		return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildOfClass("BasePart")
	end

	for _, obj in ipairs(searchWorkspace(function() return true end, 60000, true)) do
		local objName = obj.Name:lower()
		local isMatch = (objName == mainQuery or objName:find(mainQuery, 1, true))

		if not isMatch then
			for _, p in ipairs(Players:GetPlayers()) do
				if objName == tostring(p.UserId) and (mainQuery == tostring(p.UserId) or mainQuery == "") then
					isMatch = true
					break
				end
			end
		end

		if isMatch then
			if obj:IsA("BasePart") then
				if subQuery == "" or obj.Name:lower():find(subQuery, 1, true) then
					return obj
				end
			elseif obj:IsA("Model") or obj:IsA("Folder") then
				if subQuery ~= "" then
					-- Bounded walk, not GetDescendants(): the matched object can
					-- be a Model holding the entire map, and materialising every
					-- instance under it is the allocation that closes the client
					-- with no error. Level by level, with a hard budget.
					local queue, head, seen = obj:GetChildren(), 1, 0
					while head <= #queue and seen < 8000 do
						local desc = queue[head]
						head = head + 1
						seen = seen + 1
						if desc:IsA("BasePart")
							and desc.Name:lower():find(subQuery, 1, true) then
							return desc
						end
						for _, child in ipairs(desc:GetChildren()) do
							queue[#queue + 1] = child
						end
					end
				end
				local foundPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj:FindFirstChildOfClass("BasePart")
				if foundPart then return foundPart end
			end
		end
	end

	return nil
end

local function cycleTargetParts()
	local mainQuery = BOX.tpBox.Text:lower():gsub("%s+", "")
	if mainQuery == "" then return end

	local partsList = {}

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and (p.Name:lower():find(mainQuery, 1, true) or p.DisplayName:lower():find(mainQuery, 1, true) or tostring(p.UserId) == mainQuery) then
			if p.Character then
				for _, desc in ipairs(p.Character:GetDescendants()) do
					if desc:IsA("BasePart") then table.insert(partsList, desc.Name) end
				end
			end
		end
	end

	if #partsList == 0 then
		for _, desc in ipairs(searchWorkspace(function(n) return n:IsA("BasePart") end, 60000, true)) do
			if desc:IsA("BasePart") then
				local partName = desc.Name:lower()
				local isIdMatch = false
				for _, p in ipairs(Players:GetPlayers()) do
					if partName == tostring(p.UserId) and tostring(p.UserId) == mainQuery then
						isIdMatch = true
						break
					end
				end
				if isIdMatch or partName:find(mainQuery, 1, true) then
					table.insert(partsList, desc.Name)
				end
			end
		end
	end

	if #partsList > 0 then
		local currentName = BOX.targetPartBox.Text:lower()
		local currentIndex = 0
		for idx, name in ipairs(partsList) do
			if name:lower() == currentName then
				currentIndex = idx
				break
			end
		end

		local nextIndex = (currentIndex % #partsList) + 1
		BOX.targetPartBox.Text = partsList[nextIndex]

		if ON.weldEnabled then
			pcall(function() FN.enableWeld() end)
		end
	end
end

-- Flashes a message on the weld button, then lets updateUI take the text back
local function weldStatus(msg)
	UI.weldToggleBtn.Text = msg
	task.delay(2, function()
		if UI.weldToggleBtn.Parent then FN.updateUI() end
	end)
end

function FN.disableWeld()
	ON.weldEnabled = false

	if CONN.weldTargetDeathConn then
		CONN.weldTargetDeathConn:Disconnect()
		CONN.weldTargetDeathConn = nil
	end
	if CONN.weldTargetHumConn then
		CONN.weldTargetHumConn:Disconnect()
		CONN.weldTargetHumConn = nil
	end
	ST.weldTarget = nil
	ST.weldOffset = nil
	ST.weldHome = nil

	if ST.weldConstraint then
		pcall(function() ST.weldConstraint:Destroy() end)
		ST.weldConstraint = nil
	end

	local character = player.Character
	if character then
		local myRoot = character:FindFirstChild("HumanoidRootPart")
		if myRoot then
			-- Hand the root back to Freeze if it owns it, rather than blindly
			-- unanchoring and leaving the toggle claiming a state that isn't real
			myRoot.Anchored = MISC.frozen
		end

		-- Stale welds can end up anywhere in the rig, not just under the root
		for _, v in ipairs(character:GetDescendants()) do
			if (v:IsA("WeldConstraint") or v:IsA("Weld")) and v.Name == "WholeCharWeld" .. uiName then
				pcall(function() v:Destroy() end)
			end
		end

		-- The humanoid's state machine drags the root off the weld, so it gets
		-- parked while welded and handed back exactly as it was here
		local hum = character:FindFirstChildOfClass("Humanoid")
		if hum and ST.weldPrevPlatformStand ~= nil then
			pcall(function() hum.PlatformStand = ST.weldPrevPlatformStand end)
		end
	end
	ST.weldPrevPlatformStand = nil

	FN.updateUI()
end

function FN.enableWeld()
	local character = player.Character
	if not character then
		weldStatus("Weld: no character")
		return
	end

	local myRoot = character:FindFirstChild("HumanoidRootPart")
	if not myRoot then
		weldStatus("Weld: no root part")
		return
	end

	if BOX.tpBox.Text:gsub("%s+", "") == "" then
		weldStatus("Weld: enter a target first")
		return
	end

	local targetPart = resolveTargetPart()
	if not targetPart then
		weldStatus("Weld: target not found")
		return
	end

	if targetPart:IsDescendantOf(character) then
		weldStatus("Weld: can't weld to self")
		return
	end

	FN.disableWeld()

	-- PlatformStand is for the joint: it stops the humanoid fighting a body
	-- it no longer controls. CFRAME mode never gives up control, so leaving it
	-- off keeps you standing and steerable instead of hanging limp.
	local hum = character:FindFirstChildOfClass("Humanoid")
	if hum and MISC.weldMode ~= "CFRAME" then
		ST.weldPrevPlatformStand = hum.PlatformStand
		hum.PlatformStand = true
	end

	-- Move the whole rig, not just the root, and kill momentum so physics
	-- doesn't rip the character back off the instant the joint forms
	-- Where to put you back when this lets go. Captured before the move, or
	-- it would record the spot next to the target instead of the one you were
	-- standing in safely.
	ST.weldHome = myRoot.CFrame

	markIntentionalTeleport()
	-- Above them by default. Behind them when the kill combo asks for it:
	-- +Z is backwards in Roblox (LookVector is -Z), so this lands on their back
	-- rather than in their face, where they can see what is hitting them.
	local dest = targetPart.CFrame + Vector3.new(0, 3, 0)
	if MISC.weldBack then
		dest = targetPart.CFrame * CFrame.new(0, 0.5, 2.5)
	end
	character:PivotTo(dest)
	myRoot.AssemblyLinearVelocity = Vector3.zero
	myRoot.AssemblyAngularVelocity = Vector3.zero

	-- CFRAME mode stops here: record the offset and let the stepper hold it.
	-- Nothing is attached, so nothing takes your assembly away from you.
	if MISC.weldMode == "CFRAME" then
		ST.weldOffset = targetPart.CFrame:ToObjectSpace(myRoot.CFrame)
		ON.weldEnabled = true
		ST.weldTarget = targetPart

		CONN.weldTargetDeathConn = targetPart.Destroying:Once(function()
			if ON.weldEnabled then FN.disableWeld() end
		end)
		local cfModel = targetPart:FindFirstAncestorOfClass("Model")
		local cfHum = cfModel and cfModel:FindFirstChildOfClass("Humanoid")
		if cfHum then
			CONN.weldTargetHumConn = cfHum.Died:Once(function()
				if ON.weldEnabled then
					FN.disableWeld()
					FN.toast("Weld dropped: target died")
				end
			end)
		end

		FN.updateUI()
		return
	end

	local ok = pcall(function()
		local wc = Instance.new("WeldConstraint")
		wc.Name = "WholeCharWeld" .. uiName
		wc.Part0 = myRoot
		wc.Part1 = targetPart
		wc.Enabled = true
		wc.Parent = myRoot
		ST.weldConstraint = wc
	end)

	if not ok or not ST.weldConstraint then
		if hum and ST.weldPrevPlatformStand ~= nil then
			pcall(function() hum.PlatformStand = ST.weldPrevPlatformStand end)
		end
		ST.weldPrevPlatformStand = nil
		weldStatus("Weld: failed to attach")
		return
	end

	ON.weldEnabled = true
	ST.weldTarget = targetPart

	-- If the thing we welded to disappears, drop the weld instead of leaving it stuck ON
	CONN.weldTargetDeathConn = targetPart.Destroying:Once(function()
		if ON.weldEnabled then FN.disableWeld() end
	end)

	-- Destroying alone is not enough for a player target. Roblox leaves the
	-- corpse in Workspace for several seconds after death, so the part still
	-- exists and you stay welded to a ragdolling body. Their Humanoid dying is
	-- the moment that actually matters.
	local targetModel = targetPart:FindFirstAncestorOfClass("Model")
	local targetHum = targetModel and targetModel:FindFirstChildOfClass("Humanoid")
	if targetHum then
		CONN.weldTargetHumConn = targetHum.Died:Once(function()
			if ON.weldEnabled then
				FN.disableWeld()
				FN.toast("Weld dropped: target died")
			end
		end)
	end

	FN.updateUI()
end

local function toggleWeld()
	if ON.weldEnabled then
		FN.disableWeld()
	else
		FN.enableWeld()
	end
end

-- Spectate. CameraSubject only works while the camera is Custom, so free cam
-- (which forces Scriptable) has to be switched off first or nothing happens.
local function stopSpectate()
	ST.spectating = nil
	local cam = Workspace.CurrentCamera
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if cam and hum then
		pcall(function()
			cam.CameraSubject = hum
			cam.CameraType = Enum.CameraType.Custom
		end)
	end
end

local function spectateTarget()
	local query = BOX.tpBox.Text:lower():gsub("%s+", "")
	if query == "" then
		FN.toast("Spectate: enter or click a player first")
		return
	end

	local found
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			if p.Name:lower():sub(1, #query) == query
				or p.DisplayName:lower():sub(1, #query) == query
				or tostring(p.UserId) == query then
				found = p
				break
			end
		end
	end

	if not found then
		FN.toast("Spectate: player not found")
		return
	end

	local hum = found.Character and found.Character:FindFirstChildOfClass("Humanoid")
	if not hum then
		FN.toast("Spectate: they have no character loaded")
		return
	end

	if ON.freeCamEnabled then toggleFreeCam() end

	local cam = Workspace.CurrentCamera
	if cam then
		pcall(function()
			cam.CameraType = Enum.CameraType.Custom
			cam.CameraSubject = hum
		end)
		ST.spectating = found
		FN.toast("Spectating " .. found.Name)
	end
end

local function safeTeleport(targetPos)
	local character = player.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		-- Remember where we were before every jump, so Go Back can undo it.
		-- Capped so a long session can't grow the table without bound.
		CAM.tpHistory = CAM.tpHistory or {}
		table.insert(CAM.tpHistory, character.HumanoidRootPart.CFrame)
		if #CAM.tpHistory > 20 then table.remove(CAM.tpHistory, 1) end

		markIntentionalTeleport()
		local targetCFrame = CFrame.new(targetPos)
		if ST.flying and ST.flyPart then ST.flyPart.CFrame = targetCFrame end
		character:PivotTo(targetCFrame)
		character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
	end
end

-- MaceKill. A slam: teleport high above the nearest enemy, cut your gravity so
-- you hang there, then drop straight onto them swinging. Named for the mace
-- move it imitates -- rise, hover, come down on someone's head.
--
-- One press does the whole sequence. Written as a spawned routine with a cancel
-- flag so a second press stops it mid-air rather than at the end of a wait.
local function maceKill()
	if ST.maceOn then
		ST.maceOn = false
		FN.toast("MaceKill: cancelled")
		return
	end

	local ch = player.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not root or not hum then FN.toast("MaceKill: no character") return end

	-- Target: the nearest enemy, using the same picker and side rules the aim
	-- uses, so "enemy" means the same thing everywhere.
	local target = pickAimTarget(AIM)
	local tpart = target
	if not tpart then
		-- pickAimTarget needs them on screen; fall back to nearest by world
		-- distance so a mace from behind still finds someone
		local best, bd
		for _, e in ipairs(ST.charList()) do
			local o, m, h = e.plr, e.model, e.hum
			local troot = m and m:FindFirstChild("HumanoidRootPart")
			local mine = ST.sideOf(ch, player)
			local theirs = ST.sideOf(m, o)
			local sameTeam = mine and theirs and mine == theirs
			local wrong = (AIM.teamMode == "ENEMIES" and sameTeam)
				or (AIM.teamMode == "TEAM" and not sameTeam)
			if troot and h and h.Health > 0 and not wrong then
				local d = (troot.Position - root.Position).Magnitude
				if not bd or d < bd then best, bd, tpart = m, d, troot end
			end
		end
	end

	if not tpart or not tpart.Parent then FN.toast("MaceKill: no enemy") return end

	ST.maceOn = true
	local targetModel = tpart:FindFirstAncestorOfClass("Model") or tpart.Parent

	task.spawn(function()
		local home = root.CFrame

		-- 1. Rise. Straight up over the target, high enough to build the drop.
		local up = tpart.Position + Vector3.new(0, MISC.maceHeight or 80, 0)
		safeTeleport(up)
		task.wait(0.15)

		-- 2. Hover. Zero gravity on your assembly holds you at the top while
		-- you line up, instead of falling before the swing is ready.
		local hoverStart = os.clock()
		while ST.maceOn and os.clock() - hoverStart < (MISC.maceHover or 0.6) do
			local r = ch:FindFirstChild("HumanoidRootPart")
			if r then r.AssemblyLinearVelocity = Vector3.zero end
			task.wait()
		end

		-- 3. Slam. Auto Swing is switched on for the fall so every frame the
		-- crosshair is on them lands a hit, and we drive straight down onto the
		-- target. Gravity stays cancelled so the descent is our speed, not the
		-- engine's slow one.
		ST.equipBest(ch, hum)
		local wasTrigger = AIM.trigger
		AIM.trigger = true

		local slamStart = os.clock()
		while ST.maceOn and os.clock() - slamStart < 2 do
			local r = ch:FindFirstChild("HumanoidRootPart")
			local troot = targetModel and targetModel:FindFirstChild("HumanoidRootPart")
			local thum = targetModel and targetModel:FindFirstChildOfClass("Humanoid")
			if not r or not troot or not thum or thum.Health <= 0 then break end

			-- Drive down onto them, a bit above so you land on the head rather
			-- than inside the floor
			local aim = troot.Position + Vector3.new(0, 3, 0)
			local dir = (aim - r.Position)
			r.AssemblyLinearVelocity = dir.Unit * math.max(dir.Magnitude, 80)

			-- Point the camera at them so the triggerbot fires
			local cam = Workspace.CurrentCamera
			if cam then
				pcall(function()
					cam.CFrame = CFrame.lookAt(cam.CFrame.Position, troot.Position)
				end)
			end

			-- Arrived: on top of them
			if (r.Position - aim).Magnitude < 5 then break end
			task.wait()
		end

		AIM.trigger = wasTrigger
		ST.maceOn = false
		FN.updateUI()
	end)
end


-- Escape teleport: the survivor standing furthest from every infected player.
-- Better than "run away from the nearest one", which walks you into a second.
-- Actually running there, rather than teleporting. PathfindingService walks the
-- navmesh so this goes around walls instead of into them, and it is your own
-- humanoid doing the moving -- ordinary WalkSpeed, ordinary animation, nothing
-- that looks like a teleport to anyone watching.
--
-- Cancellation is a token rather than a flag: a second escape started while the
-- first is still running has to stop the old one, and a plain boolean cannot
-- tell "stop everything" apart from "stop the previous one".
local function katStopRun()
	KAT.runToken = (KAT.runToken or 0) + 1
	KAT.running = false
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	-- MoveTo at your own feet cancels the walk without freezing you in place
	if hum and ch:FindFirstChild("HumanoidRootPart") then
		pcall(function() hum:MoveTo(ch.HumanoidRootPart.Position) end)
	end
end

-- What is actually in the way, and can it be opened? Three kinds of blocker
-- turn up in a Backrooms map and they need different answers:
--
--   1. A door with a ProximityPrompt or ClickDetector -- fire it, which is
--      what pressing E would have done anyway.
--   2. A door with neither, opened by the game some other way -- drop its
--      collision locally for a moment and walk through. Character physics is
--      simulated on the owning client, so this works without the server
--      needing to agree, and the original CanCollide is put straight back.
--   3. An actual wall -- nothing to do, report it and let the caller escalate.
--
-- Returns true only when something was genuinely tried, so the caller can tell
-- "opened a door, try again" from "that is masonry, give up".
local function katOpenDoor(root, towardPos)
	if not KAT.autoDoor or not root then return false end

	local dir = (towardPos - root.Position)
	dir = Vector3.new(dir.X, 0, dir.Z)
	if dir.Magnitude < 0.1 then return false end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	params.IgnoreWater = true

	-- Chest height rather than the root's centre: a low crate is a jump, and
	-- this is looking for something door-shaped
	local hit
	pcall(function()
		hit = Workspace:Raycast(root.Position + Vector3.new(0, 1, 0), dir.Unit * 9, params)
	end)
	if not hit or not hit.Instance then return false end

	local part = hit.Instance
	local model = part:FindFirstAncestorOfClass("Model")

	-- Prompts and detectors sit on the part or beside it in its model. This
	-- used to walk the ancestor Model's descendants, which on a map where the
	-- whole floor is one Model is a table of the entire level -- the same
	-- allocation that closes the client everywhere else in this file.
	--
	-- Two shallow passes instead: the part's own children, then its immediate
	-- siblings. A door's prompt is never further away than that.
	local prompt, detector
	local function look(holder, depth)
		if not holder or prompt or detector then return end
		for _, d in ipairs(holder:GetChildren()) do
			if d:IsA("ProximityPrompt") then prompt = prompt or d end
			if d:IsA("ClickDetector") then detector = detector or d end
			-- One level down covers a prompt parented to the handle rather
			-- than the door panel itself
			if depth > 0 and d:IsA("BasePart") then look(d, depth - 1) end
			if prompt or detector then return end
		end
	end

	look(part, 1)
	if not prompt and not detector and model then look(model, 1) end

	if prompt then
		local fired = false
		pcall(function()
			if type(fireproximityprompt) == "function" then
				fireproximityprompt(prompt)
				fired = true
			end
		end)
		if not fired then
			-- No executor helper: zero the hold and drive the prompt directly
			pcall(function()
				-- Recorded before zeroing, into the same table Instant Prompts
				-- restores from. Without this the hold time was changed for the
				-- rest of the session -- a deliberately slow prompt elsewhere in
				-- the map would silently become instant.
				if ST.promptHolds[prompt] == nil then
					ST.promptHolds[prompt] = prompt.HoldDuration
				end
				prompt.HoldDuration = 0
				prompt:InputHoldBegin()
				task.wait(0.1)
				prompt:InputHoldEnd()
				fired = true
			end)
		end
		if fired then
			FN.toast("Opened " .. (model and model.Name or part.Name))
			return true
		end
	end

	if detector then
		local fired = false
		pcall(function()
			if type(fireclickdetector) == "function" then
				fireclickdetector(detector)
				fired = true
			end
		end)
		if fired then
			FN.toast("Clicked " .. (model and model.Name or part.Name))
			return true
		end
	end

	-- No prompt, no detector: is it door-shaped by name? Only then is the
	-- collision dropped -- doing it to anything in the way would be noclip
	-- with extra steps, and noclip is already its own feature.
	local name = ((model and model.Name or "") .. " " .. part.Name):lower()
	local doorish = name:find("door", 1, true) or name:find("gate", 1, true)
		or name:find("hatch", 1, true) or name:find("exit", 1, true)

	if doorish and part.CanCollide then
		if ST.doorOpened[part] == nil then
			ST.doorOpened[part] = part.CanCollide
			pcall(function() part.CanCollide = false end)
			-- Put back on a timer, so a door left open behind you does not
			-- change the map for the rest of the round
			task.delay(3, function()
				pcall(function()
					if part.Parent and ST.doorOpened[part] ~= nil then
						part.CanCollide = ST.doorOpened[part]
					end
				end)
				ST.doorOpened[part] = nil
			end)
			FN.toast("Phased " .. (model and model.Name or part.Name))
			return true
		end
	end

	return false
end

function FN.katRunPath(targetPart)
	katStopRun()
	local token = KAT.runToken
	KAT.running = true

	task.spawn(function()
		-- Counted across the whole run, not per waypoint: one wall you get
		-- around is nothing, three in a row means the route is not workable
		local stuckRuns = 0

		while KAT.running and KAT.runToken == token do
			local ch = player.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			local root = ch and ch:FindFirstChild("HumanoidRootPart")
			if not hum or not root or hum.Health <= 0 then break end
			if not targetPart or not targetPart.Parent then break end

			local goal = targetPart.Position
			local path = SERV.PathfindingService:CreatePath({
				AgentRadius = 2,
				AgentHeight = 5,
				AgentCanJump = true,
				AgentMaxSlope = 45,
			})

			local ok = pcall(function() path:ComputeAsync(root.Position, goal) end)
			local waypoints = (ok and path.Status == Enum.PathStatus.Success)
				and path:GetWaypoints() or nil

			local madeProgress = false

			if not waypoints or #waypoints < 2 then
				-- No navmesh route at all. A Backrooms map is mostly interior
				-- walls, so this is common rather than exceptional: head at the
				-- target directly and let the stuck handling below deal with
				-- whatever is in the way.
				local before = root.Position
				pcall(function() hum:MoveTo(goal) end)
				task.wait(0.6)
				local after = ch:FindFirstChild("HumanoidRootPart")
				madeProgress = after ~= nil
					and (after.Position - before).Magnitude > 2
			else
				for i = 2, #waypoints do
					if not KAT.running or KAT.runToken ~= token then return end
					local wp = waypoints[i]
					if wp.Action == Enum.PathWaypointAction.Jump then
						hum.Jump = true
					end
					pcall(function() hum:MoveTo(wp.Position) end)

					-- Progress is measured, not assumed. Waiting on
					-- MoveToFinished hangs forever on a blocked waypoint, and
					-- a plain timeout cannot tell "slow" from "stuck".
					local waited, lastPos = 0, root.Position
					local nudged = false
					while waited < 2 do
						if not KAT.running or KAT.runToken ~= token then return end
						local now = ch:FindFirstChild("HumanoidRootPart")
						if not now then return end
						if (now.Position - wp.Position).Magnitude < 4 then
							madeProgress = true
							break
						end

						-- Half a second without covering 1 stud is a wall, not
						-- a slow walk. Jump first -- most Roblox obstacles are
						-- a step or a low ledge -- then try sliding sideways
						-- around it before giving up on this route.
						if waited > 0.5 and not nudged
							and (now.Position - lastPos).Magnitude < 1 then
							nudged = true
							hum.Jump = true
							-- A door reads as a wall to the pathfinder, so ask
							-- what is actually there before shoving sideways
							if katOpenDoor(now, wp.Position) then
								task.wait(0.3)
								pcall(function() hum:MoveTo(wp.Position) end)
							else
								local side = now.CFrame.RightVector * 8
								pcall(function() hum:MoveTo(now.Position + side) end)
								task.wait(0.35)
								pcall(function() hum:MoveTo(wp.Position) end)
							end
						end

						waited = waited + task.wait(0.05)
					end

					if targetPart.Parent
						and (targetPart.Position - goal).Magnitude > 15 then
						break
					end
				end
			end

			local nowRoot = ch:FindFirstChild("HumanoidRootPart")
			if nowRoot and targetPart.Parent
				and (nowRoot.Position - targetPart.Position).Magnitude < 8 then
				break
			end

			-- Nothing moved this whole lap: the way is blocked, and looping to
			-- recompute the same impossible route just walks into the same wall
			-- forever, which is exactly what it looked like before.
			if madeProgress then
				stuckRuns = 0
			else
				stuckRuns = stuckRuns + 1
				-- One last look for a door before deciding it is masonry
				if nowRoot and targetPart.Parent
					and katOpenDoor(nowRoot, targetPart.Position) then
					stuckRuns = math.max(0, stuckRuns - 1)
				elseif stuckRuns >= 3 then
					if KAT.unstick and nowRoot and targetPart.Parent then
						-- Hop the obstacle rather than abandoning the trip.
						-- Deliberately a short hop toward the target, not a
						-- teleport onto it: this is a door you cannot open,
						-- not a free ride across the map.
						local toward = (targetPart.Position - nowRoot.Position)
						local step = math.min(toward.Magnitude, 25)
						safeTeleport(nowRoot.Position + (toward.Unit * step) + Vector3.new(0, 3, 0))
						FN.toast("Blocked -- hopped " .. math.floor(step) .. " studs")
						stuckRuns = 0
					else
						FN.toast("Blocked -- no way through")
						break
					end
				end
			end
		end

		if KAT.runToken == token then KAT.running = false end
	end)
end

-- Every "go there" button routes through this, so Escape Mode means the same
-- thing everywhere and a new destination button cannot forget to honour it.
local function katGoTo(part)
	if not part or not part.Parent then
		FN.toast("Nowhere to go")
		return false
	end
	if KAT.escapeMode == "TP" then
		safeTeleport(part.Position + Vector3.new(0, 3, 0))
	else
		FN.katRunPath(part)
	end
	return true
end

-- Nearest or furthest of the hunting side. Furthest is the one you want when
-- picking a direction to break for; nearest is for going at them deliberately,
-- which is what you do once you are the one infected.
local function katGoInfected(wantFurthest)
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then
		FN.toast("No character")
		return
	end

	local best, bestDist
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and FN.katIsInfected(other) then
			local char = other.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if root and (not hum or hum.Health > 0) then
				local d = (root.Position - myRoot.Position).Magnitude
				local better = bestDist == nil
					or (wantFurthest and d > bestDist)
					or (not wantFurthest and d < bestDist)
				if better then best, bestDist = root, d end
			end
		end
	end

	if not best then
		FN.toast("No infected players found")
		return
	end
	if katGoTo(best) then
		FN.toast(string.format("%s %s -- %.0f studs",
			(KAT.escapeMode == "TP") and "TP to" or "Running to",
			best.Parent.Name, bestDist))
	end
end

local function katRunAway()
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then
		FN.toast("No character")
		return
	end

	local hunters = {}
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and FN.katIsInfected(other) then
			local char = other.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if root then hunters[#hunters + 1] = root.Position end
		end
	end

	local best, bestScore
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and not FN.katIsInfected(other) then
			local char = other.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if root and (not hum or hum.Health > 0) then
				-- Scored against the whole ROUTE, not just the destination.
				-- Endpoint-only scoring happily picks someone safe who is
				-- directly behind the hunter chasing you -- the spot is fine,
				-- the trip there runs you straight past them.
				--
				-- Distance from each hunter to the line segment you would
				-- travel: project them onto it, clamp to the ends, measure.
				local score = math.huge
				local seg = root.Position - myRoot.Position
				local segLen = seg.Magnitude
				for _, hp in ipairs(hunters) do
					local d
					if segLen < 0.1 then
						d = (hp - myRoot.Position).Magnitude
					else
						local t = math.clamp((hp - myRoot.Position):Dot(seg) / (segLen * segLen), 0, 1)
						d = (hp - (myRoot.Position + seg * t)).Magnitude
					end
					score = math.min(score, d)
				end
				if not bestScore or score > bestScore then
					best, bestScore = root, score
				end
			end
		end
	end

	if not best then
		FN.toast("Nobody safe to run to")
		return
	end

	if katGoTo(best) then
		FN.toast(string.format("%s %s -- %.0f studs clear",
			(KAT.escapeMode == "TP") and "TP'd to" or "Running to",
			best.Parent.Name, bestScore))
	end
end

-- Spawn finder. Matches on the SpawnLocation class first, since that is what
-- Roblox spawns actually are, and falls back to a name check for games that
-- build spawns out of ordinary parts.
local function clearSpawnMarks()
	for _, adorn in ipairs(ST.spawnMarks) do
		pcall(function() adorn:Destroy() end)
	end
	table.clear(ST.spawnMarks)
end

local function findSpawns()
	clearSpawnMarks()

	-- Three modes, because "spawn" in a part name means whatever the builder
	-- felt like. A SpawnLocation is the only thing the engine itself treats as
	-- a player spawn -- everything else called "spawn" is an ore node, a mob
	-- point, a chest respawn, and mixing those in is what buried the real ones.
	local found = searchWorkspace(function(n)
		local isPlayerSpawn = n:IsA("SpawnLocation")
		if MISC.spawnMode == "PLAYER" then
			return isPlayerSpawn
		end

		local namedSpawn = n:IsA("BasePart")
			and n.Name:lower():find("spawn", 1, true) ~= nil

		if MISC.spawnMode == "ITEMS" then
			-- Named like a spawn but not an actual player spawn
			return namedSpawn and not isPlayerSpawn
		end

		return isPlayerSpawn or namedSpawn
	end, 60000, true)

	ST.spawnCount = #found
	-- No cap here, unlike Object ESP. Spawns number in the dozens at most, and
	-- a partial list defeats the point of a locator.
	for _, part in ipairs(found) do
		pcall(function()
			local a = Instance.new("BoxHandleAdornment")
			a.Name = "SpawnMark" .. uiName
			a.Adornee = part
			a.AlwaysOnTop = true
			a.ZIndex = 5
			a.Size = part.Size + Vector3.new(0.4, 0.4, 0.4)
			a.Transparency = 0.5
			a.Color3 = Color3.fromRGB(90, 255, 140)
			a.Parent = part
			table.insert(ST.spawnMarks, a)
		end)
	end
	return found
end

local function tpToNearestSpawn()
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		FN.toast("No character")
		return
	end

	local spawns = findSpawns()
	local best, bestDist
	for _, part in ipairs(spawns) do
		local d = (part.Position - hrp.Position).Magnitude
		if not bestDist or d < bestDist then
			best, bestDist = part, d
		end
	end

	if not best then
		FN.toast("No spawns found")
		return
	end
	-- Above the pad rather than inside it, or you land clipped into the part
	safeTeleport(best.Position + Vector3.new(0, 4, 0))
	FN.toast(string.format("Spawn %.0f studs away", bestDist))
end

-- Building a waypoint row is shared, because they are created two ways now:
-- by pressing the button, and by loading the ones saved last session.
ST.addWaypoint = function(wpName, savedPos)
	local wpBtn = createButton("TP: " .. wpName)
	setButtonColor(wpBtn, Color3.fromRGB(34, 158, 128))

	wpBtn.MouseButton1Click:Connect(function()
		safeTeleport(savedPos)
	end)

	table.insert(CAM.waypointButtons, wpBtn)
	-- Kept as data as well as a button: a button cannot be written to a file
	table.insert(ST.waypoints, { name = wpName, pos = savedPos })
end

local function savePosition()
	local character = player.Character
	if not character then return end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	CAM.waypointCount = CAM.waypointCount + 1
	ST.addWaypoint("Waypoint " .. CAM.waypointCount, rootPart.Position)
end

local function clearWaypoints()
	for _, btn in ipairs(CAM.waypointButtons) do
		if btn then pcall(function() btn:Destroy() end) end
	end
	CAM.waypointButtons = {}
	CAM.waypointCount = 0
	table.clear(ST.waypoints)
end

--[[
	Damage log.

	"Can I die with TP Kill on" is not a question worth answering with an
	opinion when the client can just watch its own health and count.

	Every drop in health is recorded with a timestamp, how much, and a GUESS at
	who did it -- the nearest other character at that instant. It is a guess and
	it is labelled as one: the client is not told who dealt damage, only that
	health went down, so a trap, a damage zone and a sword all look identical
	from here. Nearest-body is right most of the time in a melee game and wrong
	every time the answer was the map.

	It also records whether TP Kill was running when the hit landed, which is
	the honest version of the "you cannot die" claim. Hits taken while orbiting
	are hits the teleporting did not prevent.
--]]
function FN.dmgNote(delta, hp, maxHp)
	local who, dist = "?", nil
	local me = player.Character
	local root = me and me:FindFirstChild("HumanoidRootPart")
	if root then
		for _, entry in ipairs(ST.charList()) do
			local ch = entry.model
			local hrp = ch and ch ~= me and ch:FindFirstChild("HumanoidRootPart")
			if hrp then
				local d = (hrp.Position - root.Position).Magnitude
				if not dist or d < dist then
					who, dist = ch.Name, d
				end
			end
		end
	end
	-- Nobody within reach of a melee weapon means the nearest body is not a
	-- plausible source, and naming them anyway is worse than admitting it
	if not dist or dist > 60 then
		who, dist = "(nothing near -- map, fall or server)", nil
	end

	local hit = {
		at = os.clock(),
		amount = delta,
		left = hp,
		max = maxHp,
		who = who,
		dist = dist,
		tpKill = MISC.tpKill and true or false,
		fleeing = ST.tpKillFleeing and true or false,
	}
	local hits = ST.dmgHits
	hits[#hits + 1] = hit
	-- Fifty is a couple of minutes of a busy fight and bounded is the point
	while #hits > 50 do table.remove(hits, 1) end

	ST.dmgBy[who] = (ST.dmgBy[who] or 0) + delta

	if MISC.dmgToast and maxHp > 0 and (delta / maxHp * 100) >= MISC.dmgToastAt then
		FN.toast("-" .. math.floor(delta + 0.5) .. " from " .. who)
	end
end

function FN.dmgReset()
	ST.dmgHits = {}
	ST.dmgBy = {}
	ST.dmgLast = nil
end

function FN.dmgReport()
	local hits = ST.dmgHits
	local lines = { "[ModMenu] damage this life --" }

	if #hits == 0 then
		lines[#lines + 1] = "  nothing has hit you yet"
	end

	local now = os.clock()
	local from = math.max(1, #hits - 19)
	for i = from, #hits do
		local h = hits[i]
		local tag = ""
		if h.fleeing then
			tag = "  [was backing off]"
		elseif h.tpKill then
			tag = "  [TP Kill was orbiting]"
		end
		lines[#lines + 1] = string.format(
			"  %5.1fs ago  -%-6.1f  left %-6.1f  %s%s%s",
			now - h.at, h.amount, h.left, h.who,
			h.dist and string.format("  (%.0f studs)", h.dist) or "", tag)
	end

	-- Sorted, because the useful question is who is doing the most, and a
	-- pairs() dump answers it in whatever order the hash felt like
	local order = {}
	for name, total in pairs(ST.dmgBy) do
		order[#order + 1] = { name = name, total = total }
	end
	table.sort(order, function(a, b) return a.total > b.total end)
	if #order > 0 then
		lines[#lines + 1] = "  --- totals ---"
		for _, e in ipairs(order) do
			lines[#lines + 1] = string.format("  %-28s %.0f", e.name, e.total)
		end
	end

	-- The honest answer to "can I die with TP Kill on"
	local onCount, allCount = 0, 0
	for _, h in ipairs(hits) do
		if h.amount > 0 then
			allCount = allCount + 1
			if h.tpKill then onCount = onCount + 1 end
		end
	end
	if onCount > 0 then
		lines[#lines + 1] = "  " .. onCount .. " of " .. allCount
			.. " hits landed while TP Kill was running"
	end

	for _, l in ipairs(lines) do print(l) end
	if type(setclipboard) == "function" then
		pcall(setclipboard, table.concat(lines, "\n"))
	end
	FN.toast(#hits .. " hits logged -- see console")
end

local function setupDeathTracking(char)
	if CONN.deathConn then CONN.deathConn:Disconnect() end
	local hum = char:WaitForChild("Humanoid", 5)
	local root = char:WaitForChild("HumanoidRootPart", 5)
	if hum and root then
		CONN.deathConn = hum.Died:Connect(function()
			CAM.lastDeathPos = root.Position
			-- Printed on death rather than left for you to go and ask for,
			-- because the moment you want it is the moment it just happened
			if MISC.dmgLog then pcall(function() FN.dmgReport() end) end
			FN.updateUI()
		end)

		-- Damage log. Fresh per life: last life's totals answer a question
		-- nobody is asking any more.
		if CONN.dmgConn then CONN.dmgConn:Disconnect() end
		FN.dmgReset()
		ST.dmgLast = hum.Health
		CONN.dmgConn = hum.HealthChanged:Connect(function(hp)
			local was = ST.dmgLast or hp
			ST.dmgLast = hp
			-- HealthChanged fires on heals too, and a heal is not a hit
			if MISC.dmgLog and hp < was then
				pcall(function() FN.dmgNote(was - hp, hp, hum.MaxHealth) end)
			end
		end)
	end
end

local function toggleFullbright()
	ON.fullbrightEnabled = not ON.fullbrightEnabled
	if not ON.fullbrightEnabled then
		-- Put the lighting back the way we found it
		pcall(function()
			Lighting.Ambient = ORIGINAL.ambient
			Lighting.ColorShift_Bottom = ORIGINAL.colorShiftBottom
			Lighting.ColorShift_Top = ORIGINAL.colorShiftTop
			Lighting.GlobalShadows = ORIGINAL.globalShadows
		end)
	end
	FN.updateUI()
end

local function giveLocalBtools()
	-- HopperBin was removed from Roblox, so Instance.new throws on any modern
	-- client. Report that on the button instead of erroring out of the handler.
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		UI.btoolsBtn.Text = "BTools: no backpack"
		return
	end

	local made = 0
	for _, toolName in ipairs({ "Hammer", "Clone", "Grab" }) do
		local ok = pcall(function()
			local tool = Instance.new("HopperBin")
			tool.BinType = Enum.BinType[toolName]
			tool.Name = "BTool " .. toolName
			tool.Parent = backpack
		end)
		if ok then made = made + 1 end
	end

	UI.btoolsBtn.Text = (made > 0)
		and ("Give Local BTools (" .. made .. " added)")
		or "BTools: unsupported on this client"
	task.delay(2.5, function()
		if UI.btoolsBtn.Parent then UI.btoolsBtn.Text = "Give Local BTools" end
	end)
end

-- Anti anti-cheat. Four separate defences, because "anti-cheat" is not one
-- thing and each half of it has to be answered differently.
--
-- What none of this does is make the server accept you. Everything here runs
-- on your own machine and can only stop your own client from cooperating --
-- with a kick it was told to perform, with a report it was told to send, with
-- a watchdog script it was told to run. A server that decides on its own
-- evidence is untouched by all of it, and no client-side code can change that.
local function applyAntiAntiCheat()
	if ST.aacApplied then return end
	ST.aacApplied = true

	-- 1. Kick, via the metamethod hook. Every method call in the game passes
	-- through __namecall, so this catches a Kick from anywhere -- but it needs
	-- hookmetamethod, which plenty of executors do not ship.
	pcall(function()
		if hookmetamethod and getnamecallmethod and checkcaller then
			local oldNamecall
			oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
				local method = getnamecallmethod()
				if not checkcaller() and (method == "Kick" or method == "kick") then
					AAC.blocked = AAC.blocked + 1
					return nil
				end
				return oldNamecall(self, ...)
			end)
			AAC.viaMeta = true
		end
	end)

	-- 2. Kick, via the function hook. Player:Kick is one C function shared by
	-- every Player, so replacing it once covers all of them. This is the path
	-- that works where the metamethod hook does not -- Xeno among them.
	pcall(function()
		if not AAC.viaMeta and hookfunction and newcclosure and checkcaller then
			local oldKick
			oldKick = hookfunction(player.Kick, newcclosure(function(self, msg)
				if not checkcaller() then
					AAC.blocked = AAC.blocked + 1
					AAC.lastKick = tostring(msg or "no reason given")
					return nil
				end
				return oldKick(self, msg)
			end))
			AAC.viaFunc = true
		end
	end)
end

-- 3. Local watchdog scripts. Plenty of games do their checking in a LocalScript
-- on your own machine -- which means it is yours to switch off. Disabled rather
-- than destroyed, so a game that checks the script still exists finds it.
--
-- Matched by name against the filter, never blanket: disabling every LocalScript
-- would take the game's own movement, camera and UI with it.
local function aacKillScripts()
	local terms = {}
	for raw in (AAC.filter or ""):lower():gmatch("[^,]+") do
		local t = raw:gsub("^%s+", ""):gsub("%s+$", "")
		if t ~= "" then terms[#terms + 1] = t end
	end
	if #terms == 0 then return 0 end

	local killed = 0
	local places = {
		player:FindFirstChildOfClass("PlayerScripts"),
		player:FindFirstChildOfClass("PlayerGui"),
		player.Character,
	}

	-- Budgeted. PlayerScripts and the character are small, but PlayerGui is
	-- whatever the game put there -- and a game with a thousand-frame interface
	-- would otherwise turn a button press into a stall.
	local examined = 0

	for _, place in ipairs(places) do
		if place and examined < 5000 then
			for _, d in ipairs(place:GetDescendants()) do
				examined = examined + 1
				if examined > 5000 then break end
				if d:IsA("LocalScript") or d:IsA("ModuleScript") then
					local lower = d.Name:lower()
					for _, term in ipairs(terms) do
						if lower:find(term, 1, true) then
							local ok = pcall(function()
								if d:IsA("LocalScript") then d.Disabled = true end
							end)
							if ok then
								killed = killed + 1
								AAC.killed[d] = true
							end
							break
						end
					end
				end
			end
		end
	end

	return killed
end

-- Tools & Inventory
local function addHandleToTool(tool)
	if not tool:IsA("Tool") then return false end
	local existing = tool:FindFirstChild("Handle")
	if existing and existing:IsA("BasePart") then return false end
	if existing then existing.Name = "OldHandle_" .. existing.Name end

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(1, 1, 2)
	handle.Transparency = 1
	handle.CanCollide = false
	handle.CanQuery = false
	handle.CanTouch = false
	handle.Massless = true
	handle.Anchored = false
	handle.Parent = tool

	pcall(function() tool.RequiresHandle = true end)
	return true
end

local function addHandlesToAllTools()
	local added = 0
	local containers = {player:FindFirstChildOfClass("Backpack"), player.Character}
	for _, container in ipairs(containers) do
		if container then
			for _, obj in ipairs(container:GetDescendants()) do
				if obj:IsA("Tool") then
					local ok, made = pcall(addHandleToTool, obj)
					if ok and made then added = added + 1 end
				end
			end
		end
	end
	UI.addHandlesBtn.Text = "Added Handles: " .. added
	task.delay(2, function()
		if UI.addHandlesBtn.Parent then
			UI.addHandlesBtn.Text = "Add Handles To All Tools"
		end
	end)
end

function FN.applyWalkSpeed()
	local character = player.Character
	if character then
		local hum = character:FindFirstChildOfClass("Humanoid")
		if hum then
			-- The game's own walking speed, remembered once per character.
			-- Writing a hard-coded 16 on the way out was wrong in every game
			-- that walks at 12 or 24 -- turning the mod off used to CHANGE
			-- your speed rather than restore it.
			if ST.baseWalkSpeed == nil then ST.baseWalkSpeed = hum.WalkSpeed end

			if ON.walkSpeedEnabled and MISC.speedMode == "NORMAL" then
				hum.WalkSpeed = VAL.walkSpeed
			else
				-- CFRAME mode leaves the property exactly where the game put
				-- it. That is the whole point of the mode: the extra ground is
				-- covered by the stepper instead.
				hum.WalkSpeed = ST.baseWalkSpeed
			end
		end
	end
end

function FN.applyJumpPower()
	local character = player.Character
	if character then
		local hum = character:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.JumpPower = ON.jumpPowerEnabled and VAL.jumpPower or 50
			hum.UseJumpPower = true
		end
	end
end

