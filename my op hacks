-- ==========================================
--[[
	Where the menu lives.

	The bug that deletes it is almost certainly the game clearing PlayerGui --
	plenty of places run `for _, v in PlayerGui:GetChildren() do v:Destroy() end`
	on respawn or at a round change, and it takes our ScreenGui with everything
	else. The script itself is untouched, which is exactly what you saw: fly and
	the keybinds carried on working with no menu on screen.

	Re-parenting cannot fix that. Destroy() locks the Parent property, so once
	it has run the instance is gone for good and the watchdog below can only
	watch. The fix is to not be in PlayerGui at all:

	  HIDDEN  - gethui(), the executor's own container. Game scripts cannot
	            reach it and GetChildren() on PlayerGui never sees it.
	  COREGUI - CoreGui. Needs executor permissions, and most game scripts
	            cannot touch it either.
	  PLAYER  - PlayerGui. Ordinary, visible to the game, and the only one the
	            deleting bug can reach.

	AUTO walks that list top to bottom and takes the first that works.
--]]
function FN.guiHome()
	local mode = MISC.guiHome or "AUTO"

	if mode == "HIDDEN" or mode == "AUTO" then
		local hidden
		pcall(function()
			if type(gethui) == "function" then hidden = gethui() end
		end)
		if hidden then return hidden, "HIDDEN" end
		if mode == "HIDDEN" then return playerGui, "PLAYER" end
	end

	if mode == "COREGUI" or mode == "AUTO" then
		local core
		pcall(function() core = game:GetService("CoreGui") end)
		-- Reachable is not the same as writable: a locked-down executor hands
		-- back the service and then throws on the parent write, so prove it
		if core then
			local ok = pcall(function() return #core:GetChildren() end)
			if ok then return core, "COREGUI" end
		end
		if mode == "COREGUI" then return playerGui, "PLAYER" end
	end

	return playerGui, "PLAYER"
end

-- Parent the menu to the best home for the current mode. Returns the name of
-- wherever it ended up, so the button can say it rather than claim it.
function FN.homeGui()
	-- Rounds fought in the last ten seconds. A game removing the menu once is
	-- ordinary; removing it repeatedly means we are losing and the answer is a
	-- different home, not a faster watchdog.
	local now = tick()
	if now - (MISC.homeWindow or 0) > 10 then
		MISC.homeWindow = now
		MISC.homeFights = 0
	end
	MISC.homeFights = (MISC.homeFights or 0) + 1

	if MISC.homeFights == 6 then
		local where = MISC.guiWhere or "PLAYER"
		if where == "PLAYER" then
			FN.toast("This game keeps deleting the menu from PlayerGui")
			warn("[ModMenu] the place is sweeping PlayerGui and neither gethui() "
				.. "nor CoreGui is available here, so there is nowhere safer to "
				.. "put it. Set a rebuild source under Come Back After Teleport "
				.. "so a destroy can be recovered from.")
		end
	elseif MISC.homeFights > 40 then
		-- Past this it is a loop, and the warnings are worse than the menu
		-- being gone. Stop, and say so once.
		if not MISC.homeGaveUp then
			MISC.homeGaveUp = true
			warn("[ModMenu] stopped re-parenting: it is being removed faster "
				.. "than it can be put back. Re-run the script when the game "
				.. "has finished whatever it is doing.")
		end
		return MISC.guiWhere or "PLAYER"
	end

	local home, label = FN.guiHome()
	local ok = pcall(function()
		DEC.screenGui.Parent = home
		DEC.screenGui.DisplayOrder = 2147483647
	end)
	if not ok then
		-- The chosen home refused us. PlayerGui always accepts, and a menu the
		-- game can delete beats no menu at all.
		pcall(function() DEC.screenGui.Parent = playerGui end)
		label = "PLAYER"
	end
	MISC.guiWhere = label
	return label
end

